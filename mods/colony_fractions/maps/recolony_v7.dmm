"TS" = (
/obj/machinery/computer/ship/helm,
/obj/item/paper{
	name = "Colony Instructions";
	info = "<h1>Задачи для колонизаторов</h1><br><hr><br><b>Электропитание колонии.</b><br>На данный момент колония оборудована лишь двумя источниками питания. Тритиевым генератором - Мисс Пакман и ядерным реактором, что работает на уране. Мы не знаем о том, богата ли данная планета на минералы, поэтому, в случае если нет - ваша задача топливо экономить, или дать поручение учёным улучшить генераторы. Так же, на одном из ваших складов есть всё необходимое для установки солнечных панелей, так что займитесь этим.<br><br><b>Разведка планеты.</b><br>Кто знает какие загадки может скрывать от нас этот планетоид, и первостепенной задачей для расширения нашей колониальной программы здесь будет разведка. Хорошо прочешите каждый закоулок, изучите каждое неизвестное растение, каждое неизвестное животное, каждую неизвестную структуру - это может быть полезным для наших учёных. Но будьте предельно осторожны, и в случае обнаружения серьёзной опасности - пожалуйста, не ведите её к колонии. Может показаться что выгодно расположенные точки для обороны у входа в колонию вас спасут, но вам же потом и чинить повреждения.<br><br><b>Взаимодействие с пришедшими.</b><br>Вполне вероятно, что ваш планетоид может стать точкой интереса для пролетающих рядом кораблей, поэтому ожидайте высадок поблизости с вами. Хорошей идеей, если вы уверены в своих силах, включить радиомаяк, что расположен у вас в серверной, с запросом выходить на связь перед посадкой. Помните - это ваши владения, и вы здесь хозяева. Никто не имеет права заходить на территорию колонии без вашего разрешения, точно так же как и вы не имеете права посещать чужие корабли без их разрешения. Это очень важный момент.<br>Так-же важным будет напомнить не проявлять агрессию первыми. Попытайтесь наладить общий язык, если, конечно, эти ребята в наглую не собираются вас всех убить, ограбить или что-нибудь похуже. Для подобных случаев ваша колония оборудована двумя камерами заключения, у каждого из вас должен быть при себе энергетический пистолет. <b>В случае открытого вторжения не стесняйтесь использовать всё доступное вам вооружение, будьте готовы защищать колонию любой ценой.</b><br><br><b>Мы не пираты.</b><br>Возможно, для кого-то это неочевидно, поэтому следует отдельным пунктом напомнить. Мы - колонизаторы, не пираты. Мы не имеем никакого права грабить чужие корабли, сооружения или проявлять агрессию."
	},
/obj/structure/cable/green{
	d1 = 1;
	d2 = 4;
	icon_state = "1-4"
	},
/obj/structure/cable/green{
	d1 = 4;
	d2 = 8;
	icon_state = "4-8"
	},
/obj/item/paper{
	name = "Colony Instructions";
	info = "<h1>Задачи для колонизаторов</h1><br><hr><br><b>Электропитание колонии.</b><br>На данный момент колония оборудована лишь двумя источниками питания. Тритиевым генератором - Мисс Пакман и ядерным реактором, что работает на уране. Мы не знаем о том, богата ли данная планета на минералы, поэтому, в случае если нет - ваша задача топливо экономить, или дать поручение учёным улучшить генераторы. Так же, на одном из ваших складов есть всё необходимое для установки солнечных панелей, так что займитесь этим.<br><br><b>Разведка планеты.</b><br>Кто знает какие загадки может скрывать от нас этот планетоид, и первостепенной задачей для расширения нашей колониальной программы здесь будет разведка. Хорошо прочешите каждый закоулок, изучите каждое неизвестное растение, каждое неизвестное животное, каждую неизвестную структуру - это может быть полезным для наших учёных. Но будьте предельно осторожны, и в случае обнаружения серьёзной опасности - пожалуйста, не ведите её к колонии. Может показаться что выгодно расположенные точки для обороны у входа в колонию вас спасут, но вам же потом и чинить повреждения.<br><br><b>Взаимодействие с пришедшими.</b><br>Вполне вероятно, что ваш планетоид может стать точкой интереса для пролетающих рядом кораблей, поэтому ожидайте высадок поблизости с вами. Хорошей идеей, если вы уверены в своих силах, включить радиомаяк, что расположен у вас в серверной, с запросом выходить на связь перед посадкой. Помните - это ваши владения, и вы здесь хозяева. Никто не имеет права заходить на территорию колонии без вашего разрешения, точно так же как и вы не имеете права посещать чужие корабли без их разрешения. Это очень важный момент.<br>Так-же важным будет напомнить не проявлять агрессию первыми. Попытайтесь наладить общий язык, если, конечно, эти ребята в наглую не собираются вас всех убить, ограбить или что-нибудь похуже. Для подобных случаев ваша колония оборудована двумя камерами заключения, у каждого из вас должен быть при себе энергетический пистолет. <b>В случае открытого вторжения не стесняйтесь использовать всё доступное вам вооружение, будьте готовы защищать колонию любой ценой.</b><br><br><b>Мы не пираты.</b><br>Возможно, для кого-то это неочевидно, поэтому следует отдельным пунктом напомнить. Мы - колонизаторы, не пираты. Мы не имеем никакого права грабить чужие корабли, сооружения или проявлять агрессию.";
	language = "Spacer"
	},
/turf/simulated/floor/tiled/dark/monotile,
/area/map_template/colony/command)
