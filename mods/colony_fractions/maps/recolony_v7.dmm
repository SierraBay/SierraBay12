"Xk" = (
/obj/machinery/computer/rdconsole/core/colony{
	req_access = list();
	id = 5;
	dir = 4
	},
/obj/item/paper{
	name = "RnD instructions";
	info = "<h1>Краткие инструкции для научной деятельности</h1><br><hr><br><b>Настройка серверов.</b><br>Ваша колония оборудована сервером для хранения научных данных. Скорее всего, если вы это читаете, сервера вновь отвязаны от консолей. Поэтому вам нужно пройти в серверную и с помощью консоли настройки серверов дать доступ научным консолям в 'Colony R&D' к ним доступ.<br><br><b>Фабрикатор мехов.</b><br>Ввиду определённых обстоятельств для пользования фабрикатором необходим соответствующий доступ. Он имеется на карточке лидера колонии, поэтому не стесняйтесь обращаться к нему за помощью. Просим прощения за неудобства.<br><br><b>Документация.</b><br>Необязательно, но желательно документировать найденные на планетоиде артефакты, аномальные объекты и прочее. Это может значительно помочь в их продаже или извлечении из них пользы в будущем, а так же избавит вас от необходимости объяснять коллегам почему ту или иную вещь лучше не трогать, или наоборот, как её применять."
	},
/obj/floor_decal/industrial/outline/yellow,
/obj/item/paper{
	name = "RnD instructions";
	info = "<h1>Краткие инструкции для научной деятельности</h1><br><hr><br><b>Настройка серверов.</b><br>Ваша колония оборудована сервером для хранения научных данных. Скорее всего, если вы это читаете, сервера вновь отвязаны от консолей. Поэтому вам нужно пройти в серверную и с помощью консоли настройки серверов дать доступ научным консолям в 'Colony R&D' к ним доступ.<br><br><b>Фабрикатор мехов.</b><br>Ввиду определённых обстоятельств для пользования фабрикатором необходим соответствующий доступ. Он имеется на карточке лидера колонии, поэтому не стесняйтесь обращаться к нему за помощью. Просим прощения за неудобства.<br><br><b>Документация.</b><br>Необязательно, но желательно документировать найденные на планетоиде артефакты, аномальные объекты и прочее. Это может значительно помочь в их продаже или извлечении из них пользы в будущем, а так же избавит вас от необходимости объяснять коллегам почему ту или иную вещь лучше не трогать, или наоборот, как её применять.";
	language = "Spacer"
	},
/turf/simulated/floor/tiled/monotile,
/area/map_template/colony/science)
