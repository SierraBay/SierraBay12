/*
	COMBAT_EXTENDED — материалы брони.

	Материал описывает, как ломается броня вещи: где у неё точка поломки, с каким звуком броня её
	проходит и какие осколки летят в носителя дальше (`armor_shards.dm`), — чем её латают
	(`armor_repair.dm`) и как она держит жар луча (`laser_heat.dm`). Вещь задаёт свой материал путём
	в `ce_armor_material`, в своём блоке в `code/items/`. Вещь без своего материала ломается как
	базовый `/singleton/ce_armor_material`.

	Новый материал — подтип здесь, с причиной у каждого значения.
*/

/obj/item
	/// Материал брони вещи: путь `/singleton/ce_armor_material` или его подтипа.
	var/ce_armor_material = /singleton/ce_armor_material


/// Материал по умолчанию: так ломается любая броня, которой не задан свой.
/singleton/ce_armor_material
	/// Название материала в кодексе. null — у материала по умолчанию, там пишется жёсткость брони.
	var/name
	/// Своя точка поломки: доля HP от 0 (не включая) до 1, ниже которой начинает падать рейтинг.
	/// Ниже точки кривая состояния сжимается пропорционально: у точки 0.6 половина рейтинга
	/// остаётся на 32% HP вместо 50%. null — броня ломается по самой `ce_armor_condition_curve`.
	var/break_point
	/// Множитель HP брони. Берётся уже после нижней границы `ce_armor_health_min`, как доля
	/// вторичных зон, так что может опустить HP ниже неё.
	var/health_mult = 1
	/// Баллистическое волокно. Броня из него мягкая, в чём бы её ни носили (`ce_classify_hard_armor()`),
	/// но пули держит по кривой жёсткой брони `ce_sharp_ballistic_hard`, а не мягкой, и нижней
	/// границы тупой оси от пулевого рейтинга не получает (`armor_conversion.dm`).
	var/ballistic_fiber = FALSE
	/// Звук, с которым броня проходит точку поломки. Его слышат все рядом, а не только носитель.
	var/break_sound = 'mods/combat_extended/sounds/armor_break.ogg'
	/// По справочнику BYOND громкость — процент от полной громкости файла, 0–100: громче самого
	/// файла клиент звук не сыграет. Больше 100 лишь съедает ослабления кода до отправки клиенту —
	/// −2 за клетку дальше `world.view` и приглушение низким давлением.
	var/break_sound_volume = 400
	/// Материал осколков — `MATERIAL_*` с осколками (`shard_type`). null — броня из этого материала
	/// не колется: у материала по умолчанию неизвестно, из чего вещь, и осколка не подобрать.
	var/shard_material
	/// Множитель шанса осколка. При 1 шанс за попадание — доля HP, снятых ниже точки поломки, от
	/// максимума, так что за всю жизнь брони в носителя в среднем летит (точка поломки × множитель)
	/// осколков: при кривой — 0.95.
	var/shard_chance_mult = 1
	/// Острый урон осколка по носителю. Порядка осколка стекла под босой ногой (`shards.dm`).
	var/shard_damage = 5
	/// Чем латают броню из этого материала (`armor_repair.dm`): `CE_ARMOR_REPAIR_*`. null — по
	/// жёсткости брони: жёсткую металлом, мягкую тканью. У материала по умолчанию неизвестно, из
	/// чего вещь, а жёсткость подсказывает, во что её латать.
	var/repair_kind
	/// Множитель теплоёмкости брони (`laser_heat.dm`). Тепловые свойства материала по умолчанию —
	/// стальные: сталь — основной материал брони.
	var/heat_capacity_mult = 1
	/// Износ от луча: HP за единицу жара на броне, раскалённой добела. На холодной — почти ноль
	/// (`ce_laser_wear_exponent`).
	var/heat_wear = 0.35
	/// Доля жара каждого попадания, которую забирает абляционное покрытие, пока не выгорит. 0 —
	/// покрытия нет.
	var/coating_share = 0
	/// Проводимость: какую долю разницы температур лица и подбоя подбой догоняет за
	/// `ce_laser_conduction_seconds` на опорной толщине. Сталь догоняет за несколько секунд и печёт
	/// носителя почти сразу.
	var/heat_conduction = 0.5
	/// Размягчение: какую долю Sharp и Blunt броня теряет, раскалённая добела
	/// (`ce_laser_hot_kinetic_exponent`). Сталь теряет треть.
	var/heat_softening = 0.35
	/// Какую долю максимума HP броня теряет от полива хладагентом, раскалённая с
	/// `ce_laser_quench_crack_stage` (`laser_coolant.dm`). 0 — удар холодом ей не страшен.
	var/heat_quench_crack = 0


/// Сталь — голый лист без подбоя. Ломается по самой кривой состояния, со звуком по умолчанию.
/singleton/ce_armor_material/steel
	name = "steel"
	shard_material = MATERIAL_STEEL
	shard_chance_mult = 3
	repair_kind = CE_ARMOR_REPAIR_METAL


/// Керамика. Хрупкий материал не проседает от каждого попадания, а держит полный рейтинг, пока не
/// пойдёт трещинами. HP вдвое меньше, чем у обычной брони с теми же рейтингами: урон, который
/// обычную броню довёл бы до 80% HP, доводит керамику ровно до её точки поломки,
/// `(1 - 0.8) / (1 - 0.6) = 0.5`. Осколков нет: керамики нет среди материалов Bay. Треснувшую
/// керамику хламом не залатать — только набором кузнеца, он правит любую жёсткую броню.
///
/// Жар керамика держит лучше стали и почти не проводит: tactical-плита вмещает 318 жара, а жечь
/// носителя начинает только через 28 секунд после первого попадания. Зато от жара она трескается:
/// при вдвое меньших HP карабинная батарея снимает с неё около 19% HP, и треснувшая плита пропускает
/// больше луча. Размягчается она меньше всех — добела держит 9.5 мм из 11. Раскалённая докрасна, от
/// полива хладагентом она трескается: минус 5% HP за полив.
/singleton/ce_armor_material/ceramic
	name = "ceramic"
	break_point = 0.6
	health_mult = 0.5
	repair_kind = CE_ARMOR_REPAIR_NONE
	heat_capacity_mult = 1.2
	heat_conduction = 0.08
	heat_wear = 0.3
	heat_softening = 0.15
	heat_quench_crack = 0.05


/// Кевлар — баллистическое волокно: мягкая броня, которая держит пули как плита того же класса, а
/// нож и удар — как одежда. Ломается по самой кривой состояния, со своим звуком. Волокно не колется,
/// осколков нет. Латают его тканью, как любую мягкую броню, и набор кузнеца его не берёт.
///
/// Изнашивается кевлар как мягкая броня: остановленная пуля снимает с него весь свой урон, 10-мм
/// пистолет — 45 HP, а с жёсткой плиты с теми же рейтингами — 19; удар его не изнашивает вовсе.
/// Поэтому HP у него в полтора раза больше: medium-вставка несёт 540 HP вместо 360 и пропускает
/// пистолет с пятого попадания, а жёсткая плита — с седьмого.
///
/// Лучи кевлар не останавливает и от них не греется, а обугливается, как любая мягкая броня
/// (`laser_heat.dm`): тепловых свойств у него нет.
/singleton/ce_armor_material/kevlar
	name = "kevlar"
	ballistic_fiber = TRUE
	health_mult = 1.5
	break_sound = 'mods/combat_extended/sounds/kevlar_break.ogg'


/// Мягкий кевлар — тонкое плетение light-вставки и обычного скрытого жилета. Числа материала те же,
/// что у кевлара: тоньше вставку делает её собственный рейтинг.
/singleton/ce_armor_material/kevlar/soft
	name = "soft kevlar"


/// Абляционная броня — жилет, каска, наручи и поножи против лучей. Ломается как броня без своего
/// материала. Её покрытие выгорает вместо брони: забирает 30% жара каждого попадания, пока не
/// выгорит (`ce_laser_coating_per_rating`), и пока оно цело, жилет отражает лучи (`handle_shield()`,
/// `_master_files/code/modules/clothing/suits/armor.dm`). Жара она вмещает больше всех — жилет 342, —
/// поэтому под огнём остаётся самой холодной бронёй. Против пуль это medium-плита. Латают её
/// отражающими листами, и лист возвращает ещё и выгоревшее покрытие: серебро лучше всех, сталь
/// хуже всех (`armor_repair.dm`).
/singleton/ce_armor_material/ablative
	name = "ablative"
	repair_kind = CE_ARMOR_REPAIR_ABLATIVE
	heat_capacity_mult = 1.8
	heat_conduction = 0.15
	heat_wear = 0.2
	heat_softening = 0.3
	coating_share = 0.3


/// Материал вещи, на которой висит броня. У брони не на вещи — материал по умолчанию.
/datum/extension/armor/proc/ce_get_material()
	RETURN_TYPE(/singleton/ce_armor_material)
	var/obj/item/armor_item = holder
	if(!istype(armor_item))
		return GET_SINGLETON(/singleton/ce_armor_material)
	return GET_SINGLETON(armor_item.ce_armor_material)
