#define CE_FLESH_RHA 0.22
/// Здоровье, при котором плотность плоти равна `ce_flesh_rha`: 200 — человек. Масштаб по здоровью —
/// аналог HealthScale из CE.
#define CE_FLESH_REFERENCE_HEALTH 200

// Глубина досягаемости `D`: сколько пробития атаке надо сохранить после брони и плоти, чтобы
// гарантированно дойти до органов.

/// `D` для пуль, мм RHA. Выше пробития слабых пуль, поэтому картечь и без брони чаще оставляет
