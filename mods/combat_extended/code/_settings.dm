// ============================================================================================
// Разброс от отдачи (`recoil_spread.dm`)
// ============================================================================================
// Образец — CEV Eris (`/mob/living/var/recoil`): отдача копится на стрелке, идёт в угол разброса и
// убывает сама. Там выстрел прибавляет силу отдачи оружия на отдачу пули (`kickback()`), потолок —
// 45 (`MAX_ACCURACY_OFFSET`), а каждые 0.1 с отдача теряет 0.4 и десятую часть остатка
// (`calc_recoil()`): с потолка она сходит за 2.5 с. Числа ниже — свои: стаки здесь меряет сила
// толчка вида (`ce_get_recoil_strength()`), а убывают они по одному.

/// Дуга разброса на стак отдачи, градусы: снаряд отклоняется не дальше половины дуги в каждую
/// сторону. Прибавляется после навыка: умелый стрелок гасит разброс оружия, но не отдачу. Ноль
/// выключает разброс от отдачи.
var/global/ce_recoil_spread_arc_per_stack = 1

/// Больше стаков отдачи на стрелке не копится. 30 стаков по градусу — дуга одного уровня навыка
/// (`ce_skill_dispersion_arc_degrees`): на потолке стрелок кладёт пули как тот, кто на уровень хуже.
var/global/ce_recoil_spread_max_stacks = 30

/// Раз в столько децисекунд со стрелка снимается стак отдачи, стреляет он или нет. С единицей
/// пистолет (2 стака за выстрел, выстрел раз в 6 дс) отдачу не копит, пулемёт L6 в автоматическом
/// режиме (5 стаков, выстрел раз в децисекунду) доходит до потолка за 8 выстрелов, а с потолка
/// стаки сходят за 3 с. Ноль и меньше — стаки не держатся вовсе.
var/global/ce_recoil_spread_decay_time = 1

/// На столько больше стаков за выстрел получает стрелок за каждый уровень навыка оружия ниже
/// обученного (`SKILL_TRAINED`), доля; за каждый уровень выше — на столько же меньше. 0.25 — шаг
/// навыка мода, как у починки брони и парирования: без навыка — в полтора раза больше, мастер —
/// вдвое меньше.
var/global/ce_recoil_spread_gain_per_skill = 0.25


// ============================================================================================
// Прицел и бинокль (`scopes.dm`)
// ============================================================================================
// Пока смотрит в прицел или бинокль, держащий не поворачивается и идёт медленно, а прицел даёт
// оружию свою точность только тому, кто постоял на месте.

/// На столько децисекунд шаг смотрящего в прицел медленнее крадущегося (`creep_delay` конфига, 6):
/// крадущимся шагом — 9 дс на клетку, а обычный шаг — 4, бег — 2. 3 — прибавка Сьерры к шагу с
/// замком направления (`mods/_master_files/code/modules/mob/living/carbon/human/human_movement.dm`),
/// хотя тот файл в сборку не подключён и в игре её нет.
var/global/ce_scope_step_delay = 3

/// Столько децисекунд смотрящий в прицел должен простоять без шага, чтобы прицел дал оружию свою
/// точность (`scoped_accuracy`). Шагнул — до этого срока стреляет с точностью оружия без прицела.
/// Ноль — точность прицела сразу, и на ходу тоже.
var/global/ce_scope_settle_time = 1 SECOND


// ============================================================================================
// Кислота против одежды и брони (`acid_armor.dm`)
// ============================================================================================
// Всплеск кислоты делится по частям тела, и на каждой встречает то, что её закрывает. Сколько
// кислоты нужно и как сильно она жжёт — числа самой кислоты в Бэй (`touch_met`, `power`,
// `meltdose`, `max_damage`): здесь их нет.

/// Доля площади тела по органам: столько всплеска приходится на каждую часть. Числа Бэй — те же
/// доли, по которым `reagent_permeability()` считает, сколько химии дойдёт до кожи под одеждой.
var/global/list/ce_acid_part_shares = list(
	BP_HEAD = THERMAL_PROTECTION_HEAD,
	BP_CHEST = THERMAL_PROTECTION_UPPER_TORSO,
	BP_GROIN = THERMAL_PROTECTION_LOWER_TORSO,
	BP_L_ARM = THERMAL_PROTECTION_ARM_LEFT,
	BP_R_ARM = THERMAL_PROTECTION_ARM_RIGHT,
	BP_L_HAND = THERMAL_PROTECTION_HAND_LEFT,
	BP_R_HAND = THERMAL_PROTECTION_HAND_RIGHT,
	BP_L_LEG = THERMAL_PROTECTION_LEG_LEFT,
	BP_R_LEG = THERMAL_PROTECTION_LEG_RIGHT,
	BP_L_FOOT = THERMAL_PROTECTION_FOOT_LEFT,
	BP_R_FOOT = THERMAL_PROTECTION_FOOT_RIGHT
)

/// Доля головы, которая приходится на макушку: её закрывает шлем. Остальное — лицо, пополам глаза
/// и рот: их закрывают очки, маска или шлем с забралом. С половиной макушка — 15% тела, глаза и
/// рот — по 7.5%. Число своё: в Бэй голова для химии одна.
var/global/ce_acid_scalp_share = 0.5

/// Множитель износа брони от кислоты. С единицей броня теряет столько HP, сколько ожога не пустила
/// к коже: шлем (макушка, 15% тела) от полной дозы политриновой кислоты — 9 HP из 60 ожога. У
/// шлема их от сотни.
var/global/ce_acid_armor_wear_mult = 1


// ============================================================================================
// Внешние бронеэлементы мехов (`mech_plates.dm`)
// ============================================================================================
// Рейтинги, пробитие, HP и износ бронеэлементов — общие, из разделов выше. Здесь только то, чего
// у брони-одежды нет.

/// Множитель рейтинга по кривой состояния, ниже которого бронеэлемент отваливается от меха.
/// До нуля HP пули жёсткую броню не доводят: её износ пропорционален рейтингу, рейтинг падает
/// вместе с HP, и HP убывают по экспоненте. 0.25 — граница состояния «nearly ruined»
/// (`ce_get_wear_state()`): противопульный бронеэлемент (16 мм) на ней держит 4 мм и не
/// останавливает уже и пистолет (4.4 мм).
var/global/ce_mech_plate_break_condition = 0.25


