// --- Формулы износа §8: дефайны ---

/// Минимальный износ мягкой брони от острой атаки — доля урона до слоя. §8: `SoftArmorMinDamageFactor`.
#define CE_SOFT_ARMOR_MIN_WEAR 0.2
/// Итоговый множитель износа жёсткой брони. §8: `HardArmorDamageFactor`.
#define CE_HARD_ARMOR_WEAR_FACTOR 0.5
/// Тупая атака слабее этой доли рейтинга жёсткую броню не изнашивает: плита просто звенит. §8.
#define CE_ELASTIC_BLUNT_RATIO 0.5

// --- Кривая состояния и HP: ручки под VV ---

/// Кривая состояния: доля HP -> множитель рейтинга. §4, `healthCurve`, но рейтинг начинает
/// падать с 95% HP, а не с 80%, как в CE: износ сказывается уже со второго-третьего попадания.
/// Опорная точка «50% HP — половина рейтинга» — из CE. Первая точка с полным рейтингом (95%) —
/// точка поломки по умолчанию. Своя точка — у материала вещи (`armor_materials.dm`): ниже неё
/// кривая сжимается пропорционально.
var/global/list/ce_armor_condition_curve = list(
	list(0, 0), list(0.5, 0.5), list(0.95, 1), list(1, 1)
)

/// HP на миллиметр лучшего острого рейтинга, до излома. Откалибровано так, что medium-плита
/// несёт 360 HP и теряет половину рейтинга за девять остановленных 10-мм пуль.
var/global/ce_armor_health_per_mm = 60
/// Толщина, до которой HP растут линейно, мм. Это medium-плита: лёгкая броня калибровалась по
/// ней, а выше линейные HP давали тяжёлой броне десятки попаданий до первой потери рейтинга.
var/global/ce_armor_health_knee_mm = 6
/// Степень роста HP выше излома: 0.5 — как корень из толщины. merc-плита (16 мм) несёт 588 HP
/// вместо 962 линейных.
var/global/ce_armor_health_exponent = 0.5
/// HP на единицу тупого рейтинга, Bay МПа. Броня против холодного сильна тупой осью, а острые
/// миллиметры у неё малы: без этого riot несла бы меньше HP, чем medium-плита. 3.7 выбрано так,
/// что merc-плита (16 мм, 260) по обеим осям выходит одинаково.
var/global/ce_armor_health_per_blunt = 3.7
/// Множитель HP головных уборов. В CE каски несут примерно 0.6 HP на миллиметр от брони на тело.
/// Берётся уже после нижней границы: мягкая шапка несёт 0.6 от мягкой брони на тело.
var/global/ce_armor_health_head_mult = 0.6
/// Нижняя граница HP. Держит мягкую броню и вещи без кинетической брони: у них HP от рейтинга
/// вышли бы почти нулевыми. Доли головных уборов и конечностей берутся уже от неё: мягкие каска,
/// наручи и руки скафандра несут по 120.
var/global/ce_armor_health_min = 200

// --- Сам износ: ручки под VV ---

/// Множитель износа от всего, что не пуля: холодного оружия, бросков, рукопашки. На единицу урона
/// удар изнашивает броню примерно как пуля, но бьёт слабее, и за драку броня почти не портилась.
/// Упругое тупое остаётся нулём при любом множителе: лом от merc-плиты всё так же отскакивает.
var/global/ce_armor_melee_wear_mult = 2

/// Степень доли пробития в износе жёсткой брони от остановленной атаки: `min(1, (pen / armor) ^ N)`.
/// В CE — 2. С квадратом атака, которую броня останавливает с запасом, её почти не изнашивает:
/// пистолет (4.4 мм) снимал с bulletproof (20 мм) меньше 5 HP, а нож с merc-плиты — 1. Линейная
/// доля сохраняет максимум износа у границы пробития и нули упругого тупого.
var/global/ce_armor_wear_ratio_exponent = 1

/// Расширения, которые не изнашиваются. Кроме них не изнашивается всё, что не вещь: естественная
/// броня мобов и корпуса протезов, — и нематериальные вещи с `ce_armor_nonphysical`, например
/// энергощит (`ce_can_wear()`).
/// - `/datum/extension/armor/ablative` — экзокостюм Ascent со своим износом. Кривая состояния
