/*
	COMBAT_EXTENDED — все настройки мода: выключатели, константы и кривые.

	Каждое число, которым настраивается мод, живёт здесь вместе с объяснением, откуда оно взято и
	почему именно такое. В остальных файлах только процедуры: значения они берут отсюда по имени.

	Виды настроек:
		Выключатели, ручки — `var/global`, переключаются через VV на тест-мёрже, без пересборки.
		Кривые       — `var/global/list` точек `list(вход, выход)`, отсортированных по входу. Между
		               точками значение линейное, за крайними держится крайнее (`ce_evaluate_curve()`).
		Списки типов — `var/global/list`, не заморожены: другой мод дописывает в них свой тип.
		Дефайны      — меняются только пересборкой. Их `#undef` — в `_undefines.dm`, в конце мода.

	Единицы:
		Sharp — мм RHA, та же шкала, что в CE, поэтому плотность плоти 0.22 из CE остаётся валидной.
		Blunt — «Bay МПа» = МПа CE × 10. Урон в Bay примерно в 2.2 раза больше урона CE, а тупой урон
		        считается через кубический корень: чтобы оставить формулу CE как есть, масштабируется
		        вход, а не выход (2.2³ ≈ 10.6).
		Вход кривых брони — ключи `bullet` и `melee` на шкале 0–110 из `code/__defines/armor.dm`.

	После правки: юнит-тесты мода на карте example держат обещания дефайнов брони и опорные точки
	ниже, а таблицы с числами в README надо перемерить.

	Сюда не вынесены постоянные самих формул спеки — `10` в `(10 × bluntPen) ^ (1/3)` и прочее:
	это формула CE, а не ручка. И пороги сообщений о блоке и износе: на бой они не влияют. Числа
	материалов брони — точки поломки и звуки — живут у самих материалов, в `armor_materials.dm`.
*/


// ============================================================================================
// Выключатели
// ============================================================================================
// У вывода рейтингов и пробития и у прохода по слоям выключателя нет: без них мод не работает вовсе.
// Да и в целом выключатели не нужны - их буквально переключать можно только в коде, МС не работает
// Позже избавимся от них

/// Остаточный тупой удар от пули, пробившей слой, но потерявшей на нём урон (`residual_blunt.dm`).
var/global/ce_residual_blunt_enabled = TRUE

/// Органы задеваются по остатку пробития (`organ_depth.dm`). У плотности тканей своего выключателя
/// нет: остаток пробития читают только остаточный удар и досягаемость органов.
var/global/ce_organ_depth_enabled = TRUE

/// Износ брони (`armor_wear.dm`). Выключенный износ не копится и не читается: накопленный вернётся
/// при включении.
var/global/ce_armor_wear_enabled = TRUE

/// Починка брони хламом (`armor_repair.dm`). Выключенная — хлам проходит мимо брони, как без мода:
/// в подсумки плитоноски, на пробоины скафандра. Работает только вместе с износом.
var/global/ce_armor_repair_enabled = TRUE

/// Эффекты снарядов требуют пробития (`projectile_effects.dm`): остановленный бронёй снаряд не
/// застревает и не перебивает артерию, а помеченный снаряд получает в `on_hit()` полный блок.
var/global/ce_penetration_effects_enabled = TRUE

/// Боль и оглушение проходят броню вместе с уроном (`agony_armor.dm`): снаряд и дубинка,
/// остановленные бронёй, не причиняют боли и не оглушают, пробившие — по доле прошедшего урона.
var/global/ce_agony_armor_enabled = TRUE

/// Щиты через проход по слоям (`shields.dm`): щит в руке или на спине — внешний слой брони на
/// закрытых им зонах, без броска шанса блока Bay, со стойками и тупой волной в руку. Выключенный —
/// щиты Bay с их броском.
var/global/ce_shields_enabled = TRUE

/// Взрыв контузит, а не отключает (`concussion.dm`): бросок на паралич в `human/ex_act()`
/// откатывается, вместо него — замешательство, муть в глазах, головокружение и сбитая речь по
/// силе взрыва и броне `bomb`. Выключенный — отключка Bay.
var/global/ce_concussion_enabled = TRUE

/// Светошумовая граната по правилам мода (`flashbang_effects.dm`): звук не станит, любая каска
/// снимает звуковую часть, граната в руке бьёт кисть. Выключенный — граната Bay.
var/global/ce_flashbang_enabled = TRUE

/// Парирование с прочностью оружия (`weapon_parry.dm`): оружие встречает удар первым слоем брони —
/// пробившее его острое идёт в зону, тупое уходит волной в руку, — изнашивается, крит отбивает удар
/// чисто или даёт ответный удар, а порез о вещь при обезоруживании стал ответным ударом. Выключенный
/// — парирование Bay: удар отменяется целиком, бросок на 1 HP и порез.
var/global/ce_parry_enabled = TRUE

/// Выстрел при обезоруживании (`disarm_gunfire.dm`): два броска — реакция держащего ружьё и борьба
/// за него — решают, выстрелит ли оно в обезоруживающего или в сторону. Не на предохранителе и не
/// на намерении помощи. Выключенный — бросок Bay: ружьё стреляет в случайную клетку.
var/global/ce_disarm_gunfire_enabled = TRUE

/// Луч через жёсткую броню по вычитанию, с нагревом брони (`laser_heat.dm`). Выключенный — лучи
/// снова идут по процентной формуле Bay, а накопленный жар ни на что не влияет: не жжёт носителя и
/// не размягчает броню. Остывать броня продолжает.
var/global/ce_laser_heat_enabled = TRUE

/// Рикошеты пуль от стен (`projectile_ricochet.dm`): пуля, задевшая стену вскользь, может отскочить
/// и лететь дальше ослабленной. Выключенные — пуля застревает в стене, как в Bay.
var/global/ce_ricochet_enabled = TRUE

/// Отладка рикошетов: каждое столкновение пули со стеной, от которой она может отскочить, пишется в
/// чат всем, кто видит стену, — угол, шанс, бросок и урон до и после. Для проверки на игре.
var/global/ce_ricochet_debug = TRUE

/// Попиксельная стрельба (`projectile_aim.dm`): выстрел летит в пиксель, по которому щёлкнули, угол
/// вектора не округляется, разброс оружия идёт дробными градусами. Выключенная — вектор Bay: из
/// середины клетки в середину клетки, целыми градусами.
var/global/ce_pixel_aim_enabled = TRUE

/// Физические попадания (`projectile_hits.dm`) — порт модели попаданий Авроры: разброс от навыка
/// стрелка, круг тела — пуля, прошедшая мимо него, летит дальше без броска, — бросок с шансом зоны
/// и линейной поправкой за расстояние, выстрел в упор без промаха, выстрел по клетке под лежащим.
/// Работают только вместе с попиксельной стрельбой: дуга навыка и точка прицела живут в её векторе.
/// Выключенные — бросок Bay в `attack_mob()`.
var/global/ce_physical_hits_enabled = TRUE

/// Отладка прицела: каждый выстрел пишет стрелку в чат, куда нацелен вектор, — смещение точки
/// прицела от середины клетки цели, дугу разброса и выпавшее отклонение, — а с физическими
/// попаданиями ещё пролёт мимо тела и бросок попадания. Для проверки на игре.
var/global/ce_aim_debug = TRUE


// ============================================================================================
// Броня: рейтинги из статов предмета (`armor_conversion.dm`)
// ============================================================================================
// Осей три: Sharp против пуль (от `bullet`), Sharp против холодного (от `melee`) и Blunt (от
// `melee`). Каждая считается по СВОЕМУ входу и СВОЕЙ кривой, Blunt никогда не множитель от Sharp.
// Кривые жёсткой и мягкой брони расходятся в разы, иначе плащ с «винтовочным» `bullet` становился
// бы плитой. Это самая сильная ручка всей конверсии. Жёсткость — списки в конце раздела.

// --- Sharp против ПУЛЬ, жёсткая броня. Вход — ключ `bullet`, и только он. ---
//     ARMOR_BALLISTIC_SMALL     (25) — armor vest     -> 3.0 мм  (ниже любого пистолета)
//     ARMOR_BALLISTIC_PISTOL    (50) — low-profile tactical vest -> 6.0 мм  (держит пистолеты, магнум и
//                                                                 винтовки пробивают)
//     ARMOR_BALLISTIC_RESISTANT (65) — tactical plate -> 11.0 мм (держит винтовочный FMJ)
//     ARMOR_BALLISTIC_RIFLE     (80) — merc / rig/merc -> 16.0 мм
//     ARMOR_BALLISTIC_AP        (95) — rig/merc/heavy -> 20.0 мм
//     ARMOR_BALLISTIC_HEAVY    (110) — верх лестницы  -> 26.0 мм
// Калибровка по CE — README, «Сравнение с CE». Обещания дефайнов сохраняются: 50 «Blocks holdout
// and normal pistol ammo», 80 «Blocks rifle rounds».
// Меняешь узлы — переноси и `ce_blunt_from_sharp`, её точки стоят на выходах этой кривой.
//
// По этой же кривой держит пули баллистическое волокно — кевлар (`ballistic_fiber` у материала,
// `armor_materials.dm`): броня мягкая, а против пуль — как плита того же класса. Своей кривой у него
// нет, так что light-вставка даёт те же 3.0 мм, medium — 6.0 мм, и с калибровкой плит они не разойдутся.
var/global/list/ce_sharp_ballistic_hard = list(
	list(0, 0), list(10, 1.0), list(25, 3.0), list(50, 6.0),
	list(65, 11.0), list(80, 16.0), list(95, 20.0), list(110, 26.0)
)

// --- Sharp против ПУЛЬ, мягкая броня: одежда, скафандры, всё, что не попало в списки жёсткой и не
//     баллистическое волокно. ---
// Примерно треть жёсткой на всём диапазоне: плащ с `bullet` 50 даёт 2.0 мм, и пистолет (4.4 мм)
// проходит его с половиной урона. С CE эта кривая, в отличие от жёсткой, не сверялась.
var/global/list/ce_sharp_ballistic_soft = list(
	list(0, 0), list(10, 0.3), list(25, 1.0), list(50, 2.0),
	list(65, 3.0), list(80, 5.0), list(110, 8.0)
)

// --- Sharp против ХОЛОДНОГО ОРУЖИЯ, жёсткая броня. Вход — ключ `melee`, и только он. ---
// Отдельная от пуль ось: `bullet` в Bay означает стойкость к пулям, а способность держать нож живёт
// в `melee`. Перекрёстных нижних границ между осями НЕТ: бронебойного `hivebot/tank/armored/anti_bullet`
// (bullet 65, melee 0) надо резать, а противоударного `anti_melee` (bullet 0, melee 70) — стрелять.
//
// Узлы — обещания `code/__defines/armor.dm`, в паре с пробитием ножа ~1.5 мм и меча ~2.5 мм
// (`ce_pen_curve_melee`):
//     ARMOR_MELEE_KNIVES    (15) — «Blocks most knives»                               -> 1.6 мм
//     ARMOR_MELEE_RESISTANT (30) — «Blocks large weapons like swords and toolboxes»    -> 2.6 мм
//
// Выше 30 кривая намеренно ПОЛОГАЯ: шкала `melee` выше «держит меч» описывает уже ударную
// стойкость, а не устойчивость к острому. ARMOR_MELEE_SHIELDED (100) даёт 4.0 мм — останавливает
// любую сталь в игре.
var/global/list/ce_sharp_melee_hard = list(
	list(0, 0), list(5, 0.6), list(10, 1.1), list(15, 1.6),
	list(30, 2.6), list(50, 3.3), list(70, 3.7), list(100, 4.0)
)

// --- Sharp против ХОЛОДНОГО ОРУЖИЯ, мягкая броня. ---
// 35–40% жёсткой. Обещания дефайнов относятся к жёсткой броне: мягкая вещь с ARMOR_MELEE_KNIVES
// даёт 0.6 мм, и опорный нож (1.54 мм) её прорезает.
var/global/list/ce_sharp_melee_soft = list(
	list(0, 0), list(5, 0.2), list(10, 0.4), list(15, 0.6),
	list(30, 0.9), list(50, 1.2), list(70, 1.4), list(100, 1.6)
)

// --- Blunt, жёсткая броня, Bay МПа. Вход — ключ `melee`. ---
// Опорные точки — те же обещания дефайнов, в паре с сырой кривой ударов `ce_pen_curve_blunt`:
// ARMOR_MELEE_KNIVES (15) -> 60 против 50 у дубинки силы 15, ARMOR_MELEE_RESISTANT (30) -> 100
// против 95 у удара силы 30. Поверх ударов сидит `CE_BLUNT_PEN_MELEE_MULT`, так что в игре эти
// дефайны удар гасят, а не отменяют.
// Выше 30 кривая круче: riot-жилет (70) выходит на 240, почти как merc-плита (260 от нижней
// границы `ce_blunt_from_sharp`), — противоударная броня держит удар наравне с лучшими плитами.
var/global/list/ce_blunt_curve_hard = list(
	list(0, 0), list(5, 20), list(10, 40), list(15, 60),
	list(30, 100), list(50, 160), list(70, 240), list(100, 350)
)

// --- Blunt, мягкая броня. ---
// 40–45% жёсткой, по тому же принципу, что и мягкие острые кривые.
var/global/list/ce_blunt_curve_soft = list(
	list(0, 0), list(5, 8), list(10, 16), list(15, 25),
	list(30, 45), list(50, 70), list(70, 100), list(100, 150)
)

// --- Нижняя граница Blunt от баллистического Sharp. Вход — Sharp против пуль, мм RHA. ---
// Пластина, держащая винтовку, физически не может иметь мизерный Blunt, даже если у предмета
// забыли проставить `melee`. Кривая, а не множитель: у CE отношение Blunt/Sharp растёт с тиром.
//
// Точки по X стоят ровно на выходах `ce_sharp_ballistic_hard` в её узлах, чтобы при том же ключе
// `bullet` граница не зависела от калибровки острой оси: тупая ось брони — это баланс холодного
// оружия. Меняешь узлы `ce_sharp_ballistic_hard` — переноси и эти.
//
// ЭТУ КРИВУЮ НЕ ПОДНИМАТЬ ради остаточного урона от пуль: по ней же считаются удары дубинкой, а
// импульс пули примерно впятеро больше. Граница на уровне пули делает плиты от medium и выше
// неуязвимыми для всего тупого холодного оружия. Ручка для пуль — `CE_BLUNT_PEN_PER_BULLET_DAMAGE`.
//
// Баллистическое волокно границы не получает (`ce_get_cold_blunt()`): кевлар пулю останавливает, а
// удар пропускает.
var/global/list/ce_blunt_from_sharp = list(
	list(0, 0), list(1, 7.5), list(3, 23.75), list(6, 58.75),
	list(11, 102.5), list(16, 260), list(20, 350), list(26, 450)
)

/*
	--- Что считается жёсткой бронёй ---

	Три списка, потому что «жёсткость» в этой кодовой базе опознаётся тремя разными способами,
	и свести их к одному нельзя — каждый закрывает случаи, которые двум другим не видны.
	Порядок проверки: расширение -> носитель -> слот аксессуара (`ce_classify_hard_armor()`).
	Всё остальное — мягкая броня.

	Раньше списков смотрится материал вещи: броня из баллистического волокна (`ballistic_fiber`,
	`armor_materials.dm`) мягкая, в какой бы список ни попал её носитель. Так мягкими стали
	кевларовые вставки плитоноски — light и medium `armor_plate` — и обычный скрытый жилет
	`armor_plate/sneaky`.
*/

/// Ось 1. По типу САМОГО РАСШИРЕНИЯ — когда носитель является деталью, которую по типу
/// предмета не опознать.
/// - `/datum/extension/armor/rig` — детали ригов. Грудная секция — `/obj/item/clothing/suit/space/rig`,
///   а это НЕ `suit/armor`: без этой строки хардсьют получает жёсткую каску и мягкий нагрудник.
var/global/list/ce_hard_armor_extensions = list(
	/datum/extension/armor/rig
)

/// Ось 2. По типу НОСИТЕЛЯ — обычный случай.
/// - `/obj/item/clothing/accessory/armor_plate` — пластины плитоноски по типу, а НЕ по слоту:
///   `armor_plate/sneaky` переставлена в `_master_files` в `ACCESSORY_SLOT_DECOR`, чтобы не
///   занимать утилити-слот, и ось 3 отправила бы жёсткий тактический жилет `sneaky/tactical` в
///   мягкие. Кевларовые вставки — базовый `armor_plate` и `medium` — и обычный скрытый жилет
///   `sneaky` мягкие по материалу.
/// - `/obj/item/clothing/suit/space/void` — корпус войдсьюта: жёсткая оболочка, как у рига. Его
///   шлем — `head/helmet/space`, жёсткий как каска. Мягкими остаются только EVA-скафандры
///   `suit/space`.
/// - `/obj/item/rig` — блок управления ригом, для полноты: в слотах одежды он не лежит.
/// - `/obj/item/shield` — щиты: жёсткий корпус, лучи останавливают, если хватает брони от них.
/// - `/obj/item/mech_external_armor` — внешние бронеэлементы мехов из `mods/mechs_by_shegar`
///   (`mech_plates.dm`).
/// - `/mob/living` — естественная броня: хитин, панцири, встроенная броня мехов
///   (`/datum/extension/armor/mech` на самом `/mob/living/exosuit`).
/// - `/obj/item/organ/internal/augment/armor/changeling` — подкожная броня генокрада: кость и
///   хитин. Обычная подкожная сетка гибкая и остаётся мягкой.
var/global/list/ce_hard_armor_holders = list(
	/obj/item/clothing/head/helmet,
	/obj/item/clothing/suit/armor,
	/obj/item/clothing/suit/space/void,
	/obj/item/clothing/suit/storage/vest,
	/obj/item/clothing/accessory/armor_plate,
	/obj/item/rig,
	/obj/item/shield,
	/obj/item/mech_external_armor,
	/mob/living,
	/obj/item/organ/internal/augment/armor/changeling
)

/// Ось 3. По СЛОТУ аксессуара — для того, что бронёй по типу не назовёшь, но носится в
/// бронеслоте: наручи и поножи. `_STORAGE` и `_MISC` сюда не входят — это подсумки и нашивки.
var/global/list/ce_hard_armor_accessory_slots = list(
	ACCESSORY_SLOT_ARMOR_CHEST,
	ACCESSORY_SLOT_ARMOR_ARMS,
	ACCESSORY_SLOT_ARMOR_LEGS
)


// ============================================================================================
// Атака: пробитие из статов атаки (`attack_penetration.dm`)
// ============================================================================================
// Пробитие — кривая по урону или силе удара плюс вклад AP: у пуль он прибавляет миллиметры, у
// холодного оружия умножает.

// --- Пули: острое пробитие ---

// Sharp-пробитие пуль по калибру, мм RHA. Вход — `damage`. AP сверху — прибавка ниже.
// Опорные точки в связке с кривыми брони:
//     pistol  (damage 45, ap 0)  -> 4.4 мм, а ARMOR_BALLISTIC_PISTOL (50) даёт 6.0 мм,
//                                   то есть «Blocks holdout and normal pistol ammo» выполняется.
//     rifle   (damage 45, ap 25) -> 10.5 мм, ARMOR_BALLISTIC_RIFLE (80) даёт 16.0 мм,
//                                   то есть «Blocks rifle rounds» тоже выполняется.
// Кривая пологая: урон пули в Bay почти не связан с её энергией, так что калибр даёт основу,
// а бронебойность несёт AP.
var/global/list/ce_pen_curve_bullet = list(
	list(0, 0), list(5, 0.8), list(10, 1.4), list(20, 2.4),
	list(30, 3.4), list(45, 4.4), list(60, 5.3), list(80, 6.2)
)

/*
	Прибавка AP к острому пробитию пули, мм RHA (`ce_ap_sharp_bonus_bullet()`):

		bonus = AP × CE_AP_MM_PER_POINT_BULLET
		      + CE_AP_EARLY_BONUS_MM_BULLET × (1 - (1 - min(AP, RANGE) / RANGE)²)
*/

/// Наклон линейной части прибавки, мм RHA на единицу AP. 0.176 = 4.4 / 25: без раннего бонуса
/// `rifle` (AP 25) получал бы сверху ровно пистолетные 4.4 мм.
#define CE_AP_MM_PER_POINT_BULLET 0.176
/// Ранний бонус, мм сверх линейной части. 2 — верх, при котором `rifle` (10.5 мм) ещё
/// останавливается tactical-плитой (11 мм).
#define CE_AP_EARLY_BONUS_MM_BULLET 2
/// За сколько единиц AP набирается ранний бонус. 40 — по замыслу: разгон покрывает обычные
/// патроны вплоть до `rifle/military` (35), а бронебойные (70 и выше) стоят уже на линейной
/// части с полным бонусом.
#define CE_AP_EARLY_BONUS_RANGE_BULLET 40
/// Делитель ОТРИЦАТЕЛЬНОГО AP пули (`ce_ap_multiplier()`): `-25` вдвое уменьшает пробитие, `-100`
/// оставляет пятую часть.
#define CE_AP_DIVISOR_BULLET 25

// --- Пули: тупое пробитие — удар остановленной пули ---

/**
 * Множитель урона пули, дающий её тупое пробитие в «Bay МПа»: им остановленная пуля бьёт как
 * тупой удар.
 *
 * ЭТО ГЛАВНАЯ РУЧКА БАЛАНСА остаточного урона от остановленных пуль. Она двигает ТОЛЬКО пули:
 * тупое холодное оружие считается по `ce_pen_curve_blunt` и её не видит. Поэтому крутить надо
 * именно здесь, а не в `ce_blunt_from_sharp` — та кривая задаёт тупую ось БРОНИ, общую и для
 * пуль, и для дубинок.
 *
 * Откалибровано по бронеплитам, по остановленному 10-мм пистолету (45 урона): medium-плита
 * пропускает 10.2 урона, а merc гасит его НАСУХО — тупое пробитие пистолета 247.5 против 260 у
 * плиты, запас 5%. Выше `CE_BLUNT_PEN_BULLET_KNEE` пробитие растёт круче, а `armor_penetration`
 * его дополнительно поднимает — см. дефайны ниже.
 *
 * Расхождение со спекой осознанное: у CE выходит ~15 (7.62 NATO — 66.72 МПа при 20 урона). При 15
 * даже лучшая плита в игре пропускала 11.6 урона от остановленного пистолета, потому что
 * байевские рейтинги брони живут куда ниже импульса пули.
 */
#define CE_BLUNT_PEN_PER_BULLET_DAMAGE 5.5

/**
 * Урон пули, выше которого тупое пробитие растёт не линейно, а в степени
 * `CE_BLUNT_PEN_BULLET_EXPONENT`. Это 10-мм пистолет: на нём откалиброваны плиты, и до него
 * включительно ничего не меняется.
 *
 * Урон пуль в Bay лежит в узком диапазоне 40–80, а удар остановленной пули — кубический корень
 * из тупого пробития. С линейным пробитием слаг (60) бил остановленным всего в 1.1 раза сильнее
 * пистолета.
 */
#define CE_BLUNT_PEN_BULLET_KNEE 45
/// Степень роста тупого пробития пули выше `CE_BLUNT_PEN_BULLET_KNEE`. Под кубическим корнем
/// удара куб даёт удар, растущий с уроном линейно: остановленная пуля тяжелее пистолета бьёт
/// примерно на 30% своего урона до тупой оси брони. Слаг (60) несёт 587 Bay МПа вместо 330.
#define CE_BLUNT_PEN_BULLET_EXPONENT 3
/// Делитель вклада AP в ТУПОЕ пробитие пули: `blunt_pen *= 1 + armor_penetration / K`.
/// Винтовка в Bay несёт тот же урон, что пистолет, и отличается только AP, поэтому без него
/// остановленная винтовка била ровно как пистолет. 50 даёт `rifle` (AP 25) в полтора раза больше
/// тупого пробития: через tactical 11.2 урона вместо 7.9.
#define CE_AP_DIVISOR_BULLET_BLUNT 50
/// Потолок того же множителя. Это ровно винтовка: всё бронебойнее неё бьёт остановленным не
/// сильнее винтовки того же урона. Без потолка множитель складывается с `CE_BLUNT_PEN_BULLET_EXPONENT`:
/// остаточный удар `rifle/shell` сквозь bulletproof наносил 25 урона.
#define CE_AP_MAX_MULT_BULLET_BLUNT 1.5

// --- Холодное оружие ---

// Sharp-пробитие холодного оружия, мм RHA. Вход — `force`. AP умножает, `CE_AP_DIVISOR_MELEE`.
// Опорные точки — обещания дефайнов брони:
//     knife (force 15, ap 5)  -> 1.54 мм, ARMOR_MELEE_KNIVES    (15) даёт 1.6 мм -> остановлен.
//     sword (force 30, ap 10) -> 2.52 мм, ARMOR_MELEE_RESISTANT (30) даёт 2.6 мм -> остановлен.
var/global/list/ce_pen_curve_melee = list(
	list(0, 0), list(5, 0.5), list(10, 1.0), list(15, 1.4),
	list(30, 2.1), list(50, 3.0), list(70, 3.8), list(100, 5.0)
)

// Blunt-пробитие холодного оружия, Bay МПа. Вход — `force`.
// Сырая кривая, откалиброванная по дефайнам брони буквально:
//     дубинка  (force 15) -> 50,  а ARMOR_MELEE_KNIVES    (15) даёт Blunt 60  -> остановлена.
//     ящик     (force 30) -> 95,  а ARMOR_MELEE_RESISTANT (30) даёт Blunt 100 -> остановлен,
//                                 что и обещает комментарий «...and toolboxes».
//
// НА РУКИ ЭТИ ЧИСЛА НЕ ВЫДАЮТСЯ: сверху на них сидит `CE_BLUNT_PEN_MELEE_MULT`.
// Разделение намеренное: кривая показывает, ОТКУДА взяты числа, множитель — НАСКОЛЬКО мы от них
// отошли. Не затирать одно другим.
var/global/list/ce_pen_curve_blunt = list(
	list(0, 0), list(5, 15), list(10, 32), list(15, 50),
	list(30, 95), list(50, 175), list(70, 260), list(100, 380)
)

/**
 * Множитель тупого пробития ХОЛОДНОГО оружия — вторая ручка баланса.
 *
 * Зеркало `CE_BLUNT_PEN_PER_BULLET_DAMAGE`: та двигает только пули, эта — только удары.
 * Острая ось (`ce_pen_curve_melee`) не трогается вовсе, так что нож как не пробивал
 * ARMOR_MELEE_KNIVES, так и не пробивает — он только передаёт через неё импульс.
 *
 * Без множителя обещания дефайнов, взятые буквально, давали ПОЛНУЮ неуязвимость: ящик по
 * tactical-плите — ровно ноль, дубинка по любой плите — ноль. В CE броня импульс ГАСИТ, а не
 * отменяет. С 2.5 ящик (сила 20) проходит light и medium на 12.6, tactical — на 7.4, а merc-плита
 * держит удар насухо до силы 50.
 *
 * В отличие от пули, удар НЕ идёт через кубический корень, поэтому множитель сильнее всего
 * чувствуется на тяжёлом оружии. Если понадобится прижать именно верхний конец — крутить надо
 * хвост `ce_pen_curve_blunt`, а не этот множитель.
 */
#define CE_BLUNT_PEN_MELEE_MULT 2.5
/// Делитель вклада AP холодного оружия, и в острое, и в тупое пробитие: `+50` удваивает.
/// Он свой не по прихоти: Bay проставлял эти числа на разных неявных шкалах. AP 100 у пули стоит
/// на рельсотроне, а у холодного — на энергетическом мече с силой удара 30. Опорные точки
/// ножа и меча выше посчитаны с этим делителем.
#define CE_AP_DIVISOR_MELEE 50


// ============================================================================================
// Тело: плотность тканей и досягаемость органов (`organ_depth.dm`)
// ============================================================================================

/// Острая плотность плоти по умолчанию, мм RHA: `ce_flesh_rha` на `/singleton/species`. В CE
