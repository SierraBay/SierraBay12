// Щиты (`shields.dm`)
// ============================================================================================

/// Множитель тупого пробития пули, которую остановил щит, перед проверкой тупой брони щита. Это
/// `BulletImpactForceMultiplier` из CE (§10 спеки): там 0.2 — пуля несёт куда меньше импульса, чем
/// булава. Здесь 1, как у плит: тупая броня щитов из `melee` высока (240–260 Bay МПа, как у
/// merc-плиты), и при 0.2 рука со щитом не получала бы ничего даже от слага. При 1 пластасталевый
/// щит отдаёт руке 12 от слага, 4.6 от винтовки и ноль от 10 мм. Холодное оружие — без множителя.
var/global/ce_shield_bullet_impact_mult = 1

/// Ширина дуги, из которой щит встречает атаку, градусы: щит в руке — вокруг взгляда носителя, щит
/// на спине — вокруг спины. В Бэй дуга — всё, кроме спины и задних диагоналей, и щит в руке вместе
/// со щитом на спине закрывали носителя со всех сторон. При 90 оба вместе оставляют открытыми бока.
var/global/ce_shield_arc_degrees = 90

/// Навык стрельбы, с которым можно стрелять из-за щита в стойке «укрыться». С меньшим стрелять
/// можно только из стойки «целиться».
var/global/ce_shield_cover_fire_skill = SKILL_MASTER

/// Сколько после выстрела из стойки «укрыться» открыты голова и рука с оружием.
var/global/ce_shield_cover_fire_exposure = 1 SECOND

/// Спрайт щита в руке в стойке «укрыться»: насколько его поднять, px, — чтобы щит закрывал и лицо.
var/global/ce_shield_cover_sprite_rise = 2

/// Спрайт щита в руке в стойке «укрыться»: какую долю пути до своего места — середины тела анфас,
/// точки впереди неё в профиль — проходит щит по горизонтали. 1 — встаёт ровно туда; при 1 щит
/// уезжал слишком далеко от руки.
var/global/ce_shield_cover_sprite_pull = 0.6

/// Спрайт щита в руке в стойке «укрыться»: насколько в профиль вынести его середину вперёд от
/// середины тела, px. Анфас щит встаёт на середину тела, со спины не трогается: слой рук рисуется
/// поверх тела, и сдвинутый щит читался бы как щит на спине.
var/global/ce_shield_cover_sprite_forward = 2

// Зоны щита в руке, которые зависят от того, в какой руке щит: рука и кисть со щитом и с оружием.
#define CE_SHIELD_ARM "shield_arm"
#define CE_SHIELD_HAND "shield_hand"
#define CE_WEAPON_ARM "weapon_arm"
#define CE_WEAPON_HAND "weapon_hand"

// Стойки щита в руке: «целиться» открывает голову и руку с оружием, «укрыться» закрывает больше,
// но стрелять из неё может только мастер.
#define CE_SHIELD_STANCE_AIM "aim"
#define CE_SHIELD_STANCE_COVER "cover"


// ============================================================================================
// Контузия от взрыва (`concussion.dm`)
// ============================================================================================
// Сила контузии — ступень взрыва (лёгкий 1, тяжёлый 2, разрушительный 3), умноженная на долю
// взрыва, прошедшую броню `bomb`. Эффекты ниже — на единицу силы. Всё в тиках Life, по 2 секунды,
// и всё убывает само: замешательство, муть и речь — на 1 за тик, головокружение — на 3.

/// Зоны, чья броня `bomb` гасит контузию: голова — удар по мозгу, грудь — ударная волна по телу.
/// Сила берёт среднюю долю, прошедшую их броню, поэтому одна каска без бронежилета снимает
/// половину того, что держит сама.
var/global/list/ce_concussion_zones = list(BP_HEAD, BP_CHEST)

/// Лёжа ударная волна проходит над телом: множитель силы контузии.
var/global/ce_concussion_prone_mult = 0.5

/// Замешательство: шаги уходят в сторону, о стену носитель падает. Лёгкий взрыв без защиты — 6,
/// около 12 секунд, тяжёлый — 12. Сверху его держит `CONFUSED_MAX` (15).
var/global/ce_concussion_confusion = 6

/// Муть в глазах вместо чёрного экрана: лёгкий взрыв — 10 секунд, тяжёлый — 20.
var/global/ce_concussion_eye_blur = 5

/// Головокружение. Экран качается только выше 100, то есть с тяжёлого взрыва без защиты, около
/// 14 секунд.
var/global/ce_concussion_dizziness = 60

/// Сбитая речь: лёгкий взрыв — 10 секунд, тяжёлый — 20.
var/global/ce_concussion_stutter = 5

/// Тяжёлый взрыв сбивает с ног на столько тиков — около 4 секунд. Не на единицу силы, а целиком, и
/// только того, кто стоит и не носит никакой брони `bomb` на зонах `ce_concussion_zones`.
var/global/ce_concussion_knockdown = 2


// ============================================================================================
// Светошумовая граната (`flashbang_effects.dm`)
// ============================================================================================
// Урон кисти, в которой граната взорвалась. Кисть держит 30 и ломается от 15 тупого: 10 и 10 —
// тяжело раненая рука, которая режет болью и роняет вещи, но цела. Идёт по ключу `bomb`, так что
// его гасят только перчатки с бронёй от взрыва.

/// Тупой урон кисти с гранатой.
var/global/ce_flashbang_hand_brute = 10

/// Ожоги той же кисти.
var/global/ce_flashbang_hand_burn = 10


// ============================================================================================
// Парирование (`weapon_parry.dm`)
// ============================================================================================
// Прочность оружия — материал × размер × навык, как в CE. Стальное оружие обычного размера с
// кромкой в руках «обученного» держит острое как броня `CE_PARRY_REFERENCE_ARMOR` — 2.6 мм, «держит
// мечи», — а тупое на `ce_parry_blunt_toughness`. Размер — место в рюкзаке относительно обычного:
// острая прочность растёт корнем из него (маленький 0.71, большой 1.41, огромный 2), тупая — прямо
// (0.5, 2, 4). Таблицы волны в руку и износа — README, «Парирование с прочностью оружия».

/// Твёрдость материала, при которой прочность равна опорной броне: сталь.
#define CE_PARRY_REFERENCE_HARDNESS MATERIAL_HARD
/// Опорная броня — рейтинг `melee`, который по кривой жёсткой брони даёт острую прочность стали.
#define CE_PARRY_REFERENCE_ARMOR ARMOR_MELEE_RESISTANT
/// HP оружия — `integrity` материала, делённая на это число, как у материального оружия Bay в
/// `set_material()`.
#define CE_PARRY_INTEGRITY_PER_HEALTH 5

/// Износ оружия — такая доля того, что прошло его прочность. Из CE.
var/global/ce_parry_damage_mult = 0.5

/// Тупая прочность стального оружия обычного размера с кромкой, Bay МПа. Ниже почти любого удара —
/// дубинка 125, ящик 162, остановленный нож 157, — так что нож тяжёлый удар почти не гасит и отдаёт
/// в руку, а большое и цельное оружие гасит. Кулак (до 37) не проходит уже ничего.
var/global/ce_parry_blunt_toughness = 40

/// Доля тупого, прошедшего оружие, которая уходит волной в руку с оружием. Отступление от CE, где
/// парирующему не достаётся ничего: без него парирование ножом отменяло бы удар ящика целиком.
var/global/ce_parry_shock_mult = 0.5

/// Оружие без острия и кромки — дубинки, ящики, ломы — цельное: прочность по обеим осям во столько
/// раз выше. Из автопатчера CE.
var/global/ce_parry_blunt_weapon_mult = 2

/// Прочность за уровень навыка ближнего боя от «обученного»: неумеха держит вполовину, мастер —
/// в полтора раза. В CE размах похожий: от 0.5 до 1.75.
var/global/ce_parry_toughness_per_skill = 0.25

/// Шанс крита парирования при равном навыке, %. Из CE. Бросков два, независимых: один снимает
/// износ, другой даёт ответный удар.
var/global/ce_parry_crit_chance = 10

/// Шанс крита за уровень разницы навыка ближнего боя с атакующим, %. Как прибавка к шансу
/// парирования Bay.
var/global/ce_parry_crit_chance_per_skill = 5


// ============================================================================================
// Выстрел при обезоруживании (`disarm_gunfire.dm`)
// ============================================================================================
// Два броска: реакция — навык стрельбы держащего ружьё против навыка ближнего боя
// обезоруживающего, борьба за ружьё — ближний бой против ближнего боя. Навыки идут от 1 до 5,
// разница — до 4 уровней.

/// Итоги двух бросков: спуск не нажат, ружьё отвели в сторону, выстрел в обезоруживающего.
#define CE_DISARM_GUNFIRE_NONE 0
#define CE_DISARM_GUNFIRE_STRAY 1
#define CE_DISARM_GUNFIRE_DISARMER 2

/// Шанс каждого броска при равных навыках, %.
var/global/ce_disarm_gunfire_chance = 50

/// Сдвиг шанса броска за уровень разницы навыков в пользу держащего ружьё, %. Мастер обоих навыков
/// против неумехи — 90% на каждый бросок и выстрел в обезоруживающего в 81% попыток; наоборот — 10%
/// и 1%.
var/global/ce_disarm_gunfire_chance_per_skill = 10


// ============================================================================================
// Лазеры и нагрев брони (`laser_heat.dm`)
// ============================================================================================
// Жёсткая броня на вещи держит луч вычитанием: рейтинг `laser` × состояние × поправка на жар − AP.
// Остановленная часть луча греет броню, прошедшая идёт дальше. Мягкая броня, щиты, естественная
// броня и экзокостюмы остаются на процентной формуле Bay. Множитель жара у каждого луча — в
// `code/items/guns/beams.dm`, свойства материалов — у самих материалов (`armor_materials.dm`).

/// Теплоёмкость брони без толщины: столько жара держит до белого каления лист нулевой толщины.
var/global/ce_laser_heat_capacity_base = 100

/// Теплоёмкость на миллиметр острой брони против пуль. Рейтинг `laser` решает, какую часть луча
/// броня остановит, а толщина — сколько жара она удержит: crimson-хардсьют (16 мм) держит 340,
/// medium-плита (6 мм) — 190 до множителя материала.
var/global/ce_laser_heat_capacity_per_mm = 15

/// Множитель теплоёмкости брони головы, рук и ног — как у их HP: каски, наручи, поножи и группы
/// рук и ног зональной брони.
var/global/ce_laser_heat_limb_capacity_mult = 0.6

/// Степень кривой нагрева: температура 0..1 = (жар / теплоёмкость) ^ степень. Меньше единицы —
/// броня краснеет быстро, а к белому калению идёт всё медленнее: crimson-хардсьют красный со
/// второго попадания G40E, а добела раскалён только к концу батареи.
var/global/ce_laser_heat_temperature_exponent = 0.4

/// Жар на единицу остановленного урона луча, до множителя луча и поправки на AP. Остановленное
/// попадание G40E (40 урона, AP 10, множитель 1) несёт 36 жара.
var/global/ce_laser_heat_per_damage = 1

/// AP, при котором луч не греет вовсе: жар × (1 − AP / делитель). Пробитие превращает жар в урон,
/// прошедший насквозь: рентген-карабин (AP 50) греет вдвое слабее и проходит тяжёлые плиты.
var/global/ce_laser_heat_ap_divisor = 100

/// Насколько раскалённая броня теряет рейтинг `laser`: × (1 − спад × температура ^ степень). При
/// 0.25 и степени 4 — 98% на красном, 92% на оранжевом, 80% добела: тяжёлая броня держит луч и
/// платит жаром.
var/global/ce_laser_heat_rating_drop = 0.25
var/global/ce_laser_heat_rating_drop_exponent = 4

/// Степень износа от луча: HP −= жар × износ материала × температура ^ степень. Кубическая — холодную
/// броню луч почти не изнашивает, раскалённую добела — быстро.
var/global/ce_laser_wear_exponent = 3

/// Степень, с которой жар отнимает кинетическую броню и ускоряет её износ: × (1 − размягчение
/// материала × температура ^ степень) для Sharp и Blunt, × (1 + ручка × температура ^ степень) для
/// износа от пуль и клинков. Квадрат — красная броня почти держит, раскалённая добела теряет много:
/// стальной crimson-хардсьют добела держит 10.9 мм из 16 — винтовку, но не 7.62.
var/global/ce_laser_hot_kinetic_exponent = 2

/// Насколько быстрее раскалённая добела броня изнашивается от пуль и клинков: × (1 + ручка). При 1 —
/// вдвое. Износ от самого луча растёт с жаром сам (`ce_laser_wear_exponent`).
var/global/ce_laser_hot_kinetic_wear = 1

/// Мягкая броня не греется, а обугливается: луч изнашивает её по формуле износа мягкой брони от
/// острой атаки (§8), умноженной на это.
var/global/ce_laser_soft_char_mult = 0.5

/// Абляционное покрытие: сколько жара на единицу рейтинга `laser` оно заберёт, пока не выгорит. Долю
/// жара, которую оно забирает с каждого попадания, задаёт материал.
var/global/ce_laser_coating_per_rating = 3

// --- Остывание и ожоги ---

/// Температуры ступеней накала, 0..1: тусклый красный, красный, оранжевый, белое каление.
var/global/list/ce_laser_heat_stage_temperatures = list(0.25, 0.5, 0.75, 0.95)

/// За сколько секунд броня на воздухе остывает через каждую полосу между ступенями накала, снизу
/// вверх: ниже тусклого красного, до красного, до оранжевого, до белого и выше белого. Свечение
/// гаснет — температура уходит ниже тусклого красного — с красного за 30 секунд, с оранжевого за 60,
/// с белого каления за 120. Остаток жара уходит ещё за 20.
var/global/list/ce_laser_cooling_band_seconds = list(20, 30, 30, 60, 10)

/// Давление, ниже которого броня остывает как в вакууме, кПа. Смотрится на клетке вещи.
var/global/ce_laser_vacuum_pressure = 20
/// Множитель скорости остывания в вакууме: отдавать жар некуда, кроме излучения. Раскалённый
/// войдсьют в космосе печёт носителя вдвое дольше.
var/global/ce_laser_vacuum_cooling_mult = 0.5

/// Множитель скорости остывания брони на носителе с включённым охладителем: переносным на спине
/// или в хранилище скафандра либо модулем охлаждения РИГа.
var/global/ce_laser_cooler_cooling_mult = 2
/// Множитель ожогов на носителе с включённым охладителем: подбой прокачивается хладагентом.
var/global/ce_laser_cooler_burn_mult = 0.8
/// Заряд батареи охладителя на единицу жара, которую он снял сверх естественного остывания.
/// Раскалённый добела торс crimson-хардсьюта (340 жара) стоит около 170 заряда — меньше 2% большой
/// батареи переносного охладителя, а сам он на полной мощности тратит около единицы в секунду.
var/global/ce_laser_cooler_charge_per_heat = 1

/// Проводимость материала — доля разницы температур лица и подбоя, которую подбой догоняет за
/// столько секунд.
var/global/ce_laser_conduction_seconds = 2
/// Толщина, на которой проводимость равна материальной, мм. Толще — медленнее, как корень из
/// отношения толщин: подбой crimson-хардсьюта (16 мм) догоняет лицо в 1.6 раза медленнее, чем у
/// medium-плиты (6 мм).
var/global/ce_laser_conduction_reference_mm = 6

/// Ожоги носителя по температуре подбоя: точки `list(температура подбоя, ожогов за тик Life)`. Тик
/// Life — две секунды без лагов, ожоги идут вместе с огнём (`handle_fire()`), и лаг их только
/// замедляет. Это на одну вещь или одну группу зон зональной брони: ожог делится поровну между
/// закрытыми ею частями тела. Жжёт с красного подбоя, сильно — только ближе к белому каления:
/// раскалённая добела плита печёт грудь и пах по 6 за тик. Ожоги идут мимо брони и только пока вещь
/// надета. После батареи G40E crimson-хардсьют печёт торс по 13.6 за следующие 10 секунд на часть
/// тела, а тот, кто так и не снял его до остывания, получает по 113 на грудь и пах.
var/global/list/ce_laser_burn_curve = list(
	list(0.5, 0), list(0.75, 3), list(0.95, 12)
)

/// Множитель ожогов от брони головы, рук и ног — каски, наручей, поножей и групп рук и ног зональной
/// брони. Жара она держит меньше и раскаляется быстрее, а каска печёт одну голову, поэтому без
/// множителя раскалённая каска жгла бы голову вдвое сильнее, чем плита — грудь.
var/global/ce_laser_burn_limb_mult = 0.6

/// Не чаще раза в столько вещь пишет носителю, что жжёт.
var/global/ce_laser_burn_message_cooldown = 5 SECONDS

// --- Свечение ---
// Списки ниже — по ступеням накала `ce_laser_heat_stage_temperatures`, от тусклого красного до
// белого каления.

/// Окрашивать ли горячую броню в цвет накала. Без окраски остаётся остальное свечение: ореол,
/// эмиссив, горячий воздух, свет и прожоги. Уже раскалённая броня перерисуется со следующей сменой
/// ступени.
var/global/ce_laser_glow_tint_enabled = TRUE

/// Цвет каждой ступени: оттенок вещи, ореол вокруг неё и свет.
var/global/list/ce_laser_glow_colors = list("#5c1215", "#b1161f", "#f07a22", "#ffe9ad")

/// Насколько вещь окрашивается в цвет ступени: 0 — не окрашивается, 1 — целиком в цвете накала.
/// Жар показывают прежде всего прожоги (`laser_scorch.dm`), окраска лишь подсвечивает вещь. На
/// носителе так же окрашивается всё в силуэте горячей вещи — и её аксессуары, и то, что поверх.
var/global/list/ce_laser_glow_tint = list(0.1, 0.2, 0.3, 0.4)

/// Яркость окраски спрайта вещи: цвет накала × (подъём + усиление × яркость пикселя). Подъём светит и
/// тёмные места спрайта, усиление сохраняет его рисунок: светлое светится ярче тёмного.
var/global/ce_laser_glow_lift = 0.8
var/global/ce_laser_glow_gain = 0.45

/// Подъём яркости слоя жара на носителе: к тому, что под слоем, прибавляется цвет накала × доля
/// окраски × подъём. Слой не знает яркости пикселя под собой, поэтому подъём выше, чем у спрайта:
/// при 1.2 носитель светится так же ярко, как спрайт вещи.
var/global/ce_laser_glow_worn_lift = 1.2

/// Ширина ореола вокруг спрайта, px.
