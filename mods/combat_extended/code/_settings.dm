var/global/ce_organ_depth_bullet = 4.8

/// `D` для холодного оружия, мм RHA. Своя, потому что миллиметры холодного сжаты: его ось
/// калибровалась против холодной брони. С общей `D = 4.8` нож доходил бы до органов в 13%
/// случаев вместо 48%.
var/global/ce_organ_depth_melee = 2.5


