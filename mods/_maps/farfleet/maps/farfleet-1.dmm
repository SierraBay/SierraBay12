"SX" = (/obj/structure/table/rack,/obj/item/storage/box/bodybags,/obj/structure/railing/mapped{dir = 8; icon_state = "railing0-1"},/obj/structure/railing/mapped{dir = 1; icon_state = "railing0-1"},/obj/item/device/radio/intercom{frequency = 1344; name = "intercom (Pioneers)"; dir = 8; pixel_x = 24; pixel_y = 1},/obj/floor_decal/techfloor{dir = 4},/obj/floor_decal/industrial/outline/yellow,/turf/simulated/floor/tiled/techfloor/grid,/area/ship/farfleet/medbay/storage)
"Tg" = (/obj/machinery/atmospherics/pipe/simple/visible/black{dir = 4},/obj/machinery/atmospherics/pipe/simple/visible/fuel,/obj/machinery/computer/modular/preset/helm{dir = 8},/obj/machinery/button/blast_door{id_tag = "farfleet_fusion"; name = "Chamber Vent Control"; pixel_y = 26; pixel_x = 4},/obj/machinery/button/blast_door{id_tag = "farfleet_engineview"; name = "Chamber viewing port control"; pixel_x = -7; pixel_y = 26},/obj/item/paper/farfleet/turrets{language = "Pan-Slavic"; info = "<h1><strong> По поводу прогрева наших Ускорителей</strong></h1><p>Топливные двигатели, они у нас&nbsp;используются&nbsp;<strong>ТОЛЬКО</strong> как <strong>УСКОРИТЕЛИ</strong> и не более, углекислота не вечная, так что использовать нужно с умом.<br />В Газовом Миксере всё уже настроено, тебе остаётся сделать пару манипуляций что бы всё заработало, самое главное, <strong>не прожги</strong> наш Атмосферный Отсек, за всё время он ниразу не прогорал....<br /><br />Трубы Выдерживают 40 Мегапаскалей, у нас хоть и установлен Предохранительный Клапан, но он может не успеть стравить требуемое количество Газа.<br /><br />Как прогреть:</p><ol><li>Поставь на Западный порт Канистру с Кислородом и прикрути.</li><li>Поставь на Восточный порт Канистру с Водородом и прикрути.</li><li>Выставь в Углекислотной линии на Газовой Помпе подачу смеси на 1 мегапаскаль и включи. <br />(1 мегапаскаль = 1000 Кило Паскалей)</li><li>Включи миксер Смеси Кислорода и Водорода.</li><li>Закрой смотровое окно в камере Сгорания и <strong>НЕ ОТКРЫВАЙ</strong>.</li><li>Выставь подачу Горючей Смеси на 250 Кило Паскалей и включи</li></ol><p><em>Поздравляю, ты прогрел Топливные Ускорители!<br />Если ты начинаешь слышать как что-то Шипит, или подозрительно трескает и лопается, нажми кнопку продува камеры сгорания </em><strong>И БЕГИ ИЗ АТМОСФЕРНОГО ОТСЕКА.<br /><br /></strong>Всё зависит от тебя Юный Бортовой Техник, не проеби наше судно.</p><p><em>Якоб З.Д</em></p><p>&nbsp;</p>"; name = "About Warming Engine"},/turf/simulated/floor/tiled/techfloor,/area/ship/farfleet/engineering/atmospherics)
