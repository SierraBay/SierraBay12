/obj/item/paper/crumpled/bloody{
	info = "<p>Ценостоимость Жизни отрицательна. <br>Равновесие бытия стоит под углом 38 градусов. <br>Поверхность усыпана мелкими трещинами, сквозь которые видны проблески давящего света. <br>Мясные, первообразные тела лениво скатываются по наклонной. <b>Лишь ты - скользишь вверх небопоставленным шагом.</b><br>Ты расцветаешь красотой, словно святыня.</p>";
	info_links = "<p>Ценостоимость Жизни отрицательна. <br>Равновесие бытия стоит под углом 38 градусов. <br>Поверхность усыпана мелкими трещинами, сквозь которые видны проблески давящего света. <br>Мясные, первообразные тела лениво скатываются по наклонной. <b>Лишь ты - скользишь вверх небопоставленным шагом.</b><br>Ты расцветаешь красотой, словно святыня.</p>"
