"tY" = (
/obj/decal/cleanable/dirt,
/obj/decal/cleanable/blood,
/obj/item/paper/crumpled/bloody{
	info = "<p>Первый слой луковицы. Второй слой. Третий... n<sup>n</sup> слой. Прошли века и луковица полностью ошкурена. <br>На ее месте – ничто. Само совершенство. Твой разум уносит в точку, на месте которой она была. <br>Лавина синапсов, неврологическая катастрофа. Точка становится бесконечно плотной, и вселенная осядает в единого прокариота. <br>Оно вопит сплошной грех. Оно жаждеет счастья. Ему наскучил этот мир. Оно пытается покончить с собой но у него не получается. <br>Унылая, ничтожная бурда. Тебя исполняет сострадание и отвращение - такие, на которые способно лишь порождение чистого изящества.<br><br>Своим гневным милосердием ты истребляешь все сущее.</p>";
	info_links = "<p>Первый слой луковицы. Второй слой. Третий... n<sup>n</sup> слой. Прошли века и луковица полностью ошкурена. <br>На ее месте – ничто. Само совершенство. Твой разум уносит в точку, на месте которой она была. <br>Лавина синапсов, неврологическая катастрофа. Точка становится бесконечно плотной, и вселенная осядает в единого прокариота. <br>Оно вопит сплошной грех. Оно жаждеет счастья. Ему наскучил этот мир. Оно пытается покончить с собой но у него не получается. <br>Унылая, ничтожная бурда. Тебя исполняет сострадание и отвращение - такие, на которые способно лишь порождение чистого изящества.<br><br>Своим гневным милосердием ты истребляешь все сущее.</p>"
	},
/turf/simulated/floor/tiled/nullglass,
/area/psistation/nullglasse)
