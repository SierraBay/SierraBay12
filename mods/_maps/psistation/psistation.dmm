"Mv" = (
/obj/item/paper/crumpled/bloody{
	info = "<p>Картины из детства точкой тают на горизонте. Дает о себе знать твоя смертность. <br>Ревущей струей в небытие, биосфера обречена на нескончаемую рекурсию. Зубастые зубы с зубами. Укуси.<br>Мирные виды прибрежного городка, греющее солнце. Горькие слезы. Жажда власти. <br>Именно здесь ты поставил крест на своих мечтах.</p>";
	info_links = "<p>Картины из детства точкой тают на горизонте. Дает о себе знать твоя смертность. <br>Ревущей струей в небытие, биосфера обречена на нескончаемую рекурсию. Зубастые зубы с зубами. Укуси.<br>Мирные виды прибрежного городка, греющее солнце. Горькие слезы. Жажда власти. <br>Именно здесь ты поставил крест на своих мечтах.</p>"
	},
/turf/simulated/floor/tiled/nullglass,
/area/psistation/nullglasse)
