	name = "Sound record - Blue"
	language = LANGUAGE_HUMAN_EURO
	info = "\[Мужской голос-1\]: Молодец, нечего сказать.<br>\
			\[Мужской голос-2\]: Ну, осечки бывают, сам знаешь.<br>\
