<style>
	.power-shadow {
		font-size: 12px;
		color: #d7dde2;
	}
	.power-shadow .muted {
		color: #8e9ba7;
	}
	.power-shadow .toolbar,
	.power-shadow .summary-grid,
	.power-shadow .footer {
		margin-bottom: 10px;
	}
	.power-shadow .toolbar a {
		display: inline-block;
		padding: 4px 8px;
		margin: 0 6px 6px 0;
		border: 1px solid #33404d;
		border-radius: 3px;
		background: #1b2530;
		color: #dbe5ee;
		text-decoration: none;
	}
	.power-shadow .toolbar a.primary {
		background: #243241;
		border-color: #45617d;
	}
	.power-shadow .toolbar a.subtle {
		background: #171f27;
		color: #aeb9c4;
	}
	.power-shadow .summary-card,
	.power-shadow .panel {
		display: inline-block;
		vertical-align: top;
		box-sizing: border-box;
		background: #141b22;
		border: 1px solid #28313b;
		border-radius: 4px;
		padding: 10px 12px;
		margin: 0 8px 8px 0;
	}
	.power-shadow .summary-card {
		width: calc(25% - 8px);
		min-width: 220px;
	}
	.power-shadow .panel {
		width: 100%;
	}
	.power-shadow .eyebrow {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: #8191a0;
		margin-bottom: 6px;
	}
	.power-shadow .metric {
		font-size: 20px;
		font-weight: bold;
		color: #eef3f7;
		margin-bottom: 4px;
	}
	.power-shadow .summary-row {
		margin-top: 4px;
	}
	.power-shadow .table-wrap {
		background: #11181f;
		border: 1px solid #28313b;
		border-radius: 4px;
		padding: 6px;
	}
	.power-shadow table {
		width: 100%;
		border-collapse: collapse;
		font-size: 12px;
	}
	.power-shadow th {
		text-align: left;
		color: #9baab7;
		font-weight: normal;
		padding: 7px 8px;
		border-bottom: 1px solid #26313a;
	}
	.power-shadow td {
		padding: 7px 8px;
		border-top: 1px solid #1d2730;
		vertical-align: top;
	}
	.power-shadow tr.problem {
		background: #21181a;
	}
	.power-shadow tr.ok {
		background: #141b22;
	}
	.power-shadow .mono {
		font-family: monospace;
		color: #c8d4de;
	}
</style>

<div class='power-shadow'>
	<div class='panel' style='padding-bottom:6px;'>
		<div style='font-size:18px;font-weight:bold;color:#eef3f7;'>Power Shadow</div>
		<div class='muted'>Спокойная сводка по solver health, runtime cost и проблемным powernet'ам без лишнего шума.</div>
	</div>

	<div class='toolbar'>
		<a class='primary' href='byond://?src=\ref[src];power_shadow_dash_action=refresh'>Refresh</a>
		<a class='primary' href='byond://?src=\ref[src];power_shadow_dash_action=toggle_live'>{{if data.live_mode}}Stop live{{else}}Start live{{/if}}</a>
		<a class='primary' href='byond://?src=\ref[src];power_shadow_dash_action=auto_repair'>Make good</a>
		<a class='subtle' href='byond://?src=\ref[src];power_shadow_dash_action=export'>Statistics</a>
		<a class='subtle' href='byond://?src=\ref[src];power_shadow_dash_action=toggle_advanced'>{{if data.show_advanced}}Hide advanced{{else}}Show advanced{{/if}}</a>
	</div>

	<div class='summary-grid'>
		<div class='summary-card'>
			<div class='eyebrow'>Network Health</div>
			<div class='metric'><span class='{{:data.health_class}}'>{{:data.problem_networks}}</span> / {{:data.networks}}</div>
			<div class='summary-row'>problematic networks <span class='muted'>({{:data.problem_rate}}%)</span></div>
			<div class='summary-row'>acceptance pass <span class='{{:data.health_class}}'>{{:data.pass_rate}}%</span></div>
		</div>
		<div class='summary-card'>
			<div class='eyebrow'>Solver Quality</div>
			<div class='metric'><span class='{{:data.quality_class}}'>{{:data.report_mismatch}}%</span></div>
			<div class='summary-row'>avg mismatch rate</div>
			<div class='summary-row'>unserved P/D/T <span class='muted'>{{:data.report_unserved_primary}} / {{:data.report_unserved_deferred}} / {{:data.report_unserved_total}} W</span></div>
		</div>
		<div class='summary-card'>
			<div class='eyebrow'>Runtime Cost</div>
			<div class='metric'><span class='{{:data.runtime_class}}'>{{:data.powernet_cost}} ms/tick</span></div>
			<div class='summary-row'>powernet share <span class='{{:data.runtime_class}}'>{{:data.powernet_cost_share}}%</span></div>
			<div class='summary-row'>avg per net <span class='muted'>{{:data.cost_per_network}} ms/tick</span></div>
		</div>
		<div class='summary-card'>
			<div class='eyebrow'>Native Batch</div>
			<div class='metric'><span class='{{:data.batch_class}}'>{{if data.batch_perf_samples}}{{:data.batch_perf_samples}}{{else}}no data{{/if}}</span></div>
			<div class='summary-row'>samples collected</div>
			<div class='summary-row muted'>build/encode/call/decode {{:data.batch_perf_build_avg_us}} / {{:data.batch_perf_encode_avg_us}} / {{:data.batch_perf_call_avg_us}} / {{:data.batch_perf_decode_avg_us}} us</div>
		</div>
	</div>

	{{if data.show_advanced}}
	<div class='panel'>
		<div class='eyebrow'>Advanced Controls</div>
		<div class='toolbar' style='margin-bottom:4px;'>
			<a href='byond://?src=\ref[src];power_shadow_dash_action=view_all'>All networks</a>
			<a href='byond://?src=\ref[src];power_shadow_dash_action=view_problematic'>Problematic only</a>
			<a href='byond://?src=\ref[src];power_shadow_dash_action=top_dec'>-20 rows</a>
			<a href='byond://?src=\ref[src];power_shadow_dash_action=top_inc'>+20 rows</a>
			<a href='byond://?src=\ref[src];power_shadow_dash_action=interval_dec'>-1s live</a>
			<a href='byond://?src=\ref[src];power_shadow_dash_action=interval_inc'>+1s live</a>
		</div>
		<div class='muted'>View: {{:data.view_mode}}. Showing top {{:data.top_n}} by delta. Live: {{if data.live_mode}}ON ({{:data.live_interval}}s){{else}}OFF{{/if}}. Enabled {{:data.enabled}} / locked {{:data.locked}} / rollbacks {{:data.rollbacks}} / avg guard threshold {{:data.avg_guard_threshold}} W.</div>
	</div>
	{{else}}
	<div class='panel'>
		<div><b>View:</b> {{:data.view_mode}} <span class='muted'>| top {{:data.top_n}} by delta | live {{if data.live_mode}}ON ({{:data.live_interval}}s){{else}}OFF{{/if}}</span></div>
	</div>
	{{/if}}

	<div class='table-wrap'>
		<table>
			<tr>
				<th>Powernet</th>
				<th>Shape</th>
				<th>Backend</th>
				<th>Load / Avail</th>
				<th>Unserved</th>
				<th>Delta</th>
				<th>Health</th>
				<th>Samples</th>
			</tr>
			{{for data.rows}}
			<tr class='{{:value.is_problem ? "problem" : "ok"}}'>
				<td class='mono'>{{:value.net_ref}}</td>
				<td>{{:value.nodes}} nodes<br><span class='muted'>{{:value.cables}} cables</span></td>
				<td>{{:value.backend}}<br><span class='muted'>{{:value.mode}}</span></td>
				<td>
					{{:value.load}} / {{:value.avail}} W
					<div style='margin-top:4px;'>{{:helper.displayBar(value.load_ratio, 0, 100, value.load_bar_style)}}</div>
				</td>
				<td>
					{{:value.unserved_total}} W total
					<div class='muted'>P {{:value.unserved_primary}} / D {{:value.unserved_deferred}}</div>
				</td>
				<td>
					{{:value.delta_total}} W
					<div class='muted'>A {{:value.delta_avail}} / L {{:value.delta_load}}</div>
					<div style='margin-top:4px;'>{{:helper.displayBar(value.delta_ratio, 0, 100, value.delta_bar_style)}}</div>
				</td>
				<td>
					<span class='{{:value.is_problem ? "bad" : (value.acceptance == "Pass" ? "good" : "average")}}'>{{:value.mismatch}}</span>
					<div class='muted'>{{:value.guard}} / {{:value.acceptance}}</div>
				</td>
				<td>{{:value.samples}}<br><span class='muted'>rollback {{:value.rollbacks}}</span></td>
			</tr>
			{{/for}}
		</table>
	</div>

	<div class='footer muted'>
		Rendered rows: {{:data.rendered_rows}}. Updated: {{:data.updated_at}}.
	</div>
</div>
