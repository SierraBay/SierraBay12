<h3>Power Shadow Dashboard</h3>
<div><b>View:</b> {{data.view_mode}}, top {{data.top_n}} rows, sorted by Delta desc.</div>
<div><b>Live refresh:</b> {{#if data.live_mode}}ON ({{data.live_interval}}s){{else}}OFF{{/if}}</div>
<div><b>Runtime cost:</b> powernets {{data.powernet_cost}} ms/tick ({{data.powernet_cost_share}}%), avg {{data.cost_per_network}} ms/tick per network.</div>
<div><b>Networks:</b> {{data.networks}} total, {{data.enabled}} solver-enabled, {{data.locked}} FEA-only locked.</div>
<div><b>Problem networks:</b> {{data.problem_networks}} / {{data.networks}}</div>
<div><b>Quality:</b> mismatch {{data.report_mismatch}}%, avg |dLoad| {{data.report_load_delta}}W, avg |dAvail| {{data.report_avail_delta}}W, avg unserved P/D/T {{data.report_unserved_primary}}/{{data.report_unserved_deferred}}/{{data.report_unserved_total}}W.</div>
<div><b>Reliability:</b> acceptance pass {{data.pass_count}}/{{data.networks}} ({{data.pass_rate}}%), total rollbacks {{data.rollbacks}}, avg guard threshold {{data.avg_guard_threshold}}W.</div>
<hr>
<table class='table' style='width:100%;font-size:12px;border-collapse:collapse;'>
	<tr>
		<th>Net</th>
		<th>Nodes</th>
		<th>Cables</th>
		<th>Backend</th>
		<th>Mode</th>
		<th>Load/Avail</th>
		<th>Unserved P/D/T</th>
		<th>dAvail</th>
		<th>dLoad</th>
		<th>Delta</th>
		<th>Load Bar</th>
		<th>Delta Bar</th>
		<th>Unserved Bar</th>
		<th>Mismatch</th>
		<th>Guard</th>
		<th>Acceptance</th>
		<th>Samples</th>
		<th>Rollbacks</th>
	</tr>
	{{#each data.rows}}
	<tr{{#if this.is_problem}} style='background:#261f1f;'{{else}}{{#if (equal this.acceptance "Pass")}} style='background:#1f2620;'{{/if}}{{/if}}>
		<td>{{this.net_ref}}</td>
		<td>{{this.nodes}}</td>
		<td>{{this.cables}}</td>
		<td>{{this.backend}}</td>
		<td>{{this.mode}}</td>
		<td>{{this.load}} / {{this.avail}} W</td>
		<td>{{this.unserved_primary}} / {{this.unserved_deferred}} / {{this.unserved_total}} W</td>
		<td>{{this.delta_avail}} W</td>
		<td>{{this.delta_load}} W</td>
		<td>{{this.delta_total}} W</td>
		<td>{{helper.displayBar this.load_ratio 100 this.load_bar_style}}</td>
		<td>{{helper.displayBar this.delta_ratio 100 this.delta_bar_style}}</td>
		<td>{{helper.displayBar this.unserved_ratio 100 this.unserved_bar_style}}</td>
		<td>{{this.mismatch}}</td>
		<td>{{this.guard}}</td>
		<td>{{this.acceptance}}</td>
		<td>{{this.samples}}</td>
		<td>{{this.rollbacks}}</td>
	</tr>
	{{/each}}
</table>
<div><b>Rendered rows:</b> {{data.rendered_rows}}</div>
<div><b>Updated:</b> {{data.updated_at}}</div>
