<style>
    .piano-keyboard {
        display: flex;
        position: relative;
        height: 160px;
        background: #111;
        padding: 10px;
        overflow-x: auto;
        white-space: nowrap;
        user-select: none;
        border: 2px solid #333;
        border-radius: 8px;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
    }
    .key-container {
        display: flex;
        position: relative;
    }
    .key {
        border-radius: 0 0 3px 3px;
        position: relative;
        transition: all 0.05s ease;
        box-sizing: border-box;
    }
    .white {
        width: 22px;
        height: 130px;
        background: linear-gradient(to bottom, #eee 0%, #fff 80%, #ddd 100%);
        border: 1px solid #bbb;
        z-index: 1;
        box-shadow: inset 0 2px 5px rgba(255,255,255,0.8), 0 2px 2px rgba(0,0,0,0.2);
    }
    .black {
        width: 14px;
        height: 80px;
        background: linear-gradient(to bottom, #333 0%, #000 85%, #222 100%);
        border: 1px solid #000;
        margin-left: -7px;
        margin-right: -7px;
        z-index: 2;
        box-shadow: 0 3px 5px rgba(0,0,0,0.5), inset 0 1px 1px rgba(255,255,255,0.1);
    }
    .key.active {
        background: linear-gradient(to bottom, #00eeff 0%, #0099ff 100%) !important;
        box-shadow: 0 0 15px #00ccff, inset 0 0 5px rgba(255,255,255,0.5);
        border-color: #00ccff;
        transform: translateY(1px);
    }
    .note-name {
        position: absolute;
        bottom: 8px;
        width: 100%;
        text-align: center;
        font-size: 9px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-weight: 700;
        color: #666;
        pointer-events: none;
        text-transform: uppercase;
        letter-spacing: -0.5px;
    }
    .black .note-name {
        color: #aaa;
        bottom: 5px;
        font-size: 7px;
    }
</style>

<div class="piano-keyboard">
    <div class="key-container" id="piano-keys">
        {{if data.keys}}
            {{for data.keys}}
                <div id="note-{{:value.id}}" class="key {{:value.is_black ? 'black' : 'white'}} {{:data.active_notes.indexOf(value.id) != -1 ? 'active' : ''}}">
                    <span class="note-name">{{:value.name}}</span>
                </div>
            {{/for}}
        {{/if}}
    </div>
</div>

