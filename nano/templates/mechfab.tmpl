<div class="fabConsole">
	<div class="fabNav">
		<div class="fabNavTitle">{{:data.machine_name || "Fabricator"}}</div>
		<div class="fabNavActions">
			{{:helper.link("Sync", null, {'sync' : 1}, null, 'fabTab')}}
			<span class="fabSyncText">{{:data.sync}}</span>
		</div>
	</div>

	<div class="fabTwoCol">
		<div class="fabCol" style="width: 62%;">
			{{if data.manufacturers}}
			<div class="fabSection">
				<div class="fabSectionTitle">Manufacturer</div>
				<div class="fabSectionContent fabBtnRow">
					{{for data.manufacturers}}
						{{:helper.link(value.company, null, {'manufacturer' : value.id}, value.id == data.manufacturer ? 'selected' : null)}}
					{{/for}}
				</div>
			</div>
			{{/if}}

			<div class="fabSection">
				<div class="fabSectionTitle">Categories</div>
				<div class="fabSectionContent fabBtnRow">
					{{for data.categories}}
						{{:helper.link(value, null, {'category' : value}, value == data.category ? 'selected' : null)}}
					{{empty}}
						<span class="fabMuted">No known designs</span>
					{{/for}}
				</div>
			</div>

			<div class="fabSection">
				<div class="fabSectionTitle">Build Menu</div>
				<div class="fabSectionContent fabScroll">
					{{for data.buildable}}
						{{if value.category == data.category}}
						<div class="fabRow">
							<div class="fabRowName">{{:helper.link(value.name, null, {'build' : value.id})}}</div>
							<div class="fabRowMeta">{{:value.resourses}}, {{:value.time}}</div>
						</div>
						{{/if}}
					{{empty}}
						<span class="fabMuted">No available entries</span>
					{{/for}}
				</div>
			</div>
		</div>

		<div class="fabCol" style="width: 38%;">
			<div class="fabSection">
				<div class="fabSectionTitle">Queue</div>
				<div class="fabSectionContent">
					{{if data.current}}
						<div class="fabQueueCurrent">
							<b>{{:data.current}}</b> ({{:data.builtperc}}%)
							<span style="float:right;">{{:helper.link('Cancel', null, {'remove' : 1})}}</span>
						</div>
						{{for data.queue}}
						<div class="fabRow">
							<div class="fabRowName">{{:index + 2}}: {{:value}}</div>
							<div class="fabRowMeta">{{:helper.link('Remove', null, {'remove' : index + 2})}}</div>
						</div>
						{{empty}}
						<span class="fabMuted">Queue is empty</span>
						{{/for}}
					{{else}}
						<span class="fabMuted">Nothing is being produced</span>
					{{/if}}
				</div>
			</div>

			<div class="fabSection">
				<div class="fabSectionTitle">Materials</div>
				<div class="fabSectionContent fabScroll">
					{{for data.materials}}
					<div class="fabRow">
						<div class="fabRowName">{{:value.mat}}: {{:value.amt}}/{{:data.maxres}}</div>
						<div class="fabRowMeta">
							{{:helper.link('x1', null, {'eject' : value.mat, 'amount' : 1}, value.amt > 2000 ? null : 'disabled')}}
							{{:helper.link('x5', null, {'eject' : value.mat, 'amount' : 5}, value.amt > 10000 ? null : 'disabled')}}
							{{:helper.link('x10', null, {'eject' : value.mat, 'amount' : 10}, value.amt > 20000 ? null : 'disabled')}}
							{{:helper.link('Stack', null, {'eject' : value.mat, 'amount' : 0})}}
							{{:helper.link('All', null, {'eject' : value.mat, 'amount' : -1})}}
						</div>
					</div>
					{{/for}}
				</div>
			</div>
		</div>
	</div>
</div>

<style>
.fabConsole {
	font-family: 'Consolas', 'Courier New', monospace;
	color: #e6d2b4;
}
.fabConsole .link,
.fabConsole .linkActive,
.fabConsole .linkOn,
.fabConsole .linkOff,
.fabConsole .selected,
.fabConsole .disabled {
	background: rgba(70, 38, 14, 0.65);
	border: 1px solid rgba(196, 118, 42, 0.45);
	color: #f0c287;
	border-radius: 2px;
	padding: 1px 6px 3px 6px;
	font-size: 11px;
	float: none;
	display: inline-block;
}
.fabConsole .selected,
.fabConsole .linkActive.selected {
	background: rgba(120, 62, 18, 0.75);
	border-color: rgba(246, 160, 76, 0.6);
	color: #ffd7a3;
	box-shadow: 0 0 6px rgba(246, 160, 76, 0.25);
}
.fabConsole .disabled,
.fabConsole a.disabled:link,
.fabConsole a.disabled:visited,
.fabConsole a.disabled:active,
.fabConsole a.disabled:hover {
	background: rgba(40, 30, 24, 0.45);
	border-color: rgba(86, 66, 52, 0.4);
	color: #7f6b58;
}
.fabNav {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 4px 8px;
	margin-bottom: 8px;
	background: linear-gradient(180deg, rgba(62, 34, 14, 0.95), rgba(30, 18, 10, 0.95));
	border-bottom: 1px solid rgba(220, 136, 56, 0.45);
}
.fabNavTitle {
	font-size: 13px;
	font-weight: bold;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #ffbe76;
}
.fabNavActions { display: flex; align-items: center; gap: 6px; }
.fabSyncText { color: #d19a62; font-size: 11px; }
.fabTwoCol { display: flex; gap: 8px; }
.fabSection {
	margin-bottom: 8px;
	border: 1px solid rgba(182, 108, 42, 0.45);
	background: linear-gradient(180deg, rgba(35, 21, 12, 0.75), rgba(22, 15, 11, 0.6));
}
.fabSectionTitle {
	padding: 5px 8px;
	font-size: 11px;
	font-weight: bold;
	letter-spacing: 0.8px;
	text-transform: uppercase;
	color: #ffbe76;
	background: linear-gradient(180deg, rgba(78, 42, 14, 0.7), rgba(52, 30, 13, 0.5));
	border-bottom: 1px solid rgba(182, 108, 42, 0.35);
}
.fabSectionContent { padding: 8px; }
.fabBtnRow { display: flex; gap: 4px; flex-wrap: wrap; }
.fabScroll { max-height: 380px; overflow-y: auto; }
.fabRow {
	display: flex;
	justify-content: space-between;
	gap: 8px;
	padding: 3px 0;
	border-bottom: 1px solid rgba(90, 58, 34, 0.35);
}
.fabRowName { color: #f2cfaa; }
.fabRowMeta { color: #d8a673; font-size: 11px; text-align: right; }
.fabQueueCurrent {
	margin-bottom: 6px;
	padding: 4px 6px;
	background: rgba(70, 42, 18, 0.55);
	border: 1px solid rgba(190, 120, 56, 0.35);
}
.fabMuted { color: #a88361; }
</style>
