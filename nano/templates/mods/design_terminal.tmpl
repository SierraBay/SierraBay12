<div class="dtConsole dtTheme--{{:data.ui_theme}}">

	<!-- ── Navigation bar ─────────────────────────────────────────── -->
	<div class="dtNav">
		<div class="dtNavTitle">
			{{if data.ui_theme == 'medical'}}
				МЕДИЦИНСКИЙ
			{{else data.ui_theme == 'engineering'}}
				ИНЖЕНЕРНЫЙ
			{{else}}
				НИО
			{{/if}}
			<span class="dtDeptBadge">ТЕРМИНАЛ</span>
		</div>
		{{:helper.link("Дизайны", '', {'go_screen':'designs'}, data.dt_screen == 'designs' ? 'selected' : null, 'rndTab')}}
		{{:helper.link("Корпорации", '', {'go_screen':'corps'}, data.dt_screen == 'corps' ? 'selected' : null, 'rndTab')}}
		{{if data.has_theme_selector}}
		<div class="dtThemeSwitcher">
			{{:helper.link("◑", '', {'set_theme':'neutral'},    data.ui_theme == 'neutral'     ? 'selected' : null, 'dtThemeBtn')}}
			{{:helper.link("✚", '', {'set_theme':'medical'},    data.ui_theme == 'medical'     ? 'selected' : null, 'dtThemeBtn')}}
			{{:helper.link("⚙", '', {'set_theme':'engineering'},data.ui_theme == 'engineering' ? 'selected' : null, 'dtThemeBtn')}}
		</div>
		{{/if}}
		<div class="dtNavStatus">
			{{if data.has_server}}
				<span class="dtServerBadge dtServerBadge--online"><span class="dtServerDot"></span>{{:data.server_name}}</span>
			{{else}}
				<span class="dtServerBadge dtServerBadge--offline"><span class="dtServerDot"></span>Нет сервера</span>
			{{/if}}
			{{if data.has_account}}
				<span class="dtBalanceLabel">{{:data.account_name}}</span>
				<span class="dtBalanceValue">{{:data.currency_short}}{{:data.balance}}</span>
			{{else data.can_switch_account}}
				<span class="dtBalanceError">СЧЁТ НЕ ПРИВЯЗАН</span>
			{{/if}}
		</div>
	</div>

	<!-- ══════════════════════════════════════════════════════════════ -->
	<!-- DESIGNS SCREEN                                                -->
	<!-- ══════════════════════════════════════════════════════════════ -->
	{{if data.dt_screen == 'designs'}}
	<div class="dtBody">

		<!-- Toolbar: sync + disk -->
		<div class="dtToolbar">
			{{if data.has_server}}
				{{:helper.link("Отключиться от сети", 'cancel', {'togglesync':1}, null, 'rndTab')}}
			{{else}}
				{{:helper.link("Подключиться к сети", 'lightbulb', {'togglesync':1}, null, 'rndTab')}}
			{{/if}}
			<div class="dtToolbarSep"></div>
			{{:helper.link("Загрузить дизайны с диска", 'transferthick-e-w', {'sync':1}, null, 'rndTab')}}
			<div class="dtToolbarSep"></div>
			{{if data.has_disk}}
				<div class="dtDiskStrip">
					<span style="color:var(--dt-accent);">&#128190;</span>
					<div class="dtDiskBar"><div class="dtDiskBarFill" style="width:{{:Math.round(data.disk_used/data.disk_size*100)}}%;"></div></div>
					<span style="color:#94a3b8;">{{:data.disk_used}}/{{:data.disk_size}} GQ</span>
					{{:helper.link("Извлечь", 'eject', {'eject_disk':1})}}
				</div>
			{{else}}
				<span style="color:#475569; font-size:11px;">Диск не вставлен</span>
			{{/if}}
			<div class="dtToolbarSep"></div>
			{{:helper.link("Поиск", '', {'search':1})}}
			{{if data.search_text}}
				<span style="color:#94a3b8; font-size:11px;">«{{:data.search_text}}»</span>
				{{:helper.link("✕", '', {'search':1, 'search_text':''})}}
			{{/if}}
		</div>

		<!-- Category filter -->
		{{if data.categories.length}}
		<div class="dtFilterBar">
			<span class="dtFilterLabel">Раздел</span>
			{{:helper.link("Все", '', {'set_category':1,'category':'all'}, !data.selected_category ? 'selected' : null)}}
			{{for data.categories}}
				{{:helper.link(value, '', {'set_category':1,'category':value}, data.selected_category == value ? 'selected' : null)}}
			{{/for}}
		</div>
		{{/if}}

		<!-- Two-column design lists -->
		<div class="dtCols">

			<!-- Terminal designs -->
			<div class="dtPanel" style="flex:1;">
				<div class="dtPanelHead">
					<span>Дизайны в терминале</span>
					<span class="dtPanelCount">{{:data.terminal_designs.length}}</span>
				</div>
				<div class="dtPanelBody">
					{{for data.terminal_designs}}
					<div class="dtFileItem">
						<span class="dtFileName">{{:value.name}}</span>
						<div class="dtFileActions">
							{{if value.on_disk}}
								<span class="dtOnDisk">✓ на диске</span>
							{{else data.has_disk}}
								{{:helper.link("", 'arrowthick-1-e', {'save_to_disk':value.id})}}
							{{/if}}
						</div>
					</div>
					{{empty}}
					<div class="dtEmpty">Нет дизайнов на сервере.</div>
					{{/for}}
				</div>
			</div>

			<!-- Disk designs -->
			{{if data.has_disk}}
			<div class="dtPanel" style="flex:1;">
				<div class="dtPanelHead">
					<span>На диске</span>
					<span class="dtPanelCount">{{:data.disk_designs.length}}</span>
				</div>
				<div class="dtPanelBody">
					{{for data.disk_designs}}
					<div class="dtFileItem">
						<span class="dtFileName">{{:value.name}}</span>
						<div class="dtFileActions">
							{{:helper.link("", 'arrowthick-1-w', {'load_from_disk':value.id})}}
						</div>
					</div>
					{{empty}}
					<div class="dtEmpty">Диск пуст.</div>
					{{/for}}
				</div>
			</div>
			{{/if}}

		</div>

		{{if data.has_robotics_fab || data.has_mech_fab}}
		<div class="rndTwoCol" style="padding:0;">
			{{if data.has_robotics_fab}}
			<div class="rndCol" style="width:50%;">
				<div class="rndSection">
					<div class="rndSectionTitle">Robotics Fabricator</div>
					<div class="rndSectionContent">
						<div class="rndBtnRow" style="margin-bottom:6px;">
							{{for data.robotics_designs}}
								{{:helper.link(value.name, '', {'build_to_fab':value.id, 'fab_target':'robotics', 'amount':1})}}
							{{/for}}
						</div>
						<div class="rndBtnRow">
							{{:helper.link("Очистить очередь", '', {'clear_fab_queue':1, 'fab_target':'robotics'})}}
						</div>
						{{if data.robotics_queue.length}}
							<hr>
							{{for data.robotics_queue}}
								<div>{{:index + 1}}) {{:value}}</div>
							{{/for}}
						{{else}}
							<div class="rndMuted">Очередь пуста</div>
						{{/if}}
					</div>
				</div>
			</div>
			{{/if}}

			{{if data.has_mech_fab}}
			<div class="rndCol" style="width:50%;">
				<div class="rndSection">
					<div class="rndSectionTitle">Mech Fabricator</div>
					<div class="rndSectionContent">
						<div class="rndBtnRow" style="margin-bottom:6px;">
							{{for data.mech_designs}}
								{{:helper.link(value.name, '', {'build_to_fab':value.id, 'fab_target':'mech', 'amount':1})}}
							{{/for}}
						</div>
						<div class="rndBtnRow">
							{{:helper.link("Очистить очередь", '', {'clear_fab_queue':1, 'fab_target':'mech'})}}
						</div>
						{{if data.mech_queue.length}}
							<hr>
							{{for data.mech_queue}}
								<div>{{:index + 1}}) {{:value}}</div>
							{{/for}}
						{{else}}
							<div class="rndMuted">Очередь пуста</div>
						{{/if}}
					</div>
				</div>
			</div>
			{{/if}}
		</div>
		{{/if}}
	</div>
	{{/if}}

	<!-- ══════════════════════════════════════════════════════════════ -->
	<!-- CORPS SCREEN                                                  -->
	<!-- ══════════════════════════════════════════════════════════════ -->
	{{if data.dt_screen == 'corps'}}

	{{if data.has_account}}
	<div class="rndTwoCol" style="padding:8px 8px 0 8px;">

		<!-- Left: tree -->
		<div class="rndCol" style="width:68%;">

			<div class="rndSection">
				<div class="rndSectionTitle">Категории технологий</div>
				<div class="rndSectionContent">
					<div class="rndBtnRow" style="margin-bottom:8px;">
						{{for data.corp_categories}}
							{{:helper.link(value.name, '', {'select_tech_category':value.id}, data.selected_category_id == value.id ? 'selected' : null)}}
						{{/for}}
					</div>
					<div class="rndBtnRow rndCorpSubTabs">
						{{for data.corp_trees}}
							{{:helper.link(value.name, '', {'select_corp':value.id}, data.selected_corp == value.id ? 'selected' : null)}}
						{{/for}}
					</div>
				</div>
			</div>

			<div class="rndSection">
				<div class="rndSectionContent" style="padding:0;">
					<div id='sciTechTreeContainer'>
						{{if data.selected_corp_logo}}
							<div class="rndTreeWatermark" style="background-image:url({{:data.selected_corp_logo}});"></div>
						{{/if}}
						{{for data.corp_lines}}
							<div style="position:absolute;border-{{:value.istop?'top':'bottom'}}:1px solid rgba(100,180,255,0.35);border-{{:value.isright?'right':'left'}}:1px solid rgba(100,180,255,0.35);width:{{:value.width}}%;height:{{:value.height}}%;left:{{:value.line_x}}%;bottom:{{:value.line_y}}%"></div>
						{{/for}}
						{{for data.corp_nodes}}
							<div style="position:absolute;left:{{:value.x}}%;bottom:{{:value.y}}%;margin-left:-20px;margin-bottom:-20px;">
								{{:helper.link("<div class='sciTechTreeIcon icon-"+value.icon+"'></div>", '', {'select_corp_node':value.id}, null, "link sciTechTreeIconBox "+((value.isresearched==1)?'sciTechResearched':((value.canunlock==1)?'sciTechAvailable':'sciTechCantResearch'))+" "+((value.id==data.selected_node_id)?'sciTechSelected':''))}}
							</div>
						{{/for}}
					</div>
				</div>
			</div>

		</div>

		<!-- Right: node detail -->
		<div class="rndCol" style="width:32%;">
			<div class="rndSection">
				<div class="rndSectionTitle">Узел технологии</div>
				<div class="rndSectionContent">
					{{if data.selected_node}}
						<div class="rndNodeName">{{:data.selected_node.name}}</div>
						{{if data.selected_corp_logo}}
							<img src="{{:data.selected_corp_logo}}" class="rndNodeLogo" />
						{{/if}}

						<div class="rndNodeField">
							<div class="rndNodeLabel">Стоимость</div>
							<div class="rndNodeValue rndPriceValue">{{:data.currency_short}}{{:data.selected_node.price}}</div>
						</div>

						{{if data.selected_node.current_reputation !== null && data.selected_node.current_reputation !== undefined}}
						<div class="rndNodeField">
							<div class="rndNodeLabel">Репутация</div>
							<div class="rndNodeValue">
								{{if data.selected_node.corp_id}}{{:data.selected_node.corp_id}}: {{/if}}<span style="color:{{:data.selected_node.current_reputation >= 0?'#00FF00':'#FF0000'}}">
									{{:data.selected_node.current_reputation >= 0 ? '+' : ''}}{{:data.selected_node.current_reputation}}
								</span> / {{:data.selected_node.required_reputation}}
								{{if !data.selected_node.reputation_met}}<br/>
									<span style="color:#FF6644;font-size:11px;">Ещё {{:data.selected_node.required_reputation - data.selected_node.current_reputation}} репутации</span>
								{{/if}}
							</div>
						</div>
						{{/if}}

						<div class="rndNodeField">
							<div class="rndNodeLabel">Требования</div>
							<div class="rndNodeValue">
								{{if data.selected_node.requirements && data.selected_node.requirements.length > 0}}
									{{for data.selected_node.requirements}}
										<span style="color:{{:value.isgood?'#44ff44':'#ff4444'}}">{{:value.text}}</span><br />
									{{/for}}
								{{else}}
									<span class="rndMuted">Нет требований</span>
								{{/if}}
							</div>
						</div>

						<div class="rndNodeField">
							<div class="rndNodeLabel">Открывает</div>
							<div class="rndNodeValue">
								{{if data.selected_node.unlocks && data.selected_node.unlocks.length > 0}}
									{{for data.selected_node.unlocks}}
										{{:value.text}}<br />
									{{/for}}
								{{else}}
									<span class="rndMuted">—</span>
								{{/if}}
							</div>
						</div>

						{{if data.selected_node.isresearched}}
							<div class="rndNodeStatus rndNodeStatus--good">Открыто</div>
						{{else}}
							{{if data.selected_node.can_buy}}
								{{:helper.link("Приобрести", '', {'buy_corp_node':data.selected_node_id}, null, 'rndBuyBtn')}}
							{{else}}
								<div class="rndNodeStatus rndNodeStatus--locked">Недоступно</div>
							{{/if}}
						{{/if}}
					{{else}}
						<div class="rndMuted" style="text-align:center;padding:20px 0;">Выберите узел на карте технологий</div>
					{{/if}}
				</div>
			</div>
		</div>

	</div>

	{{else}}
		<div class="dtBody">
			<div class="dtNoAccount">
				Для покупки корпоративных лицензий необходимо привязать счёт отдела.
			</div>
		</div>
	{{/if}}

	{{/if}}

	<!-- ── Account footer ──────────────────────────────────────────── -->
	{{if data.can_switch_account}}
	<div class="dtFooter">
		<span class="dtFooterLabel">Счёт:</span>
		<span class="dtFooterValue">{{:data.has_account ? data.account_name : "Не привязан"}}</span>
		{{:helper.link("Привязать", 'key', {'link_account':1}, null, 'rndTab')}}
		{{if data.has_account}}
			{{:helper.link("Отвязать", 'cancel', {'unlink_account':1}, null, 'rndTab')}}
		{{/if}}
	</div>
	{{/if}}

</div>
