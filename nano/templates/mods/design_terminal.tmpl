<!--
Title: Design Terminal
Used In File(s): \mods\RnD\code\machinery\design_terminal.dm
-->
{{if data.ui_theme == "engineering"}}
{{:helper.ntengiMode()}}
{{else data.ui_theme == "medical"}}
{{:helper.ntmedMode()}}
{{else}}
{{:helper.ntscieMode()}}
{{/if}}
<style>

/* ── Theme variables ─────────────────────────────────────────────── */
.dtConsole {
	--dt-accent:       #7dd3fc;
	--dt-accent-dim:   #38bdf8;
	--dt-accent-glow:  rgba(125, 211, 252, 0.18);
	--dt-accent-badge: rgba(125, 211, 252, 0.12);
	--dt-border:       rgba(60, 100, 160, 0.4);
	--dt-border-accent:rgba(80, 140, 220, 0.55);
	--dt-bg:           #0b1120;
	--dt-bg-panel:     rgba(12, 20, 36, 0.85);
	--dt-bg-header:    rgba(16, 28, 48, 0.95);
	--dt-bg-row-hover: rgba(24, 40, 70, 0.6);
	--dt-title-color:  #8ab4e8;
	--dt-label:        "ТЕРМИНАЛ ДИЗАЙНОВ";
}

.dtConsole.dtTheme--medical {
	--dt-accent:       #34d399;
	--dt-accent-dim:   #10b981;
	--dt-accent-glow:  rgba(52, 211, 153, 0.18);
	--dt-accent-badge: rgba(52, 211, 153, 0.12);
	--dt-border:       rgba(6, 78, 59, 0.9);
	--dt-border-accent:rgba(52, 211, 153, 0.45);
	/* Match nano body fill (ntmedMode) for seamless edge with uiBackground-NTmed.png */
	--dt-bg:           #000a0a;
	--dt-bg-panel:     rgba(0, 14, 14, 0.92);
	--dt-bg-header:    rgba(0, 18, 16, 0.97);
	--dt-bg-row-hover: rgba(6, 40, 28, 0.65);
	--dt-title-color:  #34d399;
}

.dtConsole.dtTheme--engineering {
	--dt-accent:       #fbbf24;
	--dt-accent-dim:   #f59e0b;
	--dt-accent-glow:  rgba(251, 191, 36, 0.18);
	--dt-accent-badge: rgba(251, 191, 36, 0.12);
	--dt-border:       rgba(78, 52, 6, 0.9);
	--dt-border-accent:rgba(251, 191, 36, 0.45);
	/* Near ntengiMode body (#372102) so terminal body and window fill read as one */
	--dt-bg:           #2a1a08;
	--dt-bg-panel:     rgba(45, 28, 6, 0.9);
	--dt-bg-header:    rgba(40, 24, 5, 0.97);
	--dt-bg-row-hover: rgba(50, 35, 5, 0.65);
	--dt-title-color:  #fbbf24;
}

/* ── Layout ──────────────────────────────────────────────────────── */
.dtConsole {
	display: flex;
	flex-direction: column;
	background: var(--dt-bg);
	color: #c8dae8;
	min-height: 100%;
	box-sizing: border-box;
	font-size: 12px;
	font-family: 'Consolas', 'Courier New', monospace;
}

/* ── Nav bar ─────────────────────────────────────────────────────── */
.dtNav {
	display: flex;
	align-items: stretch;
	background: var(--dt-bg-header);
	border-bottom: 1px solid var(--dt-border-accent);
	padding: 0 8px;
	gap: 2px;
	flex-shrink: 0;
}

.dtNavTitle {
	display: flex;
	align-items: center;
	padding: 0 10px 0 4px;
	font-size: 11px;
	font-weight: bold;
	letter-spacing: 1.5px;
	color: var(--dt-accent);
	text-transform: uppercase;
	border-right: 1px solid var(--dt-border);
	margin-right: 6px;
	white-space: nowrap;
}

.dtNavTitle .dtDeptBadge {
	display: inline-block;
	margin-left: 7px;
	padding: 1px 7px;
	border-radius: 2px;
	font-size: 9px;
	letter-spacing: 0.5px;
	background: var(--dt-accent-badge);
	border: 1px solid var(--dt-border-accent);
	color: var(--dt-accent);
	vertical-align: middle;
	font-weight: normal;
}

.dtNavStatus {
	margin-left: auto;
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 4px 0;
	font-size: 11px;
}

.dtBalanceLabel { color: #94a3b8; }
.dtBalanceValue { color: var(--dt-accent); font-weight: bold; }
.dtBalanceError { color: #f87171; font-weight: bold; font-size: 10px; letter-spacing: 0.5px; }

.dtServerBadge {
	display: inline-flex;
	align-items: center;
	gap: 5px;
	padding: 2px 8px;
	border-radius: 2px;
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 0.5px;
	text-transform: uppercase;
}
.dtServerBadge--online {
	background: rgba(30, 80, 50, 0.35);
	border: 1px solid rgba(50, 160, 80, 0.4);
	color: #66dd88;
}
.dtServerBadge--offline {
	background: rgba(80, 30, 30, 0.35);
	border: 1px solid rgba(160, 50, 50, 0.4);
	color: #dd6666;
}
.dtServerDot {
	width: 6px;
	height: 6px;
	border-radius: 50%;
	display: inline-block;
	flex-shrink: 0;
}
.dtServerBadge--online .dtServerDot { background: #44cc66; box-shadow: 0 0 4px rgba(68, 204, 102, 0.7); }
.dtServerBadge--offline .dtServerDot { background: #cc4444; box-shadow: 0 0 4px rgba(204, 68, 68, 0.7); }

/* ── Body padding ────────────────────────────────────────────────── */
.dtBody {
	padding: 8px;
	display: flex;
	flex-direction: column;
	gap: 6px;
	flex: 1;
}

/* ── Toolbar strip ───────────────────────────────────────────────── */
.dtToolbar {
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 5px 8px;
	background: var(--dt-bg-panel);
	border: 1px solid var(--dt-border);
	border-radius: 3px;
	flex-wrap: wrap;
}

.dtToolbarSep {
	width: 1px;
	height: 14px;
	background: var(--dt-border);
	flex-shrink: 0;
}

/* ── Category filter bar ─────────────────────────────────────────── */
.dtFilterBar {
	display: flex;
	align-items: center;
	gap: 4px;
	flex-wrap: wrap;
	padding: 5px 8px;
	background: var(--dt-bg-panel);
	border: 1px solid var(--dt-border);
	border-radius: 3px;
}

.dtFilterLabel {
	font-size: 10px;
	letter-spacing: 0.6px;
	text-transform: uppercase;
	color: #64748b;
	margin-right: 4px;
	white-space: nowrap;
}

/* ── Two-column layout ───────────────────────────────────────────── */
.dtCols {
	display: flex;
	gap: 6px;
	flex: 1;
}

/* ── Panel ───────────────────────────────────────────────────────── */
.dtPanel {
	background: var(--dt-bg-panel);
	border: 1px solid var(--dt-border);
	border-radius: 3px;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}


.dtPanelHead {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 5px 8px;
	background: var(--dt-bg-header);
	border-bottom: 1px solid var(--dt-border);
	font-size: 10px;
	font-weight: bold;
	letter-spacing: 0.8px;
	text-transform: uppercase;
	color: var(--dt-accent);
	flex-shrink: 0;
}

.dtPanelCount {
	font-size: 10px;
	font-weight: normal;
	color: #64748b;
}

.dtPanelBody {
	overflow-y: auto;
	flex: 1;
	max-height: 360px;
}

/* ── File item row ───────────────────────────────────────────────── */
.dtFileItem {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 4px 8px;
	border-bottom: 1px solid rgba(30, 41, 59, 0.6);
}


.dtFileItem:last-child {
	border-bottom: none;
}

.dtFileName {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	flex: 1;
	margin-right: 8px;
	color: #cbd5e1;
}

.dtFileActions {
	display: flex;
	align-items: center;
	gap: 4px;
	flex-shrink: 0;
}

.dtOnDisk {
	font-size: 10px;
	color: #34d399;
}

.dtEmpty {
	padding: 24px 8px;
	text-align: center;
	color: #475569;
	font-size: 11px;
}

/* ── Disk info strip ─────────────────────────────────────────────── */
.dtDiskStrip {
	display: flex;
	align-items: center;
	gap: 6px;
	padding: 3px 6px;
	background: var(--dt-accent-badge);
	border: 1px solid var(--dt-border-accent);
	border-radius: 2px;
	font-size: 10px;
}

.dtDiskBar {
	height: 4px;
	border-radius: 2px;
	background: var(--dt-border);
	width: 64px;
	overflow: hidden;
	flex-shrink: 0;
}

.dtDiskBarFill {
	height: 100%;
	background: var(--dt-accent);
	border-radius: 2px;
}

/* ── Account footer ──────────────────────────────────────────────── */
.dtFooter {
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 5px 8px;
	background: var(--dt-bg-header);
	border-top: 1px solid var(--dt-border);
	font-size: 11px;
	flex-shrink: 0;
}

.dtFooterLabel { color: #475569; }
.dtFooterValue { color: #93c5fd; }

/* ── Theme switcher ──────────────────────────────────────────────── */
.dtThemeBtn {
	padding: 2px 8px !important;
	font-size: 10px !important;
	letter-spacing: 0.5px;
	border: 1px solid var(--dt-border) !important;
	background: rgba(24, 48, 80, 0.4) !important;
	border-radius: 2px !important;
	color: #64748b !important;
	cursor: pointer;
	float: none;
	height: auto;
}
.dtThemeBtn.selected {
	background: var(--dt-accent-badge) !important;
	border-color: var(--dt-accent) !important;
	color: var(--dt-accent) !important;
	box-shadow: 0 0 4px var(--dt-accent-glow);
}
.dtThemeSwitcher {
	display: flex;
	align-items: center;
	gap: 3px;
	padding: 0 6px;
	border-left: 1px solid var(--dt-border);
	border-right: 1px solid var(--dt-border);
	margin: 0 4px;
}

/* ── "No account" corp warning ───────────────────────────────────── */
.dtNoAccount {
	padding: 40px 8px;
	text-align: center;
	color: #f87171;
	font-size: 13px;
}

/* ── Base link/button overrides (scoped to dtConsole) ───────────── */
/* shared.css gives all buttons flat #40628a; we replace that here   */
.dtConsole .link,
.dtConsole a.link:link,
.dtConsole a.link:visited,
.dtConsole a.link:active {
	background: rgba(24, 48, 80, 0.7);
	border: 1px solid var(--dt-border);
	color: #a8c8e8;
	border-radius: 2px;
	float: none;
	height: auto;
	padding: 1px 6px 3px;
	margin: 0 2px 2px 0;
	font-size: 11px;
	font-family: 'Consolas', 'Courier New', monospace;
	letter-spacing: 0.3px;
}


/* "selected" state for category/corp filter buttons */
.dtConsole .link.selected,
.dtConsole a.selected:link,
.dtConsole a.selected:visited,
.dtConsole a.selected:active,
.dtConsole a.selected:hover {
	background: rgba(30, 80, 50, 0.75) !important;
	border-color: rgba(60, 160, 80, 0.5) !important;
	color: #88eea0 !important;
	box-shadow: 0 0 6px rgba(60, 160, 80, 0.2);
}

/* disabled */
.dtConsole .link.disabled,
.dtConsole a.disabled:link,
.dtConsole a.disabled:visited {
	background: rgba(20, 25, 35, 0.5) !important;
	border-color: rgba(50, 60, 80, 0.4) !important;
	color: #374151 !important;
	box-shadow: none !important;
	cursor: default;
}

/* ── dtNav tab buttons ───────────────────────────────────────────── */
.dtConsole .rndTab {
	padding: 4px 12px !important;
	font-size: 11px !important;
	letter-spacing: 0.6px;
	text-transform: uppercase;
	border: 1px solid var(--dt-border) !important;
	background: rgba(24, 48, 80, 0.5) !important;
	border-radius: 2px !important;
	color: #94a3b8 !important;
	float: none;
	height: auto;
	font-family: 'Consolas', 'Courier New', monospace !important;
}


.dtConsole .rndTab.selected {
	background: rgba(30, 80, 50, 0.75) !important;
	border-color: rgba(60, 160, 80, 0.5) !important;
	color: #88eea0 !important;
	box-shadow: 0 0 6px rgba(60, 160, 80, 0.2);
}

/* ── Scrollbars ──────────────────────────────────────────────────── */
.dtConsole ::-webkit-scrollbar       { width: 5px; }
.dtConsole ::-webkit-scrollbar-track { background: rgba(6,12,24,0.4); }
.dtConsole ::-webkit-scrollbar-thumb { background: var(--dt-border-accent); border-radius: 3px; }
.dtConsole ::-webkit-scrollbar-thumb:hover { background: var(--dt-accent-dim); }

/* ── rnd* layout (not in shared CSS — defined only in rdconsole) ─── */
.rndTwoCol {
	display: flex;
	gap: 8px;
	align-items: flex-start;
	padding: 0 4px;
}
.rndCol { flex-shrink: 0; }
.rndTwoCol .rndSection,
.dtConsole .rndSection {
	margin-bottom: 8px;
	background: var(--dt-bg-panel);
	border: 1px solid var(--dt-border);
	border-radius: 3px;
	overflow: hidden;
}
.rndTwoCol .rndSectionTitle,
.dtConsole .rndSectionTitle {
	padding: 5px 10px;
	font-size: 11px;
	font-weight: bold;
	letter-spacing: 0.8px;
	text-transform: uppercase;
	color: var(--dt-accent);
	background: var(--dt-bg-header);
	border-bottom: 1px solid var(--dt-border);
}
.rndSectionContent { padding: 8px 10px; }
.rndBtnRow { display: flex; gap: 4px; flex-wrap: wrap; }
.rndMuted { color: #5a7a9a; }
.rndBuyBtn {
	display: block;
	text-align: center !important;
	padding: 6px 16px !important;
	background: var(--dt-accent-badge) !important;
	border-color: var(--dt-border-accent) !important;
	color: var(--dt-accent) !important;
	margin-top: 8px;
	border-radius: 2px;
}
.rndBuyBtn:hover {
	background: var(--dt-accent-glow) !important;
	box-shadow: 0 0 8px var(--dt-accent-glow);
}

/* ═══════════════════════════════════════════════════════════════════ */
/* Tech Tree (identical to rdconsole)                                 */
/* ═══════════════════════════════════════════════════════════════════ */
#sciTechTreeContainer {
	position: relative;
	width: 99%;
	height: 440px;
	overflow: hidden;
	border: 1px solid var(--dt-border-accent);
	background: url(nanomapBackground.png);
	border-radius: 3px;
	background-color: rgba(4, 8, 16, 0.6);
	box-shadow: inset 0 0 20px rgba(0,0,0,0.4), inset 0 0 0 1px rgba(40,70,110,0.3);
}

.rndTreeWatermark {
	position: absolute;
	left: 50%; top: 50%;
	width: 60%; height: 60%;
	transform: translate(-50%, -50%);
	background: center center / contain no-repeat;
	opacity: 0.08;
	pointer-events: none;
}

.rndCorpSubTabs {
	border-top: 1px solid rgba(64,98,138,0.3);
	padding-top: 6px;
}

.sciTechTreeIcon {
	position: absolute;
	width: 32px; height: 32px;
	background-image: url(science.png);
	background-position: 0px 0px;
	background-repeat: no-repeat;
	zoom: 1;
	top: 4px; left: 4px;
}

.sciTechTreeIconBox {
	width: 40px !important; height: 40px !important;
	min-width: 40px !important;
	padding: 0 !important;
	border-radius: 3px;
	transition: all 0.15s;
	border: 1px solid transparent;
	display: block !important;
	line-height: 40px !important;
	position: relative;
}

.sciTechResearched   { background: rgba(30,110,45,0.75)!important; border-color: rgba(60,180,80,0.6)!important; box-shadow: 0 0 8px rgba(50,180,70,0.3); }
.sciTechResearched:hover { background: rgba(40,140,55,0.85)!important; }
.sciTechAvailable    { background: rgba(25,60,120,0.75)!important; border-color: rgba(60,140,240,0.5)!important; box-shadow: 0 0 8px rgba(50,120,220,0.3); }
.sciTechAvailable:hover  { background: rgba(35,75,150,0.85)!important; }
.sciTechCantResearch { background: rgba(100,30,35,0.65)!important; border-color: rgba(160,50,60,0.45)!important; }
.sciTechCantResearch:hover { background: rgba(120,40,45,0.75)!important; }
.sciTechSelected     { border-color: rgba(140,180,255,0.8)!important; box-shadow: 0 0 12px rgba(100,160,255,0.5), inset 0 0 8px rgba(100,160,255,0.15)!important; }

/* Node detail */
.rndNodeName  { font-size: 15px; font-weight: bold; color: #cde; margin-bottom: 4px; }
.rndNodeLogo  { max-width: 100%; max-height: 70px; display: block; margin: 6px 0 10px; opacity: 0.85; }
.rndNodeField { margin-bottom: 10px; }
.rndNodeLabel { font-size: 10px; color: #6a8aaa; letter-spacing: 0.6px; text-transform: uppercase; margin-bottom: 2px; }
.rndNodeValue { line-height: 1.35; font-size: 12px; }
.rndPriceValue { font-size: 15px; font-weight: bold; color: #44cc88; }
.rndNodeStatus { padding: 4px 0; text-align: center; font-size: 11px; font-weight: bold; letter-spacing: 0.5px; text-transform: uppercase; border-radius: 2px; }
.rndNodeStatus--good   { color: #44ff44; background: rgba(40,100,40,0.3); border: 1px solid rgba(60,160,60,0.3); }
.rndNodeStatus--locked { color: #ff6644; background: rgba(100,40,40,0.3); border: 1px solid rgba(160,60,60,0.3); }
.rndBuyBtn { display: block; width: 100%; text-align: center; margin-top: 6px; padding: 5px; background: rgba(30,80,160,0.5); border: 1px solid rgba(60,140,240,0.4); border-radius: 2px; }
.rndBuyBtn:hover { background: rgba(40,100,200,0.6); }

