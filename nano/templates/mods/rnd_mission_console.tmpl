<!--
Title: R&D mission console
Used In File(s): \mods\RnD\code\missions.dm
 -->
<div class="rndConsole">
<div class="rndTwoCol">
<div class="fixedLeftWider rndLeftCol" style="width:68%;">
	<div class="item" style="display:flex; gap: 6px; margin-bottom: 8px;">
		{{:helper.link("Активные задания", '', {'set_tab' : 'missions'}, data.selected_tab == 'missions' ? 'selected' : null)}}
		{{:helper.link("Корпоративные технологии", '', {'set_tab' : 'tech'}, data.selected_tab == 'tech' ? 'selected' : null)}}
		{{:helper.link("Связь с корпорациями", '', {'set_tab' : 'corps'}, data.selected_tab == 'corps' ? 'selected' : null)}}
	</div>

	{{if data.selected_tab == "missions"}}
	<div class="section">
		<div class="section-title">
			Активное задание
		</div>
		<div class="section-content">
			<div class="item" style="margin-bottom: 8px;">Лимит: {{:data.active_missions_count}} / {{:data.max_active_missions}}</div>
			{{if data.has_active_mission}}
				{{for data.active_missions}}
					<div class="labelList" style="margin-bottom: 8px;">
						<div class="labelList-item">
							<div class="labelList-item-label">Корпорация</div>
							<div class="labelList-item-content">{{:value.corp_name}}</div>
						</div>
						<div class="labelList-item">
							<div class="labelList-item-label">Контракт</div>
							<div class="labelList-item-content">{{:value.title}}</div>
						</div>
						<div class="labelList-item">
							<div class="labelList-item-label">Статус</div>
							<div class="labelList-item-content">{{:value.status}}</div>
						</div>
						<div class="labelList-item">
							<div class="labelList-item-label">Локация</div>
							<div class="labelList-item-content">{{:value.location_type}} {{:value.location_name}}</div>
						</div>
						<div class="labelList-item">
							<div class="labelList-item-label">Координаты</div>
							<div class="labelList-item-content">{{:value.location_coords}}</div>
						</div>
						{{if value.creature_name}}
							<div class="labelList-item">
								<div class="labelList-item-label">Цель</div>
								<div class="labelList-item-content">{{:value.creature_name}}</div>
							</div>
							<div class="labelList-item">
								<div class="labelList-item-label">Описание</div>
								<div class="labelList-item-content">{{:value.creature_desc}}</div>
							</div>
							<div class="labelList-item">
								<div class="labelList-item-label">Среда</div>
								<div class="labelList-item-content">{{:value.creature_habitat}}</div>
							</div>
							<div class="labelList-item">
								<div class="labelList-item-label">Сдача</div>
								<div class="labelList-item-content">Стазис-клетка через миссионный телепортер</div>
							</div>
						{{else}}
							<div class="labelList-item">
								<div class="labelList-item-label">Сдача</div>
								<div class="labelList-item-content">Миссионный телепортер</div>
							</div>
						{{/if}}
						{{if value.reward_node_name}}
							<div class="labelList-item">
								<div class="labelList-item-label">Награда</div>
								<div class="labelList-item-content">Узел: {{:value.reward_node_name}}</div>
							</div>
						{{else}}
							<div class="labelList-item">
								<div class="labelList-item-label">Награда</div>
								<div class="labelList-item-content">{{:value.reward_pack_name}}</div>
							</div>
						{{/if}}
						<div class="labelList-item">
							<div class="labelList-item-label">Описание</div>
							<div class="labelList-item-content">{{:value.description}}</div>
						</div>
					</div>
					<div class="item" style="display:flex; gap: 6px; margin-bottom: 8px;">
						{{:helper.link("Отменить", '', {'cancel_mission' : value.ref})}}
						{{:helper.link("Печать", '', {'print_mission' : value.ref})}}
					</div>
				{{/for}}
			{{else}}
				<div class="notice">Нет активных контрактов.</div>
			{{/if}}
		</div>
	</div>
	{{/if}}

	{{if data.selected_tab == "tech"}}
	<div class="section">
		<div class="section-title">
			Категории технологий
		</div>
		<div class="section-content">
			{{if !data.has_rdconsole}}
				<div class="bad">Поблизости не найдена рабочая R&D консоль.</div>
			{{else}}
				<div class="item" style="display:flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px;">
					{{for data.categories}}
						{{:helper.link(value.name, '', {'select_category' : value.id}, data.selected_category == value.id ? 'selected' : null)}}
					{{/for}}
				</div>
				<div class="item" style="display:flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px; border-top: 1px solid #40628a; padding-top: 6px;">
					{{for data.category_corp_trees}}
						{{:helper.link(value.name, '', {'select_corp' : value.id}, data.selected_corp == value.id ? 'selected' : null)}}
					{{/for}}
				</div>
				<div id='sciTechTreeContainer'>
					{{if data.selected_corp_logo}}
						<div class="rndTreeWatermark" style="background-image: url({{:data.selected_corp_logo}});"></div>
					{{/if}}
					{{for data.corp_lines}}
						<div style="position: absolute;border-{{:value.istop?'top':'bottom'}}: 1px solid white;border-{{:value.isright?'right':'left'}}: 1px solid white;width: {{:value.width}}%;height: {{:value.height}}%;left: {{:value.line_x}}%;bottom: {{:value.line_y}}%"></div>
					{{/for}}
					{{for data.corp_nodes}}
						<div style="position: absolute; left: {{:value.x}}%; bottom: {{:value.y}}%; margin-left: -20px; margin-bottom: -20px;">
							{{:helper.link("<div class='sciTechTreeIcon icon-"+value.icon+"'></div>", '', {'select_corp_node' : value.id}, null, "link sciTechTreeIconBox "+((value.canunlock==0 && value.isresearched!=1)?'sciTechCantResearch':'')+" "+((value.isresearched==1)?'sciTechResearched':'')+" "+((value.id == data.selected_node_id)?'sciTechSelected':'') )}}
						</div>
					{{/for}}
				</div>
			{{/if}}
		</div>
	</div>
	{{/if}}

	{{if data.selected_tab == "corps"}}
	<div class="section">
		<div class="section-title">
			Корпорации
		</div>
		<div class="section-content">
			<div style="display:flex; flex-wrap: wrap; gap: 6px;">
				{{for data.corporations}}
					<div style="flex: 0 0 calc(50% - 3px); max-width: calc(50% - 3px); padding: 8px; background-color: {{:data.selected_dialogue_corp_id == value.id ? '#2a4a6a' : '#1a2a3a'}}; border-radius: 4px; border: 1px solid {{:data.selected_dialogue_corp_id == value.id ? '#4a7aaa' : '#2a4a6a'}};">
						{{:helper.link(value.name + " (" + (value.reputation >= 0 ? '+' : '') + value.reputation + ")", '', {'select_corp_dialogue' : value.id}, data.selected_dialogue_corp_id == value.id ? 'selected' : null, 'link')}}
					</div>
				{{/for}}
			</div>
		</div>
	</div>
	{{/if}}
</div>

<div class="fixedLeftWider rndRightCol" style="width:32%;">
	<div class="rndRightSpacer"></div>

	{{if data.selected_tab == "tech"}}
	<div class="section">
		<div class="section-title">
			Узел технологии
		</div>
		<div class="section-content">
			{{if data.selected_node}}
				<div class="rndNodeName">{{:data.selected_node.name}}</div>
				{{if data.selected_corp_logo}}
					<img src="{{:data.selected_corp_logo}}" class="rndNodeLogo" />
				{{/if}}
				<div class="rndNodeSection">
					<div class="rndNodeLabel">Стоимость</div>
					<div class="rndNodeValue">{{:data.currency_short}}{{:data.selected_node.price}}</div>
				</div>
				{{if data.selected_node.current_reputation !== null && data.selected_node.current_reputation !== undefined}}
				<div class="rndNodeSection">
					<div class="rndNodeLabel">Репутация</div>
					<div class="rndNodeValue">
						{{if data.selected_node.corp_id}}{{:data.selected_node.corp_id}}: {{/if}}<span style="color: {{:data.selected_node.current_reputation >= 0?'#00FF00':'#FF0000'}}">
							{{:data.selected_node.current_reputation >= 0 ? '+' : ''}}{{:data.selected_node.current_reputation}}
						</span> / {{:data.selected_node.required_reputation}}
						{{if !data.selected_node.reputation_met}}<br/>
							<span style="color: #FF0000">Требуется ещё {{:data.selected_node.required_reputation - data.selected_node.current_reputation}} репутации</span>
						{{/if}}
					</div>
				</div>
				{{/if}}
				<div class="rndNodeSection">
					<div class="rndNodeLabel">Требования</div>
					<div class="rndNodeValue">
						{{if data.selected_node.requirements && data.selected_node.requirements.length > 0}}
							{{for data.selected_node.requirements}}
								<span style="color: {{:value.isgood?'#00FF00':'#FF0000'}}">{{:value.text}}</span><br />
							{{/for}}
						{{else}}
							<span style="color: #888888">Нет требований</span>
						{{/if}}
					</div>
				</div>
				<div class="rndNodeSection">
					<div class="rndNodeLabel">Открывает</div>
					<div class="rndNodeValue">
						{{for data.selected_node.unlocks}}
							{{:value.text}}<br />
						{{/for}}
					</div>
				</div>
				{{if data.selected_node.isresearched}}
					<span class="good">Открыто</span>
				{{else}}
					<div style="display:flex; gap: 6px; flex-wrap: wrap;">
						{{if data.selected_node.can_buy}}
							{{:helper.link("Купить", '', {'buy_corp_node' : data.selected_node_id})}}
						{{/if}}
						{{if data.selected_node.can_mission}}
							{{:helper.link("Взять миссию", '', {'take_corp_mission' : data.selected_node_id}, data.has_active_corp_mission ? 'disabled' : null)}}
						{{/if}}
						{{if !data.selected_node.canunlock}}
							<span class="bad">Недоступно</span>
						{{/if}}
					</div>
				{{/if}}
			{{else}}
				<div class="notice">Выберите узел.</div>
			{{/if}}
		</div>
	</div>
	{{/if}}

	{{if data.selected_tab == "corps"}}
	<div class="section">
		<div class="section-title">
			Диалог с корпорацией
		</div>
		<div class="section-content">
			{{if data.selected_corp_dialogue}}
				<div class="rndNodeName" style="margin-bottom: 12px;">{{:data.selected_corp_dialogue.name}}</div>
				<div class="rndNodeSection">
					<div class="rndNodeLabel">Текущая репутация</div>
					<div class="rndNodeValue">
						<span style="font-size: 18px; font-weight: bold; color: {{:data.selected_corp_dialogue.reputation_color}}">
							{{:data.selected_corp_dialogue.reputation >= 0 ? '+' : ''}}{{:data.selected_corp_dialogue.reputation}}/50
						</span>
						<div style="margin-top: 6px; width: 100%; height: 20px; background-color: #1a2a3a; border: 1px solid #2a4a6a; border-radius: 4px; overflow: hidden;">
							<div style="height: 100%; width: {{:(data.selected_corp_dialogue.reputation + 50) / 100 * 100}}%; background-color: {{:data.selected_corp_dialogue.reputation >= 0 ? '#00AA00' : '#AA0000'}}; transition: width 0.3s;"></div>
						</div>
					</div>
				</div>
				<div class="rndNodeSection">
					<div class="rndNodeLabel">Статус</div>
					<div class="rndNodeValue">
						{{if data.selected_corp_dialogue.reputation >= 40}}
							<span style="color: #00FF00">Отличные отношения</span>
						{{else}}
							{{if data.selected_corp_dialogue.reputation >= 20}}
								<span style="color: #00DD00">Хорошие отношения</span>
							{{else}}
								{{if data.selected_corp_dialogue.reputation >= 0}}
									<span style="color: #FFDD00">Нейтральные отношения</span>
								{{else}}
									{{if data.selected_corp_dialogue.reputation >= -20}}
										<span style="color: #FF8800">Напряженные отношения</span>
									{{else}}
										<span style="color: #FF0000">Враждебные отношения</span>
									{{/if}}
								{{/if}}
							{{/if}}
						{{/if}}
					</div>
				</div>
				<div class="rndNodeSection">
					<div class="rndNodeLabel">Доступные миссии</div>
					<div style="display:flex; flex-direction:column; gap: 8px;">
						<!-- Обычная миссия -->
						<div style="padding: 12px; background-color: #1a2a3a; border-left: 2px solid #40628a; border-radius: 3px;">
							<div style="margin-bottom: 8px;">
								<span style="font-weight: bold; color: #AABBCC;">Обычный контракт</span><br/>
								<span style="font-size: 11px; color: #888888;">Выполните задание корпорации для улучшения отношений.</span>
							</div>
							<div style="margin-bottom: 8px; font-size: 12px; color: #FFDD00;">
								<b>Награда:</b> +15 репутации
							</div>
							{{:helper.link("Принять миссию", '', {'accept_corp_mission' : data.selected_dialogue_corp_id})}}
						</div>

						<!-- Корпоративная сделка -->
						<div style="padding: 12px; background-color: #1a2a2a; border-left: 2px solid #FF8800; border-radius: 3px; margin-top: 12px;">
							<div style="margin-bottom: 8px;">
								<span style="font-weight: bold; color: #FFAA66;">Корпоративная сделка</span><br/>
								<span style="font-size: 11px; color: #AA8855;">Требуется доставить предмет конкурирующей корпорации.</span>
							</div>
							<div style="margin-bottom: 8px; font-size: 12px;">
								<span style="color: #00FF00;"><b>Награда:</b> +5 репутации с заказчиком</span><br/>
								<span style="color: #FF6666;"><b>Штраф:</b> -5 репутации с конкурентом</span>
							</div>
							{{:helper.link("Принять миссию", '', {'accept_corporate_deal' : data.selected_dialogue_corp_id})}}
						</div>

						<!-- Особая миссия -->
						{{if data.selected_corp_dialogue.reputation >= 30}}
							<div style="padding: 12px; background-color: #2a2a1a; border-left: 2px solid #FFDD00; border-radius: 3px;">
								<div style="margin-bottom: 8px;">
									<span style="font-weight: bold; color: #FFEEAA;">Особый контракт</span><br/>
									<span style="font-size: 11px; color: #999966;">Высокоуровневое задание. Требует выполнения сложных условий.</span>
								</div>
								<div style="margin-bottom: 8px; font-size: 12px; color: #00FF00;">
									<b>Награда:</b> +30 репутации
								</div>
								{{:helper.link("Принять миссию", '', {'accept_special_mission' : data.selected_dialogue_corp_id})}}
							</div>
						{{else}}
							<div style="padding: 10px; background-color: #3a2a2a; border: 1px solid #6a4a4a; border-radius: 3px; color: #999999; text-align: center; font-size: 12px;">
							Особая миссия (Требуется репутация: 30+)
						</div>
					{{/if}}
					</div>
				</div>
				<div class="rndNodeSection">
					<div class="rndNodeLabel">Информация о корпорации</div>
					<div class="rndNodeValue" style="font-size: 12px; color: #AABBCC;">
						{{:data.selected_corp_dialogue.info}}
					</div>
				</div>
			{{else}}
				<div class="notice">Выберите корпорацию.</div>
			{{/if}}
		</div>
	</div>
	{{/if}}

	<div class="section rndBalanceSection">
		<div class="section-title">
			Баланс научного отдела
		</div>
		<div class="section-content">
			{{if data.has_science_account}}
				<div class="item" style="font-size: 16px; font-weight: bold; color: #398839;">
					{{:data.currency_short}}{{:data.science_balance}}
				</div>
			{{else}}
				<div class="bad">Счет научного отдела не найден</div>
			{{/if}}
		</div>
	</div>
</div>

</div>
</div>

<style>
#sciTechTreeContainer {
	position: relative;
	width: 99%;
	height: 460px;
	overflow: hidden;
	border: 1px solid #40628a;
	background: url(nanomapBackground.png);
	border-radius: 4px;
	background-color: rgba(8, 12, 20, 0.35);
	box-shadow: inset 0 0 0 1px rgba(64, 98, 138, 0.4);
}

.rndTreeWatermark {
	content: "";
	position: absolute;
	left: 50%;
	top: 50%;
	width: 60%;
	height: 60%;
	transform: translate(-50%, -50%);
	background: center center / contain no-repeat;
	opacity: 0.12;
	pointer-events: none;
}

.rndTwoCol {
	display: flex;
	gap: 10px;
	align-items: flex-start;
}

.rndTwoCol .fixedLeftWider {
	float: none;
	margin-top: 0;
}

.rndRightSpacer {
	height: 34px;
}

.rndConsole .section {
	background: linear-gradient(180deg, rgba(12, 18, 30, 0.6), rgba(8, 12, 18, 0.45));
	border: 1px solid rgba(64, 98, 138, 0.65);
	box-shadow: inset 0 0 0 1px rgba(22, 36, 60, 0.6);
}

.rndConsole .section-title {
	letter-spacing: 0.4px;
	text-transform: uppercase;
}

.rndRightCol .section-content {
	background: linear-gradient(180deg, rgba(6, 10, 16, 0.35), rgba(6, 10, 16, 0.15));
}

.rndBalanceSection .section-content {
	overflow: hidden;
}

.rndNodeName {
	font-size: 16px;
	font-weight: bold;
	margin-bottom: 4px;
}

.rndNodeLogo {
	max-width: 270px;
	max-height: 90px;
	display: block;
	margin: 6px 0 10px 0;
}

.rndNodeSection {
	margin-bottom: 10px;
}

.rndNodeLabel {
	font-size: 12px;
	color: #9fb4d9;
	letter-spacing: 0.4px;
	text-transform: uppercase;
	margin-bottom: 2px;
}

.rndNodeValue {
	line-height: 1.35;
}

.sciTechTreeIcon {
	position: absolute;
	width: 32px;
	height: 32px;
	background-image: url(science.png);
	background-position: -0px -0px;
	background-repeat: no-repeat;
	zoom: 1;
	margin-left: 0px;
	margin-bottom: -16px;
}

.sciTechTreeIconBox {
	width: 32px;
	height: 32px;
	border-radius: 3px;
}

.sciTechResearched {
	background: #2f943c;
}

.sciTechResearched:hover {
	background: #3fB44c;
}

.sciTechCantResearch {
	background: #942f3c;
}

.sciTechCantResearch:hover {
	background: #B43f4c;
}

.sciTechSelected {
	background: #3333cc;
}

.sciTechSelected:hover {
	background: #3333cf;
}

