				<div class="tn-grid">
					<div class="tn-col">
						<div class="tn-panel">
							<div class="tn-panel-title">Linked Bank Account</div>
							<div class="tn-panel-subtitle">Identity credentials used for automated debit and credit settlement.</div>
							<hr class="tn-section-divider">
							<div style="font-size: 11px; line-height: 1.6;">
								<div><span class="tn-panel-label">Account Owner:</span> <strong>{{if data.has_account}}{{>data.account_owner_name}}{{else}}<span class="tn-empty">None</span>{{/if}}</strong></div>
								<div><span class="tn-panel-label">Account Number:</span> <span class="font-mono">#{{:data.account_number}}</span></div>
								<div><span class="tn-panel-label">Current Balance:</span> <strong class="font-mono" style="color: #55cc55;">{{:data.account_money}} {{:data.currency_short}}</strong></div>
								{{if data.has_master_budget}}
									<div><span class="tn-panel-label">Supply Budget:</span> <span class="font-mono">{{:data.master_budget}} {{:data.currency_short}}</span></div>
								{{/if}}
							</div>
							<hr class="tn-section-divider">
							<div class="tn-flex-row-sm" style="flex-wrap: wrap;">
								{{if data.has_account}}
									{{:helper.link('Unlink Account', 'close', {'PRG_account_unlink' : 1}, null, 'tn-btn tn-btn-danger tn-inlineLink')}}
								{{else}}
									{{if data.can_link_id_account}}
										{{:helper.link('Link ID Card Account', 'check', {'PRG_account_id' : 1}, null, 'tn-btn tn-btn-primary tn-inlineLink')}}
									{{/if}}
									{{:helper.link('Link via Account # and PIN', null, {'PRG_account' : 1}, null, 'tn-btn tn-btn-outline tn-inlineLink')}}
								{{/if}}
							</div>
						</div>
					</div>

					<div class="tn-col">
						<div class="tn-panel">
							<div class="tn-panel-title">Trade Beacon Routing</div>
							<div class="tn-panel-subtitle">Configure hardware endpoints for receiving shipments and exporting freight.</div>
							<hr class="tn-section-divider">
							<div style="font-size: 11px; line-height: 1.6;">
								<div style="margin-bottom: 6px;">
									<div class="tn-panel-label">Receiving Beacon (Inbound Cargo):</div>
									<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 3px;">
										<strong>{{if data.has_receiving}}{{>data.receiving}}{{else}}<span class="tn-empty">None Selected</span>{{/if}}</strong>
										{{:helper.link('Select Receiving Beacon', null, {'PRG_receiving' : 1}, null, 'tn-btn tn-btn-outline tn-inlineLink')}}
									</div>
								</div>
								<div>
									<div class="tn-panel-label">Sending Beacon (Outbound Export):</div>
									<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 3px;">
										<strong>{{if data.has_sending}}{{>data.sending}}{{else}}<span class="tn-empty">None Selected</span>{{/if}}</strong>
										{{:helper.link('Select Sending Beacon', null, {'PRG_sending' : 1}, null, 'tn-btn tn-btn-outline tn-inlineLink')}}
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		{{/if}}
	</div>
</div>

<script id="tn-global-cleanup-script">
if (window.jQuery) {
	var $els = $('.tn-wrap .link, .tn-wrap .selected, .tn-wrap .tn-nav-btn, .tn-wrap .tn-btn, .tn-wrap .linkActive');
	if ($els.stopTime) {
		$els.stopTime('linkPending');
	}
	$els.removeClass('linkPending');
}
</script>
