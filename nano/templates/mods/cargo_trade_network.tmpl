<div class="tn-wrap" data-scroll-id="tn-wrap">
	<div class="tn-stack">
		<!-- System Greeting Banner -->
		<div class="tn-sys-banner">
			<div class="tn-sys-banner-title" title="{{>data.user_greeting || 'WELCOME TO TRADE NETWORK'}}">
				{{>data.user_greeting || "WELCOME TO TRADE NETWORK"}}
			</div>
			<div class="tn-sys-banner-ntos">
				AMBER NTOS v4.2 // TRADE TERMINAL
			</div>
		</div>

		<!-- Top Hubs Navigation Bar -->
		<div class="tn-nav-bar">
			<div class="tn-nav-tabs">
				{{:helper.link('Market', 'search', {'PRG_trade_screen' : 'goods'}, data.screen == 'goods' ? 'selected' : null, 'tn-nav-btn')}}
				{{:helper.link('Cart' + (data.cart_count ? ' <span class="tn-nav-badge">' + data.cart_count + '</span>' : ''), 'cart', {'PRG_trade_screen' : 'cart'}, data.screen == 'cart' ? 'selected' : null, 'tn-nav-btn')}}
				{{:helper.link('Orders' + (data.order_count ? ' <span class="tn-nav-badge">' + data.order_count + '</span>' : ''), 'tag', {'PRG_trade_screen' : 'orders'}, data.screen == 'orders' ? 'selected' : null, 'tn-nav-btn')}}
				{{:helper.link('Contracts' + ((data.available_contract_count || data.active_contract_count) ? ' <span class="tn-nav-badge">' + (data.available_contract_count + data.active_contract_count) + '</span>' : ''), 'clipboard', {'PRG_trade_screen' : 'contracts'}, data.screen == 'contracts' ? 'selected' : null, 'tn-nav-btn')}}
				{{:helper.link('Export', 'refresh', {'PRG_trade_screen' : 'export'}, data.screen == 'export' ? 'selected' : null, 'tn-nav-btn')}}
				{{:helper.link('Logs', 'document', {'PRG_trade_screen' : 'logs'}, data.screen == 'logs' ? 'selected' : null, 'tn-nav-btn')}}
			</div>
			<div class="tn-nav-actions">
				{{:helper.link('Settings', 'gear', {'PRG_trade_screen' : 'settings'}, data.screen == 'settings' ? 'selected' : null, 'tn-nav-btn')}}
			</div>
		</div>

		<!-- =================================================================== -->
		<!-- ADAPTIVE WORKSPACE HEADER / BASKET STATUS                           -->
		<!-- =================================================================== -->
		{{if data.screen == 'goods'}}
			{{if data.cart_count <= 0}}
				<!-- Ultra-Compact Single-Line Ticker when Cart is Empty -->
				<div class="tn-cart-ticker">
					<div class="tn-ticker-items">
						<span class="tn-ticker-tag">[BASKET: EMPTY]</span>
						<span class="tn-ticker-sep">|</span>
						<span class="tn-ticker-lbl">ACCOUNT:</span>
						<span class="tn-ticker-val">
							{{if data.has_account}}
								{{>data.account_owner_name}} #{{:data.account_number}} (<span class="font-mono" style="color:#55cc55;">{{:data.account_money}} {{:data.currency_short}}</span>)
							{{else}}
								<span class="tn-empty">None Linked</span>
							{{/if}}
						</span>
						<span class="tn-ticker-sep">|</span>
						<span class="tn-ticker-lbl">BEACON:</span>
						<span class="tn-ticker-val">
							{{if data.has_receiving}}
								{{>data.receiving}}
							{{else}}
								<span class="tn-empty">None Selected</span>
							{{/if}}
						</span>
						<span class="tn-ticker-sep">|</span>
						<span class="tn-ticker-lbl">STATUS:</span>
						<span class="tn-ticker-val tn-muted">
							{{if !data.has_account}}Link account in Settings or Cart{{else !data.has_receiving}}Select receiving beacon{{else}}Catalog Ready{{/if}}
						</span>
					</div>
					<div>
						{{:helper.link('View Cart', 'cart', {'PRG_trade_screen' : 'cart'}, null, 'tn-btn tn-btn-outline tn-inlineLink')}}
					</div>
				</div>
			{{else}}
				<!-- Expanded Operational Basket Header when Cart has Items -->
				<div class="tn-workspace-header tn-cart-active-header">
					<div class="tn-basket-summary-row">
						<div class="tn-basket-lead">
							<span class="tn-basket-status-badge font-mono">[BASKET: {{:data.cart_count}} ITEMS]</span>
							<span class="tn-basket-total font-mono">{{:data.cart_total}} {{:data.currency_short}}</span>
							{{if data.cart_fee > 0}}
								<span class="tn-basket-fee font-mono">(Fee: {{:data.cart_fee}} {{:data.currency_short}})</span>
							{{/if}}
						</div>
						<div class="tn-basket-quick-meta">
							<span>
								<strong class="font-mono" style="color: #ff9900;">ACC:</strong>
								{{if data.has_account}}#{{:data.account_number}} (<span class="font-mono">{{:data.account_money}} {{:data.currency_short}}</span>){{else}}<span class="tn-empty">NO ACCT</span>{{/if}}
							</span>
							<span>
								<strong class="font-mono" style="color: #ff9900;">BCN:</strong>
								{{if data.has_receiving}}{{>data.receiving}}{{else}}<span class="tn-empty">NO BEACON</span>{{/if}}
							</span>
							{{if data.cart_trade_block_reason}}
								<span style="color: #ff7777;">[{{>data.cart_trade_block_reason}}]</span>
							{{/if}}
						</div>
						<div class="tn-basket-actions">
							{{:helper.link('Purchase to Beacon', 'check', {'PRG_receive' : 1}, data.can_purchase_cart ? null : 'disabled', 'tn-btn tn-btn-primary tn-inlineLink')}}
							{{:helper.link('Submit Requisition', 'clipboard', {'PRG_cart_form' : 'order'}, data.can_build_order ? null : 'disabled', 'tn-btn tn-btn-outline tn-inlineLink')}}
							{{:helper.link('Details', 'cart', {'PRG_trade_screen' : 'cart'}, null, 'tn-btn tn-btn-outline tn-inlineLink')}}
							{{:helper.link('Clear', 'close', {'PRG_cart_reset' : 1}, null, 'tn-btn tn-btn-danger tn-inlineLink')}}
						</div>
					</div>

					{{if data.cart_form_mode == 'order'}}
						<div class="tn-form-shell">
							<form class="tn-form" method="get" action="?src={{:data.src}}" onsubmit="if(!this.PRG_order_reason.value || !this.PRG_order_reason.value.trim()) { alert('Order reason is mandatory.'); return false; }">
								<input type="hidden" name="src" value="{{:data.src}}">
								<input type="hidden" name="PRG_build_order_form" value="1">
								<div class="tn-panel-label" style="width: 100%;">Order Justification / Reason (Required):</div>
								<textarea name="PRG_order_reason" required placeholder="State department, project requirements, or justification..."></textarea>
								<div class="tn-flex-row-sm" style="width: 100%; margin-top: 4px;">
									<input type="submit" value="Submit Order Request" class="tn-btn tn-btn-primary">
									{{:helper.link('Cancel', null, {'PRG_cart_form_cancel' : 1}, null, 'tn-btn tn-btn-outline tn-inlineLink')}}
								</div>
							</form>
						</div>
					{{/if}}
				</div>
			{{/if}}

		{{else data.screen == 'orders'}}
			<div class="tn-workspace-header">
				<div class="tn-panel-header" style="margin-bottom: 0;">
					<div>
						<div class="tn-panel-title">Crew Supply Queue</div>
						<div class="tn-panel-subtitle">Review incoming supply requests from station departments.</div>
					</div>
					<div class="tn-flex-row-lg">
						<div>
							<span class="tn-panel-label">Pending:</span>
							<strong class="font-mono" style="color: #ffaa22; font-size: 13px; margin-left: 4px;">{{:data.order_count}}</strong>
						</div>
						<div>
							<span class="tn-panel-label">Volume:</span>
							<strong class="font-mono" style="color: #55cc55; font-size: 13px; margin-left: 4px;">{{:data.pending_orders_total}} {{:data.currency_short}}</strong>
						</div>
						<div>
							{{:helper.link('Receiving Beacon', null, {'PRG_receiving' : 1}, null, 'tn-btn tn-btn-outline tn-inlineLink')}}
