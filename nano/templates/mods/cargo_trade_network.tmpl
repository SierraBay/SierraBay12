	.tn-wrap .tn-contract-money strong { color: #e8e2d6; }
	.tn-wrap .tn-contract-money .font-mono { white-space: nowrap; }
	.tn-wrap .tn-contract-next { padding-top: 4px; }
	.tn-wrap .tn-contract-details { margin-top: 8px; padding-top: 8px; border-top: 1px solid #3a3529; }
