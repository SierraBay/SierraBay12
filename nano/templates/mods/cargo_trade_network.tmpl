<style>
	html, body {
		background-color: #090b0e;
		color: #ffaa22;
		font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", Arial, sans-serif;
		overflow-y: scroll;
		margin: 0;
		padding: 0;
	}

	::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}
	::-webkit-scrollbar-track {
		background: #0d0f14;
	}
	::-webkit-scrollbar-thumb {
		background: #332200;
		border-radius: 0;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #553800;
	}

	.font-mono {
		font-family: Consolas, "Lucida Console", Monaco, "Courier New", monospace !important;
		font-variant-numeric: tabular-nums;
	}

	.tn-wrap {
		padding: 6px 8px;
		background: #090b0e;
		color: #ffaa22;
		min-height: 100%;
		box-sizing: border-box;
	}

	.tn-screen-view {
		min-height: 520px;
	}

	.tn-stack > * + * {
		margin-top: 6px;
	}

	/* Top System Banner */
	.tn-sys-banner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 4px 8px;
		background: #0f1217;
		border: 1px solid #332200;
		color: #ff9900;
		font-family: Consolas, "Lucida Console", monospace;
		font-size: 11px;
		font-weight: bold;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.tn-sys-banner-title {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.tn-sys-banner-ntos {
		color: #8c602a;
		font-size: 10px;
		letter-spacing: 0.12em;
		white-space: nowrap;
		margin-left: 12px;
	}

	/* Primary Navigation Bar */
	.tn-nav-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		padding: 4px 6px;
		background: #111419;
		border: 1px solid #332200;
	}

	.tn-nav-tabs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
	}

	.tn-nav-tabs > * + * {
		margin-left: 4px;
	}

	.tn-nav-btn {
		display: inline-flex;
		align-items: center;
		padding: 4px 10px;
		background: #14171f;
		border: 1px solid #2a1c08;
		border-radius: 0;
		color: #a67030 !important;
		font-family: Consolas, monospace;
		font-size: 11px;
		font-weight: bold;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		text-decoration: none;
		cursor: pointer;
		transition: all 0.1s ease;
		float: none !important;
		height: auto !important;
		min-height: 0 !important;
		box-sizing: border-box !important;
	}

	.tn-nav-btn .uiIcon16 {
		margin-right: 4px;
	}

	.tn-nav-btn:hover {
		background: #1d212b;
		color: #ffaa22 !important;
		border-color: #553800;
	}

	.tn-nav-btn.selected {
		background: #ff9900 !important;
		color: #090b0e !important;
		border-color: #ffaa22 !important;
		box-shadow: none !important;
		float: none !important;
		height: auto !important;
	}

	.tn-nav-btn.selected .tn-nav-badge {
		background: #090b0e;
		color: #ff9900;
		border-color: #090b0e;
	}

	.tn-nav-badge {
		display: inline-block;
		padding: 0 4px;
		margin-left: 4px;
		border-radius: 0;
		font-size: 10px;
		line-height: 1.2;
		background: #1b1408;
		border: 1px solid #442d08;
		color: #ffaa22;
		font-family: Consolas, monospace;
	}

	/* Compact Cart Ticker (Empty Basket) */
	.tn-cart-ticker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		padding: 4px 8px;
		background: #101318;
		border: 1px solid #332200;
		font-size: 11px;
	}

	.tn-ticker-items {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
	}

	.tn-ticker-items > * + * {
		margin-left: 8px;
	}

	.tn-ticker-tag {
		font-family: Consolas, monospace;
		font-weight: bold;
		font-size: 11px;
		color: #8c602a;
		background: #141109;
		border: 1px solid #2a1c08;
		padding: 1px 5px;
	}

	.tn-ticker-sep {
		color: #332200;
	}

	.tn-ticker-lbl {
		font-family: Consolas, monospace;
		font-size: 10px;
		color: #8c602a;
		font-weight: bold;
		text-transform: uppercase;
		margin-right: 4px;
	}

	.tn-ticker-val {
		color: #ffaa22;
	}

	/* Expanded Active Basket Header */
	.tn-cart-active-header {
		padding: 6px 10px;
		background: #111419;
		border: 1px solid #443010;
	}

	.tn-basket-summary-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
	}

	.tn-basket-lead {
		display: flex;
		align-items: center;
	}

	.tn-basket-lead > * + * {
		margin-left: 8px;
	}

	.tn-basket-status-badge {
		background: #1c1408;
		border: 1px solid #ff9900;
		color: #ff9900;
		font-size: 11px;
		font-weight: bold;
		padding: 2px 6px;
	}

	.tn-basket-total {
		font-size: 13px;
		font-weight: bold;
		color: #55cc55;
	}

	.tn-basket-fee {
		font-size: 10px;
		color: #8c602a;
	}

	.tn-basket-quick-meta {
		display: flex;
		flex-wrap: wrap;
		font-size: 11px;
		color: #a67030;
	}

	.tn-basket-quick-meta > * + * {
		margin-left: 12px;
	}

	.tn-basket-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
	}

	.tn-basket-actions > * + * {
		margin-left: 4px;
	}

	/* Dynamic Workspace Headers for other screens */
	.tn-workspace-header {
		padding: 6px 10px;
		background: #111419;
		border: 1px solid #332200;
	}

	/* General Industrial Action Buttons */
	.tn-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 3px 8px;
		border-radius: 0 !important;
		font-family: Consolas, monospace;
		font-size: 11px;
		font-weight: bold;
		text-transform: uppercase;
		text-decoration: none;
		cursor: pointer;
		user-select: none;
		box-sizing: border-box;
		line-height: 1.3;
		transition: all 0.1s ease;
		float: none !important;
		height: auto !important;
	}

	.tn-btn .uiIcon16 {
		margin-right: 4px;
	}

	.tn-btn + .tn-btn {
		margin-left: 4px;
	}

	.tn-btn-primary {
		background: #ff9900;
		color: #090b0e !important;
		border: 1px solid #ffaa22;
	}
	.tn-btn-primary:hover {
		background: #ffaa22;
		color: #000000 !important;
	}

	.tn-btn-outline {
		background: #13171e;
		color: #ffaa22 !important;
		border: 1px solid #3d2808;
	}
	.tn-btn-outline:hover {
		background: #1c212b;
		border-color: #ffaa22;
	}

	.tn-btn-danger {
		background: #1e1010;
		color: #ff7777 !important;
		border: 1px solid #551c1c;
	}
	.tn-btn-danger:hover {
		background: #2b1414;
		border-color: #ff5555;
	}

	.tn-btn-disabled,
	.link.disabled,
	.tn-btn.disabled {
		background: #111317 !important;
		color: #4a3820 !important;
		border: 1px solid #221a10 !important;
		cursor: not-allowed !important;
		pointer-events: none;
	}

	/* Layout Grids and Panels */
	.tn-grid {
		display: flex;
		flex-wrap: wrap;
		margin: -3px;
	}

	.tn-col {
		flex: 1 1 320px;
		min-width: 280px;
		margin: 3px;
		box-sizing: border-box;
	}

	.tn-panel {
		padding: 8px 10px;
		background: #111419;
		border: 1px solid #332200;
		border-radius: 0;
	}

	.tn-panel + .tn-panel {
		margin-top: 6px;
	}

	.tn-panel-header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 6px;
	}

	.tn-panel-title {
		font-family: Consolas, monospace;
		font-size: 12px;
		font-weight: bold;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #ff9900;
	}

	.tn-panel-subtitle {
		font-size: 11px;
		color: #8c602a;
		margin-top: 2px;
	}

	.tn-panel-label {
		font-family: Consolas, monospace;
		font-size: 10px;
		font-weight: bold;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #8c602a;
	}

	.tn-empty-panel {
		padding: 16px;
		border: 1px dashed #332200;
		background: #0f1217;
		border-radius: 0;
		text-align: center;
	}

	.tn-empty {
		color: #664411;
		font-style: italic;
	}

	.tn-muted {
		color: #8c602a;
	}

	.tn-subtle {
		color: #664411;
	}

	/* Status Indicators & Tags (Diegetic Amber NTOS) */
	.tn-status-dot {
		display: inline-block;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		vertical-align: middle;
		margin-right: 4px;
	}

	.tn-dot-good {
		background: #55cc55;
		box-shadow: 0 0 4px #55cc55;
	}

	.tn-dot-average {
		background: #ffaa22;
		box-shadow: 0 0 4px #ffaa22;
	}

	.tn-dot-bad {
		background: #ff4444;
		box-shadow: 0 0 4px #ff4444;
	}

	.tn-tag {
		display: inline-block;
		font-family: Consolas, monospace;
		font-size: 10px;
		font-weight: bold;
		padding: 1px 4px;
		border-radius: 0;
		line-height: 1.2;
		white-space: nowrap;
		background: #13171e;
		border: 1px solid #2a1c08;
		color: #ffaa22;
	}

	.tn-tag-good {
		background: #0e1a10;
		color: #55cc55;
		border-color: #225522;
	}

	.tn-tag-average {
		background: #1a1408;
		color: #ffaa22;
		border-color: #443010;
	}

	.tn-tag-bad {
		background: #1c0e0e;
		color: #ff7777;
		border-color: #551c1c;
	}

	.tn-tag-disabled {
		background: #111317;
		color: #554425;
		border-color: #221808;
	}

	.notice {
		padding: 6px 10px;
		border-radius: 0;
		font-size: 11px;
		margin-top: 4px;
		margin-bottom: 4px;
	}

	.notice.good {
		background: #0e1a10;
		color: #55cc55;
		border: 1px solid #225522;
	}

	.notice.average {
		background: #1a1408;
		color: #ffaa22;
		border: 1px solid #443010;
	}

	.notice.bad {
		background: #1c0e0e;
		color: #ff7777;
		border: 1px solid #551c1c;
	}

	.tn-section-divider {
		margin: 6px 0;
		border: 0;
		border-top: 1px solid #221608;
	}

	/* Forms & Inputs */
	.tn-form-shell {
		padding: 6px 8px;
		border: 1px solid #332200;
		background: #0f1217;
		border-radius: 0;
		margin-top: 6px;
	}

	.tn-form {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
	}

	.tn-form > * + * {
		margin-left: 4px;
	}

	.tn-form textarea,
	.tn-form input[type='text'],
	.tn-form input[type='number'] {
		background: #07080a;
		color: #ffaa22;
		border: 1px solid #3d2808;
		padding: 3px 5px;
		box-sizing: border-box;
		border-radius: 0;
		font-family: Consolas, monospace;
		font-size: 11px;
	}

	.tn-form textarea:focus,
	.tn-form input[type='text']:focus,
	.tn-form input[type='number']:focus {
		border-color: #ff9900;
		outline: none;
	}

	.tn-form textarea {
		width: 100%;
		min-height: 48px;
		resize: vertical;
	}

	.tn-form input[type='submit'] {
		background: #ff9900;
		color: #090b0e;
		border: 1px solid #ffaa22;
		border-radius: 0;
		padding: 3px 8px;
		font-family: Consolas, monospace;
		font-weight: bold;
		cursor: pointer;
		font-size: 11px;
	}

	.tn-form input[type='submit']:hover {
		background: #ffaa22;
	}

	.tn-form input[type='submit']:disabled,
	.tn-form input[type='submit'].disabled {
		background: #14171f;
		color: #4a3820;
		border-color: #221a10;
		cursor: not-allowed;
	}

	/* Market Sidebar Styles */
	.tn-market-sidebar {
		flex: 0 0 210px !important;
		max-width: 220px !important;
		min-width: 190px !important;
	}

	.tn-market-main {
		flex: 1 1 520px !important;
		min-width: 320px !important;
	}

	.tn-station-select-wrap {
		position: relative;
		width: 100%;
	}

	.tn-station-select {
		width: 100%;
		height: 26px;
		background: #07080a;
		color: #ffaa22;
		border: 1px solid #332200;
		border-radius: 0;
		padding: 2px 6px;
		font-family: Consolas, monospace;
		font-size: 11px;
		font-weight: bold;
		cursor: pointer;
		box-sizing: border-box;
		text-overflow: ellipsis;
	}

	.tn-station-select:focus {
		border-color: #ff9900;
		outline: none;
	}

	.tn-station-select option {
		background: #111419;
		color: #ffaa22;
		padding: 3px 5px;
	}

	.tn-wrap .tn-station-card {
		display: block !important;
		float: none !important;
		clear: both !important;
		width: 100% !important;
		height: auto !important;
		box-sizing: border-box !important;
		padding: 5px 6px !important;
		border: 1px solid #2a1c08 !important;
		background: #13171f !important;
		border-radius: 0 !important;
		margin-top: 4px !important;
		text-align: left !important;
	}

	.tn-station-name {
		font-weight: bold;
		font-size: 11px;
		color: #ffaa22;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tn-station-meta-row {
		margin-top: 3px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		font-size: 10px;
	}

	.tn-station-meta-row > * + * {
		margin-left: 4px;
	}

	.tn-station-faction {
		font-family: Consolas, monospace;
		font-size: 10px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tn-wrap .tn-category-vertical-list {
		display: block;
		width: 100%;
		max-height: 440px;
		overflow-y: auto;
		overflow-x: hidden;
		box-sizing: border-box;
	}

	.tn-wrap .tn-category-item,
	.tn-wrap .link.tn-category-item,
	.tn-wrap .linkActive.tn-category-item,
	.tn-wrap .selected.tn-category-item {
		display: block !important;
		float: none !important;
		clear: both !important;
		width: 100% !important;
		height: auto !important;
		min-height: 24px !important;
		line-height: 18px !important;
		padding: 3px 8px !important;
		margin: 0 0 2px 0 !important;
		border-radius: 0 !important;
		background: #12151b !important;
		border: 1px solid #261b0a !important;
		border-left: 3px solid transparent !important;
		color: #8c602a !important;
		text-align: left !important;
		white-space: normal !important;
		word-break: break-word !important;
		text-decoration: none !important;
		font-family: Consolas, monospace !important;
		font-size: 11px !important;
		font-weight: bold !important;
		cursor: pointer !important;
		box-sizing: border-box !important;
		transition: background 0.1s ease, color 0.1s ease, border-color 0.1s ease;
	}

	.tn-wrap .tn-category-item .uiIcon16 {
		float: left;
		margin-right: 6px;
		margin-top: 1px;
	}

	.tn-wrap .tn-category-item:hover,
	.tn-wrap .linkActive.tn-category-item:hover {
		background: #1a1e27 !important;
		color: #ffaa22 !important;
		border-color: #443010 !important;
		border-left-color: #ffaa22 !important;
	}

	.tn-wrap .tn-category-item.selected,
	.tn-wrap .link.tn-category-item.selected,
	.tn-wrap .tn-category-item.tn-selected {
		background: #1f190a !important;
		border: 1px solid #443010 !important;
		border-left: 3px solid #ff9900 !important;
		color: #ff9900 !important;
		cursor: default !important;
		box-shadow: inset 1px 0 0 rgba(255, 153, 0, 0.2) !important;
	}

	/* Catalog Header Bar: Live Search & Sort */
	.tn-catalog-header-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		padding: 4px 8px;
		background: #111419;
		border: 1px solid #332200;
		margin-bottom: 6px;
	}

	.tn-catalog-title {
		font-family: Consolas, monospace;
		font-size: 12px;
		font-weight: bold;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: #ff9900;
	}

	.tn-filter-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
	}

	.tn-filter-controls > * + * {
		margin-left: 6px;
	}

	.tn-search-box {
		position: relative;
		display: flex;
		align-items: center;
		min-width: 150px;
	}

	.tn-search-icon {
		position: absolute;
		left: 6px;
		font-size: 10px;
		color: #664411;
		pointer-events: none;
	}

	.tn-search-input {
		width: 100%;
		height: 24px;
		padding: 2px 20px 2px 20px;
		background: #07080a;
		color: #ffaa22;
		border: 1px solid #332200;
		border-radius: 0;
		font-size: 11px;
		box-sizing: border-box;
	}

	.tn-search-input:focus {
		border-color: #ff9900;
		outline: none;
	}

	.tn-search-input::placeholder {
		color: #664411;
		font-style: italic;
	}

	.tn-search-clear {
		position: absolute;
		right: 4px;
		background: transparent;
		border: none;
		color: #664411;
		cursor: pointer;
		font-size: 11px;
		padding: 1px;
		line-height: 1;
	}

	.tn-search-clear:hover {
		color: #ff7777;
	}

	.tn-sort-select {
		height: 24px;
		background: #07080a;
		color: #ffaa22;
		border: 1px solid #332200;
		border-radius: 0;
		padding: 1px 4px;
		font-family: Consolas, monospace;
		font-size: 11px;
		cursor: pointer;
	}

	.tn-sort-select:focus {
		border-color: #ff9900;
		outline: none;
	}

	.tn-cards-counter {
		font-size: 11px;
		color: #8c602a;
		white-space: nowrap;
	}

	/* High-Density Catalog Data Table */
	.tn-catalog-table {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed;
		background: #0c0e12;
		border: 1px solid #332200;
	}

	.tn-catalog-table th {
		background: #141820;
		color: #ff9900;
		font-family: Consolas, monospace;
		font-size: 10px;
		font-weight: bold;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 5px 6px;
		border-bottom: 1px solid #ff9900;
		text-align: left;
		vertical-align: middle;
	}

	.tn-catalog-table th.tn-th-right {
		text-align: right;
	}

	.tn-catalog-table th.tn-th-center {
		text-align: center;
	}

	.tn-catalog-table td {
		padding: 3px 6px;
		border-bottom: 1px solid #1a140a;
		vertical-align: middle;
		font-size: 11px;
	}

	.tn-good-row:nth-child(even) td {
		background: rgba(255, 153, 0, 0.012);
	}

	.tn-good-row:hover td {
		background: #1c1a14;
		border-bottom-color: #3d2b10;
	}

	.tn-good-row.tn-restricted td {
		opacity: 0.55;
		background: #111317;
	}

	/* Fixed 32x32 crisp sprite display container */
	.tn-sprite-box {
		width: 32px;
		height: 32px;
		background: #07080a;
		border: 1px solid #2a1c08;
