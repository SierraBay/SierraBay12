{{var uiSrc = $('body').data('urlParameters').src;}}
{{var formatTradeAmount = function(value) { var amount = Math.round((Number(value) || 0) * 100) / 100; var parts = amount.toFixed(amount % 1 ? 2 : 0).split('.'); parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ','); return parts.join('.'); };}}
{{##def.contract_row:
	<div class="tn-contract-row" data-key="{{:contractActive ? 'active-' : 'offer-'}}{{:contract_entry.id}}" data-index="{{:contract_index}}" data-type="{{>contract_entry.type_label}}" data-ready="{{:contract_entry.can_act ? 1 : 0}}" data-reward="{{:contract_entry.reward}}" data-deposit="{{:contract_entry.deposit}}" data-distance="{{:contract_entry.distance}}" data-search="{{>contract_entry.serial + ' ' + contract_entry.type_label + ' ' + contract_entry.source_name + ' ' + contract_entry.destination_name + ' ' + contract_entry.cargo}}">
		<div class="tn-contract-heading">
			<div class="tn-contract-identity">
				<span class="font-mono tn-muted">#{{>contract_entry.serial}}</span>
				<span class="tn-muted">{{>contract_entry.type_label}}</span>
				{{if contractActive}}<span class="tn-tag tn-tag-{{:contract_entry.status_tone}}">{{>contract_entry.status}}</span>{{/if}}
			</div>
			<button type="button" class="tn-contract-toggle" aria-label="Details for #{{>contract_entry.serial}}" aria-expanded="false" aria-controls="tn-contract-details-{{:contractActive ? 'active-' : 'offer-'}}{{:contract_entry.id}}" onclick="window.cargoToggleContractDetails &amp;&amp; window.cargoToggleContractDetails(this)"><span class="tn-contract-marker" aria-hidden="true">+</span> Details</button>
		</div>
		<div class="tn-contract-route">{{>contract_entry.source_name}} &rarr; {{>contract_entry.destination_name}}</div>
		<div class="tn-contract-cargo">{{>contract_entry.cargo}}</div>
		{{if contractActive}}
			<div class="tn-contract-next"><span class="tn-panel-label">Next step:</span> {{>contract_entry.instruction_text || contract_entry.action_hint}}</div>
		{{/if}}
		<div id="tn-contract-details-{{:contractActive ? 'active-' : 'offer-'}}{{:contract_entry.id}}" class="tn-contract-details tn-hidden">
			{{if !contractActive}}<p>{{>contract_entry.instruction_text}}</p>{{/if}}
			{{if contract_entry.action_hint && contract_entry.action_hint != contract_entry.instruction_text}}<p class="tn-muted">{{>contract_entry.action_hint}}</p>{{/if}}
			<div class="tn-labeled-row"><span>Cargo value</span><span class="font-mono">{{>formatTradeAmount(contract_entry.base_value)}} {{>data.currency_short}}</span></div>
			<div class="tn-labeled-row"><span>Distance</span><span class="font-mono">{{:contract_entry.distance}}</span></div>
			{{if contractActive && contract_entry.accepted_by}}<div class="tn-labeled-row"><span>Accepted by</span><span>{{>contract_entry.accepted_by}}</span></div>{{/if}}
			{{if contract_entry.deposit > 0}}<p class="tn-contract-terms">The deposit is debited on acceptance and returned after successful completion.</p>{{/if}}
		</div>
		<div class="tn-contract-footer">
			<div class="tn-contract-money">
				<span>Reward <strong class="font-mono">{{>formatTradeAmount(contract_entry.reward)}} {{>data.currency_short}}</strong></span>
				<span>{{if contractActive}}Deposit{{else}}Deposit now{{/if}} <span class="font-mono">{{>formatTradeAmount(contract_entry.deposit)}} {{>data.currency_short}}</span></span>
				<span>Penalty <span class="font-mono{{if contract_entry.penalty > 0}} tn-bad{{/if}}">{{>formatTradeAmount(contract_entry.penalty)}} {{>data.currency_short}}</span></span>
			</div>
			<div class="tn-contract-action">
				{{if contract_entry.block_reason}}
					<div class="tn-contract-feedback tn-bad">{{>contract_entry.block_reason}}</div>
				{{else contract_entry.status_text && contract_entry.status_text != contract_entry.status && contract_entry.status_text != contract_entry.instruction_text}}
					<div class="tn-contract-feedback">{{>contract_entry.status_text}}</div>
				{{/if}}
				{{if contractActive}}
					{{:helper.link(contract_entry.action_label || 'Deliver', 'check', {'PRG_contract_deliver' : contract_entry.id}, contract_entry.can_act ? null : 'disabled', 'tn-btn tn-btn-primary')}}
				{{else}}
					{{:helper.link('Accept', 'check', {'PRG_contract_accept' : contract_entry.id}, contract_entry.can_act ? null : 'disabled', 'tn-btn tn-btn-primary')}}
				{{/if}}
			</div>
		</div>
	</div>
#}}
{{##def.contract_history_row:
	<div class="tn-contract-history-row" data-key="history-{{:contract_entry.id}}" data-outcome="{{:historyOutcome}}">
		<div class="tn-contract-heading">
			<div class="tn-contract-identity"><span class="font-mono tn-muted">#{{>contract_entry.serial}}</span><span class="tn-muted">{{>contract_entry.type_label}}</span></div>
			<span class="tn-tag tn-tag-{{:contract_entry.status_tone}}">{{>contract_entry.status}}</span>
		</div>
		<div class="tn-contract-route">{{>contract_entry.source_name}} &rarr; {{>contract_entry.destination_name}}</div>
		{{if contract_entry.accepted_by}}<div class="tn-muted">Accepted by {{>contract_entry.accepted_by}}</div>{{/if}}
		<div class="tn-contract-resolution{{if historyOutcome == 'failed'}} tn-bad{{/if}}">{{>contract_entry.resolved_note}}</div>
	</div>
#}}
