																	{{/if}}

																	<!-- Exact Quantity Toggle Button -->
																	{{:helper.link('Qty', null, {'PRG_goods_quantity_target' : good_entry.id}, null, 'tn-btn tn-btn-outline tn-inlineLink')}}
																</div>

																{{if good_entry.quantity_form_open}}
																	<div class="tn-popover-form">
																		<form class="tn-form" method="get" action="?src={{:data.src}}" onsubmit="var fld=(this.elements &amp;&amp; this.elements['PRG_cart_set_amount']) ? this.elements['PRG_cart_set_amount'] : this.PRG_cart_set_amount; var amt = parseInt(fld ? fld.value : 0, 10); if(isNaN(amt) || amt &lt; 0) { alert('Enter a valid amount.'); return false; } var maxAmt = parseInt(fld ? fld.getAttribute('max') : 0, 10); if(maxAmt &gt; 0 &amp;&amp; amt &gt; maxAmt) { alert('Cannot order more than available stock (' + maxAmt + ').'); return false; }">
																			<input type="hidden" name="src" value="{{:data.src}}">
																			<input type="hidden" name="PRG_cart_set_form" value="{{:good_entry.id}}">
