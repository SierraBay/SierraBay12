							</div>
						{{/if}}
					</div>
				</div>
			</div>

			<!-- Instant Search & Sorting Client-Side Script -->
			<script id="cargo-market-script">
			window.cargoLiveFilter = function() {
				var searchInput = document.getElementById('cargo-search-input');
				var rawQuery = searchInput ? searchInput.value.toLowerCase().replace(/^\s+|\s+$/g, '') : '';
				var filterTokens = rawQuery ? rawQuery.split(/\s+/) : [];
				var tbody = document.getElementById('cargo-goods-tbody');
				if (!tbody) return;
				var rows = [];
				if (window.jQuery) {
					rows = $(tbody).find('.tn-good-row').get();
				} else if (tbody.querySelectorAll) {
					var nodeList = tbody.querySelectorAll('.tn-good-row');
					for (var k = 0; k < nodeList.length; k++) rows.push(nodeList[k]);
				}
				var visibleCount = 0;
				for (var i = 0; i < rows.length; i++) {
					var row = rows[i];
					var name = row.getAttribute('data-name') || '';
					if (!name) {
						var nameEl = row.querySelector ? row.querySelector('.tn-item-title') : (window.jQuery ? $(row).find('.tn-item-title')[0] : null);
						name = nameEl ? (nameEl.textContent || nameEl.innerText || '') : '';
					}
					name = name.toLowerCase();
					var match = true;
					for (var t = 0; t < filterTokens.length; t++) {
						if (name.indexOf(filterTokens[t]) === -1) {
							match = false;
							break;
						}
					}
					if (match) {
						row.style.display = '';
						visibleCount++;
					} else {
						row.style.display = 'none';
					}
				}
				var noResults = document.getElementById('cargo-search-no-results');
				if (noResults) {
					noResults.style.display = (visibleCount === 0 && rows.length > 0) ? 'block' : 'none';
				}
				var counter = document.getElementById('cargo-cards-counter');
				if (counter) {
					counter.innerHTML = visibleCount + (rawQuery ? ' / ' + rows.length : '') + ' items';
				}
				window._cargoSearchQuery = rawQuery;
			};

			window.cargoLiveSort = function() {
				var sortSelect = document.getElementById('cargo-sort-select');
				var sortVal = sortSelect ? sortSelect.value : 'default';
				var tbody = document.getElementById('cargo-goods-tbody');
				if (!tbody) return;
				var rows = [];
				if (window.jQuery) {
					rows = $(tbody).find('.tn-good-row').get();
				} else if (tbody.querySelectorAll) {
					var nodeList = tbody.querySelectorAll('.tn-good-row');
					for (var k = 0; k < nodeList.length; k++) rows.push(nodeList[k]);
				}
				if (!rows.length) return;

				rows.sort(function(a, b) {
					if (sortVal === 'price_asc') {
						return (parseFloat(a.getAttribute('data-price')) || 0) - (parseFloat(b.getAttribute('data-price')) || 0);
					} else if (sortVal === 'price_desc') {
						return (parseFloat(b.getAttribute('data-price')) || 0) - (parseFloat(a.getAttribute('data-price')) || 0);
					} else if (sortVal === 'name_asc' || sortVal === 'name_desc') {
						var nameA = (a.getAttribute('data-name') || '').toLowerCase();
						var nameB = (b.getAttribute('data-name') || '').toLowerCase();
						var cmp = nameA.localeCompare ? nameA.localeCompare(nameB) : (nameA < nameB ? -1 : (nameA > nameB ? 1 : 0));
						return sortVal === 'name_asc' ? cmp : -cmp;
					} else {
						return (parseInt(a.getAttribute('data-index'), 10) || 0) - (parseInt(b.getAttribute('data-index'), 10) || 0);
					}
				});

				for (var i = 0; i < rows.length; i++) {
					tbody.appendChild(rows[i]);
				}
				window._cargoSortVal = sortVal;
			};

			window.cargoApplyFilterAndSort = function() {
				var tbody = document.getElementById('cargo-goods-tbody');
				if (!tbody) return;

				var catEl = document.getElementById('cargo-current-category');
				var currentCatKey = catEl ? ((catEl.getAttribute('data-station') || '') + '::' + (catEl.getAttribute('data-cat') || '')) : '';
				if (window._cargoLastCategoryKey !== undefined && window._cargoLastCategoryKey !== currentCatKey) {
					window._cargoSearchQuery = '';
					var searchInput = document.getElementById('cargo-search-input');
					if (searchInput) searchInput.value = '';
				}
				window._cargoLastCategoryKey = currentCatKey;

				var searchInput = document.getElementById('cargo-search-input');
				if (searchInput && window._cargoSearchQuery !== undefined && window._cargoSearchQuery !== '') {
					searchInput.value = window._cargoSearchQuery;
				}
				var sortSelect = document.getElementById('cargo-sort-select');
				if (sortSelect && window._cargoSortVal !== undefined) {
					sortSelect.value = window._cargoSortVal;
				}
				if (window.cargoLiveSort) window.cargoLiveSort();
				if (window.cargoLiveFilter) window.cargoLiveFilter();
			};

			if (window.NanoStateManager && window.NanoStateManager.addAfterUpdateCallback) {
				window.NanoStateManager.addAfterUpdateCallback('cargo_trade_market', function(data) {
					if (window.cargoApplyFilterAndSort) {
						window.cargoApplyFilterAndSort();
					}
					return data;
				});
			}

			if (window.cargoApplyFilterAndSort) {
				window.cargoApplyFilterAndSort();
			}
			</script>
			<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" style="display:none;" onload="var s = document.getElementById('cargo-market-script'); if(s &amp;&amp; !window.cargoLiveFilter) { try { (window.execScript || function(c){ window.eval(c); })(s.innerHTML); } catch(e){} } else if(window.cargoApplyFilterAndSort) { window.cargoApplyFilterAndSort(); }" onerror="var s = document.getElementById('cargo-market-script'); if(s &amp;&amp; !window.cargoLiveFilter) { try { (window.execScript || function(c){ window.eval(c); })(s.innerHTML); } catch(e){} } else if(window.cargoApplyFilterAndSort) { window.cargoApplyFilterAndSort(); }">

		<!-- =================================================================== -->
		<!-- TAB 2: ORDERS QUEUE (orders)                                        -->
		<!-- =================================================================== -->
		{{else data.screen == 'orders'}}
			<div class="tn-screen-view" data-view="screen-orders" data-view-screen="orders">
				{{if !data.has_receiving}}
					<div class="notice average">
						<strong>Receiving Beacon Not Configured:</strong> A local receiving beacon must be selected to approve and deliver orders.
						<span style="margin-left: 8px;">
							{{:helper.link('Set Receiving Beacon', null, {'PRG_receiving' : 1}, null, 'tn-btn tn-btn-outline tn-inlineLink')}}
						</span>
					</div>
				{{/if}}

				{{if !data.order_count}}
					<div class="tn-empty-panel">
						<div class="tn-panel-title">No Pending Orders</div>
						<div class="tn-panel-subtitle tn-muted">The station supply queue is clear. New requests submitted by crew will appear here.</div>
					</div>
				{{else}}
					<div class="tn-scroll-box" data-scroll-id="tn-orders-list" style="max-height: 520px;">
						{{for data.orders:order_entry:order_index}}
							<div class="tn-order-card{{if order_entry.selected}} tn-selected{{/if}}">
								<div class="tn-panel-header">
									<div>
										<span class="tn-panel-title">Order #{{:order_entry.id}}</span>
										<span style="color: #ffaa22; margin-left: 6px;">&mdash; {{>order_entry.requestor_name}} ({{>order_entry.buyer_faction}})</span>
									</div>
									<div class="font-mono" style="font-size: 13px; font-weight: bold; color: #55cc55;">
										{{:order_entry.total}} {{:data.currency_short}}
									</div>
								</div>

								<div style="font-size: 11px; margin-top: 3px;">
									<span class="tn-panel-label">Reason:</span>
									<span style="font-style: italic; color: #e0d5c1; margin-left: 4px;">{{>order_entry.reason}}</span>
								</div>

								<div class="tn-flex-row-lg" style="font-size: 10px; margin-top: 4px; color: #8c602a;">
									<div>Base Cost: <span class="font-mono" style="color: #ffaa22;">{{:order_entry.cost}} {{:data.currency_short}}</span></div>
									<div>Handling Fee: <span class="font-mono" style="color: #ffaa22;">{{:order_entry.fee}} {{:data.currency_short}}</span></div>
									<div>Positions: <span class="font-mono" style="color: #ffaa22;">{{:order_entry.item_count}}</span></div>
								</div>

								<!-- Expandable Contents Breakdown -->
								<div class="tn-order-items-box">
									<div class="tn-panel-label" style="margin-bottom: 3px;">Requested Items:</div>
									{{for order_entry.contents:order_group:order_group_index}}
										<div style="font-weight: bold; color: #ff9900; margin-top: 2px;">{{>order_group.station_name}}</div>
										{{for order_group.categories:order_category:order_category_index}}
											{{for order_category.items:order_item:order_item_index}}
												<div style="display: flex; justify-content: space-between; padding: 2px 0; border-bottom: 1px solid #1a140a;">
													<span>{{>order_item.name}} &times; <strong class="font-mono">{{:order_item.amount}}</strong></span>
													<span class="font-mono" style="color: #55cc55;">{{:order_item.price}} {{:data.currency_short}}</span>
												</div>
											{{/for}}
										{{/for}}
