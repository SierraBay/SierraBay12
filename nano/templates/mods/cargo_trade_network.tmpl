	.tn-wrap .tn-contract-details .tn-contract-terms { margin: 8px 0 0; color: #b5aa97; font-size: 12px; }
	.tn-wrap .tn-contract-footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-top: 8px; }
	.tn-wrap .tn-contract-action { display: flex; align-items: center; justify-content: flex-end; max-width: 100%; margin-left: auto; }
	.tn-wrap .tn-contract-feedback { flex: 1 1 220px; min-width: 0; max-width: 380px; margin: 4px 12px 4px 0; font-size: 12px; }
	.tn-wrap .tn-contract-footer .tn-btn { flex-shrink: 0; margin-left: auto; }
	.tn-wrap .tn-history-toggle { display: block; width: 100%; padding: 0; border: 0; background: transparent; color: #e8e2d6; font: inherit; font-size: 14px; font-weight: bold; text-align: left; cursor: pointer; }
	.tn-wrap .tn-history-body { margin-top: 8px; }	.tn-wrap .tn-list-scroll { max-height: 65vh; }
	.tn-wrap .tn-contract-scroll { max-height: 55vh; }
	.tn-wrap .tn-scroll-box { scrollbar-face-color: #514735; scrollbar-track-color: #171614; scrollbar-arrow-color: #b5aa97; scrollbar-shadow-color: #514735; scrollbar-highlight-color: #514735; scrollbar-darkshadow-color: #171614; scrollbar-3dlight-color: #171614; }
	.tn-wrap .tn-scroll-box::-webkit-scrollbar { width: 8px; height: 8px; }
	.tn-wrap .tn-scroll-box::-webkit-scrollbar-track { background: #171614; }
	.tn-wrap .tn-scroll-box::-webkit-scrollbar-thumb { background: #514735; border-radius: 3px; }
	.tn-wrap .tn-scroll-box::-webkit-scrollbar-thumb:hover { background: #65502b; }
	.tn-wrap .tn-history-scroll { max-height: 30vh; }
	.tn-wrap .tn-preset-scroll { max-height: 30vh; }
	.tn-wrap .tn-list-filters { margin-bottom: 12px; }
	.tn-wrap input.tn-list-search { width: 100%; padding-right: 28px; }
	.tn-wrap .tn-order-row, .tn-wrap .tn-log-row, .tn-wrap .tn-export-row { padding: 12px 0; border-bottom: 1px solid #3a3529; overflow-wrap: break-word; }
	.tn-wrap .tn-order-row:first-child, .tn-wrap .tn-log-row:first-child, .tn-wrap .tn-export-row:first-child { padding-top: 0; }
	.tn-wrap .tn-order-row:last-child, .tn-wrap .tn-log-row:last-child, .tn-wrap .tn-export-row:last-child { border-bottom: 0; padding-bottom: 0; }
	.tn-wrap .tn-order-row.tn-selected { border-left: 2px solid #d9a441; padding-left: 8px; }
	.tn-wrap .tn-record-heading, .tn-wrap .tn-record-footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; }
	.tn-wrap .tn-record-heading > :first-child, .tn-wrap .tn-record-footer > :first-child { flex: 1 1 180px; min-width: 0; margin-right: 8px; }
	.tn-wrap .tn-record-identity, .tn-wrap .tn-record-finance, .tn-wrap .tn-record-actions { display: flex; flex-wrap: wrap; align-items: center; }
	.tn-wrap .tn-record-identity > *, .tn-wrap .tn-record-finance > * { margin-right: 8px; }
	.tn-wrap .tn-record-actions { flex-wrap: nowrap; justify-content: flex-end; margin-left: auto; max-width: 100%; min-width: 0; }
	.tn-wrap .tn-record-actions > * { margin: 4px 0 4px 4px; }
	.tn-wrap .tn-record-actions .tn-btn { flex-shrink: 0; }
	.tn-wrap .tn-action-reason { flex: 1 1 180px; min-width: 0; max-width: 240px; font-size: 12px; }
	.tn-wrap .tn-order-reason { margin: 4px 0; }
	.tn-wrap .tn-record-details { margin-top: 8px; padding-top: 8px; border-top: 1px solid #3a3529; }
	.tn-wrap .tn-cart-line { display: flex; flex-wrap: wrap; align-items: center; padding: 8px 0; border-bottom: 1px solid #3a3529; }
	.tn-wrap .tn-cart-line-name { flex: 1 1 160px; min-width: 0; margin-right: 8px; overflow-wrap: break-word; }
	.tn-wrap .tn-cart-line-controls { display: flex; align-items: center; margin-left: auto; }
	.tn-wrap .tn-cart-quantity { width: 44px; text-align: center; }
	.tn-wrap .tn-cart-line-price { width: 100px; margin: 0 8px; text-align: right; overflow-wrap: break-word; }
	.tn-wrap .tn-checkout-action { margin-top: 8px; }
	.tn-wrap .tn-checkout-action .tn-btn { display: flex; width: 100%; }
	.tn-wrap .tn-checkout-action .tn-action-reason { margin-bottom: 4px; }
	.tn-wrap .tn-setting-note { margin: 4px 0 8px; color: #b5aa97; font-size: 12px; }
	.tn-wrap .tn-export-checkout { margin-top: 12px; padding-top: 8px; border-top: 1px solid #514735; }

	/* Reused layout helpers for forms, summaries and item lists. */
	.tn-wrap .tn-full { width: 100%; }
	.tn-wrap .tn-space-top { margin-top: 8px; }
	.tn-wrap .tn-space-bottom { margin-bottom: 8px; }
	.tn-wrap .tn-space-left { margin-left: 4px; }
	.tn-wrap .tn-no-bottom { margin-bottom: 0; }
	.tn-wrap .tn-hidden { display: none; }
	.tn-wrap .tn-empty-description { max-width: 480px; margin: 8px auto 0; }
	.tn-wrap .tn-number { text-align: right; }
	.tn-wrap .tn-bold { font-weight: bold; }
	.tn-wrap .tn-cart-items { flex: 2 1 440px; }
	.tn-wrap .tn-checkout-column { flex: 1 1 280px; }

	@media (max-width: 760px) {
		.tn-wrap .tn-settings-tab { margin-left: 0; }
		.tn-wrap .tn-market-sidebar { flex: 1 1 100%; }
		.tn-wrap .tn-market-main { flex-basis: 100%; }
		.tn-wrap .tn-category-vertical-list { display: flex; flex-wrap: wrap; max-height: 140px; }
		.tn-wrap .tn-category-item { width: auto; margin: 2px 4px 2px 0; }
		.tn-wrap .tn-market-sidebar .tn-panel + .tn-panel { margin-top: 4px; }
		.tn-wrap .tn-trader-meta { width: 100%; margin-top: 4px; }
		.tn-wrap .tn-trader-meta > * { margin: 4px 8px 0 0; }
		.tn-wrap .tn-contract-filters .tn-search-box { flex-basis: 100%; }
	}
	@media (max-width: 520px) {
		.tn-wrap { padding: 4px; }
		.tn-wrap .tn-panel, .tn-wrap .tn-market-main { padding: 8px; }
		.tn-wrap .tn-catalog-table .tn-icon-col, .tn-wrap .tn-catalog-table .tn-icon-cell { display: none; }
		.tn-wrap .tn-catalog-table .tn-stock-col { width: 40px; }
		.tn-wrap .tn-catalog-table .tn-price-col { width: 64px; }
		.tn-wrap .tn-catalog-table .tn-quantity-col { width: 108px; }
		.tn-wrap .tn-catalog-table td, .tn-wrap .tn-catalog-table th { padding-left: 2px; padding-right: 2px; }
		.tn-wrap .tn-basket-actions { margin-top: 8px; }
		.tn-wrap .tn-basket-actions > * { margin-bottom: 4px; }
	}
</style>

<div class="tn-wrap" data-scroll-id="tn-wrap">
	<div class="tn-stack">
		<div class="tn-nav-bar">
			<div class="tn-nav-tabs">
				{{:helper.link('Market', 'search', {'PRG_trade_screen' : 'goods'}, data.screen == 'goods' ? 'selected' : null, 'tn-nav-btn')}}
				{{:helper.link('Cart' + (data.cart_count ? ' <span class="tn-nav-badge">' + data.cart_count + '</span>' : ''), 'cart', {'PRG_trade_screen' : 'cart'}, data.screen == 'cart' ? 'selected' : null, 'tn-nav-btn')}}
				{{:helper.link('Orders' + (data.order_count ? ' <span class="tn-nav-badge">' + data.order_count + '</span>' : ''), 'tag', {'PRG_trade_screen' : 'orders'}, data.screen == 'orders' ? 'selected' : null, 'tn-nav-btn')}}
				{{:helper.link('Contracts' + ((data.available_contract_count || data.active_contract_count) ? ' <span class="tn-nav-badge">' + (data.available_contract_count + data.active_contract_count) + '</span>' : ''), 'clipboard', {'PRG_trade_screen' : 'contracts'}, data.screen == 'contracts' ? 'selected' : null, 'tn-nav-btn')}}
				{{:helper.link('Export', 'refresh', {'PRG_trade_screen' : 'export'}, data.screen == 'export' ? 'selected' : null, 'tn-nav-btn')}}
				{{:helper.link('History', 'document', {'PRG_trade_screen' : 'logs'}, data.screen == 'logs' ? 'selected' : null, 'tn-nav-btn')}}
				{{:helper.link('Settings', 'gear', {'PRG_trade_screen' : 'settings'}, data.screen == 'settings' ? 'selected' : null, 'tn-nav-btn tn-settings-tab')}}
			</div>
		</div>

		{{if data.screen == 'goods'}}
			<div class="tn-summary">
				<div class="tn-summary-meta">
					<span><span class="tn-panel-label">Account:</span> {{if data.has_account}}{{>data.account_owner_name}} <span class="font-mono">({{>formatTradeAmount(data.account_money)}} {{:data.currency_short}})</span>{{else}}<span class="tn-muted">Not linked</span>{{/if}}</span>
					<span><span class="tn-panel-label">Receiving:</span> {{if data.has_receiving}}{{>data.receiving}}{{else}}<span class="tn-muted">Not selected</span>{{/if}}</span>
				</div>
				{{:helper.link('View cart', 'cart', {'PRG_trade_screen' : 'cart'}, null, 'tn-btn tn-btn-outline')}}
			</div>
			{{if !data.has_account || !data.has_receiving}}
				<div class="notice average">
					{{if !data.has_account}}Link an account to add items.{{else}}Select a receiving beacon to purchase items.{{/if}}
					{{:helper.link('Settings', 'gear', {'PRG_trade_screen' : 'settings'}, null, 'tn-btn tn-btn-outline')}}
				</div>
			{{/if}}

		{{else data.screen == 'orders'}}
			<div class="tn-workspace-header">
				<div class="tn-panel-header tn-no-bottom">
					<div>
						<div class="tn-panel-title">Orders</div>
					</div>
					<div class="tn-flex-row-lg">
						<div>
							<span class="tn-panel-label">Requests:</span>
							<strong class="font-mono tn-space-left">{{:data.order_count}}</strong>
						</div>
						<div>
							<span class="tn-panel-label">Total:</span>
							<strong class="font-mono tn-space-left">{{>formatTradeAmount(data.pending_orders_total)}} {{:data.currency_short}}</strong>
						</div>
						<div>
							{{:helper.link('Receiving beacon', null, {'PRG_receiving' : 1}, null, 'tn-btn tn-btn-outline')}}
						</div>
					</div>
				</div>
			</div>

		{{else data.screen == 'contracts'}}
			<div class="tn-workspace-header">
				<div class="tn-panel-header tn-no-bottom">
					<div class="tn-panel-title">Contracts</div>
					<div class="tn-summary-meta">
						{{if data.has_account}}<span>Account: <strong>{{>data.account_owner_name}}</strong> <span class="font-mono">({{>formatTradeAmount(data.account_money)}} {{>data.currency_short}})</span></span>
						{{else}}<span class="tn-muted">No account linked</span>{{:helper.link('Settings', 'gear', {'PRG_trade_screen' : 'settings'}, null, 'tn-btn tn-btn-outline')}}{{/if}}
					</div>
				</div>
				<div class="tn-contract-beacons">
					<div>{{:helper.link('Inbound beacon', null, {'PRG_receiving' : 1}, null, 'tn-btn tn-btn-outline')}} <span class="tn-muted">{{if data.has_receiving}}{{>data.receiving}}{{else}}None selected{{/if}}</span></div>
					<div>{{:helper.link('Outbound beacon', null, {'PRG_sending' : 1}, null, 'tn-btn tn-btn-outline')}} <span class="tn-muted">{{if data.has_sending}}{{>data.sending}}{{else}}None selected{{/if}}</span></div>
				</div>
			</div>

		{{else data.screen == 'export'}}
			<div class="tn-workspace-header"><div class="tn-panel-header tn-no-bottom"><div class="tn-panel-title">Export</div><span class="tn-muted">{{if data.has_sending}}{{>data.sending}}{{else}}No sending beacon selected{{/if}}</span></div></div>

		{{else data.screen == 'logs'}}
			<div class="tn-workspace-header"><div class="tn-panel-header tn-no-bottom"><div class="tn-panel-title">History</div><span class="tn-muted">{{if data.has_printer}}Printer connected{{else}}No printer connected{{/if}}</span></div></div>

		{{else data.screen == 'cart'}}
			<div class="tn-workspace-header"><div class="tn-panel-header tn-no-bottom"><div class="tn-panel-title">Cart <span class="tn-muted font-mono">({{:data.cart_count}} items)</span></div>{{:helper.link('Back to Market', null, {'PRG_trade_screen' : 'goods'}, null, 'tn-btn tn-btn-outline')}}</div></div>

		{{else data.screen == 'settings'}}
			<div class="tn-workspace-header">
				<div class="tn-panel-header tn-no-bottom">
					<div>
						<div class="tn-panel-title">Settings</div>
					</div>
					<div>
						{{:helper.link('Back to Market', null, {'PRG_trade_screen' : 'goods'}, null, 'tn-btn tn-btn-outline')}}
					</div>
				</div>
			</div>
		{{/if}}
		{{if data.message}}
			<div class="notice average">{{>data.message}}</div>
		{{/if}}
		{{if data.screen == 'goods'}}
			<div class="tn-screen-view" data-view="screen-goods" data-view-screen="market">
				<div class="tn-market-trader">
					{{if !data.has_visible_stations}}
						<div class="tn-empty">No trade stations in sensor range.</div>
					{{else}}
						<label for="cargo-trader-select">Trader</label>
						<select id="cargo-trader-select" class="tn-station-select" onchange="if(this.value){ var fn = window.NanoUtility &amp;&amp; window.NanoUtility.generateHref; window.location.href = fn ? fn({'PRG_station': this.value}) : ('?src={{:uiSrc}};PRG_station=' + encodeURIComponent(this.value)); }">
							{{for data.stations:station_entry:station_index}}
								<option value="{{:station_entry.uid}}" {{if station_entry.selected}}selected{{/if}}>{{>station_entry.name}} &mdash; {{>station_entry.status_label}}</option>
							{{/for}}
						</select>
						{{if data.has_selected_station && data.selected_station}}
							<div class="tn-trader-meta">
								<span class="tn-station-faction" style="color: {{:data.selected_station.faction_color}}">{{>data.selected_station.faction}}</span>
								<span class="tn-tag tn-tag-{{:data.selected_station.market_tone}}">{{>data.selected_station.market_label}}</span>
							</div>
						{{/if}}
					{{/if}}
				</div>
				<div class="tn-grid">
					{{if data.has_selected_station}}
						<div class="tn-col tn-market-sidebar">
							<div class="tn-panel">
								<div class="tn-panel-title">Categories</div>
								<hr class="tn-section-divider">
								{{if data.selected_station && data.selected_station.block_reason}}
									<div class="tn-empty">Catalog blocked.</div>
								{{else data.categories && data.categories.length}}
									<div class="tn-category-vertical-list tn-scroll-box" data-scroll-id="tn-category-list">
										{{for data.categories:category_entry:category_index}}
											{{:helper.link(category_entry.name, null, {'PRG_goods_category' : category_entry.name}, category_entry.selected ? 'selected' : null, 'tn-category-item ')}}
										{{/for}}
									</div>
								{{else}}
									<div class="tn-empty">No categories available.</div>
								{{/if}}
							</div>
						</div>
					{{/if}}
					<div class="tn-col tn-market-main">
						{{if data.has_selected_station}}
							<div class="tn-catalog-header-bar">
								<div class="tn-catalog-title">
									{{if data.selected_category && !data.selected_station.block_reason}}{{>data.selected_category}}{{else}}Catalog{{/if}}
								</div>
								<div class="tn-filter-controls">
									<div class="tn-search-box">
										<span class="tn-search-icon uiIcon16 icon-search" aria-hidden="true"></span>
										<input type="text" id="cargo-search-input" class="tn-search-input font-mono" placeholder="Search this category" aria-label="Search this category" oninput="window.cargoLiveFilter &amp;&amp; window.cargoLiveFilter()" onpropertychange="window.cargoLiveFilter &amp;&amp; window.cargoLiveFilter()" onkeyup="window.cargoLiveFilter &amp;&amp; window.cargoLiveFilter()">
										<button type="button" class="tn-search-clear" title="Clear search" onclick="var inp=document.getElementById('cargo-search-input'); if(inp){ inp.value=''; window.cargoLiveFilter &amp;&amp; window.cargoLiveFilter(); inp.focus(); }" aria-label="Clear search"><span class="uiIcon16 icon-close" aria-hidden="true"></span></button>
									</div>
									<select id="cargo-sort-select" aria-label="Sort items" class="tn-sort-select" onchange="window.cargoLiveSort &amp;&amp; window.cargoLiveSort()">
										<option value="default">Default order</option>
										<option value="price_asc">Price: Low &rarr; High</option>
										<option value="price_desc">Price: High &rarr; Low</option>
										<option value="name_asc">Name: A &rarr; Z</option>
										<option value="name_desc">Name: Z &rarr; A</option>
									</select>
									<div id="cargo-cards-counter" class="tn-cards-counter font-mono"></div>
								</div>
							</div>

							<div id="cargo-current-category" data-station="{{:data.selected_station.uid}}" data-cat="{{:data.selected_category}}" class="tn-hidden"></div>

							{{if data.selected_station.block_reason}}
								<div class="notice bad">{{>data.selected_station.block_reason}}</div>
								<div class="tn-empty-panel">
									<div class="tn-panel-title">Trader unavailable</div>
									<div class="tn-panel-subtitle tn-muted tn-empty-description">
										Move into sensor range or clear radio interference to view this inventory.
									</div>
								</div>
							{{else}}
								<div class="tn-scroll-box tn-goods-scroll" data-scroll-id="tn-goods-table">
									{{if data.goods && data.goods.length}}
										<table class="tn-catalog-table">
											<thead>
												<tr>
													<th class="tn-icon-col"></th>
													<th>Item</th>
													<th class="tn-stock-col tn-th-right">Stock</th>
													<th class="tn-price-col tn-th-right">Price</th>
													<th class="tn-quantity-col">Quantity</th>
												</tr>
											</thead>
											<tbody id="cargo-goods-tbody">
												{{for data.goods:good_entry:good_index}}
													<tr class="tn-good-row{{if good_entry.in_cart_amount > 0}} tn-in-cart{{/if}}{{if !good_entry.can_add}} tn-restricted{{/if}}" data-key="{{>data.selected_station.uid + '::' + data.selected_category + '::' + good_entry.id}}" data-name="{{>good_entry.name}}" data-price="{{:good_entry.price}}" data-stock="{{:good_entry.stock}}" data-id="{{:good_entry.id}}" data-index="{{:good_index}}">
														<td class="tn-icon-cell">
															<div class="tn-sprite-box">
																{{if good_entry.icon}}
																	<img class="tn-sprite-img" src="{{:good_entry.icon}}" alt="{{>good_entry.name}}">
																{{else}}
																		<span class="tn-sprite-placeholder uiIcon16 icon-cart" aria-hidden="true"></span>
																{{/if}}
															</div>
														</td>
														<td>
															<button type="button" class="tn-item-toggle" aria-expanded="false" aria-controls="cargo-good-details-{{:good_index}}" onclick="window.cargoToggleGoodDetails &amp;&amp; window.cargoToggleGoodDetails(this)">
																<span class="tn-item-title"><span class="tn-item-marker" aria-hidden="true">+</span>{{>good_entry.name}}</span>
															</button>
															<div id="cargo-good-details-{{:good_index}}" class="tn-item-details tn-hidden">
																{{if good_entry.desc}}<p>{{>good_entry.desc}}</p>{{/if}}
																<div class="tn-labeled-row"><span>Buyback</span><span class="font-mono">{{>formatTradeAmount(good_entry.sell_price)}} {{:data.currency_short}}</span></div>
																{{if good_entry.markup_text}}<div class="tn-labeled-row"><span>Markup</span><span class="font-mono">{{>good_entry.markup_text}}</span></div>{{/if}}
															</div>
														</td>
														<td class="tn-number">
															{{if good_entry.stock <= 0}}
																<span class="font-mono tn-bad tn-bold">0</span>
															{{else}}
																<strong class="font-mono">{{:good_entry.stock}}</strong>
															{{/if}}
														</td>
														<td class="tn-number">
															<span class="font-mono tn-bold">
																{{>formatTradeAmount(good_entry.price)}} {{:data.currency_short}}
															</span>
														</td>
														<td class="tn-number">
															{{if !good_entry.can_add && !good_entry.in_cart_amount}}
																<span class="tn-muted">{{if good_entry.stock <= 0}}Out of stock{{else !data.has_account}}Link account{{else}}Unavailable{{/if}}</span>
															{{else}}
																<div class="tn-actions-wrap">
																	{{if good_entry.in_cart_amount > 0}}
																		<div class="tn-table-stepper">
																			{{:helper.link('-', null, {'PRG_cart_remove_direct' : data.selected_station.uid, 'PRG_cart_category_name' : data.selected_category, 'PRG_cart_good_id' : good_entry.id, 'PRG_cart_remove_amount' : 1}, null, 'tn-table-stepper-btn')}}
																			{{:helper.link(good_entry.in_cart_amount, null, {'PRG_goods_quantity_target' : good_entry.id}, null, 'tn-quantity-value font-mono')}}
																			{{:helper.link('+', null, {'PRG_cart_add_good' : good_entry.id, 'PRG_cart_add_amount' : 1}, (!good_entry.can_add || good_entry.in_cart_amount >= good_entry.stock) ? 'disabled' : null, 'tn-table-stepper-btn')}}
																		</div>
																	{{else}}
																		{{:helper.link('Add', null, {'PRG_cart_add_good' : good_entry.id, 'PRG_cart_add_amount' : 1}, null, 'tn-btn tn-btn-outline')}}
																	{{/if}}
