								{{/if}}
							</div>
							{{if data.cart_form_mode == 'link_account'}}
								<div class="tn-form-shell tn-space-top">
									<form class="tn-form" method="get" action="?src={{:uiSrc}}">
										<input type="hidden" name="src" value="{{:uiSrc}}">
										<label class="tn-panel-label tn-full" for="cargo-field-PRG_link_account_number">Account number</label>
										<input id="cargo-field-PRG_link_account_number" type="number" name="PRG_link_account_number" value="{{if data.can_link_id_account}}{{:data.inserted_id_account_number}}{{/if}}" placeholder="Account #" required class="tn-full">
										<label class="tn-panel-label tn-full tn-space-top" for="cargo-field-PRG_link_account_pin">PIN:</label>
										<input id="cargo-field-PRG_link_account_pin" type="password" name="PRG_link_account_pin" value="" placeholder="PIN" required class="tn-full">
										<div class="tn-flex-row-sm tn-full tn-space-top">
											<input type="submit" value="Link account" class="tn-btn tn-btn-primary">
											{{:helper.link('Cancel', null, {'PRG_cart_form_cancel' : 1}, null, 'tn-btn tn-btn-outline')}}
										</div>
									</form>
								</div>
							{{else data.cart_form_mode == 'link_id_account'}}
								<div class="tn-form-shell tn-space-top">
									<form class="tn-form" method="get" action="?src={{:uiSrc}}">
										<input type="hidden" name="src" value="{{:uiSrc}}">
										<label class="tn-panel-label tn-full" for="cargo-field-PRG_link_id_pin">PIN for ID card account (#{{:data.inserted_id_account_number}}):</label>
										<input id="cargo-field-PRG_link_id_pin" type="password" name="PRG_link_id_pin" value="" placeholder="PIN" required class="tn-full">
										<div class="tn-flex-row-sm tn-full tn-space-top">
											<input type="submit" value="Verify PIN" class="tn-btn tn-btn-primary">
											{{:helper.link('Cancel', null, {'PRG_cart_form_cancel' : 1}, null, 'tn-btn tn-btn-outline')}}
										</div>
									</form>
								</div>
							{{/if}}
						</div>
					</div>

					<div class="tn-col">
						<div class="tn-panel">
							<div class="tn-panel-title">Beacons</div>
							<hr class="tn-section-divider">
							<div>
								<div class="tn-space-bottom">
									<div class="tn-panel-label">Receiving</div><div class="tn-setting-note">Receives purchases and contract cargo.</div>
									<div class="tn-summary tn-space-top">
										<strong>{{if data.has_receiving}}{{>data.receiving}}{{else}}<span class="tn-empty">None selected</span>{{/if}}</strong>
										{{:helper.link('Select beacon', null, {'PRG_receiving' : 1}, null, 'tn-btn tn-btn-outline')}}
									</div>
									{{if data.cart_form_mode == 'select_receiving'}}
										<div class="tn-form-shell tn-space-top">
											<form class="tn-form" method="get" action="?src={{:uiSrc}}">
												<input type="hidden" name="src" value="{{:uiSrc}}">
												<label class="tn-panel-label tn-full" for="cargo-field-PRG_beacon_id">Receiving beacon</label>
												<select id="cargo-field-PRG_beacon_id" name="PRG_beacon_id" class="tn-full">
													<option value="none">None (clear selection)</option>
													{{for data.available_receiving_beacons:beacon:beacon_index}}
														<option value="{{:beacon.ref}}" {{if beacon.id == data.receiving}}selected{{/if}}>{{>beacon.id}}</option>
													{{/for}}
												</select>
												<div class="tn-flex-row-sm tn-full tn-space-top">
													<input type="submit" value="Set beacon" class="tn-btn tn-btn-primary">
													{{:helper.link('Cancel', null, {'PRG_cart_form_cancel' : 1}, null, 'tn-btn tn-btn-outline')}}
												</div>
											</form>
										</div>
									{{/if}}
								</div>
								<div>
									<div class="tn-panel-label">Sending</div><div class="tn-setting-note">Sends exports, contract deliveries and data handoffs.</div>
									<div class="tn-summary tn-space-top">
										<strong>{{if data.has_sending}}{{>data.sending}}{{else}}<span class="tn-empty">None selected</span>{{/if}}</strong>
										{{:helper.link('Select beacon', null, {'PRG_sending' : 1}, null, 'tn-btn tn-btn-outline')}}
									</div>
									{{if data.cart_form_mode == 'select_sending'}}
										<div class="tn-form-shell tn-space-top">
											<form class="tn-form" method="get" action="?src={{:uiSrc}}">
												<input type="hidden" name="src" value="{{:uiSrc}}">
												<label class="tn-panel-label tn-full" for="cargo-field-PRG_beacon_id">Sending beacon</label>
												<select id="cargo-field-PRG_beacon_id" name="PRG_beacon_id" class="tn-full">
													<option value="none">None (clear selection)</option>
													{{for data.available_sending_beacons:beacon:beacon_index}}
														<option value="{{:beacon.ref}}" {{if beacon.id == data.sending}}selected{{/if}}>{{>beacon.id}}</option>
													{{/for}}
												</select>
												<div class="tn-flex-row-sm tn-full tn-space-top">
													<input type="submit" value="Set beacon" class="tn-btn tn-btn-primary">
													{{:helper.link('Cancel', null, {'PRG_cart_form_cancel' : 1}, null, 'tn-btn tn-btn-outline')}}
												</div>
											</form>
										</div>
									{{/if}}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		{{/if}}
	</div>
</div>

<script id="cargo-controls-script">
window.cargoClearFormError = function(input) {
	input.removeAttribute('aria-invalid');
	$(input.form).find('.tn-form-error').hide();
};
window.cargoValidateQuantityForm = function(form) {
	var input = form.elements['PRG_cart_set_amount'];
	var amount = Number(input.value);
	var maximum = Number(input.getAttribute('max'));
	var error = '';
	if (!input.value.replace(/^\s+|\s+$/g, '') || !isFinite(amount) || amount < 0 || amount % 1) error = 'Enter a whole quantity of zero or more.';
	else if (amount > maximum) error = 'Maximum quantity: ' + maximum + '.';
	$(form).find('.tn-form-error').text(error).toggle(!!error);
	if (error) {
		input.setAttribute('aria-invalid', 'true');
		input.focus();
	}
	return !error;
};
window.cargoValidateOrderForm = function(form) {
	var input = form.PRG_order_reason;
	var valid = !!input.value.replace(/^\s+|\s+$/g, '');
	$(form).find('.tn-form-error').toggle(!valid);
	if (!valid) {
		input.setAttribute('aria-invalid', 'true');
		input.focus();
	}
	return valid;
};
window.cargoToggleDetails = function(button) {
	var row = $(button).closest('[data-detail-key]');
	var group = row.attr('data-detail-group');
	var key = row.attr('data-detail-key');
	window._cargoDetails = window._cargoDetails || {};
	window._cargoDetails[group] = window._cargoDetails[group] === key ? null : key;
	window.cargoApplyDetails();
};
window.cargoApplyDetails = function() {
	var state = window._cargoDetails || {};
	$('.tn-wrap [data-detail-key]').each(function() {
		var row = $(this);
		var expanded = state[row.attr('data-detail-group')] === row.attr('data-detail-key');
		row.find('.tn-detail-toggle').attr('aria-expanded', expanded ? 'true' : 'false');
		row.find('.tn-detail-marker').text(expanded ? '-' : '+');
		row.find('.tn-record-details').toggle(expanded);
	});
};
window.cargoListState = function(name) {
	var key = name === 'logs' ? name + '-' + ($('[data-log-stream]').attr('data-log-stream') || '') : name;
	window._cargoLists = window._cargoLists || {};
	return window._cargoLists[key] || (window._cargoLists[key] = {query: '', filter: ''});
};
window.cargoFilterList = function(name) {
	var list = document.getElementById('cargo-' + name + '-list');
	if (!list) return;
	var state = window.cargoListState(name);
	state.query = $('#cargo-' + name + '-search').val() || '';
	state.filter = $('#cargo-' + name + '-filter').val() || '';
	var query = state.query.toLowerCase().replace(/^\s+|\s+$/g, '');
	var tokens = query ? query.split(/\s+/) : [];
	var rows = $(list).children('[data-search]');
	var count = 0;
	rows.each(function() {
		var row = $(this);
		var match = !state.filter || row.attr('data-filter') === state.filter;
		var text = (row.attr('data-search') || '').toLowerCase();
		for (var i = 0; match && i < tokens.length; i++) match = text.indexOf(tokens[i]) !== -1;
		row.toggle(match);
		if (match) count++;
	});
	$('#cargo-' + name + '-counter').text(count + ' / ' + rows.length).toggle(!!(query || state.filter));
	$('#cargo-' + name + '-empty').toggle(count === 0);
};
window.cargoInitLists = function() {
	var names = ['orders', 'logs'];
	for (var i = 0; i < names.length; i++) {
		var name = names[i];
		if (!document.getElementById('cargo-' + name + '-list')) continue;
		var state = window.cargoListState(name);
		var search = $('#cargo-' + name + '-search');
		if (search.val() !== state.query) search.val(state.query);
		$('#cargo-' + name + '-filter').val(state.filter);
		window.cargoFilterList(name);
	}
};
window.cargoContractState = function() {
	if (!window._cargoContractUi) {
		window._cargoContractUi = {query: '', type: '', availability: '', sort: 'ready', history: '', activeDetails: null, offerDetails: null};
	}
	return window._cargoContractUi;
};
window.cargoApplyContractDetails = function() {
	var state = window.cargoContractState();
	$('.tn-wrap .tn-contract-row').each(function() {
		var key = $(this).attr('data-key');
		var expanded = key === state.activeDetails || key === state.offerDetails;
		$(this).find('.tn-contract-toggle').attr('aria-expanded', expanded ? 'true' : 'false');
		$(this).find('.tn-contract-marker').text(expanded ? '-' : '+');
		$(this).find('.tn-contract-details').toggle(expanded);
	});
};
window.cargoToggleContractDetails = function(button) {
	var state = window.cargoContractState();
	var key = $(button).closest('.tn-contract-row').attr('data-key');
	var field = key.indexOf('active-') === 0 ? 'activeDetails' : 'offerDetails';
	state[field] = state[field] === key ? null : key;
	window.cargoApplyContractDetails();
};
window.cargoFilterContracts = function() {
	var list = document.getElementById('cargo-contract-offers');
	if (!list) return;
	var state = window.cargoContractState();
	state.query = $('#cargo-contract-search').val() || '';
	state.type = $('#cargo-contract-type').val() || '';
	state.availability = $('#cargo-contract-availability').val() || '';
	var query = state.query.toLowerCase().replace(/^\s+|\s+$/g, '');
	var tokens = query ? query.split(/\s+/) : [];
	var count = 0;
	var rows = $(list).children('.tn-contract-row');
	rows.each(function() {
		var row = $(this);
		var ready = row.attr('data-ready') === '1';
		var match = (!state.type || row.attr('data-type') === state.type) &&
			(!state.availability || (state.availability === 'ready' ? ready : !ready));
		var text = (row.attr('data-search') || '').toLowerCase();
		for (var i = 0; match && i < tokens.length; i++) match = text.indexOf(tokens[i]) !== -1;
		row.toggle(match);
		if (match) count++;
	});
	$('#cargo-contract-counter').text(count + ' / ' + rows.length + ' offers');
	$('#cargo-contract-no-results').toggle(count === 0);
	var filtered = !!(query || state.type || state.availability || state.sort !== 'ready');
	$('#cargo-contract-reset, #cargo-contract-filter-summary').toggle(filtered);
};
window.cargoSortContracts = function(sortOverride) {
	var list = document.getElementById('cargo-contract-offers');
	if (!list) return;
	var state = window.cargoContractState();
	var sort = sortOverride || $('#cargo-contract-sort').val() || 'ready';
	var focused = document.activeElement;
	var scroll = list.scrollTop;
	var rows = $(list).children('.tn-contract-row').get();
	rows.sort(function(a, b) {
		var difference = 0;
		if (sort === 'ready') difference = Number(b.getAttribute('data-ready')) - Number(a.getAttribute('data-ready'));
		else if (sort === 'reward') difference = Number(b.getAttribute('data-reward')) - Number(a.getAttribute('data-reward'));
		else if (sort === 'deposit') difference = Number(a.getAttribute('data-deposit')) - Number(b.getAttribute('data-deposit'));
		else if (sort === 'distance') difference = Number(a.getAttribute('data-distance')) - Number(b.getAttribute('data-distance'));
		return difference || Number(a.getAttribute('data-index')) - Number(b.getAttribute('data-index'));
	});
	for (var i = 0; i < rows.length; i++) {
		if (list.children[i] !== rows[i]) list.insertBefore(rows[i], list.children[i] || null);
	}
	if (focused && document.activeElement !== focused && $.contains(list, focused)) focused.focus();
	list.scrollTop = scroll;
	if (!sortOverride) {
		state.sort = sort;
		window.cargoFilterContracts();
	}
};
window.cargoResetContractFilters = function() {
	var state = window.cargoContractState();
	state.query = state.type = state.availability = '';
	state.sort = 'ready';
	window.cargoContractInit();
};
window.cargoFilterContractHistory = function() {
	var filter = document.getElementById('cargo-contract-history-filter');
	if (!filter) return;
	var state = window.cargoContractState();
	state.history = filter.value;
	var count = 0;
	var rows = $('.tn-wrap .tn-contract-history-row');
	rows.each(function() {
		var match = !state.history || $(this).attr('data-outcome') === state.history;
		$(this).toggle(match);
		if (match) count++;
	});
	$('#cargo-contract-history-counter').text(count + ' / ' + rows.length + ' contracts');
	$('#cargo-contract-history-counter').toggle(!!state.history);
	$('#cargo-contract-history-empty').toggle(count === 0);
};
window.cargoContractInit = function() {
	if (!document.getElementById('tn-contracts-active-panel')) return;
	var state = window.cargoContractState();
	$('#cargo-contract-search').val(state.query);
	$('#cargo-contract-type').val(state.type);
	if (!$('#cargo-contract-type').val()) {
		state.type = '';
		$('#cargo-contract-type').val('');
	}
	$('#cargo-contract-availability').val(state.availability);
	$('#cargo-contract-sort').val(state.sort);
	$('#cargo-contract-history-filter').val(state.history);
	window.cargoApplyContractDetails();
	window.cargoSortContracts();
	window.cargoFilterContractHistory();
	if (window.NanoStateManager && window.NanoStateManager.addBeforeUpdateCallback) {
		window.NanoStateManager.addBeforeUpdateCallback('cargo_trade_contracts', function(data) {
			window.cargoSortContracts('default');
			return data;
		});
	}
};
window.cargoToggleGoodDetails = function(button) {
	var key = $(button).closest('.tn-good-row').attr('data-key');
	window._cargoExpandedGoodKey = window._cargoExpandedGoodKey === key ? null : key;
	window.cargoTradeInit();
};
window.cargoToggleHistory = function() {
	window._cargoHistoryOpen = !window._cargoHistoryOpen;
	window.cargoTradeInit();
};
window.cargoTradeInit = function() {
	if (!window.jQuery) return;
	window.cargoContractInit();
	window.cargoApplyDetails();
	window.cargoInitLists();
	$('.tn-wrap .tn-good-row').each(function() {
		var expanded = $(this).attr('data-key') === window._cargoExpandedGoodKey;
		$(this).toggleClass('tn-expanded', expanded);
		$(this).find('.tn-item-toggle').attr('aria-expanded', expanded ? 'true' : 'false');
		$(this).find('.tn-item-marker').text(expanded ? '-' : '+');
		$(this).find('.tn-item-details').toggle(expanded);
	});
	var history = document.getElementById('tn-contract-history');
	if (history) {
		history.style.display = window._cargoHistoryOpen ? 'block' : 'none';
		$('.tn-history-toggle').attr('aria-expanded', window._cargoHistoryOpen ? 'true' : 'false');
		$('#tn-history-marker').text(window._cargoHistoryOpen ? '-' : '+');
	}
	$('.tn-wrap .linkActive').attr('role', 'button').attr('tabindex', '0');
	$('.tn-nav-bar, .tn-pillnav').attr('role', 'tablist');
	$('.tn-wrap .tn-nav-btn, .tn-wrap .tn-pillnav-link').each(function() {
		$(this).attr('role', 'tab').attr('aria-selected', $(this).hasClass('selected') ? 'true' : 'false');
	});
	$('.tn-wrap .tn-quantity-value').attr('title', 'Set quantity').attr('aria-label', 'Set item quantity');
	$('.tn-wrap .tn-cart-line').each(function() {
		var name = $(this).find('.tn-cart-line-name').text();
		$(this).find('.tn-cart-decrement').attr('aria-label', 'Remove one ' + name);
		$(this).find('.tn-cart-remove').attr('aria-label', 'Remove all ' + name);
	});
	$('.tn-wrap .disabled').attr('aria-disabled', 'true');
	$('.tn-wrap .linkActive').off('keydown.cargo').on('keydown.cargo', function(event) {
		if (event.which === 13 || event.which === 32) {
			event.preventDefault();
			this.click();
		}
	});
	if (window._cargoClearArmedUntil > new Date().getTime()) {
		$('.tn-wrap .tn-confirm-clear.linkActive').text('Confirm clear');
	}
	if (window.NanoStateManager && window.NanoStateManager.addAfterUpdateCallback) {
		window.NanoStateManager.addAfterUpdateCallback('cargo_trade_controls', function(data) {
			window.cargoTradeInit();
			return data;
		});
	}
	if (!window._cargoConfirmRegistered && document.addEventListener) {
		window._cargoConfirmRegistered = true;
		document.addEventListener('click', function(event) {
			var target = event.target;
			while (target && target !== document) {
				if ((' ' + target.className + ' ').indexOf(' tn-confirm-clear ') !== -1 && (' ' + target.className + ' ').indexOf(' linkActive ') !== -1) {
				if (!(window._cargoClearArmedUntil > new Date().getTime())) {
					event.preventDefault();
					event.stopPropagation();
					window._cargoClearArmedUntil = new Date().getTime() + 5000;
					$(target).text('Confirm clear');
					window.clearTimeout(window._cargoClearTimer);
					window._cargoClearTimer = window.setTimeout(function() {
						window._cargoClearArmedUntil = 0;
						$('.tn-wrap .tn-confirm-clear.linkActive').text('Clear cart');
					}, 5000);
				} else {
					window._cargoClearArmedUntil = 0;
					window.clearTimeout(window._cargoClearTimer);
				}
				return;
			}
				target = target.parentNode;
			}
		}, true);
	}
};
window.cargoTradeInit();
</script>
<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" style="display:none;" onload="var s=document.getElementById('cargo-controls-script'); if(s &amp;&amp; !window.cargoTradeInit){ (window.execScript || function(c){window.eval(c);})(s.innerHTML); } else if(window.cargoTradeInit){window.cargoTradeInit();}">
