															<span class="font-mono" style="color: #ffaa22; font-weight: bold; font-size: 11px;">
																{{:good_entry.price}} {{:data.currency_short}}
															</span>
															{{if good_entry.markup_text}}
																<div class="font-mono" style="font-size: 9px; color: #8c602a; margin-top: 1px;">
																	{{:good_entry.markup_text}}
																</div>
															{{/if}}
