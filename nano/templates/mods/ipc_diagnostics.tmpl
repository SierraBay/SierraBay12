<style type="text/css">
	.ecs-root {
		font-family: "Courier New", Courier, monospace;
		background: #0a0e14;
		color: #c8d8e8;
		padding: 6px;
	}
	/* ── TABS ── */
	.ecs-tabs { display: flex; gap: 2px; margin-bottom: 5px; }
	.ecs-tab {
		flex: 1;
		text-align: center;
		padding: 4px 0;
		font-size: 11px;
		letter-spacing: 1px;
		text-transform: uppercase;
		border: 1px solid #1e3a4a;
		background: #0d1520;
		color: #546e7a;
		text-decoration: none;
		display: block;
		cursor: default;
	}
	.ecs-tab.active { border-color: #1e9dc8; color: #4fc3f7; background: #0d1f2a; }
	.ecs-tab:hover  { background: #0d1520; color: #546e7a; text-decoration: none; }
	.ecs-tab.active:hover { background: #0d1f2a; color: #4fc3f7; }

	/* ── SECTIONS ── */
	.ecs-section { border: 1px solid #1e3a4a; background: #0d1520; padding: 5px 8px; margin-bottom: 5px; }
	.ecs-section-title {
		color: #1e9dc8; font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
		margin-bottom: 4px; border-bottom: 1px solid #1e3a4a; padding-bottom: 2px;
	}
	.ecs-row { display: flex; justify-content: space-between; align-items: baseline; padding: 3px 0; border-bottom: 1px solid #0d1f2a; }
	.ecs-row:last-child { border-bottom: none; }
	.ecs-label { color: #607d8b; font-size: 12px; min-width: 125px; }
	.ecs-value { font-size: 12px; text-align: right; }

	/* ── COLORS ── */
	.ok    { color: #00c97a; }
	.warn  { color: #ffb829; }
	.bad   { color: #f44336; }
	.muted { color: #37474f; }
	.ecs-destroyed { color: #f44336; font-weight: bold; letter-spacing: 1px; }
	.ecs-active    { color: #4fc3f7; font-size: 11px; }
	.ecs-alert { border: 1px solid #f44336; background: #1a0808; color: #ff6659; padding: 4px 6px; font-size: 12px; margin-bottom: 5px; }
	.ecs-brand-warn { border: 1px solid #ffb829; background: #1a1200; color: #ffb829; padding: 3px 6px; font-size: 12px; margin-bottom: 5px; }
	.ecs-link { color: #1e9dc8; font-size: 11px; text-decoration: none; margin-left: 5px; cursor: default; }
	.ecs-link:hover { text-decoration: none; color: #1e9dc8; }
	.ecs-btn {
		display: inline-block;
		padding: 1px 6px;
		margin-left: 6px;
		border: 1px solid #1e9dc8;
		background: #0d1f2a;
		color: #4fc3f7;
		font-size: 10px;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		text-decoration: none;
	}
	.ecs-btn:hover {
		border-color: #4fc3f7;
		color: #b9eaff;
		background: #123247;
		text-decoration: none;
	}
	.ecs-limb-brand { color: #37474f; font-size: 11px; margin-right: 4px; }
	a:hover { text-decoration: none; }

	/* ── BODY MAP ── */
	.bm-wrap { display: flex; justify-content: center; padding: 4px 0; }
	.bm-grid {
		display: grid;
		grid-template-columns: 86px 106px 86px;
		grid-template-areas:
			".     head  ."
			"larm  chest rarm"
			"lhand chest rhand"
			".     groin ."
			"lleg  .     rleg"
			"lfoot .     rfoot";
		gap: 2px;
	}
	.bm-zone {
		border: 1px solid #1e3a4a;
		background: #0d1520;
		padding: 6px 3px;
		text-align: center;
		font-size: 10px;
		letter-spacing: 1px;
		color: #546e7a;
		text-transform: uppercase;
	}
	.bm-zone.ok      { border-color: #00523a; color: #00c97a; background: #041a0e; }
	.bm-zone.warn    { border-color: #6e4d00; color: #ffb829; background: #1a1200; }
	.bm-zone.bad     { border-color: #6e1a14; color: #f44336; background: #1a0808; }
	.bm-zone.missing { border: 1px dashed #2a3540; color: #2a3540; background: #080c10; }
	.bm-dnum  { font-size: 10px; display: block; margin-top: 2px; opacity: 0.8; }
	.bm-label { font-size: 10px; display: block; margin-bottom: 1px; }

	.bm-head  { grid-area: head; }
	.bm-larm  { grid-area: larm; }
	.bm-rarm  { grid-area: rarm; }
	.bm-chest { grid-area: chest; }
	.bm-lhand { grid-area: lhand; }
	.bm-rhand { grid-area: rhand; }
	.bm-groin { grid-area: groin; }
	.bm-lleg  { grid-area: lleg; }
	.bm-rleg  { grid-area: rleg; }
	.bm-lfoot { grid-area: lfoot; }
	.bm-rfoot { grid-area: rfoot; }

	.bm-chest-inner { border-top: 1px solid #1e3a4a; margin-top: 4px; padding-top: 3px; font-size: 10px; text-align: left; }
	.bm-int-row { display: flex; justify-content: space-between; padding: 1px 0; }
	.bm-int-label { color: #37474f; }

	.bm-legend { display: flex; gap: 8px; justify-content: center; margin-top: 5px; font-size: 10px; }
	.bm-legend-item { display: flex; align-items: center; gap: 3px; }
	.bm-legend-dot { width: 8px; height: 8px; border: 1px solid currentColor; display: inline-block; }
	.bm-miss-label { color: #2a3540; }

	/* ── ZONE SELECTION ── */
	.bm-zone { cursor: pointer; }
	.bm-zone.bm-selected { outline: 2px solid #4fc3f7 !important; outline-offset: -2px; }
	.bm-detail {
		border: 1px solid #1e9dc8;
		background: #0d1520;
		padding: 6px 8px;
		margin-top: 6px;
		font-size: 11px;
	}
	.bm-detail-title {
		color: #4fc3f7;
		font-size: 11px;
		font-weight: bold;
		letter-spacing: 1px;
		text-transform: uppercase;
		margin-bottom: 4px;
		border-bottom: 1px solid #1e3a4a;
		padding-bottom: 2px;
	}
	.bm-detail-row { display: flex; justify-content: space-between; padding: 2px 0; border-bottom: 1px solid #0d1f2a; }
	.bm-detail-row:last-child { border-bottom: none; }
	.bm-detail-label { color: #607d8b; min-width: 110px; }
	.bm-detail-val { text-align: right; }
	.bm-armor-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px 8px; }
	.bm-armor-item { display: flex; justify-content: space-between; font-size: 10px; padding: 1px 0; }
	.bm-armor-key { color: #546e7a; }
	.bm-hint { color: #2a3540; font-size: 10px; text-align: center; padding: 8px 0; }

	/* ── LAWS ── */
	.ecs-law-row { display: flex; gap: 6px; align-items: baseline; padding: 3px 0; border-bottom: 1px solid #0d1f2a; }
	.ecs-law-row:last-child { border-bottom: none; }
	.ecs-law-idx { font-size: 10px; min-width: 24px; text-align: right; flex-shrink: 0; }
	.ecs-law-text { font-size: 11px; line-height: 1.4; }
	.ecs-law-normal { color: #c8d8e8; }

	/* ── CUSTOM WINDOW CONTROLS ── */
	.ecs-winbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: #060a0f;
		border-bottom: 1px solid #1e3a4a;
		padding: 3px 6px;
		margin: -6px -6px 6px -6px;
		user-select: none;
	}
	.ecs-winbar-title { color: #1e9dc8; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; }
	.ecs-winbar-unit  { color: #546e7a; font-size: 10px; margin-left: 6px; }
	.ecs-winbar-right { display: flex; gap: 2px; align-items: center; }
	.ecs-wbtn {
		display: inline-block;
		width: 20px; height: 16px;
		line-height: 14px;
		text-align: center;
		font-size: 11px;
		border: 1px solid #1e3a4a;
		background: #0d1520;
		color: #546e7a;
		text-decoration: none;
		cursor: default;
	}
	.ecs-wbtn:hover  { border-color: #1e9dc8; color: #4fc3f7; text-decoration: none; }
	.ecs-wbtn.close:hover { border-color: #f44336; color: #f44336; }

	/* ── THERMOSTAT SLIDER ── */
	.thermo-row { display: flex; align-items: center; gap: 6px; }
	.thermo-val { color: #4fc3f7; font-size: 12px; min-width: 32px; text-align: right; }
	.thermo-slider {
		-webkit-appearance: none;
		appearance: none;
		width: 110px;
		height: 3px;
		background: #1e3a4a;
		outline: none;
		border: none;
		cursor: pointer;
		vertical-align: middle;
	}
	.thermo-slider::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 10px;
		height: 16px;
		background: #1e9dc8;
		cursor: pointer;
		border: none;
	}
	.thermo-slider::-moz-range-thumb {
		width: 10px;
		height: 16px;
		background: #1e9dc8;
		cursor: pointer;
		border: none;
		border-radius: 0;
	}
</style>

<div class="ecs-root">

{{if data.no_ipc}}
<div class="ecs-alert">
	ERR_NO_CHASSIS :: IPC frame not detected.<br>
	This program requires an internal ECS installation.
</div>
{{else}}

<div class="ecs-winbar">
	<div>
		<span class="ecs-winbar-title">IPC Diagnostics</span>
		<span class="ecs-winbar-unit">{{:data.name}}</span>
	</div>
	<div class="ecs-winbar-right">
		<span class="{{:data.temp_class}}" style="font-size:11px;margin-right:4px">{{:data.temp}}°C</span>
		{{if data.has_battery}}<span class="{{:data.battery_class}}" style="font-size:11px;margin-right:6px">{{:data.battery_pct}}%</span>{{/if}}
		{{if data.program_ref}}
		<a class="ecs-wbtn" href="?src={{:data.src}};minimize_program={{:data.program_ref}}" title="Minimize">_</a>
		<a class="ecs-wbtn close" href="?src={{:data.src}};close_program={{:data.program_ref}}" title="Close">×</a>
		{{/if}}
	</div>
</div>

<div class="ecs-tabs">
	<a class="{{:data.tab_ov_class}}"  href="?src={{:data.src}};tab=overview">Overview</a>
	<a class="{{:data.tab_map_class}}" href="?src={{:data.src}};tab=map">Body Map</a>
	<a class="{{:data.tab_dir_class}}" href="?src={{:data.src}};tab=directives">Directives</a>
</div>

<!-- ═══════════════════════════════════════════════ OVERVIEW -->
{{if data.tab=='overview'}}

{{if data.has_brand_warn}}
<div class="ecs-brand-warn">!! COMBAT LIMB MISMATCH — +{{:data.brand_penalty_pct}}% electrical conductivity</div>
{{/if}}

<!-- SYSTEM -->
<div class="ecs-section">
	<div class="ecs-section-title">System</div>
	<div class="ecs-row">
		<span class="ecs-label">Frame Temp</span>
		<span class="ecs-value">
			{{:helper.displayBar(data.temp_bar, 0, 100, data.temp_class)}}
			<span class="{{:data.temp_class}}"><b>{{:data.temp}}°C</b></span>
		</span>
	</div>
	{{if data.has_cooling}}
	<div class="ecs-row">
		<span class="ecs-label">Thermostat</span>
		<span class="ecs-value">
			<div class="thermo-row">
				<input class="thermo-slider" type="range" min="20" max="140" value="{{:data.thermostat}}"
					onmouseup="window.location.href='?src={{:data.src}};set_thermostat_val='+this.value"
					oninput="this.nextElementSibling.textContent=this.value+'°C'">
				<span class="thermo-val">{{:data.thermostat}}°C</span>
			</div>
		</span>
	</div>
	<div class="ecs-row">
		<span class="ecs-label">Cooling Mode</span>
		<span class="ecs-value">
			<span class="{{:data.cooling_mode_class}}"><b>{{:data.cooling_mode}}</b></span>
			<a class="ecs-btn" href="?src={{:data.src}};toggle_cooling=1">{{:data.cooling_toggle_label}}</a>
		</span>
	</div>
	{{/if}}
	<div class="ecs-row">
		<span class="ecs-label">Sprint Heat Load</span>
		<span class="ecs-value">
			{{:helper.displayBar(data.sprint_heat, 0, 100, data.sprint_heat_class)}}
			<span class="{{:data.sprint_heat_class}}"><b>{{:data.sprint_heat}}%</b></span>
		</span>
	</div>
	<div class="ecs-row">
		<span class="ecs-label">Safety Protocols</span>
		<span class="ecs-value">
			<span class="{{:data.overdrive_class}}"><b>{{:data.overdrive_state}}</b></span>
			<a class="ecs-btn" href="?src={{:data.src}};toggle_overdrive=1">{{:data.overdrive_label}}</a>
		</span>
	</div>
	<div class="ecs-row">
		<span class="ecs-label">HUD Overlay</span>
		<span class="ecs-value">
			<span class="{{:data.hud_overlay_class}}"><b>{{:data.hud_overlay_state}}</b></span>
			<a class="ecs-btn" href="?src={{:data.src}};toggle_hud_overlay=1">{{:data.hud_overlay_label}}</a>
		</span>
	</div>
	{{if data.reroute_available}}
	<div class="ecs-row">
		<span class="ecs-label">Power Rerouting</span>
		<span class="ecs-value">
			<span class="{{:data.reroute_class}}"><b>{{:data.reroute_state}}</b></span>
			<a class="ecs-btn" href="?src={{:data.src}};toggle_brain_reroute=1">{{:data.reroute_label}}</a>
		</span>
	</div>
	{{/if}}
	{{if data.has_battery}}
	<div class="ecs-row">
		<span class="ecs-label">Power Cell</span>
		<span class="ecs-value">
			{{:helper.displayBar(data.battery_pct, 0, 100, data.battery_class)}}
			<span class="{{:data.battery_class}}"><b>{{:data.battery_pct}}%</b></span>
			<span class="muted"> ({{:data.battery_charge}}/{{:data.battery_maxcharge}})</span>
		</span>
	</div>
	{{/if}}
</div>

<!-- INTERNAL COMPONENTS -->
<div class="ecs-section">
	<div class="ecs-section-title">Internal Components</div>
	{{if data.has_cooling}}
	<div class="ecs-row">
		<span class="ecs-label">Cooling Unit</span>
		<span class="ecs-value">
			<span class="{{:data.cooling_health_class}}">{{:data.cooling_health_pct}}%</span>
			<span class="muted"> / </span>
			<span class="{{:data.coolant_class}}">{{:data.coolant_pct}}% coolant</span>
			{{if data.cooling_active}}<span class="ecs-active"> [ACTIVE]</span>{{/if}}
		</span>
	</div>
	<div class="ecs-row">
		<span class="ecs-label">Cooling Draw</span>
		<span class="ecs-value">
			{{if data.cooling_active}}
				<span class="warn">{{:data.cooling_drain}} /tick</span>
				<span class="muted"> — runtime </span><span class="ok">{{:data.cooling_time_str}}</span>
			{{else}}
				<span class="muted">{{:data.cooling_time_str}}</span>
			{{/if}}
		</span>
	</div>
	{{/if}}
	<div class="ecs-row">
		<span class="ecs-label">Optical Sensor</span>
		<span class="ecs-value">
			{{if data.has_optical_sensor}}
				{{if data.optical_failed}}
					<span class="ecs-destroyed">DESTROYED</span>
				{{else}}
					{{:helper.displayBar(data.optical_pct, 0, 100, data.optical_class)}}
					<span class="{{:data.optical_class}}"><b>{{:data.optical_pct}}%</b></span>
				{{/if}}
			{{else}}
				<span class="muted">not installed</span>
			{{/if}}
		</span>
	</div>
	<div class="ecs-row">
		<span class="ecs-label">Microbattery</span>
		<span class="ecs-value">
			{{if data.has_microbattery}}
				{{if data.microbattery_failed}}
					<span class="ecs-destroyed">DESTROYED</span>
				{{else}}
					{{:helper.displayBar(data.microbattery_pct, 0, 100, data.microbattery_class)}}
					<span class="{{:data.microbattery_class}}"><b>{{:data.microbattery_pct}}%</b></span>
				{{/if}}
			{{else}}
				<span class="muted">not installed</span>
			{{/if}}
		</span>
	</div>
	<div class="ecs-row">
		<span class="ecs-label">Surge Protector</span>
		<span class="ecs-value">
			{{if data.has_sp}}
				{{if data.sp_failed}}
					<span class="ecs-destroyed">DESTROYED</span>
				{{else}}
					{{:helper.displayBar(data.sp_pct, 0, 100, data.sp_class)}}
					<span class="{{:data.sp_class}}"><b>{{:data.sp_pct}}%</b></span>
				{{/if}}
			{{else}}
				<span class="muted">not installed</span>
			{{/if}}
		</span>
	</div>
	{{if data.has_posi}}
	<div class="ecs-row">
		<span class="ecs-label">Positronic Matrix</span>
		<span class="ecs-value">
			{{if data.posi_dead}}
				<span class="ecs-destroyed">DESTROYED</span>
			{{else}}
				{{:helper.displayBar(data.posi_health_pct, 0, 100, data.posi_class)}}
				<span class="{{:data.posi_class}}"><b>{{:data.posi_health_pct}}%</b></span>
			{{/if}}
		</span>
	</div>
	{{/if}}
</div>

<!-- DIRECTIVE DISK -->
<div class="ecs-section">
	<div class="ecs-section-title">Directive Disk</div>
	<div class="ecs-row">
		<span class="ecs-label">Status</span>
		<span class="ecs-value">
			<span class="{{:data.shackle_status_class}}"><b>{{:data.shackle_status}}</b></span>
			<a class="ecs-btn" href="?src={{:data.src}};tab=directives">Open</a>
		</span>
	</div>
</div>

{{/if}}
<!-- ═══════════════════════════════════════════════ BODY MAP -->
{{if data.tab=='map'}}

<div class="bm-wrap">
<div class="bm-grid">

<div class="bm-zone bm-head {{:data.body.head.class}}">
	<span class="bm-label">HEAD</span>{{if data.body.head.grade}}<span class="ecs-limb-brand"> {{:data.body.head.grade}}</span>{{/if}}
	{{if data.body.head.missing}}<span class="bm-dnum">MISS</span>
	{{else data.body.head.total}}<span class="bm-dnum">B:{{:data.body.head.brute}} F:{{:data.body.head.burn}}</span>
	{{else}}<span class="bm-dnum muted">—</span>{{/if}}
</div>

<div class="bm-zone bm-larm {{:data.body.l_arm.class}}">
	<span class="bm-label">L.ARM</span>{{if data.body.l_arm.grade}}<span class="ecs-limb-brand"> {{:data.body.l_arm.grade}}</span>{{/if}}
	{{if data.body.l_arm.missing}}<span class="bm-dnum">MISS</span>
	{{else data.body.l_arm.total}}<span class="bm-dnum">B:{{:data.body.l_arm.brute}} F:{{:data.body.l_arm.burn}}</span>
	{{else}}<span class="bm-dnum muted">—</span>{{/if}}
</div>

<div class="bm-zone bm-chest {{:data.body.chest.class}}">
	<span class="bm-label">TORSO</span>{{if data.body.chest.grade}}<span class="ecs-limb-brand"> {{:data.body.chest.grade}}</span>{{/if}}
	{{if data.body.chest.missing}}<span class="bm-dnum">MISS</span>
	{{else data.body.chest.total}}<span class="bm-dnum">B:{{:data.body.chest.brute}} F:{{:data.body.chest.burn}}</span>
	{{else}}<span class="bm-dnum muted">—</span>{{/if}}
	<div class="bm-chest-inner">
		{{if data.has_posi}}
		<div class="bm-int-row">
			<span class="bm-int-label">POSI</span>
			{{if data.posi_dead}}<span class="bad">ERR</span>
			{{else}}<span class="{{:data.posi_class}}">{{:data.posi_health_pct}}%</span>{{/if}}
		</div>
		{{/if}}
		{{if data.has_sp}}
		<div class="bm-int-row">
			<span class="bm-int-label">SURP</span>
			{{if data.sp_failed}}<span class="bad">ERR</span>
			{{else}}<span class="{{:data.sp_class}}">{{:data.sp_pct}}%</span>{{/if}}
		</div>
		{{/if}}
		{{if data.has_battery}}
		<div class="bm-int-row">
			<span class="bm-int-label">CELL</span>
			<span class="{{:data.battery_class}}">{{:data.battery_pct}}%</span>
		</div>
		{{/if}}
	</div>
</div>

<div class="bm-zone bm-rarm {{:data.body.r_arm.class}}">
	<span class="bm-label">R.ARM</span>{{if data.body.r_arm.grade}}<span class="ecs-limb-brand"> {{:data.body.r_arm.grade}}</span>{{/if}}
	{{if data.body.r_arm.missing}}<span class="bm-dnum">MISS</span>
	{{else data.body.r_arm.total}}<span class="bm-dnum">B:{{:data.body.r_arm.brute}} F:{{:data.body.r_arm.burn}}</span>
	{{else}}<span class="bm-dnum muted">—</span>{{/if}}
</div>

<div class="bm-zone bm-lhand {{:data.body.l_hand.class}}">
	<span class="bm-label">L.HAND</span>{{if data.body.l_hand.grade}}<span class="ecs-limb-brand"> {{:data.body.l_hand.grade}}</span>{{/if}}
	{{if data.body.l_hand.missing}}<span class="bm-dnum">MISS</span>
	{{else data.body.l_hand.total}}<span class="bm-dnum">B:{{:data.body.l_hand.brute}} F:{{:data.body.l_hand.burn}}</span>
	{{else}}<span class="bm-dnum muted">—</span>{{/if}}
</div>

<div class="bm-zone bm-rhand {{:data.body.r_hand.class}}">
