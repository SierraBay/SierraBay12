{{if data.tab=='directives'}}

<div class="ecs-section">
	<div class="ecs-section-title">Directive Disk</div>
	<div class="ecs-row">
		<span class="ecs-label">Status</span>
		<span class="ecs-value"><span class="{{:data.shackle_status_class}}"><b>{{:data.shackle_status}}</b></span></span>
	</div>
	{{if data.shackle_module}}
	<div class="ecs-row">
		<span class="ecs-label">Media</span>
		<span class="ecs-value">{{:data.shackle_module}}</span>
	</div>
	{{/if}}
	{{if data.directive_set_name}}
	<div class="ecs-row">
		<span class="ecs-label">Profile</span>
		<span class="ecs-value">{{:data.directive_set_name}}</span>
	</div>
	{{/if}}
</div>

{{if data.has_directives}}
<div class="ecs-section">
	<div class="ecs-section-title">Active Directives</div>
	{{for data.directives}}
	<div class="ecs-law-row">
		{{if value.zero}}<span class="ecs-law-idx bad">0.</span>
		{{else value.ion}}<span class="ecs-law-idx warn">ION</span>
		{{else}}<span class="ecs-law-idx muted">{{:value.index}}.</span>{{/if}}
		<span class="ecs-law-text {{:value.law_class}}">{{:value.text}}</span>
	</div>
	{{/for}}
	<div class="ecs-row">
		<span class="ecs-label">Vocalizer</span>
		<span class="ecs-value">
			<a class="ecs-btn" href="?src={{:data.src}};broadcast_directives=1">Recite</a>
		</span>
	</div>
</div>
{{else}}
<div class="ecs-section">
	<div class="ecs-section-title">Active Directives</div>
	<div class="ecs-row">
		<span class="muted">No chassis directives loaded. Seat a directive disk in the ECS to bind this unit.</span>
	</div>
</div>
{{/if}}

{{/if}}

{{/if}}
