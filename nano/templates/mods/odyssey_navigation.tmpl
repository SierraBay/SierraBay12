<!-- Odyssey sector navigation console — FTL-style IC map -->
{{:helper.TechMode()}}
<style>
	.odysseyShell {
		position: relative;
		height: 640px;
		overflow: hidden;
		box-sizing: border-box;
		border: 2px solid #9a9a9a;
		border-radius: 10px;
		background: #14100f;
		color: #f0f0f0;
		font-family: "Lucida Console", "Courier New", monospace;
	}
	.odysseyShell::before {
		content: "";
		pointer-events: none;
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 0;
		opacity: .18;
		background: repeating-linear-gradient(
			to bottom,
			rgba(255,255,255,.04) 0px,
			rgba(255,255,255,.04) 1px,
			transparent 1px,
			transparent 3px
		);
	}
	.odysseyTitle {
		position: absolute;
		z-index: 4;
		top: 14px;
		left: 18px;
		font-size: 28px;
		font-weight: bold;
		letter-spacing: 3px;
		color: #ffffff;
		text-shadow: 3px 3px 0 #000;
	}
	.odysseyStatus {
		position: absolute;
		z-index: 4;
		top: 48px;
		left: 18px;
		font-size: 12px;
		color: #c8c0b8;
	}
	.odysseyMap {
		position: absolute;
		z-index: 1;
		left: 0;
		right: 0;
		top: 0;
		bottom: 54px;
	}
	.odysseySvg {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.odysseyNode {
		position: absolute;
		z-index: 2;
		width: 16px;
		height: 16px;
		margin-left: -8px;
		margin-bottom: -8px;
		border-radius: 50%;
		box-sizing: border-box;
		border: 1px solid rgba(0,0,0,.55);
	}
	.odysseyNode--civilian { background: #3fd03a; box-shadow: 0 0 6px #3fd03a; }
	.odysseyNode--hostile { background: #e23b3b; box-shadow: 0 0 6px #e23b3b; }
	.odysseyNode--nebula { background: #9b4fd6; box-shadow: 0 0 6px #9b4fd6; }
	.odysseyNode--locked { opacity: .45; }
	.odysseyNode--current {
		box-shadow: 0 0 0 2px #fff, 0 0 10px #fff;
	}
	.odysseyNode--selected {
		box-shadow: 0 0 0 2px #ffe14a, 0 0 12px #ffe14a;
	}
	.odysseyBracket {
		position: absolute;
		z-index: 3;
		width: 28px;
		height: 28px;
		margin-left: -14px;
		margin-bottom: -14px;
		pointer-events: none;
		background:
			linear-gradient(#ffe14a, #ffe14a) left top / 8px 2px no-repeat,
			linear-gradient(#ffe14a, #ffe14a) left top / 2px 8px no-repeat,
			linear-gradient(#ffe14a, #ffe14a) right top / 8px 2px no-repeat,
			linear-gradient(#ffe14a, #ffe14a) right top / 2px 8px no-repeat,
			linear-gradient(#ffe14a, #ffe14a) left bottom / 8px 2px no-repeat,
			linear-gradient(#ffe14a, #ffe14a) left bottom / 2px 8px no-repeat,
			linear-gradient(#ffe14a, #ffe14a) right bottom / 8px 2px no-repeat,
			linear-gradient(#ffe14a, #ffe14a) right bottom / 2px 8px no-repeat;
	}
	.odysseyLabel {
		position: absolute;
		z-index: 4;
		margin-left: 18px;
		margin-bottom: -10px;
		padding: 3px 7px;
		white-space: nowrap;
		border: 1px solid #d8d8d8;
		background: #0a0a0a;
		color: #ffffff;
		font-size: 11px;
		line-height: 1.2;
		text-decoration: none;
	}
	.odysseyLabel a,
	.odysseyLabel .link {
		color: #ffffff !important;
		background: transparent !important;
		border: 0 !important;
		padding: 0 !important;
		margin: 0 !important;
		text-decoration: none !important;
		box-shadow: none !important;
	}
	.odysseyShip {
		position: absolute;
		z-index: 3;
		width: 0;
		height: 0;
		margin-left: -28px;
		margin-bottom: -6px;
		border-top: 6px solid transparent;
		border-bottom: 6px solid transparent;
		border-left: 14px solid #3fd03a;
		filter: drop-shadow(1px 1px 0 #000);
	}
	.odysseyFooter {
		position: absolute;
		z-index: 4;
		left: 10px;
		right: 10px;
		bottom: 8px;
		height: 38px;
		padding: 0 14px;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		border: 1px solid #9a9a9a;
		border-radius: 8px;
		background: rgba(10, 8, 8, .92);
		font-size: 12px;
	}
	.odysseyLegend {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.odysseyLegendItem {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: #f0f0f0;
	}
	.odysseyDot {
		display: inline-block;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		border: 1px solid rgba(0,0,0,.5);
	}
	.odysseyDot--civilian { background: #3fd03a; }
	.odysseyDot--hostile { background: #e23b3b; }
	.odysseyDot--nebula { background: #9b4fd6; }
	.odysseyCourse {
		color: #d7d0c8;
		text-align: right;
	}
	.odysseyActions {
		position: absolute;
		z-index: 5;
		top: 14px;
		right: 14px;
		text-align: right;
	}
	.odysseyActions .link {
		display: inline-block;
		margin-left: 6px;
		margin-bottom: 6px;
	}
	.odysseyInactive {
		position: absolute;
		z-index: 2;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		width: 70%;
		padding: 24px;
		text-align: center;
		border: 1px solid #9a9a9a;
		border-radius: 8px;
		background: rgba(0,0,0,.55);
		font-size: 16px;
	}
</style>

<div class="odysseyShell">
	<div class="odysseyTitle">SECTOR MAP</div>

	{{if !data.active}}
		<div class="odysseyInactive">Навигационная сеть Одиссеи неактивна.<br>Нет активной секторной кампании.</div>
	{{else}}
		<div class="odysseyStatus">
			Эшелон {{:data.shift}}/{{:data.max_shifts}} · Текущий сектор: {{:data.current_name}}
		</div>

		{{if data.can_access}}
			<div class="odysseyActions">
				{{if data.terminal}}
					{{:helper.link("Завершить Одиссею", '', {'select': 'complete'})}}
				{{else}}
					{{:helper.link("Курс домой", '', {'select': 'return'})}}
				{{/if}}
			</div>
		{{/if}}

		<div class="odysseyMap">
			<svg class="odysseySvg" viewBox="0 0 100 100" preserveAspectRatio="none">
				{{for data.lines}}
					<line x1="{{:value.x1}}" y1="{{:value.y1}}" x2="{{:value.x2}}" y2="{{:value.y2}}" stroke="#d8d8d8" stroke-width="0.35" vector-effect="non-scaling-stroke" />
				{{/for}}
			</svg>

			{{for data.nodes}}
				{{if value.current}}
					<div class="odysseyShip" style="left:{{:value.x}}%;bottom:{{:value.y}}%;" title="Текущее положение"></div>
				{{/if}}
				<div class="odysseyNode odysseyNode--{{:value.visual}} {{:value.available || value.current ? '' : 'odysseyNode--locked'}} {{:value.current ? 'odysseyNode--current' : ''}} {{:value.selected ? 'odysseyNode--selected' : ''}}" style="left:{{:value.x}}%;bottom:{{:value.y}}%;" title="{{:value.name}}"></div>
				{{if value.available}}
					<div class="odysseyBracket" style="left:{{:value.x}}%;bottom:{{:value.y}}%;"></div>
					{{if data.can_access}}
						<div class="odysseyLabel" style="left:{{:value.x}}%;bottom:{{:value.y}}%;">
							{{:helper.link(value.choice_label, '', {'select': value.id})}}
						</div>
					{{else}}
						<div class="odysseyLabel" style="left:{{:value.x}}%;bottom:{{:value.y}}%;">{{:value.choice_label}}</div>
					{{/if}}
				{{/if}}
			{{/for}}
		</div>

		<div class="odysseyFooter">
			<div class="odysseyLegend">
				<span class="odysseyLegendItem"><span class="odysseyDot odysseyDot--civilian"></span> Гражданский</span>
				<span class="odysseyLegendItem"><span class="odysseyDot odysseyDot--hostile"></span> Враждебный</span>
				<span class="odysseyLegendItem"><span class="odysseyDot odysseyDot--nebula"></span> Туманность</span>
			</div>
			<div class="odysseyCourse">
				Курс: {{:data.selected_name}}
				{{if data.selected_by}} · Подтвердил: {{:data.selected_by}}{{/if}}
				{{if !data.can_access}} · Требуется доступ командования{{/if}}
			</div>
		</div>
	{{/if}}
</div>
