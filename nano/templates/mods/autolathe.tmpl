	min-width: 0;
	line-height: 1.3;
	cursor: pointer;
}

.fabConsole .hasIcon {
	padding: 1px 6px 3px 2px;
}

.fabConsole a:hover,
.fabConsole .link:hover,
.fabConsole .linkActive:hover {
	background: rgba(40, 70, 120, 0.8);
	border-color: rgba(80, 140, 220, 0.55);
	color: #cce4ff;
	box-shadow: 0 0 6px rgba(60, 130, 220, 0.15);
}

.fabConsole .selected,
.fabConsole a.selected:link,
.fabConsole a.selected:visited,
.fabConsole a.selected:active,
.fabConsole a.selected:hover {
	background: rgba(30, 80, 50, 0.75);
	border-color: rgba(60, 160, 80, 0.5);
	color: #88eea0;
	box-shadow: 0 0 6px rgba(60, 160, 80, 0.2);
}

.fabConsole .linkOn,
.fabConsole a.linkOn:link,
.fabConsole a.linkOn:visited,
.fabConsole a.linkOn:active,
.fabConsole a.linkOn:hover {
	background: rgba(30, 80, 50, 0.75);
	border-color: rgba(60, 160, 80, 0.5);
	color: #88eea0;
}

.fabConsole .disabled,
.fabConsole a.disabled:link,
.fabConsole a.disabled:visited,
.fabConsole a.disabled:active,
.fabConsole a.disabled:hover {
	background: rgba(30, 36, 48, 0.5);
	border-color: rgba(50, 60, 80, 0.4);
