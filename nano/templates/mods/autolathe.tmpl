<!--
Title: Autolathe
Used In File(s): \code\game\machinery\autolathe.dm
 -->

<div class="fabConsole">

<div class="fabHeader">
	<span class="fabHeaderTitle">&#9881; ФАБРИКАТОР</span>
	<span class="fabHeaderStatus">
		{{if data.paused}}
			<span class="fabStatusBadge fabStatusBadge--paused">ПАУЗА</span>
		{{else data.current}}
			<span class="fabStatusBadge fabStatusBadge--active">РАБОТА</span>
		{{else}}
			<span class="fabStatusBadge fabStatusBadge--idle">ОЖИДАНИЕ</span>
		{{/if}}
	</span>
</div>

<!-- Materials & Reagents Row -->
<div class="fabResourceRow">
	{{if data.have_materials && data.have_reagents}}
		<div class="fabResourceCol">
			{{#def._materials}}
		</div>
		<div class="fabResourceCol">
			{{#def._reagents}}
		</div>
	{{else data.have_materials}}
		<div style="width: 100%;">
			{{#def._materials}}
		</div>
	{{else data.have_reagents}}
		<div style="width: 100%;">
			{{#def._reagents}}
		</div>
	{{/if}}
</div>

<!-- Disk Slots -->
{{if data.have_disk}}
<div class="fabSection">
	<div class="fabSectionContent" style="padding: 5px 10px;">
		<div class="fabDiskRow">
			<span class="fabDiskLabel">ДИСК:</span>
			{{if data.disk}}
				<span class="fabDiskName">{{:data.disk.name ? data.disk.name : 'data disk'}}</span>
				{{if data.disk.license > 0}}
					<span class="fabDiskLicense">{{:data.disk.license}} лицензий</span>
				{{else data.disk.license == 0}}
					<span class="fabDiskLicense fabDiskLicense--empty">0 лицензий</span>
				{{/if}}
			{{else}}
				<span class="fabMuted">не вставлен</span>
			{{/if}}
			<span style="margin-left: auto;">{{:helper.link(data.disk ? 'Извлечь' : 'Вставить', 'eject', {'disk' : 1})}}</span>
		</div>
	</div>
</div>
{{/if}}

{{if data.have_disk2}}
<div class="fabSection">
	<div class="fabSectionContent" style="padding: 5px 10px;">
		<div class="fabDiskRow">
			<span class="fabDiskLabel">ДИСК 2:</span>
			{{if data.disk2}}
				<span class="fabDiskName">{{:data.disk2.name ? data.disk2.name : 'data disk'}}</span>
				{{if data.disk2.license > 0}}
					<span class="fabDiskLicense">{{:data.disk2.license}} лицензий</span>
				{{else data.disk2.license == 0}}
					<span class="fabDiskLicense fabDiskLicense--empty">0 лицензий</span>
				{{/if}}
			{{else}}
				<span class="fabMuted">не вставлен</span>
			{{/if}}
			<span style="margin-left: auto;">{{:helper.link(data.disk2 ? 'Извлечь' : 'Вставить', 'eject', {'disk2' : 1})}}</span>
		</div>
	</div>
</div>
{{/if}}

<!-- Skill Quality Notice -->
{{if data.uses_stat}}
<div class="fabSection">
	<div class="fabSectionContent" style="padding: 5px 10px;">
		<span class="fabLabel">Качество деталей:</span>
		<span class="{{:data.max_quality >= 0 ? 'good' : 'average'}}">{{:data.max_quality < 0 ? data.max_quality : '+' + data.max_quality}}</span>
	</div>
</div>
{{/if}}

<!-- Categories Bar -->
{{if data.categories}}
<div class="fabSection">
	<div class="fabSectionContent fabCategoryBar">
		{{for data.categories :category:category_i}}
			{{:helper.link(category, null, {'category' : category_i+1}, category == data.show_category ? 'selected' : null, 'fabCatBtn')}}
		{{empty}}
			<span class="fabMuted">Нет известных дизайнов</span>
		{{/for}}
	</div>
</div>
{{/if}}

<!-- Designs & Queue Columns -->
<div class="fabMainArea">
	<div class="fabDesignCol">
		<div class="fabSection fabDesignSection">
			<div class="fabSectionTitle">Дизайны</div>
			<div class="fabSectionContent fabDesignList">
				{{#def._designs}}
			</div>
		</div>
	</div>
	<div class="fabQueueCol">
		{{#def._queue}}
	</div>
</div>

</div>

<style>

/* === Fabricator Console Root === */
