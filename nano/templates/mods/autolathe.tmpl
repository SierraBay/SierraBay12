}

.fabConsole .warning:hover {
	background: rgba(140, 60, 15, 0.75) !important;
	border-color: rgba(220, 120, 40, 0.6) !important;
	color: #ffcc88 !important;
}

.fabConsole a.icon,
.fabConsole .link.icon,
.fabConsole .linkActive.icon,
.fabConsole .linkOn.icon,
.fabConsole .linkOff.icon,
.fabConsole .selected.icon,
.fabConsole .disabled.icon {
