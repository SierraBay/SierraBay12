		.tn-wrap .tn-basket-actions { margin-top: 8px; }
		.tn-wrap .tn-basket-actions > * { margin-bottom: 4px; }
	}
</style>

<div class="tn-wrap" data-scroll-id="tn-wrap"><div class="tn-stack">
	<div class="tn-nav-bar"><div class="tn-nav-tabs">
		{{:helper.link('Market', 'search', {'PRG_trade_screen' : 'goods'}, data.screen == 'goods' ? 'selected' : null, 'tn-nav-btn')}}
		{{:helper.link('Cart' + (data.cart_count ? ' <span class="tn-nav-badge">' + data.cart_count + '</span>' : ''), 'cart', {'PRG_trade_screen' : 'cart'}, data.screen == 'cart' ? 'selected' : null, 'tn-nav-btn')}}
		{{:helper.link('Orders' + (data.order_count ? ' <span class="tn-nav-badge">' + data.order_count + '</span>' : ''), 'tag', {'PRG_trade_screen' : 'orders'}, data.screen == 'orders' ? 'selected' : null, 'tn-nav-btn')}}
		{{:helper.link('Account', 'gear', {'PRG_trade_screen' : 'account'}, data.screen == 'account' ? 'selected' : null, 'tn-nav-btn tn-settings-tab')}}
	</div></div>
	{{if data.screen == 'goods'}}
		<div class="tn-summary"><div class="tn-summary-meta"><span><span class="tn-panel-label">Account:</span> {{if data.has_account}}{{>data.account_owner_name}} <span class="font-mono">({{>formatTradeAmount(data.account_money)}} {{>data.currency_short}})</span>{{else}}Not linked{{/if}}</span></div><div class="tn-flex-row-sm">{{if !data.has_account}}{{if data.can_link_id_account}}{{:helper.link('Use ID card', 'check', {'PRG_account_id' : 1}, null, 'tn-btn tn-btn-outline')}}{{else}}{{:helper.link('Link account', 'gear', {'PRG_trade_screen' : 'account'}, null, 'tn-btn tn-btn-outline')}}{{/if}}{{/if}}{{:helper.link('View cart', 'cart', {'PRG_trade_screen' : 'cart'}, null, 'tn-btn tn-btn-outline')}}</div></div>
			<div class="tn-screen-view" data-view="screen-goods" data-view-screen="market">
				<div class="tn-market-trader">
					{{if !data.has_visible_stations}}
						<div class="tn-empty">No trade stations in sensor range.</div>
					{{else}}
						<label for="cargo-trader-select">Trader</label>
						<select id="cargo-trader-select" class="tn-station-select" onchange="if(this.value){ var fn = window.NanoUtility &amp;&amp; window.NanoUtility.generateHref; window.location.href = fn ? fn({'PRG_station': this.value}) : ('?src={{:uiSrc}};PRG_station=' + encodeURIComponent(this.value)); }">
							{{for data.stations:station_entry:station_index}}
								<option value="{{:station_entry.uid}}" {{if station_entry.selected}}selected{{/if}}>{{>station_entry.name}} &mdash; {{>station_entry.status_label}}</option>
							{{/for}}
						</select>
						{{if selectedTrader}}<div class="tn-trader-meta"><span class="tn-muted">{{>selectedTrader.faction}}</span><span class="tn-tag tn-tag-{{:selectedTrader.market_tone}}">{{>selectedTrader.market_label}}</span></div>{{/if}}
					{{/if}}
				</div>
				<div class="tn-grid">
					{{if data.has_selected_station}}
						<div class="tn-col tn-market-sidebar">
							<div class="tn-panel">
								<div class="tn-panel-title">Categories</div>
								<hr class="tn-section-divider">
								{{if data.selected_station && data.selected_station.block_reason}}
									<div class="tn-empty">Catalog blocked.</div>
								{{else data.categories && data.categories.length}}
									<div class="tn-category-vertical-list tn-scroll-box" data-scroll-id="tn-category-list">
										{{for data.categories:category_entry:category_index}}
											{{:helper.link(category_entry.name, null, {'PRG_goods_category' : category_entry.name}, category_entry.selected ? 'selected' : null, 'tn-category-item ')}}
										{{/for}}
									</div>
								{{else}}
									<div class="tn-empty">No categories available.</div>
								{{/if}}
							</div>
						</div>
					{{/if}}
					<div class="tn-col tn-market-main">
						{{if data.has_selected_station}}
							<div class="tn-catalog-header-bar">
								<div class="tn-catalog-title">
									{{if data.selected_category && !data.selected_station.block_reason}}{{>data.selected_category}}{{else}}Catalog{{/if}}
								</div>
								<div class="tn-filter-controls">
									<div class="tn-search-box">
										<span class="tn-search-icon uiIcon16 icon-search" aria-hidden="true"></span>
										<input type="text" id="cargo-search-input" class="tn-search-input font-mono" placeholder="Search this category" aria-label="Search this category" oninput="window.cargoLiveFilter &amp;&amp; window.cargoLiveFilter()" onpropertychange="window.cargoLiveFilter &amp;&amp; window.cargoLiveFilter()" onkeyup="window.cargoLiveFilter &amp;&amp; window.cargoLiveFilter()">
										<button type="button" class="tn-search-clear" title="Clear search" onclick="var inp=document.getElementById('cargo-search-input'); if(inp){ inp.value=''; window.cargoLiveFilter &amp;&amp; window.cargoLiveFilter(); inp.focus(); }" aria-label="Clear search"><span class="uiIcon16 icon-close" aria-hidden="true"></span></button>
									</div>
									<select id="cargo-sort-select" aria-label="Sort items" class="tn-sort-select" onchange="window.cargoLiveSort &amp;&amp; window.cargoLiveSort()">
										<option value="default">Default order</option>
										<option value="price_asc">Price: Low &rarr; High</option>
										<option value="price_desc">Price: High &rarr; Low</option>
										<option value="name_asc">Name: A &rarr; Z</option>
										<option value="name_desc">Name: Z &rarr; A</option>
									</select>
									<div id="cargo-cards-counter" class="tn-cards-counter font-mono"></div>
								</div>
							</div>

							<div id="cargo-current-category" data-station="{{:data.selected_station.uid}}" data-cat="{{:data.selected_category}}" class="tn-hidden"></div>

							{{if data.selected_station.block_reason}}
								<div class="notice bad">{{>data.selected_station.block_reason}}</div>
								<div class="tn-empty-panel">
									<div class="tn-panel-title">Trader unavailable</div>
									<div class="tn-panel-subtitle tn-muted tn-empty-description">
										Move into sensor range or clear radio interference to view this inventory.
									</div>
								</div>
							{{else}}
								<div class="tn-scroll-box tn-goods-scroll" data-scroll-id="tn-goods-table">
									{{if data.goods && data.goods.length}}
										<table class="tn-catalog-table">
											<thead>
												<tr>
													<th class="tn-icon-col"></th>
													<th>Item</th>
													<th class="tn-stock-col tn-th-right">Stock</th>
													<th class="tn-price-col tn-th-right">Price</th>
													<th class="tn-quantity-col">Quantity</th>
												</tr>
											</thead>
											<tbody id="cargo-goods-tbody">
												{{for data.goods:good_entry:good_index}}
													<tr class="tn-good-row{{if good_entry.in_cart_amount > 0}} tn-in-cart{{/if}}{{if !good_entry.can_add}} tn-restricted{{/if}}" data-key="{{>data.selected_station.uid + '::' + data.selected_category + '::' + good_entry.id}}" data-name="{{>good_entry.name}}" data-price="{{:good_entry.price}}" data-stock="{{:good_entry.stock}}" data-id="{{:good_entry.id}}" data-index="{{:good_index}}">
														<td class="tn-icon-cell">
															<div class="tn-sprite-box">
																{{if good_entry.icon}}
																	<img class="tn-sprite-img" src="{{:good_entry.icon}}" alt="{{>good_entry.name}}">
																{{else}}
																		<span class="tn-sprite-placeholder uiIcon16 icon-cart" aria-hidden="true"></span>
																{{/if}}
															</div>
														</td>
														<td>
															<button type="button" class="tn-item-toggle" aria-expanded="false" aria-controls="cargo-good-details-{{:good_index}}" onclick="window.cargoToggleGoodDetails &amp;&amp; window.cargoToggleGoodDetails(this)">
																<span class="tn-item-title"><span class="tn-item-marker" aria-hidden="true">+</span>{{>good_entry.name}}</span>
															</button>
															<div id="cargo-good-details-{{:good_index}}" class="tn-item-details tn-hidden">
																{{if good_entry.desc}}<p>{{>good_entry.desc}}</p>{{/if}}
																																{{if good_entry.markup_text}}<div class="tn-labeled-row"><span>Markup</span><span class="font-mono">{{>good_entry.markup_text}}</span></div>{{/if}}
															</div>
														</td>
														<td class="tn-number">
															{{if good_entry.stock <= 0}}
																<span class="font-mono tn-bad tn-bold">0</span>
															{{else}}
																<strong class="font-mono">{{:good_entry.stock}}</strong>
															{{/if}}
														</td>
														<td class="tn-number">
															<span class="font-mono tn-bold">
																{{>formatTradeAmount(good_entry.price)}} {{:data.currency_short}}
															</span>
														</td>
														<td class="tn-number">
															{{if !good_entry.can_add && !good_entry.in_cart_amount}}
																<span class="tn-muted">{{if good_entry.stock <= 0}}Out of stock{{else}}Unavailable{{/if}}</span>
															{{else}}
																<div class="tn-actions-wrap">
																	{{if good_entry.in_cart_amount > 0}}
																		<div class="tn-table-stepper">
																			{{:helper.link('-', null, {'PRG_cart_remove_direct' : data.selected_station.uid, 'PRG_cart_category_name' : data.selected_category, 'PRG_cart_good_id' : good_entry.id, 'PRG_cart_remove_amount' : 1}, null, 'tn-table-stepper-btn')}}
																			{{:helper.link(good_entry.in_cart_amount, null, {'PRG_goods_quantity_target' : good_entry.id}, null, 'tn-quantity-value font-mono')}}
																			{{:helper.link('+', null, {'PRG_cart_add_good' : good_entry.id, 'PRG_cart_add_amount' : 1}, (!good_entry.can_add || good_entry.in_cart_amount >= good_entry.stock) ? 'disabled' : null, 'tn-table-stepper-btn')}}
																		</div>
																	{{else}}
																		{{:helper.link('Add', null, {'PRG_cart_add_good' : good_entry.id, 'PRG_cart_add_amount' : 1}, null, 'tn-btn tn-btn-outline')}}
																	{{/if}}
																	{{if !good_entry.in_cart_amount}}{{:helper.link('Qty', null, {'PRG_goods_quantity_target' : good_entry.id}, null, 'tn-btn tn-btn-outline')}}{{/if}}
																</div>

																{{if good_entry.quantity_form_open}}
																	<div class="tn-popover-form">
																		<form class="tn-form" method="get" action="?src={{:uiSrc}}" onsubmit="return window.cargoValidateQuantityForm(this)">
																			<input type="hidden" name="src" value="{{:uiSrc}}">
																			<input type="hidden" name="PRG_cart_set_form" value="{{:good_entry.id}}">
																			<input type="number" name="PRG_cart_set_amount" aria-label="Item quantity" min="0" max="{{:good_entry.can_add ? good_entry.stock : Math.min(good_entry.in_cart_amount, good_entry.stock)}}" value="{{:Math.min(good_entry.in_cart_amount || 1, good_entry.stock)}}" class="tn-popover-input font-mono" required oninput="window.cargoClearFormError(this)">
																			<div class="tn-form-error tn-bad tn-full tn-hidden" role="alert"></div>
																			<input type="submit" value="Set" class="tn-btn tn-btn-primary">
																			{{:helper.link('Cancel', null, {'PRG_goods_quantity_cancel' : 1}, null, 'tn-btn tn-btn-outline')}}
																		</form>
																	</div>
																{{/if}}
															{{/if}}
														</td>
													</tr>
												{{/for}}
											</tbody>
										</table>
										<div id="cargo-search-no-results" class="tn-empty-panel tn-hidden">
											<div class="tn-panel-title">No matching items</div>
											<div class="tn-panel-subtitle tn-muted">Try adjusting your filter query or clearing the search.</div>
										</div>
									{{else}}
										<div class="tn-empty-panel">
											<div class="tn-panel-title">No goods in this category</div>
											<div class="tn-panel-subtitle tn-muted">Choose another category or trader.</div>
										</div>
									{{/if}}
								</div>
							{{/if}}
						{{else}}
							<div class="tn-empty-panel">
								<div class="tn-panel-title">Select a trader</div>
								<div class="tn-panel-subtitle tn-muted">Choose a trader to view its inventory.</div>
							</div>
						{{/if}}
					</div>
				</div>
			</div>
			{{if data.cart_count > 0}}
				<div class="tn-cart-footer">
					<div class="tn-basket-summary-row">
						<div class="tn-basket-lead">Cart: {{:data.cart_count}} items &middot; <span class="tn-basket-total font-mono">{{>formatTradeAmount(data.cart_total)}} {{:data.currency_short}}</span></div>
						<div class="tn-basket-actions">
							{{:helper.link('Request order', 'clipboard', {'PRG_cart_form' : 'order'}, canOpenOrderForm ? null : 'disabled', 'tn-btn tn-btn-primary')}}
							{{:helper.link('Details', 'cart', {'PRG_trade_screen' : 'cart'}, null, 'tn-btn tn-btn-outline')}}
							{{:helper.link('Clear', 'close', {'PRG_cart_reset' : 1}, null, 'tn-btn tn-btn-danger tn-confirm-clear')}}
						</div>
					</div>
					{{if !data.has_account}}<div class="tn-muted tn-space-top">Link an account to submit an order.</div>{{else data.account_money < data.cart_total}}<div class="tn-bad tn-space-top">Insufficient balance for items and handling fee.</div>{{/if}}
					{{if data.orders_locked}}<div class="tn-muted">Order requests are on cooldown.</div>{{/if}}
					{{if data.cart_form_mode == 'order'}}{{var requestReady = canOpenOrderForm;}}{{#def.order_request_form}}{{/if}}
				</div>
			{{/if}}

			<script id="cargo-market-script">
			window.cargoLiveFilter = function() {
				var searchInput = document.getElementById('cargo-search-input');
				var rawQuery = searchInput ? searchInput.value.toLowerCase().replace(/^\s+|\s+$/g, '') : '';
				var filterTokens = rawQuery ? rawQuery.split(/\s+/) : [];
				var tbody = document.getElementById('cargo-goods-tbody');
				if (!tbody) return;
				var rows = [];
				if (window.jQuery) {
					rows = $(tbody).find('.tn-good-row').get();
				} else if (tbody.querySelectorAll) {
					var nodeList = tbody.querySelectorAll('.tn-good-row');
					for (var k = 0; k < nodeList.length; k++) rows.push(nodeList[k]);
				}
				var visibleCount = 0;
				for (var i = 0; i < rows.length; i++) {
					var row = rows[i];
					var name = row.getAttribute('data-name') || '';
					if (!name) {
						var nameEl = row.querySelector ? row.querySelector('.tn-item-title') : (window.jQuery ? $(row).find('.tn-item-title')[0] : null);
						name = nameEl ? (nameEl.textContent || nameEl.innerText || '') : '';
					}
					name = name.toLowerCase();
					var match = true;
					for (var t = 0; t < filterTokens.length; t++) {
						if (name.indexOf(filterTokens[t]) === -1) {
							match = false;
							break;
						}
					}
					if (match) {
						row.style.display = '';
						visibleCount++;
					} else {
						row.style.display = 'none';
					}
				}
				var noResults = document.getElementById('cargo-search-no-results');
				if (noResults) {
					noResults.style.display = (visibleCount === 0 && rows.length > 0) ? 'block' : 'none';
				}
				var counter = document.getElementById('cargo-cards-counter');
				if (counter) {
					counter.innerHTML = visibleCount + (rawQuery ? ' / ' + rows.length : '') + ' items';
				}
				window._cargoSearchQuery = rawQuery;
			};

			window.cargoLiveSort = function(sortOverride) {
				var sortSelect = document.getElementById('cargo-sort-select');
				var sortVal = sortOverride || (sortSelect ? sortSelect.value : 'default');
				var tbody = document.getElementById('cargo-goods-tbody');
				if (!tbody) return;
				var focused = document.activeElement;
				var scrollBox = document.querySelector('.tn-goods-scroll');
				var scrollTop = scrollBox ? scrollBox.scrollTop : 0;
				var rows = [];
				if (window.jQuery) {
					rows = $(tbody).find('.tn-good-row').get();
				} else if (tbody.querySelectorAll) {
					var nodeList = tbody.querySelectorAll('.tn-good-row');
					for (var k = 0; k < nodeList.length; k++) rows.push(nodeList[k]);
				}
				if (!rows.length) return;

				rows.sort(function(a, b) {
					if (sortVal === 'price_asc') {
						return (parseFloat(a.getAttribute('data-price')) || 0) - (parseFloat(b.getAttribute('data-price')) || 0);
					} else if (sortVal === 'price_desc') {
						return (parseFloat(b.getAttribute('data-price')) || 0) - (parseFloat(a.getAttribute('data-price')) || 0);
					} else if (sortVal === 'name_asc' || sortVal === 'name_desc') {
						var nameA = (a.getAttribute('data-name') || '').toLowerCase();
						var nameB = (b.getAttribute('data-name') || '').toLowerCase();
						var cmp = nameA.localeCompare ? nameA.localeCompare(nameB) : (nameA < nameB ? -1 : (nameA > nameB ? 1 : 0));
						return sortVal === 'name_asc' ? cmp : -cmp;
					} else {
						return (parseInt(a.getAttribute('data-index'), 10) || 0) - (parseInt(b.getAttribute('data-index'), 10) || 0);
					}
				});

				for (var i = 0; i < rows.length; i++) {
					if (tbody.children[i] !== rows[i]) {
						tbody.insertBefore(rows[i], tbody.children[i] || null);
					}
				}
				if (focused && document.activeElement !== focused && window.jQuery && $.contains(tbody, focused)) {
					focused.focus();
				}
				if (scrollBox) scrollBox.scrollTop = scrollTop;
				if (!sortOverride) window._cargoSortVal = sortVal;
			};

			window.cargoApplyFilterAndSort = function() {
				var tbody = document.getElementById('cargo-goods-tbody');
				if (!tbody) return;

				var catEl = document.getElementById('cargo-current-category');
				var currentCatKey = catEl ? ((catEl.getAttribute('data-station') || '') + '::' + (catEl.getAttribute('data-cat') || '')) : '';
				if (window._cargoLastCategoryKey !== undefined && window._cargoLastCategoryKey !== currentCatKey) {
					window._cargoSearchQuery = '';
					var searchInput = document.getElementById('cargo-search-input');
					if (searchInput) searchInput.value = '';
				}
				window._cargoLastCategoryKey = currentCatKey;

				var searchInput = document.getElementById('cargo-search-input');
				if (searchInput && window._cargoSearchQuery !== undefined && window._cargoSearchQuery !== '') {
					searchInput.value = window._cargoSearchQuery;
				}
				var sortSelect = document.getElementById('cargo-sort-select');
				if (sortSelect && window._cargoSortVal !== undefined) {
					sortSelect.value = window._cargoSortVal;
				}
				if (window.cargoLiveSort) window.cargoLiveSort();
				if (window.cargoLiveFilter) window.cargoLiveFilter();
			};

			if (window.NanoStateManager && window.NanoStateManager.addBeforeUpdateCallback) {
