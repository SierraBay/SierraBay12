																	{{:helper.link('Remove', null, {'PRG_cart_remove_direct' : cart_item.station_uid, 'PRG_cart_category_name' : cart_item.category_name, 'PRG_cart_good_id' : cart_item.good_id, 'PRG_cart_remove_amount' : cart_item.amount}, null, 'tn-inlineLink')}}
																</div>
