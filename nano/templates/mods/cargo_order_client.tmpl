						<div class="section">
							<div class="section-title">Submit Order Request</div>
							<div class="section-content">
								{{if data.submit_block_reason}}
									<div class="notice average">{{:data.submit_block_reason}}</div>
								{{/if}}

								{{if data.orders_locked}}
									<div class="notice average">Ordering cooldown active. Please wait a few seconds.</div>
								{{/if}}

								<div class="tn-form-shell" style="margin-top: 8px;">
									<form class="tn-form" method="get" action="?src={{:data.src}}" onsubmit="if(!this.PRG_order_reason.value || !this.PRG_order_reason.value.trim()) { alert('Order reason is mandatory.'); return false; }">
										<input type="hidden" name="src" value="{{:data.src}}">
										<input type="hidden" name="PRG_build_order_form" value="1">
										<label class="tn-form-label-wide">Order Justification / Reason (Required):</label>
										<textarea name="PRG_order_reason" required placeholder="State your department, project, or reason for requesting these supplies..." {{if !data.can_submit_order}}disabled{{/if}}>{{:data.order_reason}}</textarea>
										<div style="margin-top: 8px; width: 100%;">
											<input type="submit" value="Submit Order Request" {{if !data.can_submit_order}}disabled class="disabled"{{/if}}>
										</div>
									</form>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

		<!-- Tab 3: Orders (orders) -->
		{{else data.screen == 'orders'}}
			<div class="tn-screen-view" data-view="screen-orders">
				<div class="tn-grid">
					<!-- Left: Orders Queue List -->
					<div class="tn-col">
						<div class="section">
							<div class="section-title">Supply Order Queue</div>
							<div class="section-content">
								{{if !data.order_count}}
									<div class="tn-empty-panel">
										<div class="tn-panel-title">No pending orders</div>
										<div class="tn-panel-subtitle tn-muted">No orders are currently in the supply queue.</div>
									</div>
								{{else}}
									<div class="tn-panel">
										<div class="tn-panel-header">
											<div class="tn-panel-copy">
												<div class="tn-panel-label">Queue Overview</div>
												<div class="tn-panel-title">{{:data.order_count}} orders pending in system</div>
												<div class="tn-panel-subtitle tn-muted">You may review all orders, and cancel orders submitted by your account.</div>
											</div>
										</div>
									</div>

									<div class="tn-scroll-box tn-orders-scroll" data-scroll-id="tn-orders-table">
										<table class="tn-table">
											<thead>
												<tr>
													<th class="tn-w-20">Order</th>
													<th class="tn-w-30">Requester</th>
													<th class="tn-w-15">Total</th>
													<th class="tn-w-15">Status</th>
													<th class="tn-w-20 tn-table-actions">Action</th>
												</tr>
											</thead>
											<tbody>
												{{for data.orders:order_entry:order_index}}
													<tr class="candystripe tn-order-row{{if order_entry.selected}} tn-row-selected{{/if}}">
														<td>
															{{:helper.link('#' + order_entry.id, null, {'PRG_view_order' : order_entry.id}, order_entry.selected ? 'selected' : null, 'tn-inlineLink')}}
														</td>
														<td>
															{{:order_entry.requestor_name}}
															{{if order_entry.is_mine}}
																<span class="tn-badge tn-badge-good" style="margin-left: 4px;">Mine</span>
															{{/if}}
														</td>
														<td>{{:order_entry.total}} {{:data.currency_short}}</td>
														<td>
															<span class="tn-badge tn-badge-{{:order_entry.status_tone}}">{{:order_entry.status}}</span>
														</td>
														<td class="tn-table-actions">
															{{if order_entry.can_cancel}}
																{{:helper.link('Cancel', null, {'PRG_cancel_order' : order_entry.id}, null, 'tn-inlineLink')}}
															{{else}}
																<span class="tn-muted" style="font-size: 11px;">Locked</span>
															{{/if}}
														</td>
													</tr>
												{{/for}}
											</tbody>
										</table>
									</div>
								{{/if}}
							</div>
						</div>
					</div>

					<!-- Right: Selected Order Detail -->
					<div class="tn-col">
						{{if data.has_selected_order}}
							<div class="section">
								<div class="section-title">Order Details: #{{:data.selected_order.id}}</div>
								<div class="section-content">
									<div class="tn-panel">
										<div class="tn-panel-header">
											<div class="tn-panel-copy">
												<div class="tn-panel-label">Requester Information</div>
												<div class="tn-panel-title">{{:data.selected_order.requestor_name}}</div>
												<div class="tn-panel-subtitle tn-muted">
													Account #{{:data.selected_order.requestor_account_number}}
													{{if data.selected_order.is_mine}}
														<span class="tn-badge tn-badge-good">Your Account</span>
													{{/if}}
												</div>
											</div>
											<div class="tn-panel-side">
												<span class="tn-badge tn-badge-{{:data.selected_order.status_tone}}">{{:data.selected_order.status}}</span>
											</div>
										</div>

										<div class="tn-kv-grid">
											<div class="tn-kv">
												<div class="tn-panel-label">Base Cost</div>
												<div class="tn-kv-value">{{:data.selected_order.cost}} {{:data.currency_short}}</div>
											</div>
											<div class="tn-kv">
												<div class="tn-panel-label">Handling Fee</div>
												<div class="tn-kv-value">{{:data.selected_order.fee}} {{:data.currency_short}}</div>
											</div>
											<div class="tn-kv">
												<div class="tn-panel-label">Total Cost</div>
												<div class="tn-kv-value" style="color: #64b5f6;">{{:data.selected_order.total}} {{:data.currency_short}}</div>
											</div>
										</div>

										<div style="margin-top: 8px;">
											<div class="tn-panel-label">Reason / Purpose:</div>
											<div class="tn-note" style="margin-top: 4px; font-style: italic;">
												{{:data.selected_order.reason}}
											</div>
										</div>

										{{if data.selected_order.can_cancel}}
											<hr class="tn-section-divider">
											<div class="tn-actions">
												{{:helper.link('Cancel This Order', 'cross', {'PRG_cancel_order' : data.selected_order.id}, null, 'redButton tn-inlineLink')}}
											</div>
										{{/if}}
									</div>

									<!-- Order Contents List -->
									<div class="tn-panel" style="margin-top: 8px;">
										<div class="tn-panel-label">Requested Items</div>
										<div class="tn-flow-list tn-scroll-box tn-order-details-scroll" data-scroll-id="tn-order-details" style="margin-top: 6px;">
											{{for data.selected_order.contents:order_group:order_group_index}}
												<div class="tn-list-block">
													<div class="tn-list-block-title">{{:order_group.station_name}}</div>
													{{for order_group.categories:order_category:order_category_index}}
														<div style="margin-top: 4px;">
															<div class="tn-panel-label">{{:order_category.name}}</div>
															{{for order_category.items:order_item:order_item_index}}
																<div class="tn-list-row">
																	<div class="tn-list-row-main">{{:order_item.name}} x{{:order_item.amount}}</div>
																	<div class="tn-list-row-side">{{:order_item.price}} {{:data.currency_short}}</div>
																</div>
															{{/for}}
														</div>
													{{/for}}
												</div>
											{{/for}}
										</div>
									</div>
								</div>
							</div>
						{{else}}
							<div class="section">
								<div class="section-title">Order Details</div>
								<div class="section-content">
									<div class="tn-empty-panel">
										<div class="tn-panel-title">Select an order</div>
										<div class="tn-panel-subtitle tn-muted">Click an order ID from the queue to view justification, breakdown, and items.</div>
									</div>
								</div>
							</div>
						{{/if}}
					</div>
				</div>
			</div>
		{{/if}}
	</div>
</div>
