			<!-- Instant Search & Sorting Logic -->
			<script id="cargo-market-script">
			window.cargoLiveFilter = function() {
				var searchInput = document.getElementById('cargo-search-input');
				var filterText = searchInput ? searchInput.value.toLowerCase().replace(/^\s+|\s+$/g, '') : '';
				var grid = document.getElementById('cargo-cards-grid');
				if (!grid) return;
				var cards = [];
				if (window.jQuery) {
					cards = $(grid).find('.tn-product-card').get();
				} else if (grid.querySelectorAll) {
					var nodeList = grid.querySelectorAll('.tn-product-card');
					for (var k = 0; k < nodeList.length; k++) cards.push(nodeList[k]);
				}
				var visibleCount = 0;
				for (var i = 0; i < cards.length; i++) {
					var card = cards[i];
					var nameEl = card.querySelector ? card.querySelector('.tn-product-name') : (window.jQuery ? $(card).find('.tn-product-name')[0] : null);
					var name = nameEl ? (nameEl.textContent || nameEl.innerText || '').toLowerCase() : '';
					if (!filterText || name.indexOf(filterText) !== -1) {
						card.style.display = '';
						visibleCount++;
					} else {
						card.style.display = 'none';
					}
				}
				var noResults = document.getElementById('cargo-search-no-results');
				if (noResults) {
					noResults.style.display = (visibleCount === 0 && cards.length > 0) ? 'block' : 'none';
				}
				var counter = document.getElementById('cargo-cards-counter');
				if (counter) {
					counter.innerHTML = 'Товаров: ' + visibleCount + (filterText ? ' <span class="tn-muted">(из ' + cards.length + ')</span>' : '');
				}
				window._cargoSearchQuery = filterText;
			};

			window.cargoLiveSort = function() {
				var sortSelect = document.getElementById('cargo-sort-select');
				var sortVal = sortSelect ? sortSelect.value : 'default';
				var grid = document.getElementById('cargo-cards-grid');
				if (!grid) return;
				var cards = [];
				if (window.jQuery) {
					cards = $(grid).find('.tn-product-card').get();
				} else if (grid.querySelectorAll) {
					var nodeList = grid.querySelectorAll('.tn-product-card');
					for (var k = 0; k < nodeList.length; k++) cards.push(nodeList[k]);
				}
				if (!cards.length) return;

				cards.sort(function(a, b) {
					if (sortVal === 'price_asc') {
						return (parseFloat(a.getAttribute('data-price')) || 0) - (parseFloat(b.getAttribute('data-price')) || 0);
					} else if (sortVal === 'price_desc') {
						return (parseFloat(b.getAttribute('data-price')) || 0) - (parseFloat(a.getAttribute('data-price')) || 0);
					} else if (sortVal === 'name_asc' || sortVal === 'name_desc') {
						var elA = a.querySelector ? a.querySelector('.tn-product-name') : (window.jQuery ? $(a).find('.tn-product-name')[0] : null);
						var elB = b.querySelector ? b.querySelector('.tn-product-name') : (window.jQuery ? $(b).find('.tn-product-name')[0] : null);
						var nameA = (elA ? (elA.textContent || elA.innerText || '') : '').toLowerCase();
						var nameB = (elB ? (elB.textContent || elB.innerText || '') : '').toLowerCase();
						var cmp = nameA.localeCompare ? nameA.localeCompare(nameB) : (nameA < nameB ? -1 : (nameA > nameB ? 1 : 0));
						return sortVal === 'name_asc' ? cmp : -cmp;
					} else {
						return (parseInt(a.getAttribute('data-index'), 10) || 0) - (parseInt(b.getAttribute('data-index'), 10) || 0);
					}
				});

				for (var i = 0; i < cards.length; i++) {
					grid.appendChild(cards[i]);
				}
				window._cargoSortVal = sortVal;
			};

			window.cargoApplyFilterAndSort = function() {
				var catEl = document.getElementById('cargo-current-category');
				var currentCatKey = catEl ? ((catEl.getAttribute('data-station') || '') + '::' + (catEl.getAttribute('data-cat') || '')) : '';
				if (window._cargoLastCategoryKey !== undefined && window._cargoLastCategoryKey !== currentCatKey) {
					window._cargoSearchQuery = '';
					var searchInput = document.getElementById('cargo-search-input');
					if (searchInput) searchInput.value = '';
				}
				window._cargoLastCategoryKey = currentCatKey;

				var searchInput = document.getElementById('cargo-search-input');
				if (searchInput && window._cargoSearchQuery !== undefined && window._cargoSearchQuery !== '') {
					searchInput.value = window._cargoSearchQuery;
				}
				var sortSelect = document.getElementById('cargo-sort-select');
				if (sortSelect && window._cargoSortVal !== undefined) {
					sortSelect.value = window._cargoSortVal;
				}
				if (window.cargoLiveSort) window.cargoLiveSort();
				if (window.cargoLiveFilter) window.cargoLiveFilter();
			};

			if (window.NanoStateManager && window.NanoStateManager.addAfterUpdateCallback) {
				window.NanoStateManager.addAfterUpdateCallback('cargo_order_market', function(data) {
					if (window.cargoApplyFilterAndSort) {
						window.cargoApplyFilterAndSort();
					}
					return data;
				});
			}
			</script>
			<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" style="display:none;" onload="var s = document.getElementById('cargo-market-script'); if(s && !window.cargoLiveFilter) { try { (window.execScript || function(c){ window.eval(c); })(s.innerHTML); } catch(e){} } if(window.cargoApplyFilterAndSort) { window.cargoApplyFilterAndSort(); }" onerror="var s = document.getElementById('cargo-market-script'); if(s && !window.cargoLiveFilter) { try { (window.execScript || function(c){ window.eval(c); })(s.innerHTML); } catch(e){} } if(window.cargoApplyFilterAndSort) { window.cargoApplyFilterAndSort(); }">

