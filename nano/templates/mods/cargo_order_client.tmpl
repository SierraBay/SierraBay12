{{var uiSrc = $('body').data('urlParameters').src;}}
{{var formatTradeAmount = function(value) { var amount = Math.round((Number(value) || 0) * 100) / 100; var parts = amount.toFixed(amount % 1 ? 2 : 0).split('.'); parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ','); return parts.join('.'); };}}
{{var selectedTrader = null; var traders = data.stations || []; for (var traderIndex = 0; traderIndex < traders.length; traderIndex++) { if (data.selected_station && traders[traderIndex].uid == data.selected_station.uid) selectedTrader = traders[traderIndex]; } }}
{{var canOpenOrderForm = data.has_account && data.cart_count > 0 && !data.orders_locked && data.account_money >= data.cart_total;}}
{{##def.order_request_form:
	<div class="tn-form-shell"><form class="tn-form" method="get" action="?src={{:uiSrc}}" onsubmit="return window.cargoValidateOrderForm(this)">
		<input type="hidden" name="src" value="{{:uiSrc}}"><input type="hidden" name="PRG_build_order_form" value="1">
		<label class="tn-panel-label tn-full" for="cargo-field-PRG_order_reason">Reason (required)</label>
		<textarea id="cargo-field-PRG_order_reason" name="PRG_order_reason" required placeholder="Department or reason for this order" oninput="window.cargoClearFormError(this)" {{if !requestReady}}disabled{{/if}}>{{>data.order_reason || ''}}</textarea>
		<div class="tn-form-error tn-bad tn-full tn-hidden" role="alert">Enter a reason for this order.</div>
		{{if data.submit_block_reason}}<div class="tn-action-reason tn-bad tn-full">{{>data.submit_block_reason}}</div>{{/if}}
		<div class="tn-flex-row-sm tn-full tn-space-top"><input type="submit" value="Submit order" class="tn-btn tn-btn-primary" {{if !requestReady}}disabled{{/if}}>{{if data.screen == 'goods'}}{{:helper.link('Cancel', null, {'PRG_cart_form_cancel' : 1}, null, 'tn-btn tn-btn-outline')}}{{/if}}</div>
	</form></div>
#}}
{{##def.order_account:
	<div class="tn-panel-title">Account</div><hr class="tn-section-divider">
	{{if data.has_account}}
		<div class="tn-labeled-row"><span>Owner</span><strong>{{>data.account_owner_name}}</strong></div>
		<div class="tn-labeled-row"><span>Account number</span><span class="font-mono">#{{:data.account_number}}</span></div>
		<div class="tn-labeled-row"><span>Balance</span><strong class="font-mono">{{>formatTradeAmount(data.account_money)}} {{>data.currency_short}}</strong></div>
		{{if data.screen == 'account'}}<div class="tn-labeled-row"><span>Authentication</span><span>{{if data.account_verified}}ID card{{else}}Account number and PIN{{/if}}</span></div>{{/if}}
		<div class="tn-space-top">{{:helper.link('Unlink account', 'close', {'PRG_account_unlink' : 1}, null, 'tn-btn tn-btn-danger')}}</div>
	{{else}}
		<div class="tn-muted">No account linked.</div><p class="tn-setting-note">Link an account to submit supply orders.</p>
		<div class="tn-flex-row-sm">{{if data.can_link_id_account}}{{:helper.link('Use ID card', 'check', {'PRG_account_id' : 1}, null, 'tn-btn tn-btn-primary')}}{{/if}}{{:helper.link('Account number and PIN', null, {'PRG_account' : 1}, null, 'tn-btn tn-btn-outline')}}</div>
	{{/if}}
	{{if data.cart_form_mode == 'link_account'}}
		<div class="tn-form-shell"><form class="tn-form" method="get" action="?src={{:uiSrc}}">
			<input type="hidden" name="src" value="{{:uiSrc}}">
			<label class="tn-panel-label tn-full" for="cargo-field-PRG_link_account_number">Account number</label><input id="cargo-field-PRG_link_account_number" type="number" name="PRG_link_account_number" value="{{if data.can_link_id_account}}{{:data.available_id_account_number}}{{/if}}" placeholder="Account #" required class="tn-full">
			<label class="tn-panel-label tn-full tn-space-top" for="cargo-field-PRG_link_account_pin">PIN</label><input id="cargo-field-PRG_link_account_pin" type="password" name="PRG_link_account_pin" value="" placeholder="PIN" required class="tn-full">
			<div class="tn-flex-row-sm tn-full tn-space-top"><input type="submit" value="Link account" class="tn-btn tn-btn-primary">{{:helper.link('Cancel', null, {'PRG_cart_form_cancel' : 1}, null, 'tn-btn tn-btn-outline')}}</div>
		</form></div>
	{{else data.cart_form_mode == 'link_id_account'}}
		<div class="tn-form-shell"><form class="tn-form" method="get" action="?src={{:uiSrc}}">
			<input type="hidden" name="src" value="{{:uiSrc}}">
			<label class="tn-panel-label tn-full" for="cargo-field-PRG_link_id_pin">PIN for ID card account (#{{:data.available_id_account_number}})</label><input id="cargo-field-PRG_link_id_pin" type="password" name="PRG_link_id_pin" value="" placeholder="PIN" required class="tn-full">
			<div class="tn-flex-row-sm tn-full tn-space-top"><input type="submit" value="Verify PIN" class="tn-btn tn-btn-primary">{{:helper.link('Cancel', null, {'PRG_cart_form_cancel' : 1}, null, 'tn-btn tn-btn-outline')}}</div>
		</form></div>
	{{/if}}
#}}
