.rndSectionTitle {
	padding: 5px 10px;
	font-size: 11px;
	font-weight: bold;
	letter-spacing: 0.8px;
	text-transform: uppercase;
	color: #8ab4e8;
	background: linear-gradient(180deg, rgba(20, 36, 60, 0.6), rgba(12, 24, 44, 0.4));
	border-bottom: 1px solid rgba(64, 98, 138, 0.35);
