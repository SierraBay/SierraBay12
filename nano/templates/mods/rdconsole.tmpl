					{{/for}}
				</div>
			</div>
		</div>
		<div class="rndCol" style="width: 50%;">
			<div class="rndSection">
				<div class="rndSectionTitle">Локальная база данных</div>
				<div class="rndSectionContent rndFileList">
					{{for data.known_nodes}}
					<div class="rndFileItem">
