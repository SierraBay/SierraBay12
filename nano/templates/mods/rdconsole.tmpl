		</div>
		<div class="rndNavStatus">
			{{if data.has_disk}}
				<span class="rndMuted">{{:data.disk_used}}GQ / {{:data.disk_size}}GQ</span>
			{{/if}}
		</div>
	</div>

	{{if data.has_disk}}
	<div class="rndTwoCol">
		<div class="rndCol" style="width: 50%;">
			<div class="rndSection">
				<div class="rndSectionTitle">Диск</div>
				<div class="rndSectionContent rndFileList">
					{{for data.disk_tech_nodes}}
					<div class="rndFileItem">
