<!--
Title: R&D Console (Unified)
Used In File(s): \mods\RnD\code\machinery\rdconsole.dm
-->
{{if data.ui_theme == "engineering"}}
{{:helper.ntengiMode()}}
{{else data.ui_theme == "medical"}}
{{:helper.ntmedMode()}}
{{else}}
{{:helper.ntscieMode()}}
{{/if}}
{{if data.screen == "working"}}
<div class="rndConsole rndTheme--{{:data.ui_theme || 'neutral'}}">
	<div class="rndCenterScreen">
		<div class="rndLoadingIcon">&#9881;</div>
		<div class="rndLoadingText">ОБРАБОТКА ДАННЫХ</div>
		<div class="rndLoadingSubtext">Пожалуйста, подождите...</div>
	</div>
</div>
{{else data.screen == "locked"}}
<div class="rndConsole rndTheme--{{:data.ui_theme || 'neutral'}}">
	<div class="rndCenterScreen">
		<div class="rndLoadingIcon">&#128274;</div>
		<div class="rndLoadingText">СИСТЕМА ЗАБЛОКИРОВАНА</div>
		<div style="margin-top: 16px;">
			{{:helper.link("Разблокировать", 'unlocked', {'unlock' : 1}, null, 'rndUnlockBtn')}}
		</div>
	</div>
</div>
{{/if}}

<!-- ============================================================ -->
<!-- MAIN NAVIGATION SCREENS (lab, tech_trees, missions, corps)   -->
<!-- ============================================================ -->
{{if !data.screen || data.screen == "main" || data.screen == "tech_trees" || data.screen == "missions" || data.screen == "corps"}}
<div class="rndConsole rndTheme--{{:data.ui_theme || 'neutral'}}">

	<!-- Top Navigation Bar -->
	<div class="rndNav">
		<div class="rndNavTabs">
			{{:helper.link("Лаборатория", '', {'go_screen' : 'main'}, (!data.screen || data.screen == 'main') ? 'selected' : null, 'rndTab')}}
			{{:helper.link("Технологии", '', {'go_screen' : 'tech_trees'}, data.screen == 'tech_trees' ? 'selected' : null, 'rndTab')}}
			{{if !data.is_robotics_console}}
				{{:helper.link("Контракты", '', {'go_screen' : 'missions'}, data.screen == 'missions' ? 'selected' : null, 'rndTab')}}
			{{/if}}
			{{:helper.link("Корпорации", '', {'go_screen' : 'corps'}, data.screen == 'corps' ? 'selected' : null, 'rndTab')}}
		</div>
		<div class="rndNavStatus">
			{{if data.has_theme_selector}}
				<div class="rndThemeSwitch">
					{{:helper.link("◑", '', {'set_theme':'neutral'},    data.ui_theme == 'neutral'     ? 'selected' : null, 'rndThemeBtn')}}
					{{:helper.link("✚", '', {'set_theme':'medical'},    data.ui_theme == 'medical'     ? 'selected' : null, 'rndThemeBtn')}}
					{{:helper.link("⚙", '', {'set_theme':'engineering'},data.ui_theme == 'engineering' ? 'selected' : null, 'rndThemeBtn')}}
				</div>
			{{/if}}
			{{if data.has_server}}
				<span class="rndServerBadge rndServerBadge--online"><span class="rndServerDot"></span>{{:data.server_name}}</span>
			{{else}}
				<span class="rndServerBadge rndServerBadge--offline"><span class="rndServerDot"></span>Нет сервера</span>
			{{/if}}
			{{if data.has_science_account}}
				{{:helper.link("Накладная", 'receipt', {'print_invoice' : 1}, null, 'rndTab')}}
				<span class="rndBalanceLabel">{{:data.science_account_name}}</span>
				<span class="rndBalanceValue">{{:data.currency_short}}{{:data.science_balance}}</span>
			{{else data.can_switch_account}}
				<span class="rndBalanceError">СЧЁТ НЕ ПРИВЯЗАН</span>
			{{/if}}
		</div>
	</div>

	<!-- ======================== -->
	<!-- LAB / MAIN SCREEN        -->
	<!-- ======================== -->
	{{if !data.screen || data.screen == "main"}}
	<div class="rndTwoCol">
		<!-- Left Column: Fabrication, Analysis, Experiments -->
		<div class="rndCol" style="width: 58%;">

			<!-- Fabrication Access -->
			<div class="rndSection">
				<div class="rndSectionTitle">Производство</div>
				<div class="rndSectionContent">
					<div class="rndBtnRow">
						{{if data.is_robotics_console}}
							{{:helper.link("Robofabricator", 'image', {'go_screen' : 'robotics_fabricator'}, data.has_robotics_fab ? null : 'disabled', 'rndMenuBtn')}}
							{{:helper.link("Mech Fabricator", 'video', {'go_screen' : 'mech_fabricator'}, data.has_mech_fab ? null : 'disabled', 'rndMenuBtn')}}
							{{:helper.link("Circuit Imprinter", 'video', {'go_screen' : 'circuit_imprinter'}, data.has_circuit_imprinter ? null : 'disabled', 'rndMenuBtn')}}
						{{else}}
							{{:helper.link("Protolathe", 'image', {'go_screen' : 'protolathe'}, data.has_protolathe ? null : 'disabled', 'rndMenuBtn')}}
							{{:helper.link("Circuit Imprinter", 'video', {'go_screen' : 'circuit_imprinter'}, data.has_circuit_imprinter ? null : 'disabled', 'rndMenuBtn')}}
						{{/if}}
					</div>
				</div>
			</div>

			<!-- Destructive Analyzer -->
			<div class="rndSection">
				<div class="rndSectionTitle">Деструктивный анализатор</div>
				<div class="rndSectionContent">
					{{if !data.destroy_data}}
						<span class="rndMuted">Деструктивный анализатор не обнаружен</span>
					{{else}}
						{{if !data.destroy_data.has_item}}
							<span class="rndMuted">Предмет не загружен</span>
						{{else}}
							<div class="rndAnalyzerItem">
								<span class="rndLabel">Объект:</span> {{:data.destroy_data.item_name}}
							</div>
							<table class="rndTechTable">
								{{for data.destroy_data.tech_data}}
								<tr>
									<td class="rndTechName">{{:value.name}}</td>
									<td class="rndTechBar"><div style="width: 95%">{{:helper.displayBar(value.level, 0, 5, 'good', value.level)}}</div></td>
								</tr>
								{{/for}}
							</table>
							<div class="rndBtnRow" style="margin-top: 6px;">
								{{:helper.link("Извлечь дизайн", 'save', {'extract_design' : 1}, data.has_disk ? null : 'disabled')}}
								{{:helper.link("Деконструировать", '', {'deconstruct' : 1})}}
								{{:helper.link("Спектральный анализ", 'signal-diag', {'start_spectral' : 1}, data.destroy_data.can_spectral ? null : 'disabled')}}
								{{:helper.link("Извлечь", '', {'eject_item' : 1})}}
							</div>
						{{/if}}
					{{/if}}
				</div>
			</div>

			<!-- Spectral Analysis -->
			{{if !data.is_robotics_console && data.spectral_active}}
			<div class="rndSection">
				<div class="rndSectionTitle">Спектральный анализ</div>
				<div class="rndSectionContent">
					<div class="rndColorGrid">
						<div class="rndColorBlock {{:data.spectral_flash == 'red' ? 'rndColorActive' : ''}}" style="background: {{:data.spectral_flash == 'red' ? '#ff4444' : '#880000'}};">
							{{if data.spectral_phase == 'input'}}{{:helper.link("", '', {'spectral_choice' : 'red'}, null, 'rndColorOverlay')}}{{/if}}
						</div>
						<div class="rndColorBlock {{:data.spectral_flash == 'green' ? 'rndColorActive' : ''}}" style="background: {{:data.spectral_flash == 'green' ? '#44ff44' : '#008800'}};">
							{{if data.spectral_phase == 'input'}}{{:helper.link("", '', {'spectral_choice' : 'green'}, null, 'rndColorOverlay')}}{{/if}}
						</div>
						<div class="rndColorBlock {{:data.spectral_flash == 'blue' ? 'rndColorActive' : ''}}" style="background: {{:data.spectral_flash == 'blue' ? '#4444ff' : '#000088'}};">
							{{if data.spectral_phase == 'input'}}{{:helper.link("", '', {'spectral_choice' : 'blue'}, null, 'rndColorOverlay')}}{{/if}}
						</div>
						<div class="rndColorBlock {{:data.spectral_flash == 'yellow' ? 'rndColorActive' : ''}}" style="background: {{:data.spectral_flash == 'yellow' ? '#ffff44' : '#888800'}};">
							{{if data.spectral_phase == 'input'}}{{:helper.link("", '', {'spectral_choice' : 'yellow'}, null, 'rndColorOverlay')}}{{/if}}
						</div>
					</div>
					{{:helper.link("Отмена", 'cancel', {'cancel_spectral' : 1})}}
					{{if data.spectral_result_text}}<hr class="rndDivider">{{:data.spectral_result_text}}{{/if}}
				</div>
			</div>
			{{else !data.is_robotics_console}}
				{{if data.spectral_result_text}}
				<div class="rndSection">
					<div class="rndSectionTitle" style="display: flex; justify-content: space-between; align-items: center;">
						<span>Результаты спектрального анализа</span>
						{{:helper.link("✕", 'cancel', {'clear_spectral' : 1})}}
					</div>
					<div class="rndSectionContent">{{:data.spectral_result_text}}</div>
				</div>
				{{/if}}
			{{/if}}

			<!-- Research Report Compilation -->
			{{if !data.is_robotics_console}}
			<div class="rndSection">
				<div class="rndSectionTitle" style="display: flex; justify-content: space-between; align-items: center;">
					<span>Компиляция научного отчёта</span>
					{{:helper.link(data.report_collapsed ? "▶" : "▼", '', {'toggle_report_collapse' : 1})}}
				</div>
				{{if !data.report_collapsed}}
				<div class="rndSectionContent">
					{{if data.report_tech_data && data.report_tech_data.length}}
					<table style="width: 100%; border-collapse: collapse;">
						<tr>
							<th style="text-align: left; padding: 2px 6px;">Технология</th>
							<th style="text-align: center; padding: 2px 6px;">Уровень</th>
							<th style="text-align: center; padding: 2px 6px;">Скомп.</th>
							<th style="text-align: center; padding: 2px 6px;">Новое</th>
							<th style="text-align: center; padding: 2px 6px;">Стоимость</th>
						</tr>
						{{for data.report_tech_data}}
						<tr>
							<td style="padding: 2px 6px;">{{:value.name}}</td>
							<td style="text-align: center; padding: 2px 6px;">{{:value.level}}</td>
							<td style="text-align: center; padding: 2px 6px; color: #888;">{{:value.compiled}}</td>
							<td style="text-align: center; padding: 2px 6px;">
								{{if value.new_levels > 0}}
									<span style="color: #00ff00;">+{{:value.new_levels}}</span>
								{{else}}
									<span style="color: #666;">—</span>
								{{/if}}
							</td>
							<td style="text-align: center; padding: 2px 6px;">
								{{if value.value > 0}}
									<span style="color: #ffcc00;">{{:value.value * 15}} Т</span>
								{{else}}
									<span style="color: #666;">—</span>
								{{/if}}
							</td>
						</tr>
						{{/for}}
					</table>
					{{else}}
						<span class="rndMuted">Нет данных деконструкции. Поместите предметы в деструктивный анализатор.</span>
					{{/if}}
					<div class="rndBtnRow" style="margin-top: 8px;">
						{{:helper.link("Скомпилировать отчёт (" + data.report_value + " Т)", 'save', {'compile_report' : 1}, data.can_compile ? null : 'disabled', 'rndExpBtn')}}
					</div>
					<span class="rndMuted"><i>Скомпилированный отчёт можно продать через карго шаттл.</i></span>
				</div>
				{{/if}}
			</div>
			{{/if}}

			<!-- Artifact Catalogization -->
			{{if !data.is_robotics_console && data.catalog_active}}
			<div class="rndSection">
				<div class="rndSectionTitle">Каталогизация артефакта — Этап {{:data.catalog_step}}/3</div>
				<div class="rndSectionContent">
					<b>{{:data.catalog_step_name}}</b><br>
					<span class="rndMuted"><i>{{:data.catalog_step_hint}}</i></span><br><br>
					{{if data.catalog_step == 1}}
						<span class="rndLabel">Тип излучения:</span><br>
						<div class="rndBtnRow">
							{{:helper.link("Неопознанное", '', {'catalog_choice' : '0'})}}
							{{:helper.link("Энергетическое", '', {'catalog_choice' : '1'})}}
							{{:helper.link("Псионическое", '', {'catalog_choice' : '2'})}}
							{{:helper.link("Электромагнитное", '', {'catalog_choice' : '3'})}}
						</div>
						<div class="rndBtnRow">
							{{:helper.link("Корпускулярное", '', {'catalog_choice' : '4'})}}
							{{:helper.link("Органическое", '', {'catalog_choice' : '5'})}}
							{{:helper.link("Блюспейс", '', {'catalog_choice' : '6'})}}
							{{:helper.link("Синтетическое", '', {'catalog_choice' : '7'})}}
						</div>
					{{else data.catalog_step == 2}}
						<span class="rndLabel">Режим активации:</span><br>
						<div class="rndBtnRow">
							{{:helper.link("Тактильный", '', {'catalog_choice' : '0'})}}
							{{:helper.link("Аура", '', {'catalog_choice' : '1'})}}
							{{:helper.link("Импульсный", '', {'catalog_choice' : '2'})}}
						</div>
					{{else data.catalog_step == 3}}
						<span class="rndLabel">Радиус действия:</span><br>
						<div class="rndBtnRow">
							{{:helper.link("Малый (1-2)", '', {'catalog_choice' : 'short'})}}
							{{:helper.link("Средний (3-4)", '', {'catalog_choice' : 'medium'})}}
							{{:helper.link("Большой (5+)", '', {'catalog_choice' : 'long'})}}
						</div>
					{{/if}}
					<br>
					{{:helper.link("Отмена", 'cancel', {'cancel_catalog' : 1})}}
					{{if data.catalog_result_text}}<hr class="rndDivider">{{:data.catalog_result_text}}{{/if}}
				</div>
			</div>
			{{else !data.is_robotics_console}}
				{{if data.catalog_result_text}}
				<div class="rndSection">
					<div class="rndSectionTitle" style="display: flex; justify-content: space-between; align-items: center;">
						<span>Результаты каталогизации</span>
						{{:helper.link("✕", 'cancel', {'clear_catalog' : 1})}}
					</div>
					<div class="rndSectionContent">{{:data.catalog_result_text}}</div>
				</div>
				{{/if}}
				<div class="rndSection">
					<div class="rndSectionTitle">Каталогизация артефактов</div>
					<div class="rndSectionContent">
						{{if data.can_catalog && data.catalog_files}}
							<span class="rndMuted"><i>Отсканируйте артефакт полевым сканером, сохраните файл на диск и вставьте в консоль.</i></span>
							<table style="width: 100%; border-collapse: collapse; margin-top: 4px;">
								{{for data.catalog_files}}
								<tr>
									<td style="padding: 2px 6px;">{{:value.name}}.RDF</td>
									<td style="padding: 2px 6px; color: #888;">ID: {{:value.artifact_id}}</td>
									<td style="padding: 2px 6px; text-align: right;">
										{{:helper.link("Каталогизировать", 'search', {'start_catalog' : value.ref})}}
									</td>
								</tr>
								{{/for}}
							</table>
						{{else}}
							<span class="rndMuted">Нет доступных файлов сканирования артефактов на диске.</span><br>
							<span class="rndMuted"><i>Отсканируйте артефакт полевым исследовательским сканером, сохраните RDF файл на диск и вставьте его в консоль.</i></span>
						{{/if}}
					</div>
				</div>
			{{/if}}
		</div>

		<!-- Right Column: Tech Levels, Disk, System -->
		<div class="rndCol" style="width: 42%;">

			<!-- Research Levels -->
			<div class="rndSection">
				<div class="rndSectionTitle">Уровни исследований</div>
				<div class="rndSectionContent">
					<table class="rndTechTable" style="width: 100%;">
						{{for data.tech_trees}}
						<tr>
							<td class="rndTechName">{{:value.shortname}}</td>
							<td class="rndTechBar"><div style="width: 95%">{{:helper.displayBar(value.level, 0, value.maxlevel, 'good', value.level + ' / ' + value.maxlevel)}}</div></td>
						</tr>
						{{/for}}
					</table>
				</div>
			</div>

			<!-- Disk -->
			<div class="rndSection">
				<div class="rndSectionTitle">Накопитель данных</div>
				<div class="rndSectionContent">
					{{if data.has_disk}}
						<div class="rndDiskInfo">
							<span class="rndLabel">Заполнение:</span>
							<div style="width: 90%; margin: 4px 0;">{{:helper.displayBar(data.disk_used, 0, data.disk_size, 'good', data.disk_used + "GQ / " + data.disk_size + "GQ")}}</div>
						</div>
						<div class="rndBtnRow">
							{{:helper.link("Управление дизайнами", 'save', {'go_screen' : 'disk_management_designs'})}}
							{{:helper.link("Извлечь", 'eject', {'eject_disk' : 1})}}
						</div>
					{{else}}
						<span class="rndMuted">Диск не обнаружен</span>
					{{/if}}
				</div>
			</div>

			<!-- System Controls -->
			<div class="rndSection">
				<div class="rndSectionTitle">Система</div>
				<div class="rndSectionContent">
					<div class="rndBtnRow">
						{{:helper.link("Настройки", 'wrench', {'toggle_settings' : 1}, null, data.show_settings ? 'rndMenuBtn selected' : 'rndMenuBtn')}}
						{{:helper.link("Устройства", 'link', {'toggle_link_menu' : 1}, null, data.show_link_menu ? 'rndMenuBtn selected' : 'rndMenuBtn')}}
					</div>

					{{if data.show_settings}}
					<div class="rndSubPanel">
						<div class="rndBtnRow">
							{{:helper.link("Загрузить дизайны с диска", 'transferthick-e-w', {'sync' : 1}, data.sync ? null : 'disabled')}}
						</div>
						{{if data.can_switch_server}}
						<div class="rndBtnRow">
							{{:helper.link("Подключиться к сети", 'lightbulb', {'togglesync' : 1}, data.sync ? 'disabled' : null)}}
							{{:helper.link("Отключиться от сети", 'cancel', {'togglesync' : 1}, data.sync ? null : 'disabled')}}
						</div>
						{{/if}}
						<div class="rndBtnRow">
							{{:helper.link("Заблокировать", 'locked', {'lock' : 1})}}
							{{:helper.link("Сбросить базу данных", 'trash', {'reset' : 1})}}
						</div>
						{{if data.can_switch_account}}
						<div class="rndBtnRow" style="margin-top:6px;">
							<span class="rndMuted" style="margin-right:6px;">Счёт списания:</span>
							<span style="color:#aaddff;">{{:data.has_science_account ? data.science_account_name : "Не привязан"}}</span>
						</div>
						<div class="rndBtnRow">
							{{:helper.link("Привязать счёт", 'key', {'link_account' : 1})}}
							{{if data.has_science_account}}
								{{:helper.link("Отвязать", 'cancel', {'unlink_account' : 1})}}
							{{/if}}
						</div>
						{{/if}}
					</div>
					{{/if}}

					{{if data.show_link_menu}}
					<div class="rndSubPanel">
						<div class="rndBtnRow">
							{{:helper.link("Переподключить устройства", 'link', {'find_device' : 1})}}
						</div>
						<div class="rndBtnRow">
							{{:helper.link("Откл. анализатор", 'close', {'disconnect' : "destroy"}, data.has_dest_analyzer ? null : 'disabled')}}
							{{:helper.link("Откл. протолат", 'close', {'disconnect' : "lathe"}, data.has_protolathe ? null : 'disabled')}}
							{{:helper.link("Откл. импринтер", 'close', {'disconnect' : "imprinter"}, data.has_circuit_imprinter ? null : 'disabled')}}
						</div>
						<div class="rndBtnRow">
							{{:helper.link(data.linked_drone_pad_id ? "Дрон пад ID: " + data.linked_drone_pad_id : "Привязать дрон пад", 'airplay', {'link_drone_pad' : 1})}}
						</div>
					</div>
					{{/if}}
				</div>
			</div>

		</div>
	</div>
	{{/if}}

	<!-- ======================== -->
	<!-- TECHNOLOGY TREES SCREEN  -->
	<!-- ======================== -->
	{{if data.screen == "tech_trees"}}
	<div class="rndTwoCol">
		<div class="rndCol" style="width: 68%;">

			<!-- Category Tabs -->
			<div class="rndSection">
				<div class="rndSectionTitle">Категории технологий</div>
				<div class="rndSectionContent">
					<div class="rndBtnRow" style="margin-bottom: 8px;">
						{{for data.categories}}
							{{:helper.link(value.name, '', {'select_tech_category' : value.id}, data.selected_category == value.id ? 'selected' : null)}}
						{{/for}}
					</div>
					<!-- Corporation Sub-tabs -->
					<div class="rndBtnRow rndCorpSubTabs">
						{{for data.corp_trees}}
							{{:helper.link(value.name, '', {'select_corp' : value.id}, data.selected_corp == value.id ? 'selected' : null)}}
						{{/for}}
					</div>
				</div>
			</div>

			<!-- Tech Tree Visualization -->
			<div class="rndSection">
				<div class="rndSectionContent" style="padding: 0;">
					<div id='sciTechTreeContainer'>
						{{if data.selected_corp_logo}}
							<div class="rndTreeWatermark" style="background-image: url({{:data.selected_corp_logo}});"></div>
						{{/if}}
						{{for data.corp_lines}}
							<div style="position: absolute;border-{{:value.istop?'top':'bottom'}}: 1px solid rgba(100,180,255,0.35);border-{{:value.isright?'right':'left'}}: 1px solid rgba(100,180,255,0.35);width: {{:value.width}}%;height: {{:value.height}}%;left: {{:value.line_x}}%;bottom: {{:value.line_y}}%"></div>
						{{/for}}
						{{for data.corp_nodes}}
							<div style="position: absolute; left: {{:value.x}}%; bottom: {{:value.y}}%; margin-left: -20px; margin-bottom: -20px;">
								{{:helper.link("<div class='sciTechTreeIcon icon-"+value.icon+"'></div>", '', {'select_corp_node' : value.id}, null, "link sciTechTreeIconBox "+((value.isresearched==1)?'sciTechResearched':((value.canunlock==1)?'sciTechAvailable':'sciTechCantResearch'))+" "+((value.id == data.selected_node_id)?'sciTechSelected':'') )}}
							</div>
						{{/for}}
					</div>
				</div>
			</div>

		</div>

		<!-- Right Column: Selected Node Details -->
		<div class="rndCol" style="width: 32%;">
			<div class="rndSection">
				<div class="rndSectionTitle">Узел технологии</div>
				<div class="rndSectionContent">
					{{if data.selected_node}}
						<div class="rndNodeName">{{:data.selected_node.name}}</div>
						{{if data.selected_corp_logo}}
							<img src="{{:data.selected_corp_logo}}" class="rndNodeLogo" />
						{{/if}}

						<div class="rndNodeField">
							<div class="rndNodeLabel">Стоимость</div>
							<div class="rndNodeValue rndPriceValue">{{:data.currency_short}}{{:data.selected_node.price}}</div>
						</div>

						{{if data.selected_node.current_reputation !== null && data.selected_node.current_reputation !== undefined}}
						<div class="rndNodeField">
							<div class="rndNodeLabel">Репутация</div>
							<div class="rndNodeValue">
								{{if data.selected_node.corp_id}}{{:data.selected_node.corp_id}}: {{/if}}<span style="color: {{:data.selected_node.current_reputation >= 0?'#00FF00':'#FF0000'}}">
									{{:data.selected_node.current_reputation >= 0 ? '+' : ''}}{{:data.selected_node.current_reputation}}
								</span> / {{:data.selected_node.required_reputation}}
								{{if !data.selected_node.reputation_met}}<br/>
									<span style="color: #FF6644; font-size: 11px;">Требуется ещё {{:data.selected_node.required_reputation - data.selected_node.current_reputation}} репутации</span>
								{{/if}}
							</div>
						</div>
						{{/if}}

						<div class="rndNodeField">
							<div class="rndNodeLabel">Требования</div>
							<div class="rndNodeValue">
								{{if data.selected_node.requirements && data.selected_node.requirements.length > 0}}
									{{for data.selected_node.requirements}}
										<span style="color: {{:value.isgood?'#44ff44':'#ff4444'}}">{{:value.text}}</span><br />
									{{/for}}
								{{else}}
									<span class="rndMuted">Нет требований</span>
								{{/if}}
							</div>
						</div>

						<div class="rndNodeField">
							<div class="rndNodeLabel">Открывает</div>
							<div class="rndNodeValue">
								{{if data.selected_node.unlocks && data.selected_node.unlocks.length > 0}}
									{{for data.selected_node.unlocks}}
										{{:value.text}}<br />
									{{/for}}
								{{else}}
									<span class="rndMuted">—</span>
								{{/if}}
							</div>
						</div>

						{{if data.selected_node.isresearched}}
							<div class="rndNodeStatus rndNodeStatus--good">Открыто</div>
						{{else}}
							{{if data.selected_node.can_buy}}
								{{:helper.link("Приобрести", '', {'buy_corp_node' : data.selected_node_id}, null, 'rndBuyBtn')}}
							{{else}}
								<div class="rndNodeStatus rndNodeStatus--locked">Недоступно</div>
							{{/if}}
						{{/if}}
					{{else}}
						<div class="rndMuted" style="text-align: center; padding: 20px 0;">Выберите узел на карте технологий</div>
					{{/if}}
				</div>
			</div>
		</div>
	</div>
	{{/if}}

	<!-- ======================== -->
	<!-- CONTRACTS / MISSIONS     -->
	<!-- ======================== -->
	{{if !data.is_robotics_console && data.screen == "missions"}}
	<div class="rndTwoCol">
		<div class="rndCol" style="width: 100%;">

			<div class="rndSection">
				<div class="rndSectionTitle">Корпоративные контракты {{:helper.link("Печать", 'printer', {'print_missions': 1}, null, 'rndTab')}}</div>
				<div class="rndSectionContent">
					<p class="rndMuted" style="font-size: 11px; margin-bottom: 10px;"><i>Контракты на исследование объектов, обнаруженных на заброшенных объектах в системе. Выполнение контрактов открывает доступ к корпоративным технологиям.</i></p>

					{{if data.missions && data.missions.length}}
						{{for data.missions}}
						<div class="rndMissionCard">
							<div class="rndMissionHeader">
								<span class="rndMissionTitle">{{:value.title}}</span>
								<span class="rndMissionType rndMissionType--{{:value.state == 4 ? 'done' : (value.mission_type == 'complex' ? 'complex' : 'simple')}}">{{:value.state == 4 ? 'Выполнен' : (value.mission_type == 'complex' ? 'Сложный' : 'Простой')}}</span>
							</div>
							<table class="rndMissionTable">
								<tr><td class="rndMissionLabel">Корпорация</td><td>{{:value.corp_name}}</td></tr>
								<tr><td class="rndMissionLabel">Локация</td><td>{{:value.site_name}}</td></tr>
								<tr><td class="rndMissionLabel">Статус</td><td>{{if value.state == 4}}<span style="color:#44ff44;">Выполнен</span>{{else}}<span class="rndMuted">В процессе</span>{{/if}}</td></tr>
							</table>
							<div class="rndMissionDesc">{{:value.description}}</div>
							{{if value.state != 4}}
							<div class="rndMissionObjectives">
								{{for value.objectives :obj:obj_i}}
								<div class="rndMissionObj {{:obj.completed ? 'rndMissionObj--done' : ''}}">
									<span class="rndMissionObjIcon">{{:obj.completed ? '&#10003;' : '&#9744;'}}</span>
									<span class="rndMissionObjText">{{:obj.description}}</span>
									<span class="rndMissionObjStatus">{{:obj.status}}</span>
								</div>
								{{/for}}
							</div>
							{{/if}}
						</div>
						{{/for}}
					{{else}}
						<div class="rndEmptyNotice">Контрактов нет. Контракты генерируются при обнаружении заброшенных объектов в системе.</div>
					{{/if}}
				</div>
			</div>

			<!-- Data Submission (RDF & Photos) -->
			{{if data.has_disk}}
			<div class="rndSection">
				<div class="rndSectionTitle">Подача данных сканирования</div>
				<div class="rndSectionContent">
					{{if data.rdf_files && data.rdf_files.length}}
					<table class="rndDataTable">
						<tr><th>Файл</th><th>Зона</th><th>Подать для контракта</th></tr>
						{{for data.rdf_files}}
						<tr>
							<td>{{:value.filename}}</td>
							<td>{{:value.scan_area}}</td>
							<td>
								{{for data.missions :mission:mi}}
									{{if mission.state != 4}}
										{{:helper.link(mission.title, 'transferthick-e-w', {'submit_rdf' : value.id, 'submit_rdf_mission' : mission.ref})}}
									{{/if}}
								{{/for}}
							</td>
						</tr>
						{{/for}}
					</table>
					{{else}}
						<span class="rndMuted"><i>На диске нет файлов RDF.</i></span>
					{{/if}}
				</div>
			</div>
			<div class="rndSection">
				<div class="rndSectionTitle">Подача фотографий</div>
				<div class="rndSectionContent">
					{{if data.photo_files && data.photo_files.length}}
					<table class="rndDataTable">
						<tr><th>Файл</th><th>Подать для контракта</th></tr>
						{{for data.photo_files}}
						<tr>
							<td>{{:value.filename}}</td>
							<td>
								{{for data.missions :mission:mi}}
									{{if mission.state != 4}}
										{{:helper.link(mission.title, 'transferthick-e-w', {'submit_photo' : value.id, 'submit_photo_mission' : mission.ref})}}
									{{/if}}
								{{/for}}
							</td>
						</tr>
						{{/for}}
					</table>
					{{else}}
						<span class="rndMuted"><i>На диске нет фотографий.</i></span>
					{{/if}}
				</div>
			</div>
			{{/if}}
			<p class="rndMuted" style="font-size: 11px; margin-top: 4px;"><i>Физические фотографии и отчёты об артефактах можно подать, положив их на консоль.</i></p>

		</div>
	</div>
	{{/if}}

	<!-- ======================== -->
	<!-- CORPORATIONS SCREEN      -->
	<!-- ======================== -->
	{{if data.screen == "corps"}}
	<div class="rndTwoCol">
		<div class="rndCol" style="width: 60%;">
			<div class="rndSection">
				<div class="rndSectionTitle">Корпорации</div>
				<div class="rndSectionContent">
					<div class="rndCorpGrid">
						{{for data.corporations}}
						<div class="rndCorpCard {{:data.selected_dialogue_corp_id == value.id ? 'rndCorpCard--selected' : ''}}">
							{{:helper.link(value.name, '', {'select_corp_dialogue' : value.id}, null, 'link rndCorpLink')}}
							<div class="rndCorpRep">
								<div class="rndCorpRepBar"><div class="rndCorpRepFill" style="width:{{:(value.reputation + 50)}}%; background-color:{{:value.reputation >= 0 ? '#2a8a2a' : '#8a2a2a'}};"></div></div>
								<span style="color:{{:value.reputation >= 0 ? '#44dd44' : '#dd4444'}}; font-size:11px;">{{:value.reputation >= 0 ? '+' : ''}}{{:value.reputation}}</span>
							</div>
						</div>
						{{/for}}
					</div>
				</div>
			</div>
		</div>

		<div class="rndCol" style="width: 40%;">
			<div class="rndSection">
				<div class="rndSectionTitle">Информация о корпорации</div>
				<div class="rndSectionContent">
					{{if data.selected_corp_dialogue}}
						<div class="rndNodeName" style="margin-bottom: 12px;">{{:data.selected_corp_dialogue.name}}</div>

						<div class="rndNodeField">
							<div class="rndNodeLabel">Текущая репутация</div>
							<div class="rndNodeValue">
								<span style="font-size: 18px; font-weight: bold; color: {{:data.selected_corp_dialogue.reputation_color}}">
									{{:data.selected_corp_dialogue.reputation >= 0 ? '+' : ''}}{{:data.selected_corp_dialogue.reputation}}/50
								</span>
								<div class="rndRepBar">
									<div class="rndRepFill" style="width: {{:(data.selected_corp_dialogue.reputation + 50)}}%; background-color: {{:data.selected_corp_dialogue.reputation >= 0 ? '#00AA00' : '#AA0000'}};"></div>
								</div>
							</div>
						</div>

						<div class="rndNodeField">
							<div class="rndNodeLabel">Статус отношений</div>
							<div class="rndNodeValue">
								{{if data.selected_corp_dialogue.reputation >= 40}}
									<span style="color: #00FF00">Отличные отношения</span>
								{{else}}
									{{if data.selected_corp_dialogue.reputation >= 20}}
										<span style="color: #00DD00">Хорошие отношения</span>
									{{else}}
										{{if data.selected_corp_dialogue.reputation >= 0}}
											<span style="color: #FFDD00">Нейтральные отношения</span>
										{{else}}
											{{if data.selected_corp_dialogue.reputation >= -20}}
												<span style="color: #FF8800">Напряжённые отношения</span>
											{{else}}
												<span style="color: #FF0000">Враждебные отношения</span>
											{{/if}}
										{{/if}}
									{{/if}}
								{{/if}}
							</div>
						</div>

						<div class="rndNodeField">
							<div class="rndNodeLabel">О корпорации</div>
							<div class="rndNodeValue rndCorpInfo">
								{{:data.selected_corp_dialogue.info}}
							</div>
						</div>
					{{else}}
						<div class="rndMuted" style="text-align: center; padding: 20px 0;">Выберите корпорацию для просмотра информации</div>
					{{/if}}
				</div>
			</div>
		</div>
	</div>
	{{/if}}

</div>
{{/if}}

<!-- ============================================================ -->
<!-- PROTOLATHE / CIRCUIT IMPRINTER SCREEN                        -->
<!-- ============================================================ -->
{{if data.screen == "protolathe" || data.screen == "circuit_imprinter" || data.screen == "robotics_fabricator" || data.screen == "mech_fabricator"}}
<div class="rndConsole rndTheme--{{:data.ui_theme || 'neutral'}}">
	<div class="rndNav rndNavSub">
		<div class="rndNavTabs">
			{{:helper.link("Назад", 'arrowreturn-1-w', {'go_screen' : 'main'}, null, 'rndTab')}}
			<span class="rndNavTitle">{{if data.screen == "protolathe"}}Protolathe{{else data.screen == "circuit_imprinter"}}Circuit Imprinter{{else data.screen == "robotics_fabricator"}}Robofabricator{{else}}Mech Fabricator{{/if}}</span>
		</div>
	</div>

	<div class="rndTwoCol">
		<div class="rndCol" style="width: 60%;">
			<div class="rndSection">
				<div class="rndSectionTitle">
					{{if data.screen == "protolathe"}}Меню протолата{{else data.screen == "circuit_imprinter"}}Меню импринтера{{else data.screen == "robotics_fabricator"}}Меню робофабрикатора{{else}}Меню мехфабрикатора{{/if}}
					<span style="float: right;">
						{{:helper.link("Поиск", '', {'search' : 1})}}
						{{if data.search_text}} <span class="rndMuted">«{{:data.search_text}}»</span>{{/if}}
					</span>
				</div>
				<div class="rndSectionContent">
					<!-- Design Categories -->
					<div class="rndBtnRow" style="margin-bottom: 6px; flex-wrap: wrap;">
						{{for data.all_categories}}
							{{:helper.link(value, '', {'select_category' : value}, data.selected_category == value ? 'selected' : null)}}
						{{/for}}
					</div>
					{{if data.selected_category && data.hdd_capacities[data.selected_category]}}
					{{var hddInfo = data.hdd_capacities[data.selected_category];}}
					{{var pct = Math.round(hddInfo.used / hddInfo.max * 100);}}
					<div class="rndDiskBarWrap" style="margin-bottom: 8px;">
						<span class="rndMuted" style="font-size:10px;">HDD: {{:hddInfo.used}} / {{:hddInfo.max}} GQ</span>
						<div class="rndDiskBar">
							<div class="rndDiskBarFill {{:pct >= 100 ? 'rndDiskBarFull' : pct >= 75 ? 'rndDiskBarWarn' : ''}}" style="width:{{:pct}}%;"></div>
						</div>
						<span class="rndMuted" style="font-size:10px; min-width:28px;">{{:pct}}%</span>
					</div>
					{{/if}}

					<!-- Design List -->
					<div class="rndDesignListScroll" data-scroll-id="rnd-proto-designs">
						<table class="rndDesignTable">
							{{for data.possible_designs}}
							<tr class="{{:value.banned ? 'rndDesignBanned' : ''}}">
								<td class="rndDesignIcon"><img src={{:value.data.icon}} height=24 width=24></td>
								<td class="rndDesignName">
									{{if value.banned}}<span class="rndBannedMark">&#9888;</span>{{/if}}
									{{:helper.link(value.data.name, '', {'build' : value.id, 'amount': 1}, value.can_create >= 1 && !value.banned ? null : 'disabled')}}
									{{if data.screen == "protolathe" && !value.banned}}
										{{if value.can_create >= 3}}{{:helper.link('x3', '', {'build' : value.id, 'amount': 3})}}{{/if}}
										{{if value.can_create >= 5}}{{:helper.link('x5', '', {'build' : value.id, 'amount': 5})}}{{/if}}
									{{/if}}
								</td>
								<td class="rndDesignCost">
									{{for value.data.materials :material:material_i}}
										{{material.amount = value.data.adjust_materials ? Math.round((material.req * data.materials_data.mat_efficiency) * 100) / 100 : material.req;}}
										<span style="color: {{:value.missing_materials.indexOf(material.id) == -1 ? '#cde' : '#ff4444'}}">{{:material.amount}} {{:material.name}} </span>
									{{/for}}
									{{for value.data.chemicals :chemical:chemical_i}}
										<span style="color: {{:value.missing_chemicals.indexOf(chemical.id) == -1 ? '#cde' : '#ff4444'}}">{{:chemical.req}} {{:chemical.name}} </span>
									{{/for}}
									{{if value.temp_chemical}}{{:value.temp_chemical}}{{/if}}
								</td>
							</tr>
							<tr><td colspan='3'><small class="rndMuted">{{:value.data.desc}}</small></td></tr>
							{{/for}}
						</table>
					</div>
				</div>
			</div>
		</div>

		<div class="rndCol" style="width: 40%;">
			<!-- Material Storage -->
			<div class="rndSection">
				<div class="rndSectionTitle">Хранилище материалов</div>
				<div class="rndSectionContent">
					<table class="rndTechTable" style="width: 100%;">
						{{for data.materials_data.reagents}}
						<tr><td class="rndTechName">{{:value.name}}</td><td>{{:Math.round(value.amount * 100) / 100}}</td></tr>
						{{/for}}
						{{for data.materials_data.materials}}
						<tr>
							<td class="rndTechName">{{:value.name.toTitleCase()}}</td>
							<td>{{:Math.round(value.amount * 100) / 100}}/{{:data.materials_data.mat_capacity}}</td>
							<td>
								{{if value.amount && value.ejectable}}
									{{:helper.link("x1", '', {'eject_sheet' : value.id, 'amount' : 1})}}
									{{:helper.link("x5", '', {'eject_sheet' : value.id, 'amount' : 5}, value.amount >= 5 ? "" : "disabled")}}
									{{:helper.link("All", '', {'eject_sheet' : value.id, 'amount' : 1000})}}
								{{/if}}
							</td>
						</tr>
						{{/for}}
						{{if (!data.materials_data.materials || !data.materials_data.materials.length) && (!data.materials_data.reagents || !data.materials_data.reagents.length)}}
							<tr><td class="rndMuted">Пусто</td></tr>
						{{/if}}
					</table>
				</div>
			</div>

			<!-- Construction Queue -->
			<div class="rndSection">
				<div class="rndSectionTitle">Очередь производства</div>
				<div class="rndSectionContent">
					{{if data.device_current}}
						<div style="margin-bottom: 4px;">Производство: <b>{{:data.device_current}}</b></div>
						{{if data.device_error}}<div class="bad">{{:data.device_error}}</div>{{/if}}
					{{/if}}
					{{for data.queue}}
						<div>{{:index + 1}}) {{:value}}</div>
					{{empty}}
						<span class="rndMuted">Очередь пуста</span>
					{{/for}}
					{{if data.queue.length > 0}}
						<div style="margin-top: 6px;">{{:helper.link("Очистить", '', {'clear_queue' : 1})}}</div>
					{{/if}}
				</div>
			</div>
		</div>
	</div>
</div>
{{/if}}

<!-- ============================================================ -->
<!-- DISK MANAGEMENT SCREENS                                      -->
<!-- ============================================================ -->
{{if data.screen == "disk_management_designs"}}
<div class="rndConsole rndTheme--{{:data.ui_theme || 'neutral'}}">
	<div class="rndNav rndNavSub">
		<div class="rndNavTabs">
			{{:helper.link("Назад", 'arrowreturn-1-w', {'go_screen' : 'main'}, null, 'rndTab')}}
			<span class="rndNavTitle">Управление дизайнами</span>
		</div>
		<div class="rndNavStatus">
			{{if data.has_disk}}
				{{var pct = Math.round(data.disk_used / data.disk_size * 100);}}
				<div class="rndDiskBarWrap">
					<span class="rndMuted" style="font-size:10px;">{{:data.disk_used}} / {{:data.disk_size}} GQ</span>
					<div class="rndDiskBar">
						<div class="rndDiskBarFill {{:pct >= 100 ? 'rndDiskBarFull' : pct >= 75 ? 'rndDiskBarWarn' : ''}}" style="width:{{:pct}}%;"></div>
					</div>
					<span class="rndMuted" style="font-size:10px; min-width:28px;">{{:pct}}%</span>
				</div>
			{{/if}}
		</div>
	</div>

	{{if data.has_disk}}
	<!-- Category Filter & Search -->
	<div class="rndSection">
		<div class="rndSectionTitle">Фильтр</div>
		<div class="rndSectionContent">
			<div class="rndBtnRow" style="flex-wrap: wrap; gap: 3px;">
				{{:helper.link("Все", '', {'select_disk_category' : '__all__'}, !data.selected_disk_category ? 'selected' : null)}}
				{{for data.disk_design_categories}}
					{{:helper.link(value, '', {'select_disk_category' : value}, data.selected_disk_category == value ? 'selected' : null)}}
				{{/for}}
				<span style="margin-left: auto;">
					{{:helper.link("Поиск", '', {'search' : 1})}}
					{{if data.search_text}} <span class="rndMuted">«{{:data.search_text}}»</span> {{:helper.link("X", '', {'clear_search' : 1})}}{{/if}}
				</span>
			</div>
		</div>
	</div>

	<div class="rndTwoCol">
		<div class="rndCol" style="width: 50%;">
			<div class="rndSection">
				<div class="rndSectionTitle" style="display:flex; justify-content:space-between; align-items:center;">
					<span>Диск</span>
					<span style="font-size:10px; font-weight:normal; color:#5a7a9a; letter-spacing:0;">{{:data.disk_designs.length}} дизайнов</span>
				</div>
				<div class="rndSectionContent rndFileList" data-scroll-id="rnd-disk-designs">
					{{for data.disk_designs}}
					<div class="rndFileItem{{:value.banned ? ' rndDesignBanned' : ''}}">
						<span>
							{{if value.banned}}<span class="rndBannedMark" title="Дизайн запрещён администратором">&#9888;</span> {{/if}}{{:value.name}}
						</span>
						<span>
							{{:helper.link("", 'trash', {'delete_disk_file' : value.id}, data.disk_read_only ? 'disabled' : null)}}
							{{:helper.link("", 'arrowthick-1-e', {'download_disk_design' : value.id}, value.banned ? 'disabled' : null)}}
						</span>
					</div>
					{{empty}}
					<span class="rndMuted">На диске нет дизайнов</span>
					{{/for}}
				</div>
			</div>
		</div>
		<div class="rndCol" style="width: 50%;">
			<div class="rndSection">
				<div class="rndSectionTitle" style="display:flex; justify-content:space-between; align-items:center;">
					<span>Локальная база данных</span>
					<span style="font-size:10px; font-weight:normal; color:#5a7a9a; letter-spacing:0;">{{:data.known_designs.length}} дизайнов</span>
				</div>
				<div class="rndSectionContent rndFileList" data-scroll-id="rnd-disk-known">
					{{for data.known_designs}}
					<div class="rndFileItem{{:value.banned ? ' rndDesignBanned' : ''}}">
						<span>
							{{if value.banned}}<span class="rndBannedMark" title="Дизайн запрещён администратором">&#9888;</span> {{/if}}{{:value.name}}
						</span>
						{{:helper.link("", 'arrowthick-1-w', {'upload_disk_design' : value.id}, (data.disk_read_only || value.banned) ? 'disabled' : null)}}
					</div>
					{{empty}}
					<span class="rndMuted">Локальная база пуста</span>
					{{/for}}
				</div>
			</div>
		</div>
	</div>
	{{/if}}
</div>
{{/if}}

{{if data.screen == "disk_management_tech"}}
<div class="rndConsole rndTheme--{{:data.ui_theme || 'neutral'}}">
