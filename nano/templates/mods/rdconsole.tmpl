.rndCenterScreen {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	min-height: 300px;
	text-align: center;
}

.rndLoadingIcon {
	font-size: 48px;
	color: #4a88cc;
	animation: rndSpin 2s linear infinite;
	margin-bottom: 16px;
}

@keyframes rndSpin {
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}

.rndLoadingText {
	font-size: 18px;
	font-weight: bold;
	letter-spacing: 3px;
	text-transform: uppercase;
	color: #8ab4e8;
}

.rndLoadingSubtext {
	font-size: 12px;
	color: #5a7a9a;
	margin-top: 8px;
}

/* === Tech Table === */
.rndTechTable {
	width: 100%;
	border-collapse: collapse;
}

.rndTechTable td {
	padding: 2px 0;
}

.rndTechName {
	width: 120px;
	color: #8ab4e8;
	font-size: 12px;
	white-space: nowrap;
}

.rndTechBar {
	width: 100%;
}

/* === Analyzer === */
.rndAnalyzerItem {
	margin-bottom: 6px;
	font-size: 13px;
}

/* === Color Grid (Spectral) === */
.rndColorGrid {
	display: flex;
	gap: 8px;
	margin-bottom: 8px;
	justify-content: center;
}

.rndColorBlock {
	width: 56px;
	height: 56px;
	border-radius: 4px;
	border: 2px solid rgba(40, 70, 110, 0.5);
	position: relative;
	transition: all 0.2s;
}

.rndColorBlock:hover {
	border-color: rgba(160, 200, 255, 0.6);
	box-shadow: 0 0 14px rgba(100, 160, 255, 0.25);
	transform: scale(1.05);
}

.rndColorBlock.rndColorActive {
	border-color: white;
	box-shadow: 0 0 16px rgba(255, 255, 255, 0.4);
}

.rndColorOverlay {
	position: absolute !important;
	top: 0 !important;
	left: 0 !important;
	right: 0 !important;
	bottom: 0 !important;
	width: 100% !important;
	height: 100% !important;
	min-width: 0 !important;
	max-width: none !important;
	float: none !important;
	display: block !important;
	background: transparent !important;
	border: none !important;
	border-radius: 4px !important;
	padding: 0 !important;
	margin: 0 !important;
	cursor: pointer !important;
	box-shadow: none !important;
}

