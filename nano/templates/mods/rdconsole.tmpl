}

/* === Tech Tree === */
#sciTechTreeContainer {
	position: relative;
	width: 99%;
	height: 480px;
	overflow: hidden;
	border: 1px solid rgba(64, 98, 138, 0.5);
	background: url(nanomapBackground.png);
	border-radius: 3px;
	background-color: rgba(4, 8, 16, 0.6);
	box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.4), inset 0 0 0 1px rgba(40, 70, 110, 0.3);
}

.rndTreeWatermark {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 60%;
	height: 60%;
	transform: translate(-50%, -50%);
	background: center center / contain no-repeat;
	opacity: 0.08;
	pointer-events: none;
}

.rndCorpSubTabs {
	border-top: 1px solid rgba(64, 98, 138, 0.3);
	padding-top: 6px;
}

.sciTechTreeIcon {
	position: absolute;
