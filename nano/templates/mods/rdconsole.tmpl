	font-size: 12px;
	color: #aaccee;
}

.rndExpBadge {
	font-size: 9px;
	padding: 2px 6px;
	border-radius: 2px;
	letter-spacing: 0.5px;
	text-transform: uppercase;
}

.rndExpBadge--active {
	background: rgba(60, 120, 40, 0.4);
	color: #6c6;
	border: 1px solid rgba(80, 160, 60, 0.4);
}

.rndExpBody {
	font-size: 12px;
	margin-bottom: 6px;
	line-height: 1.4;
}

.rndExpResult {
	padding: 4px 8px;
	margin-bottom: 4px;
	background: rgba(6, 12, 24, 0.4);
	border-left: 2px solid rgba(80, 160, 255, 0.4);
