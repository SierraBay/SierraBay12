.rndSectionContent {
	padding: 8px 10px;
}

/* === Utility Classes === */
.rndMuted {
	color: #5a7a9a;
}

.rndLabel {
	font-size: 12px;
	color: #8ab4e8;
	letter-spacing: 0.3px;
}

.rndDivider {
	border: none;
	border-top: 1px solid rgba(64, 98, 138, 0.3);
	margin: 8px 0;
}

.rndBtnRow {
	display: flex;
	gap: 4px;
	flex-wrap: wrap;
}

.rndSubPanel {
	margin-top: 8px;
	padding: 8px;
	background: rgba(6, 12, 24, 0.4);
	border: 1px solid rgba(40, 70, 110, 0.3);
	border-radius: 2px;
}

.rndMenuBtn {
	padding: 8px 16px !important;
	font-size: 12px !important;
	letter-spacing: 0.4px;
	flex: 1;
	text-align: center !important;
}

.rndExpBtn {
	flex: 1;
}

.rndUnlockBtn {
	padding: 8px 24px !important;
	font-size: 13px !important;
}

.rndBuyBtn {
	display: block;
	text-align: center !important;
	padding: 6px 16px !important;
	background: rgba(40, 100, 60, 0.5) !important;
	border-color: rgba(60, 160, 80, 0.5) !important;
	margin-top: 8px;
}

.rndBuyBtn:hover {
	background: rgba(50, 120, 70, 0.6) !important;
}

