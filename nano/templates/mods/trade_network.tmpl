									<div class="tn-panel-title">Select a trader</div>
									<div class="tn-panel-subtitle tn-muted">Choose a visible trade station on the left to inspect availability, categories, and pricing.</div>
								</div>
							</div>
						</div>
					{{/if}}
				</div>
			</div>

		<!-- Export -->
