										<div class="tn-panel-label">Prerequisites</div>
										<div class="tn-panel-title">Prepare a sending route</div>
									</div>
									<div class="tn-panel-side">
										<div class="tn-header-count">{{:data.export_total}}</div>
										<div class="tn-muted">{{:data.currency_short}} estimated</div>
									</div>
								</div>
								<div class="tn-kv-grid">
									<div class="tn-kv">
										<div class="tn-panel-label">Linked Account</div>
										<div class="tn-kv-value">
