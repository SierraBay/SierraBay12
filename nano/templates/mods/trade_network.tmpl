												Ready
											{{else}}
												<span class="tn-empty">Required</span>
											{{/if}}
										</div>
									</div>
									<div class="tn-kv">
										<div class="tn-panel-label">Sending Beacon</div>
										<div class="tn-kv-value">
											{{if data.has_sending}}
												{{:data.sending}}
											{{else}}
												<span class="tn-empty">Not selected.</span>
											{{/if}}
										</div>
									</div>
								</div>

								<hr class="tn-section-divider">

