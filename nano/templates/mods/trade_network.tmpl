								</div>
								<div class="tn-actions">
									{{:helper.link('Set receiving beacon', null, {'PRG_receiving' : 1}, null, 'tn-inlineLink')}}
								</div>
							</div>

							{{if !data.available_contracts || !data.available_contracts.length}}
								<div class="tn-empty-panel">
									<div class="tn-panel-title">No available contracts</div>
									<div class="tn-panel-subtitle tn-muted">New delivery opportunities will appear here.</div>
								</div>
							{{else}}
								<table class="tn-table">
									<thead>
										<tr>
											<th class="tn-w-16">Route</th>
											<th class="tn-w-10">Dist.</th>
											<th class="tn-w-30">Cargo</th>
											<th class="tn-w-12">Value</th>
											<th class="tn-w-12">Reward</th>
											<th class="tn-w-10">Status</th>
											<th class="tn-w-10">Action</th>
										</tr>
									</thead>
									<tbody>
										{{for data.available_contracts:contract_entry:contract_index}}
											<tr class="candystripe tn-order-row">
												<td>
													<div>#{{:contract_entry.serial}}</div>
													<span class="tn-table-muted tn-muted">{{:contract_entry.source_name}} -> {{:contract_entry.destination_name}}</span>
												</td>
												<td>{{:contract_entry.distance}}</td>
												<td>
													<div>{{:contract_entry.cargo}}</div>
													<span class="tn-table-muted tn-muted">{{:contract_entry.status_text}}</span>
												</td>
												<td>{{:contract_entry.base_value}} {{:data.currency_short}}</td>
												<td>{{:contract_entry.reward}} {{:data.currency_short}}</td>
												<td><span class="tn-badge tn-badge-{{:contract_entry.status_tone}}">{{:contract_entry.status}}</span></td>
												<td class="tn-table-actions">{{:helper.link('Accept', null, {'PRG_contract_accept' : contract_entry.id}, contract_entry.can_act ? null : 'disabled', 'tn-inlineLink')}}</td>
											</tr>
										{{/for}}
									</tbody>
								</table>
							{{/if}}
						</div>
					</div>
				</div>

				<div class="tn-col">
					<div class="section">
						<div class="section-title">Active Contracts</div>
						<div class="section-content">
							<div class="tn-panel">
								<div class="tn-panel-header">
									<div class="tn-panel-copy">
										<div class="tn-panel-label">Outbound Work</div>
										<div class="tn-panel-title">{{:data.active_contract_count}} active contracts</div>
										<div class="tn-panel-subtitle tn-muted">Deliver completed cargo through the configured sending route.</div>
									</div>
								</div>
								<div class="tn-actions">
									{{:helper.link('Set sending beacon', null, {'PRG_sending' : 1}, null, 'tn-inlineLink')}}
								</div>
							</div>

							{{if !data.active_contracts || !data.active_contracts.length}}
								<div class="tn-empty-panel">
									<div class="tn-panel-title">No active contracts</div>
									<div class="tn-panel-subtitle tn-muted">Accepted contracts will stay here until delivered or failed.</div>
								</div>
							{{else}}
								<table class="tn-table">
									<thead>
										<tr>
											<th class="tn-w-16">Route</th>
											<th class="tn-w-10">Dist.</th>
											<th class="tn-w-28">Cargo</th>
											<th class="tn-w-16">Assigned To</th>
											<th class="tn-w-10">Reward</th>
											<th class="tn-w-10">Status</th>
											<th class="tn-w-10">Action</th>
										</tr>
									</thead>
									<tbody>
										{{for data.active_contracts:contract_entry:contract_index}}
											<tr class="candystripe tn-order-row">
												<td>
													<div>#{{:contract_entry.serial}}</div>
													<span class="tn-table-muted tn-muted">{{:contract_entry.source_name}} -> {{:contract_entry.destination_name}}</span>
												</td>
												<td>{{:contract_entry.distance}}</td>
												<td>
													<div>{{:contract_entry.cargo}}</div>
													<span class="tn-table-muted tn-muted">{{:contract_entry.status_text}}</span>
												</td>
												<td>{{:contract_entry.accepted_by}}</td>
												<td>{{:contract_entry.reward}} {{:data.currency_short}}</td>
												<td><span class="tn-badge tn-badge-{{:contract_entry.status_tone}}">{{:contract_entry.status}}</span></td>
												<td class="tn-table-actions">{{:helper.link('Deliver', null, {'PRG_contract_deliver' : contract_entry.id}, contract_entry.can_act ? null : 'disabled', 'tn-inlineLink')}}</td>
											</tr>
										{{/for}}
									</tbody>
								</table>
							{{/if}}
						</div>
					</div>

					<div class="section">
						<div class="section-title">Resolved Contracts</div>
						<div class="section-content">
							<div class="tn-panel">
								<div class="tn-panel-label">History</div>
								<div class="tn-panel-title">{{:data.resolved_contract_count}} resolved contracts</div>
							</div>

							{{if !data.resolved_contract_count}}
								<div class="tn-empty-panel">
									<div class="tn-panel-title">No resolved contracts</div>
									<div class="tn-panel-subtitle tn-muted">Completed and failed contract history will appear here.</div>
								</div>
							{{else}}
								<table class="tn-table">
									<thead>
										<tr>
											<th class="tn-w-16">Route</th>
											<th class="tn-w-10">Dist.</th>
											<th class="tn-w-30">Cargo</th>
											<th class="tn-w-14">Assigned To</th>
											<th class="tn-w-10">Result</th>
											<th class="tn-w-20">Notes</th>
										</tr>
									</thead>
									<tbody>
										{{for data.completed_contracts:contract_entry:contract_index}}
											<tr class="candystripe tn-order-row">
												<td>
													<div>#{{:contract_entry.serial}}</div>
													<span class="tn-table-muted tn-muted">{{:contract_entry.source_name}} -> {{:contract_entry.destination_name}}</span>
												</td>
												<td>{{:contract_entry.distance}}</td>
												<td>{{:contract_entry.cargo}}</td>
												<td>{{:contract_entry.accepted_by}}</td>
												<td><span class="tn-badge tn-badge-{{:contract_entry.status_tone}}">{{:contract_entry.status}}</span></td>
												<td>{{:contract_entry.reward}} {{:data.currency_short}} paid</td>
											</tr>
										{{/for}}
										{{for data.failed_contracts:contract_entry:contract_index}}
											<tr class="candystripe tn-order-row">
												<td>
													<div>#{{:contract_entry.serial}}</div>
													<span class="tn-table-muted tn-muted">{{:contract_entry.source_name}} -> {{:contract_entry.destination_name}}</span>
												</td>
												<td>{{:contract_entry.distance}}</td>
												<td>{{:contract_entry.cargo}}</td>
												<td>{{:contract_entry.accepted_by}}</td>
												<td><span class="tn-badge tn-badge-{{:contract_entry.status_tone}}">{{:contract_entry.status}}</span></td>
												<td>{{:contract_entry.status_text}} {{if contract_entry.penalty}}({{:contract_entry.penalty}} {{:data.currency_short}} penalty){{/if}}</td>
											</tr>
										{{/for}}
									</tbody>
								</table>
							{{/if}}
						</div>
					</div>
				</div>
			</div>

		<!-- Logs -->
		{{else data.screen == 'logs'}}
			<div class="section">
				<div class="section-title">Logs</div>
				<div class="section-content">
					<div class="tn-panel">
						<div class="tn-panel-header">
							<div class="tn-panel-copy">
								<div class="tn-panel-label">Archive</div>
								<div class="tn-panel-title">{{if data.log_entries}}{{:data.log_entries.length}}{{else}}0{{/if}} entries in view</div>
								<div class="tn-panel-subtitle tn-muted">Switch log channels and print invoices from the currently selected history stream.</div>
							</div>
						</div>
						{{if data.has_printer}}
							<div class="tn-note">Printer is available for invoice output.</div>
						{{else}}
							<div class="notice average">Install a printer to enable invoice output.</div>
						{{/if}}
					</div>

					<div class="tn-pillnav">
						{{:helper.link('Shipping', null, {'PRG_log_screen' : 'Shipping'}, data.log_screen == 'Shipping' ? 'selected' : null, 'tn-inlineLink')}}
						{{:helper.link('Export', null, {'PRG_log_screen' : 'Export'}, data.log_screen == 'Export' ? 'selected' : null, 'tn-inlineLink')}}
						{{:helper.link('Orders', null, {'PRG_log_screen' : 'Order'}, data.log_screen == 'Order' ? 'selected' : null, 'tn-inlineLink')}}
						{{:helper.link('Contracts', null, {'PRG_log_screen' : 'Contract'}, data.log_screen == 'Contract' ? 'selected' : null, 'tn-inlineLink')}}
					</div>

					{{if !data.log_entries || !data.log_entries.length}}
						<div class="tn-empty-panel">
							<div class="tn-panel-title">No entries in this log</div>
							<div class="tn-panel-subtitle tn-muted">Change the log tab or wait for new trading activity to be recorded.</div>
						</div>
					{{else}}
						<table class="tn-table">
							<thead>
								<tr>
									<th class="tn-w-18">Invoice</th>
									<th class="tn-w-16">Time</th>
									<th class="tn-w-36">Account</th>
									<th class="tn-w-15">Total</th>
									<th class="tn-w-15">Actions</th>
								</tr>
							</thead>
							<tbody>
								{{for data.log_entries:log_entry:log_entry_index}}
									<tr class="candystripe tn-log-row">
										<td>#{{:log_entry.id}}</td>
										<td>{{:log_entry.time}}</td>
										<td>{{:log_entry.ordering_acct}}</td>
										<td>{{:log_entry.total_paid}} {{:data.currency_short}}</td>
										<td class="tn-table-actions">
											{{:helper.link('Print', null, {'PRG_print' : log_entry.id}, data.has_printer ? null : 'disabled', 'tn-inlineLink')}}
											{{:helper.link('Internal', null, {'PRG_print_internal' : log_entry.id}, data.has_printer ? null : 'disabled', 'tn-inlineLink')}}
										</td>
									</tr>
								{{/for}}
							</tbody>
						</table>
					{{/if}}
				</div>
			</div>
		{{/if}}
	</div>
</div>
