<style>
	.tn-wrap {
		padding: 8px;
	}

	.tn-stack > * + * {
		margin-top: 8px;
	}

	.tn-nav,
	.tn-actions,
	.tn-tabs {
		overflow: hidden;
	}

	.tn-inlineLink,
	.tn-inlineLink.link,
	.tn-inlineLink.linkActive {
		float: none;
		display: inline-block;
		vertical-align: middle;
	}

	.tn-toolbar {
		padding: 10px 12px;
	}

	.tn-toolbar-row {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 18px;
		align-items: flex-end;
	}

	.tn-workflow-group {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		align-items: center;
	}

	.tn-workflow-label {
		min-width: 70px;
		font-size: 11px;
		font-weight: bold;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #7e90a7;
	}

	.tn-summary-grid,
	.tn-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tn-summary-card,
	.tn-col {
		flex: 1 1 320px;
		min-width: 320px;
	}

	.tn-summary-card {
		padding: 10px 12px;
		border: 1px solid rgba(255, 255, 255, 0.06);
		background: rgba(255, 255, 255, 0.02);
	}

	.tn-summary-label,
	.tn-panel-label,
	.tn-subtle,
	.tn-muted {
		color: #7e90a7;
	}

	.tn-summary-label,
	.tn-panel-label {
		font-size: 11px;
		font-weight: bold;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.tn-summary-value,
	.tn-panel-title {
		margin-top: 4px;
		font-size: 15px;
		font-weight: bold;
		color: #eef4ff;
	}

	.tn-summary-meta {
		margin-top: 4px;
		font-size: 12px;
	}

	.tn-empty {
		color: #aaa;
		font-style: italic;
	}

	.tn-empty-panel {
		padding: 18px;
		border: 1px dashed rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.02);
	}

	.tn-panel {
		padding: 12px;
		border: 1px solid rgba(255, 255, 255, 0.06);
		background: rgba(255, 255, 255, 0.02);
	}

	.tn-panel + .tn-panel,
	.tn-panel + .section,
	.section + .tn-panel {
		margin-top: 8px;
	}

	.tn-panel-header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px;
		align-items: flex-start;
		margin-bottom: 10px;
	}

	.tn-panel-copy {
		flex: 1 1 220px;
		min-width: 220px;
	}

	.tn-panel-title {
		margin: 0;
	}

	.tn-panel-subtitle {
		margin-top: 4px;
	}

	.tn-panel-side {
		text-align: right;
	}

	.tn-header-count {
		font-size: 22px;
		font-weight: bold;
		line-height: 1;
	}

	.tn-kv-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 8px;
	}

	.tn-kv {
		padding: 8px 10px;
		border: 1px solid rgba(255, 255, 255, 0.05);
		background: rgba(0, 0, 0, 0.14);
	}

	.tn-kv-value {
		margin-top: 3px;
		word-break: break-word;
	}

	.tn-pillnav {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		margin-bottom: 10px;
	}

	.tn-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		align-items: center;
	}

	.tn-actions-primary {
		gap: 6px;
	}

	.tn-actions-primary .tn-inlineLink,
	.tn-actions-primary .tn-inlineLink.link,
	.tn-actions-primary .tn-inlineLink.linkActive {
		padding: 2px 6px;
	}

	.tn-actions-split {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px;
		align-items: center;
	}

	.tn-station-list > * + * {
		margin-top: 6px;
	}

	.tn-station {
		padding: 8px 10px;
		border: 1px solid rgba(255, 255, 255, 0.05);
		background: rgba(255, 255, 255, 0.02);
	}

	.tn-station-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 10px;
	}

	.tn-station-main {
		min-width: 0;
	}

	.tn-station-name {
		display: block;
		font-weight: bold;
		word-break: break-word;
	}

	.tn-station-meta {
		margin-top: 5px;
		display: flex;
		flex-wrap: wrap;
		gap: 4px 8px;
		align-items: center;
	}

	.tn-station-faction {
		font-size: 12px;
		font-weight: bold;
	}

	.tn-table {
		width: 100%;
		border-collapse: collapse;
	}

	.tn-table th,
	.tn-table td {
		padding: 6px 8px;
		text-align: left;
		vertical-align: top;
	}

	.tn-table th {
		color: #7e90a7;
		font-size: 11px;
		font-weight: bold;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.tn-table td {
		word-break: break-word;
	}

	.tn-table-actions {
		white-space: nowrap;
	}

	.tn-table-muted {
		display: block;
		margin-top: 3px;
	}

	.tn-order-row,
	.tn-log-row,
	.tn-saved-row {
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}

	.tn-row-selected {
		background: rgba(73, 114, 161, 0.18);
	}

	.tn-badge {
		display: inline-block;
		padding: 2px 8px;
		border-radius: 999px;
		font-size: 11px;
		font-weight: bold;
		line-height: 1.4;
		white-space: nowrap;
	}

	.tn-badge-good {
		background: rgba(56, 142, 60, 0.28);
		color: #a9e6a6;
	}

	.tn-badge-average {
		background: rgba(177, 134, 44, 0.28);
		color: #f0d48a;
	}

	.tn-badge-bad {
		background: rgba(160, 58, 58, 0.28);
		color: #ffb0b0;
	}

	.tn-flow-list > * + * {
		margin-top: 8px;
	}

	.tn-list-block {
		padding: 10px 12px;
		border: 1px solid rgba(255, 255, 255, 0.05);
		background: rgba(255, 255, 255, 0.02);
	}

	.tn-list-block-title {
		font-size: 14px;
		font-weight: bold;
	}

	.tn-list-block-subtitle {
		margin-top: 4px;
	}

	.tn-list-row {
		display: flex;
		justify-content: space-between;
		gap: 10px;
		padding: 6px 0;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	.tn-list-row:first-child {
		border-top: none;
		padding-top: 0;
	}

	.tn-list-row-main {
		min-width: 0;
	}

	.tn-list-row-side {
		text-align: right;
		white-space: nowrap;
	}

	.tn-form-shell {
		padding: 10px 12px;
		border: 1px solid rgba(73, 114, 161, 0.28);
		background: rgba(73, 114, 161, 0.12);
	}

	.tn-form {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		align-items: center;
	}

	.tn-form textarea,
	.tn-form input[type='text'],
	.tn-form input[type='number'] {
		background: #111;
		color: #fff;
		border: 1px solid #444;
		padding: 4px 6px;
		box-sizing: border-box;
	}

	.tn-form input[type='number'] {
		width: 90px;
	}

	.tn-form input[type='text'] {
		min-width: 220px;
	}

	.tn-form textarea {
		width: 100%;
		min-height: 76px;
		resize: vertical;
	}

	.tn-form input[type='submit'] {
		background: #4972a1;
		color: #fff;
		border: none;
		border-radius: 0.16em;
		padding: 4px 10px;
		cursor: pointer;
	}

	.tn-form-label-wide {
		width: 100%;
	}

	.tn-section-divider {
		margin: 12px 0;
		border: 0;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.tn-note {
		padding: 8px 10px;
		border: 1px solid rgba(255, 255, 255, 0.05);
		background: rgba(255, 255, 255, 0.02);
		color: #cfd8e7;
	}

	.tn-w-10 {
		width: 10%;
	}

	.tn-w-12 {
		width: 12%;
	}

	.tn-w-14 {
		width: 14%;
	}

	.tn-w-15 {
		width: 15%;
	}

	.tn-w-16 {
		width: 16%;
	}

	.tn-w-18 {
		width: 18%;
	}

	.tn-w-20 {
		width: 20%;
	}

	.tn-w-25 {
		width: 25%;
	}

	.tn-w-26 {
		width: 26%;
	}

	.tn-w-28 {
		width: 28%;
	}

	.tn-w-30 {
		width: 30%;
	}

	.tn-w-34 {
		width: 34%;
	}

	.tn-w-36 {
		width: 36%;
	}

	.tn-w-45 {
		width: 45%;
	}

	.tn-w-75 {
		width: 75%;
	}
</style>

<div class="tn-wrap">
	<div class="tn-stack">
		<div class="section">
			<div class="section-content tn-toolbar">
				<div class="tn-toolbar-row">
					<div class="tn-workflow-group">
						<div class="tn-workflow-label">Setup</div>
						{{:helper.link('Settings', null, {'PRG_trade_screen' : 'settings'}, data.screen == 'settings' ? 'selected' : null, 'tn-inlineLink')}}
					</div>
					<div class="tn-workflow-group">
						<div class="tn-workflow-label">Trade</div>
						{{:helper.link('Traders', null, {'PRG_trade_screen' : 'goods'}, data.screen == 'goods' ? 'selected' : null, 'tn-inlineLink')}}
						{{:helper.link('Cart', null, {'PRG_trade_screen' : 'cart'}, data.screen == 'cart' ? 'selected' : null, 'tn-inlineLink')}}
						{{:helper.link('Saved', null, {'PRG_trade_screen' : 'saved'}, data.screen == 'saved' ? 'selected' : null, 'tn-inlineLink')}}
					</div>
					<div class="tn-workflow-group">
						<div class="tn-workflow-label">Operations</div>
						{{:helper.link('Export', null, {'PRG_trade_screen' : 'export'}, data.screen == 'export' ? 'selected' : null, 'tn-inlineLink')}}
						{{:helper.link('Orders', null, {'PRG_trade_screen' : 'orders'}, data.screen == 'orders' ? 'selected' : null, 'tn-inlineLink')}}
						{{:helper.link('Contracts', null, {'PRG_trade_screen' : 'contracts'}, data.screen == 'contracts' ? 'selected' : null, 'tn-inlineLink')}}
						{{:helper.link('Logs', null, {'PRG_trade_screen' : 'logs'}, data.screen == 'logs' ? 'selected' : null, 'tn-inlineLink')}}
					</div>
				</div>
			</div>
		</div>

		<div class="tn-summary-grid">
			<div class="tn-summary-card">
				<div class="tn-summary-label">Trade Identity</div>
				<div class="tn-summary-value">{{:data.faction}}</div>
				<div class="tn-summary-meta">
					{{if data.has_account}}
						{{:data.account_owner_name}} #{{:data.account_number}} ({{:data.account_money}} {{:data.currency_short}})
					{{else}}
						<span class="tn-empty">No linked account.</span>
					{{/if}}
				</div>
			</div>

			<div class="tn-summary-card">
				<div class="tn-summary-label">Beacons</div>
				<div class="tn-summary-value">
					{{if data.has_receiving}}
						{{:data.receiving}}
					{{else}}
						<span class="tn-empty">Receiving not selected.</span>
					{{/if}}
				</div>
				<div class="tn-summary-meta">
					Sending:
					{{if data.has_sending}}
						{{:data.sending}}
					{{else}}
						<span class="tn-empty">Not selected.</span>
					{{/if}}
				</div>
			</div>

			<div class="tn-summary-card">
				<div class="tn-summary-label">Cart</div>
				<div class="tn-summary-value">{{:data.cart_count}} items</div>
				<div class="tn-summary-meta">{{:data.cart_total}} {{:data.currency_short}} total</div>
			</div>

			<div class="tn-summary-card">
				<div class="tn-summary-label">Operations Queue</div>
				<div class="tn-summary-value">{{:data.order_count}} pending orders</div>
				<div class="tn-summary-meta">{{:data.active_contract_count}} active contracts</div>
			</div>
		</div>

		<!-- Settings -->
		{{if data.screen == 'settings'}}
			<div class="tn-grid">
				<div class="tn-col">
					<div class="section">
						<div class="section-title">Trade Identity</div>
						<div class="section-content">
							<div class="tn-kv-grid">
								<div class="tn-kv">
									<div class="tn-panel-label">Faction</div>
									<div class="tn-kv-value">{{:data.faction}}</div>
								</div>
								<div class="tn-kv">
									<div class="tn-panel-label">Linked Account</div>
									<div class="tn-kv-value">
										{{if data.has_account}}
											{{:data.account_owner_name}} #{{:data.account_number}}
										{{else}}
											<span class="tn-empty">No linked account.</span>
										{{/if}}
									</div>
								</div>
								{{if data.has_account}}
									<div class="tn-kv">
										<div class="tn-panel-label">Account Balance</div>
										<div class="tn-kv-value">{{:data.account_money}} {{:data.currency_short}}</div>
									</div>
								{{/if}}
								{{if data.has_master_budget}}
									<div class="tn-kv">
										<div class="tn-panel-label">Supply Budget</div>
										<div class="tn-kv-value">{{:data.master_budget}} {{:data.currency_short}}</div>
									</div>
								{{/if}}
								{{if !data.has_account && data.has_inserted_id}}
									<div class="tn-kv">
										<div class="tn-panel-label">Inserted ID Account</div>
										<div class="tn-kv-value">
											{{if data.inserted_id_account_number}}
												#{{:data.inserted_id_account_number}}
											{{else}}
												<span class="tn-empty">No bank account is linked to this ID.</span>
											{{/if}}
										</div>
									</div>
								{{/if}}
							</div>

							<hr class="tn-section-divider">

							<div class="tn-actions">
								{{if data.faction != 'Independent'}}
									{{:helper.link('Reset faction', null, {'PRG_faction_unlink' : 1}, null, 'tn-inlineLink')}}
								{{else}}
									{{:helper.link('Link faction', null, {'PRG_faction' : 1}, null, 'tn-inlineLink')}}
								{{/if}}

								{{if data.has_account}}
									{{:helper.link('Unlink account', null, {'PRG_account_unlink' : 1}, null, 'tn-inlineLink')}}
								{{else}}
									{{if data.can_link_id_account}}
										{{:helper.link('Link ID account', null, {'PRG_account_id' : 1}, null, 'tn-inlineLink')}}
									{{/if}}
									{{:helper.link('Link account', null, {'PRG_account' : 1}, null, 'tn-inlineLink')}}
								{{/if}}
							</div>
						</div>
					</div>
				</div>

				<div class="tn-col">
					<div class="section">
						<div class="section-title">Trade Beacons</div>
						<div class="section-content">
							<div class="tn-flow-list">
								<div class="tn-list-block">
									<div class="tn-list-block-title">Receiving Beacon</div>
									<div class="tn-list-block-subtitle">
										{{if data.has_receiving}}
											{{:data.receiving}}
										{{else}}
											<span class="tn-empty">Not selected.</span>
										{{/if}}
									</div>
									<div class="tn-actions">
										{{:helper.link('Set receiving beacon', null, {'PRG_receiving' : 1}, null, 'tn-inlineLink')}}
									</div>
								</div>

								<div class="tn-list-block">
									<div class="tn-list-block-title">Sending Beacon</div>
									<div class="tn-list-block-subtitle">
										{{if data.has_sending}}
											{{:data.sending}}
										{{else}}
											<span class="tn-empty">Not selected.</span>
										{{/if}}
									</div>
									<div class="tn-actions">
										{{:helper.link('Set sending beacon', null, {'PRG_sending' : 1}, null, 'tn-inlineLink')}}
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

		<!-- Traders -->
		{{else data.screen == 'goods'}}
			<div class="tn-grid">
				<div class="tn-col">
					<div class="section">
						<div class="section-title">Visible Traders</div>
						<div class="section-content">
							{{if !data.has_visible_stations}}
								<div class="tn-empty-panel">
									<div class="tn-panel-title">No visible traders</div>
									<div class="tn-panel-subtitle tn-muted">No trade stations are currently visible.</div>
								</div>
							{{else}}
								<div class="tn-panel">
									<div class="tn-panel-header">
										<div class="tn-panel-copy">
											<div class="tn-panel-label">Network Status</div>
											<div class="tn-panel-title">{{:data.stations.length}} traders in range</div>
											<div class="tn-panel-subtitle tn-muted">Choose a trader to browse categories and queue items for delivery.</div>
										</div>
									</div>
									<div class="tn-station-list">
										{{for data.stations:station_entry:station_index}}
											<div class="tn-station">
												<div class="tn-station-header">
													<div class="tn-station-main">
														{{:helper.link(station_entry.name, null, {'PRG_station' : station_entry.uid}, station_entry.selected ? 'selected' : null, 'tn-inlineLink tn-station-name')}}
														<div class="tn-station-meta">
															<span class="tn-badge tn-badge-{{:station_entry.status_tone}}">{{:station_entry.status_label}}</span>
															<span class="tn-badge tn-badge-{{:station_entry.market_tone}}">{{:station_entry.market_label}}</span>
															<span class="tn-station-faction" style="color:{{:station_entry.faction_color}}">{{:station_entry.faction}}</span>
														</div>
													</div>
												</div>
											</div>
										{{/for}}
									</div>
								</div>
							{{/if}}
						</div>
					</div>
				</div>

				<div class="tn-col">
					{{if data.has_selected_station}}
						<div class="section">
							<div class="section-title">Trader Detail</div>
							<div class="section-content">
								<div class="tn-panel">
									<div class="tn-panel-header">
										<div class="tn-panel-copy">
											<div class="tn-panel-label">Selected Trader</div>
											<div class="tn-panel-title">{{:data.selected_station.name}}</div>
											<div class="tn-panel-subtitle">
												<span class="tn-station-faction" style="color:{{:data.selected_station.faction_color}}">{{:data.selected_station.faction}}</span>
											</div>
										</div>
										<div class="tn-panel-side">
											<span class="tn-badge tn-badge-{{:data.selected_station.status_tone}}">{{:data.selected_station.status_label}}</span>
											<span class="tn-badge tn-badge-{{:data.selected_station.market_tone}}">{{:data.selected_station.market_label}}</span>
										</div>
									</div>

									<div class="tn-panel-subtitle tn-muted">{{:data.selected_station.desc}}</div>
									<div class="tn-panel-subtitle tn-muted">{{:data.selected_station.market_desc}}</div>

									<div class="tn-kv-grid">
										<div class="tn-kv">
											<div class="tn-panel-label">Favor</div>
											<div class="tn-kv-value">{{:data.selected_station.favor}} / {{:data.selected_station.unlock_favor}}</div>
										</div>
										<div class="tn-kv">
											<div class="tn-panel-label">Restock In</div>
											<div class="tn-kv-value">{{:data.selected_station.restock_in}}</div>
										</div>
										<div class="tn-kv">
											<div class="tn-panel-label">Cart</div>
											<div class="tn-kv-value">{{:data.cart_count}} items queued</div>
										</div>
									</div>

									<hr class="tn-section-divider">

									<div class="tn-actions-split">
										<div class="tn-actions">
											{{:helper.link('Open cart', null, {'PRG_trade_screen' : 'cart'}, null, 'tn-inlineLink')}}
											{{:helper.link('Save current cart', null, {'PRG_cart_form' : 'save'}, data.can_save_cart ? null : 'disabled', 'tn-inlineLink')}}
										</div>
										<div class="tn-muted">{{:data.cart_total}} {{:data.currency_short}} total</div>
									</div>
								</div>

								{{if data.selected_station.block_reason}}
									<div class="notice bad">{{:data.selected_station.block_reason}}</div>
								{{else}}
									<div class="tn-panel">
										<div class="tn-panel-header">
											<div class="tn-panel-copy">
												<div class="tn-panel-label">Goods</div>
												<div class="tn-panel-title">Browse Available Categories</div>
											</div>
										</div>

										<div class="tn-pillnav">
											{{for data.categories:category_entry:category_index}}
												{{:helper.link(category_entry.name, null, {'PRG_goods_category' : category_entry.name}, category_entry.selected ? 'selected' : null, 'tn-inlineLink')}}
											{{/for}}
										</div>

										{{if data.goods && data.goods.length}}
											<table class="tn-table">
												<thead>
													<tr>
														<th class="tn-w-45">Item</th>
