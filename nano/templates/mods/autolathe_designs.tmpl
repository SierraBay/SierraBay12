{{for data.designs}}
	<div class="fabDesignItem {{:value.can_build ? '' : 'fabDesignItem--unavailable'}}">
		<div class="fabDesignRow">
			<div class="fabDesignIcon">
				<img src='{{:value.icon}}' height=24 width=24>
			</div>
			<div class="fabDesignName">{{:value.name}}</div>
			{{if value.point_cost > 0}}
				{{if !data.disk}}
					<span class="fabDesignLicense {{:data.use_license ? 'fabDesignLicense--bad' : 'fabDesignLicense--ok'}}">{{:value.point_cost}} LP</span>
				{{else}}
					<span class="fabDesignLicense {{:data.disk.license >= value.point_cost ? 'fabDesignLicense--ok' : 'fabDesignLicense--bad'}}">{{:value.point_cost}} LP</span>
				{{/if}}
			{{/if}}
			<div class="fabDesignActions">
				{{:helper.link('', 'plus', {'add_to_queue' : value.filename})}}
				{{:helper.link('', 'calculator', {'add_to_queue' : value.filename, 'several' : 1})}}
				{{:helper.link('', 'triangle-1-' + (value.filename == data.unfolded ? 'n' : 's'), {'unfold' : value.filename})}}
			</div>
		</div>
		{{if value.filename == data.unfolded}}
			<div class="fabDesignDetails">
				{{if value.materials}}
				<div class="fabDetailGroup">
					<div class="fabDetailLabel">Материалы</div>
					{{for value.materials :material:material_i}}
						{{material.amount = value.adjust_materials ? Math.round((material.req * data.mat_efficiency) * 100) / 100 : material.req;}}
						<div class="fabDetailValue">{{:material.name}}: {{:material.amount}}</div>
					{{/for}}
				</div>
				{{/if}}
				{{if value.chemicals}}
				<div class="fabDetailGroup">
					<div class="fabDetailLabel">Реагенты</div>
					{{for value.chemicals :chemical:chemical_i}}
						<div class="fabDetailValue">{{:chemical.name}}: {{:Math.round(chemical.req * 100) / 100}}</div>
					{{/for}}
				</div>
				{{/if}}
				<div class="fabDetailGroup">
					<span class="fabDetailStat"><b>Время:</b> {{:value.time}}</span>
					<span class="fabDetailStat"><b>Скорость:</b> {{:data.speed}}</span>
				</div>
				{{if value.minimum_quality > -2}}
				<div class="fabDetailGroup">
					<span class="fabDetailStat"><b>Мин. качество:</b> {{:value.minimum_quality < 0 ? value.minimum_quality : '+' + value.minimum_quality}}</span>
				</div>
				{{/if}}
			</div>
		{{/if}}
	</div>
{{empty}}
	<div class="fabEmptyState">
		{{if !data.disk && data.have_disk}}
			Диск не вставлен
		{{else !data.have_design_selector}}
			Управляется удалённо
		{{else}}
			Нет дизайнов
		{{/if}}
	</div>
{{/for}}
