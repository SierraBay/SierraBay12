<style>
    .piano-roll-container {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        display: flex;
        flex-direction: column;
        background: #222;
        color: #ddd;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        overflow: hidden;
    }
    .toolbar {
        display: flex;
        padding: 5px 10px;
        background: #333;
        border-bottom: 2px solid #444;
        gap: 10px;
        align-items: center;
        flex-shrink: 0;
    }
    .editor-body {
        display: flex;
        flex: 1;
        overflow: hidden;
        position: relative;
    }
    .sidebar {
        width: 80px;
        background: #2a2a2a;
        border-right: 2px solid #444;
        overflow: hidden;
        flex-shrink: 0;
        position: relative;
    }
    .grid-container {
        flex: 1;
        overflow: auto;
        background: #1a1a1a;
        position: relative;
    }
    .key {
        border-bottom: 1px solid #333;
        font-size: 10px;
        padding-left: 5px;
        display: flex;
        align-items: center;
        box-sizing: border-box;
    }
    .key.white { background: #eee; color: #333; }
    .key.black { background: #444; color: #ddd; }
    
    .btn {
        background: #444;
        color: #ddd;
        border: 1px solid #666;
        padding: 2px 8px;
        cursor: pointer;
    }
    .btn:hover { background: #555; }
    
    #diag-panel {
        background: #111;
        color: #0f0;
        font-family: monospace;
        font-size: 10px;
        padding: 2px 10px;
        border-top: 1px solid #444;
        flex-shrink: 0;
    }
    .selection-rect {
        border: 1px dashed #00AAFF;
        background: rgba(0, 170, 255, 0.2);
        position: absolute;
        pointer-events: none;
        z-index: 100;
    }
    #save-overlay, #export-modal {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        z-index: 1000;
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: #00AAFF;
        font-size: 20px;
        font-weight: bold;
    }
    .modal-content {
        background: #222;
        padding: 20px;
        border: 2px solid #444;
        width: 80%;
        max-width: 600px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    #export-textarea {
        width: 100%;
        height: 300px;
        background: #111;
        color: #0f0;
        font-family: monospace;
        border: 1px solid #444;
        padding: 10px;
        resize: none;
    }
</style>

<div class="piano-roll-container" data-src="{{:data.ref}}">
    <div id="save-overlay">
        <div>SAVING COMPOSITION...</div>
        <div id="save-progress" style="font-size: 14px; margin-top: 10px;">0%</div>
    </div>

    <div id="export-modal">
        <div class="modal-content">
            <div style="font-size: 16px;">EXPORTED SONG TEXT:</div>
            <textarea id="export-textarea" readonly></textarea>
            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button class="btn" id="close-export-btn">Close</button>
            </div>
        </div>
    </div>

    <div class="toolbar">
        <button class="btn" id="save-btn">Save</button>
        <button class="btn" id="delete-btn">Delete Selected</button>
        <button class="btn" id="export-btn">Export Text</button>
        <div style="margin-left: 10px;">
            Snap:
            <select id="grid-snap" class="btn">
                <option value="4">1/4</option>
                <option value="8">1/8</option>
                <option value="16" selected>1/16</option>
                <option value="32">1/32</option>
            </select>
        </div>
        <div style="margin-left: 10px;">
            BPM:
            <input type="number" id="bpm-input" value="{{:data.tempo}}" step="1" min="1" max="500" style="width: 50px; background: #222; color: #0f0; border: 1px solid #444; padding: 1px 3px;">
        </div>
        <div style="margin-left: auto; display: flex; gap: 5px;" id="playback-info">
        </div>
    </div>

    <div class="editor-body">
        <div class="sidebar" id="sidebar">
            <div id="sidebar-content"></div>
        </div>
        <div class="grid-container" id="grid-container">
            <div id="selection-box" class="selection-rect" style="display:none"></div>
            <canvas id="piano-roll-canvas"></canvas>
        </div>
    </div>
</div>
