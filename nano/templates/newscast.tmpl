{{if data.show_sector_map}}
	{{:helper.link("Return", 'arrowreturnthick-1-w', {'return_to_home' : 1})}}
	<hr>
	<!-- Odyssey Sector Map (public read-only in Newscast) -->
<style>
	.odysseyShell {
		position: relative;
		height: 560px;
		overflow: hidden;
		box-sizing: border-box;
		border: 2px solid #9a9a9a;
		border-radius: 10px;
		background: #14100f;
		color: #f0f0f0;
		font-family: "Lucida Console", "Courier New", monospace;
	}
	.odysseyShell::before {
		content: "";
		pointer-events: none;
		position: absolute;
		top: 0; left: 0; right: 0; bottom: 0;
		z-index: 0;
		opacity: .18;
		background: repeating-linear-gradient(to bottom, rgba(255,255,255,.04) 0px, rgba(255,255,255,.04) 1px, transparent 1px, transparent 3px);
	}
	.odysseyTitle { position: absolute; z-index: 4; top: 10px; left: 14px; font-size: 24px; font-weight: bold; letter-spacing: 2px; color: #fff; text-shadow: 3px 3px 0 #000; }
	.odysseyStatus { position: absolute; z-index: 4; top: 40px; left: 14px; font-size: 11px; color: #c8c0b8; }
	.odysseyMap { position: absolute; z-index: 1; left: 0; right: 260px; top: 0; bottom: 48px; }
	.odysseySvg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
	.odysseyNode {
		position: absolute; z-index: 2; width: 16px; height: 16px; margin-left: -8px; margin-bottom: -8px;
		border-radius: 50%; box-sizing: border-box; border: 1px solid rgba(0,0,0,.55); pointer-events: none;
	}
	.odysseyNode--civilian { background: #3fd03a; box-shadow: 0 0 6px #3fd03a; }
	.odysseyNode--hostile { background: #e23b3b; box-shadow: 0 0 6px #e23b3b; }
	.odysseyNode--nebula { background: #9b4fd6; box-shadow: 0 0 6px #9b4fd6; }
	.odysseyNode--locked { opacity: .45; }
	.odysseyNode--current { box-shadow: 0 0 0 2px #fff, 0 0 10px #fff; }
	.odysseyNode--selected { box-shadow: 0 0 0 2px #ffe14a, 0 0 12px #ffe14a; }
	.odysseyNode--viewed { box-shadow: 0 0 0 2px #9ad7ff, 0 0 10px #9ad7ff; }
	.odysseyNode--terminal { box-shadow: 0 0 0 2px #ffe14a, 0 0 12px #ffe14a; }
	.odysseyHit { position: absolute; z-index: 6; width: 30px; height: 30px; margin-left: -15px; margin-bottom: -15px; }
	.odysseyHit .link, .odysseyHit a {
		display: block; width: 30px; height: 30px; padding: 0 !important; margin: 0 !important;
		border: 0 !important; background: transparent !important; box-shadow: none !important;
		text-indent: -9999px; overflow: hidden;
	}
	.odysseyBracket {
		position: absolute; z-index: 3; width: 28px; height: 28px; margin-left: -14px; margin-bottom: -14px; pointer-events: none;
		background:
			linear-gradient(#ffe14a,#ffe14a) left top / 8px 2px no-repeat,
			linear-gradient(#ffe14a,#ffe14a) left top / 2px 8px no-repeat,
			linear-gradient(#ffe14a,#ffe14a) right top / 8px 2px no-repeat,
			linear-gradient(#ffe14a,#ffe14a) right top / 2px 8px no-repeat,
			linear-gradient(#ffe14a,#ffe14a) left bottom / 8px 2px no-repeat,
			linear-gradient(#ffe14a,#ffe14a) left bottom / 2px 8px no-repeat,
			linear-gradient(#ffe14a,#ffe14a) right bottom / 8px 2px no-repeat,
			linear-gradient(#ffe14a,#ffe14a) right bottom / 2px 8px no-repeat;
	}
	.odysseyLabel {
		position: absolute; z-index: 5; margin-left: 18px; margin-bottom: -10px; padding: 3px 7px;
		white-space: nowrap; border: 1px solid #d8d8d8; background: #0a0a0a; color: #fff; font-size: 11px;
	}
	.odysseyLabel .link, .odysseyLabel a {
		color: #fff !important; background: transparent !important; border: 0 !important;
		padding: 0 !important; margin: 0 !important; box-shadow: none !important;
	}
	.odysseyShip {
		position: absolute; z-index: 3; width: 0; height: 0; margin-left: -28px; margin-bottom: -6px;
		border-top: 6px solid transparent; border-bottom: 6px solid transparent; border-left: 14px solid #3fd03a;
		pointer-events: none;
	}
	.odysseyDossier {
		position: absolute; z-index: 4; top: 64px; right: 8px; bottom: 48px; width: 240px; padding: 10px;
		box-sizing: border-box; border: 1px solid #9a9a9a; border-radius: 8px; background: rgba(10,8,8,.94);
		overflow: auto; font-size: 12px; line-height: 1.4;
	}
	.odysseyDossier h3 { margin: 0 0 6px 0; font-size: 13px; color: #fff; }
	.odysseyDossierMeta { margin-bottom: 8px; color: #c8c0b8; }
	.odysseyDossierBody { margin-bottom: 10px; color: #ece6de; }
	.odysseyDossierExits { margin-bottom: 10px; color: #b9d7ff; }
	.odysseyDossierHint { color: #8f8680; font-size: 11px; }
	.odysseyFooter {
		position: absolute; z-index: 4; left: 8px; right: 8px; bottom: 6px; height: 34px; padding: 0 10px;
		box-sizing: border-box; border: 1px solid #9a9a9a; border-radius: 8px; background: rgba(10,8,8,.92);
		font-size: 11px; line-height: 34px;
	}
	.odysseyFooterLeft { float: left; }
	.odysseyFooterRight { float: right; color: #d7d0c8; }
	.odysseyDot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 4px; vertical-align: middle; }
	.odysseyDot--civilian { background: #3fd03a; }
	.odysseyDot--hostile { background: #e23b3b; }
	.odysseyDot--nebula { background: #9b4fd6; }
	.odysseyDot--terminal { background: #ffe14a; box-shadow: 0 0 4px #ffe14a; }
	.odysseyInactive { margin: 80px auto; width: 70%; padding: 20px; text-align: center; border: 1px solid #9a9a9a; border-radius: 8px; background: rgba(0,0,0,.55); }
	.odysseyShell--compact { height: 520px; }
	.odysseyShell--compact .odysseyTitle { font-size: 18px; top: 8px; left: 10px; }
	.odysseyShell--compact .odysseyStatus { top: 32px; left: 10px; font-size: 10px; max-width: 92%; }
	.odysseyShell--compact .odysseyMap { left: 4px; right: 4px; top: 52px; bottom: 156px; }
	.odysseyShell--compact .odysseyDossier {
		top: auto; left: 8px; right: 8px; bottom: 42px; width: auto; height: 108px; padding: 8px; font-size: 11px;
	}
	.odysseyShell--compact .odysseyFooter { font-size: 10px; height: 30px; line-height: 30px; }
	.odysseyShell--compact .odysseyLabel { font-size: 10px; padding: 2px 5px; }
</style>
	{{if !data.odyssey || !data.odyssey.active}}
		<div class="odysseyInactive">Навигационная сеть Одиссеи неактивна.</div>
	{{else}}
		<div class="odysseyShell{{if data.odyssey_compact}} odysseyShell--compact{{/if}}">
			<div class="odysseyTitle">SECTOR MAP</div>
			<div class="odysseyStatus">Эшелон {{:data.odyssey.shift}}/{{:data.odyssey.max_shifts}} · Текущий сектор: {{:data.odyssey.current_name}}</div>
			<div class="odysseyMap">
				<svg class="odysseySvg" viewBox="0 0 100 100" preserveAspectRatio="none">
					{{for data.odyssey.lines}}
						<line x1="{{:value.x1}}" y1="{{:value.y1}}" x2="{{:value.x2}}" y2="{{:value.y2}}" stroke="#d8d8d8" stroke-width="0.35" vector-effect="non-scaling-stroke" />
					{{/for}}
				</svg>
				{{for data.odyssey.nodes}}
					{{if value.current}}
						<div class="odysseyShip" style="left:{{:value.x}}%;bottom:{{:value.y}}%;"></div>
					{{/if}}
					<div class="odysseyNode odysseyNode--{{:value.visual}} {{:value.terminal ? 'odysseyNode--terminal' : ''}} {{:value.available || value.current ? '' : 'odysseyNode--locked'}} {{:value.current ? 'odysseyNode--current' : ''}} {{:value.selected ? 'odysseyNode--selected' : ''}} {{:value.viewed ? 'odysseyNode--viewed' : ''}}" style="left:{{:value.x}}%;bottom:{{:value.y}}%;"></div>
					{{if value.available}}
						<div class="odysseyBracket" style="left:{{:value.x}}%;bottom:{{:value.y}}%;"></div>
						<div class="odysseyLabel" style="left:{{:value.x}}%;bottom:{{:value.y}}%;">
							{{:helper.link(value.choice_label, '', {'odyssey_inspect': value.id})}}
						</div>
					{{/if}}
					<div class="odysseyHit" style="left:{{:value.x}}%;bottom:{{:value.y}}%;">
							{{:helper.link('.', '', {'odyssey_inspect': value.id})}}
					</div>
				{{/for}}
			</div>
			<div class="odysseyDossier">
				{{if data.odyssey.has_view}}
					<h3>{{:data.odyssey.view.name}}</h3>
					<div class="odysseyDossierMeta">
						Класс: {{:data.odyssey.view.danger_label}} · Эшелон {{:data.odyssey.view.depth}}
						{{if data.odyssey.view.terminal}} · Финал{{/if}}
						{{if data.odyssey.view.current}} · Здесь{{/if}}
						{{if data.odyssey.view.selected}} · Курс{{/if}}
					</div>
					<div class="odysseyDossierBody">{{:data.odyssey.view.summary}}</div>
					<div class="odysseyDossierExits">Коридоры: {{:data.odyssey.view.exits}}</div>
					{{if data.odyssey.view.available}}
						<div class="odysseyDossierHint">Сектор доступен. Курс прокладывает командование.</div>
					{{else data.odyssey.view.current}}
						<div class="odysseyDossierHint">Сьерра находится в этом секторе.</div>
					{{else}}
						<div class="odysseyDossierHint">Нет прямого коридора из текущего положения.</div>
					{{/if}}
				{{else}}
					<div class="odysseyDossierHint">Выберите сектор на карте.</div>
				{{/if}}
			</div>
			<div class="odysseyFooter">
				<span class="odysseyFooterLeft">
					<span class="odysseyDot odysseyDot--civilian"></span>Гражданский
					&nbsp;<span class="odysseyDot odysseyDot--hostile"></span>Враждебный
					&nbsp;<span class="odysseyDot odysseyDot--nebula"></span>Туманность
					&nbsp;<span class="odysseyDot odysseyDot--terminal"></span>Финал
				</span>
				<span class="odysseyFooterRight">
					Курс: {{:data.odyssey.selected_name}}{{if data.odyssey.selected_by}} · {{:data.odyssey.selected_by}}{{/if}}
				</span>
			</div>
		</div>
	{{/if}}
{{else data.has_network}}
	{{if data.prog_state == 1}} <!-- NEWSCAST_HOME - Display channels and date/time -->
		<table style="width:100%">
			<tr>
			<td>Interface and networks operational.
			<tr>
			<td>{{:data.time_blurb}}
			<tr>
			<td>{{:data.notifs_blurb}}
			<td>{{:helper.link(data.notifs_enabled ? "Disable" : "Enable", data.notifs_enabled ? 'volume-off' : 'volume-o', {'toggle_notifs' : 1})}}
		</table>
		{{if data.odyssey_active}}
			<h3><u>Expedition</u></h3>
			<table style="width:100%">
				<tr>
				<td>{{:helper.link("Sector Map", "image", {'view_sector_map' : 1})}}
				<td><i>Live navigational brief for Sierra's current expedition.</i>
			</table>
		{{/if}}
		<h3><u>Connected channels</u></h3>
		<table style="width:100%">
			{{for data.channels}}
				<tr>
				{{if value.censored}}
					<td>{{:helper.link(value.name, null, {'view_channel' : value.ref})}} <font color='red'>***</font>
				{{else}}
					<td>{{:helper.link(value.name, null, {'view_channel' : value.ref})}}
				{{/if}}
			{{empty}}
				<p><font color='red'><h2><b>NO CHANNELS FOUND</b></h2>Couldn't locate any channels on the local NTNet instance. Please try again in a few minutes.</font></p>
			{{/for}}
		</table>
	{{else data.prog_state == 2}} <!-- NEWSCAST_VIEW_CHANNEL - Show the contents of the active channel -->
		{{for data.active_channels}}
			<h3><u>{{:value.name}}</u></h3>
			<i><font size=1>Created by <font color="#cc9090">{{:value.author}}</font></font></i>
			<hr>
			{{if value.censored}}
				{{:data.dnotice_blurb}}<br><br> <!-- no reading for you, pensive -->
			{{else}}
				{{for data.active_stories}}
					<br>"{{:value.body}}"<br>
					{{if value.has_photo}}
						<br>
						<table style="width:100%">
							<tr>
							<td>{{:value.photo_dat}}<br>
							<!--<td>{{:helper.link("View photo", null, {'view_photo' : value.story_ref})}}-->
						</table>
					{{/if}}
					<i><font size=1>Story by <font color="#cc9090">{{:value.author}}</font> at {{:value.timestamp}}</font></i>
					<br><br><hr>
				{{empty}}
					<p><i>This network has submitted no stories during the current time slot. Please use network-specific sites, apps, and archives to access stories submitted outside of this time slot.</i></p>
				{{/for}}
			{{/if}}
		{{/for}}
		{{:helper.link("Return", 'arrowreturnthick-1-w', {'return_to_home' : 1})}}
	{{/if}}
{{else}}
	<p><font color='red'><h2><b>NO NETWORK FOUND</b></h2>Couldn't fetch news data from a feed network. Ensure you have a connection to NTNet and there is a network broadcaster in your sector.</font></p>
	{{if data.odyssey_active}}
		<p>{{:helper.link("Open Sector Map", "image", {'view_sector_map' : 1})}}</p>
	{{/if}}
{{/if}}
