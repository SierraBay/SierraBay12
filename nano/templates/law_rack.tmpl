<div class="item">
	<div class="itemLabel">
		Linked AI:
	</div>
	<div class="itemContent">
		{{if data.linked_ai}}
			<span class="good" style="font-weight: bold;">{{:data.linked_ai}}</span>
		{{else}}
			<span class="idle">None</span>
		{{/if}}
	</div>
</div>

<div class="item">
	<div class="itemLabel">
		Active Preset:
	</div>
	<div class="itemContent">
		{{if data.active_preset_name}}
			<span class="average" style="font-weight: bold;">{{:data.active_preset_name}}</span>
		{{else}}
			<span class="idle">None</span>
		{{/if}}
	</div>
</div>

<div class="item">
	<div class="itemLabel">
		Inserted ID:
	</div>
	<div class="itemContent">
		{{if data.inserted_id}}
			<span class="good" style="font-weight: bold;">{{:data.inserted_id}}</span>
			<div style="float: right;">
				{{:helper.link('Eject ID', 'eject', {'eject_id' : 1}, null, 'redButton')}}
			</div>
		{{else}}
			<span class="idle">None (Insert ID card to unlock slots)</span>
		{{/if}}
	</div>
</div>

<div class="item">
	<div class="itemLabel">
		Access Status:
	</div>
	<div class="itemContent">
		{{if data.slots_unlocked}}
			<span class="good" style="font-weight: bold; letter-spacing: 1px;">UNLOCKED</span>
		{{else}}
			<span class="bad" style="font-weight: bold; letter-spacing: 1px;">LOCKED</span>
		{{/if}}
	</div>
</div>

<div class="item">
	<div class="itemLabel">
		Last Sync Status:
	</div>
	<div class="itemContent">
		{{if data.last_sync_time}}
			<span style="font-weight: 500;">{{:data.last_sync_time}} - {{:data.last_sync_status}}</span>
		{{else}}
			<span class="idle">Never</span>
		{{/if}}
	</div>
</div>

<hr/>

<div class="item">
	<div class="itemLabel">
		Rack Actions:
	</div>
	<div class="itemContent">
		{{if data.slots_unlocked}}
			{{:helper.link('Link AI', 'link', {'link_ai' : 1})}}
			{{if data.sync_in_progress}}
				<span class="average" style="font-weight: bold; margin-left: 8px;">Syncing...</span>
			{{else}}
				{{:helper.link('Force Sync', 'refresh', {'force_sync' : 1}, data.linked_ai ? null : 'disabled')}}
			{{/if}}
		{{else}}
			<span class="idle">Unlock rack to perform actions</span>
		{{/if}}
	</div>
</div>

<hr/>

<h3>Installed Law Modules</h3>

{{if data.slots && data.slots.length}}
	{{for data.slots}}
		<div class="item" style="border-bottom: 1px solid #333; padding-bottom: 8px; margin-bottom: 8px;">
			<div class="itemLabel" style="width: 150px; float: left;">
				<div style="font-weight: bold; margin-bottom: 4px;">Slot {{:value.index}}</div>
				{{if value.has_module}}
					{{if value.type == 'core'}}
						<span class="good" style="font-weight: bold; font-size: 10px; border: 1px solid #48a048; padding: 1px 4px; border-radius: 3px; background-color: rgba(72,160,72,0.15);">CORE</span>
					{{else value.type == 'supplied'}}
						<span class="average" style="font-weight: bold; font-size: 10px; border: 1px solid #d08020; padding: 1px 4px; border-radius: 3px; background-color: rgba(208,128,32,0.15);">SUPPLIED</span>
					{{else value.type == 'corrupted'}}
						<span class="bad" style="font-weight: bold; font-size: 10px; border: 1px solid #d02020; padding: 1px 4px; border-radius: 3px; background-color: rgba(208,32,32,0.15); animation: blinker 1s linear infinite;">CORRUPTED</span>
					{{else}}
						<span class="idle" style="font-weight: bold; font-size: 10px; border: 1px solid #666; padding: 1px 4px; border-radius: 3px; background-color: rgba(100,100,100,0.15);">STANDARD</span>
					{{/if}}
				{{else}}
					<span class="idle" style="font-size: 10px; border: 1px dashed #444; padding: 1px 4px; border-radius: 3px;">EMPTY</span>
				{{/if}}
			</div>
			
			<div class="itemContent" style="width: 430px; float: right;">
				{{if value.has_module}}
					<div style="font-weight: bold; font-size: 13px; color: #fff; margin-bottom: 2px;">
						{{:value.name}}
					</div>
					<div style="font-size: 11px; color: #ccc; font-style: italic; background-color: rgba(0,0,0,0.2); padding: 4px 6px; border-radius: 4px; margin-bottom: 6px; border-left: 3px solid #666; word-wrap: break-word;">
						"{{:value.preview}}"
					</div>
					
					{{if data.slots_unlocked}}
						{{:helper.link('Remove', 'close', {'remove' : value.index}, null, 'redButton')}}
						{{if value.index > 1}}
							{{:helper.link('Move Up', 'arrowthick-1-n', {'move_up' : value.index})}}
						{{/if}}
						{{if value.index < data.max_slots}}
							{{:helper.link('Move Down', 'arrowthick-1-s', {'move_down' : value.index})}}
						{{/if}}
					{{else}}
						<span class="idle">Locked</span>
					{{/if}}
				{{else}}
					<div style="color: #666; font-style: italic; padding: 12px 0;">
						Insert a law module to program this slot
					</div>
				{{/if}}
			</div>
			<div style="clear: both;"></div>
		</div>
	{{/for}}
{{/if}}

<style>
@keyframes blinker {
	50% { opacity: 0.3; }
}
</style>
