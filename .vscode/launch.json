{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "byond",
      "request": "launch",
      "name": "Build & DS Debug",
      "preLaunchTask": "dm: build - ${command:CurrentDME}",
      "dmb": "${workspaceFolder}/${command:CurrentDMB}"
    },
    {
      "type": "byond",
      "request": "launch",
      "name": "Build & DD Debug",
      "preLaunchTask": "dm: build - ${command:CurrentDME}",
      "dmb": "${workspaceFolder}/${command:CurrentDMB}",
      "dreamDaemon": true
    },
    {
      "type": "byond",
      "request": "launch",
      "name": "DS Debug",
      "preLaunchTask": "tgui: build",
      "dmb": "${workspaceFolder}/${command:CurrentDMB}"
    },
    {
      "type": "byond",
      "request": "launch",
      "name": "Run Unit Tests",
      "preLaunchTask": "dm: build unit tests",
      "postDebugTask": "dm: show unit test results",
      "dmb": "${workspaceFolder}/baystation12.dmb",
      "dreamDaemon": true
    },
    {
      "type": "auxtools",
      "request": "launch",
      "name": "auxtools: Build & Debug",
      "preLaunchTask": "dm: build - ${command:dreammaker.getFilenameDme}",
      "dmb": "${workspaceFolder}/${command:dreammaker.getFilenameDmb}",
      "server": "dreamdaemon"
    },
    {
      "type": "auxtools",
      "request": "launch",
      "name": "auxtools: Debug",
      "dmb": "${workspaceFolder}/${command:dreammaker.getFilenameDmb}",
      "server": "dreamdaemon"
    },
    {
      "type": "auxtools",
      "request": "attach",
      "name": "auxtools: Attach",
      "processId": "${command:auxtools.pickWorld}"
    }
  ]
}
